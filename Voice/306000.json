{
    "id": 306000,
    "collectionNo": 449,
    "name": "美遊・エーデルフェルト",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "在那里。去吧！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "这样就能碰到了！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "看见了。……呀！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "【蓝宝石】扫荡一空！",
                "0_B041": "【美游】预备～",
                "0_B042": "【二人】乳白色光束！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "思念停留此处，愿望寄托彼方。",
                "0_B051": "漂浮于乳白之上的薄红之月啊。",
                "0_B052": "请照遍现世的一切吧……！",
                "0_B053": "贯穿日轮的星河朔月。"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "今年也好热……"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "补充能量。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "村子外面很危险呢。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "不要太吵闹。妖精会逃掉的。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "不要……靠近那个村子……"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "【美游】那么，我继续回去采集妖精了。 【蓝宝石】那真的是可以收集的东西吗……？"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "别碰我！"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "这就是天罚……！？"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "我一旦倒下……村子就会……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "请……放了妖精……"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "我去抓住它。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "它往那边逃了。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "不要动……"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "祈求，乳白色的雨。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "要试着沉溺吗？"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "要跳过去了。跟我来！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "不能只顾着玩呢。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "我会履行巫女的职责。"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "我感受到伊莉雅的气息了……！"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "这样一来，你就逃不掉了！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "被打上……天际吧！"
            }
        },
        "0_B250": {
            "name": "宝具カード 4",
            "text": {
                "0_B250": "你的愿望，一定会实现。"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "出来吧！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "摇晃般……击打！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "这样就能……一网打尽了！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "我讨厌污秽的东西。你也，变干净吧！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "妖精……有一点可爱。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "稍微，拿出一点干劲。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "【蓝宝石】美游大人，是敌人。 【美游】维护治安也是巫女的工作吗。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "【美游】呼。多少也散了散心呢。 【蓝宝石】那在天黑之前赶紧回村子吧。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "【蓝宝石】损伤轻微！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "【蓝宝石】美游大人，请坚持住……！"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "自黑暗诞生，融化于光明的愿望之流星。",
                "0_B801": "相信吧。",
                "0_B802": "天空的彼岸一定是只有善者居住的世界。",
                "0_B803": "贯穿日轮的星河朔月。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "即便是虚假的，人类的感情也能贯穿世界……！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "【蓝宝石】补充水分是很重要的。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "【蓝宝石】这光辉究竟是什么……？"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "啊……不要随便乱动。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "不要，妨碍我！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "凉快一点了吗？"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "这种种火，妖精也能吃吗……？"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "我似乎……明白了些什么。",
                "0_G021": "为什么我会被妖精所吸引。",
                "0_G022": "为什么我非得收集它们不可。",
                "0_G023": "答案……就快揭晓了……"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "【美游】来水边一看，发现这里也有妖精。",
                "0_G031": "【蓝宝石】被抓住的妖精不知不觉就会消失。",
                "0_G032": "【蓝宝石】这到底是什么啊……？",
                "0_G033": "【美游】而且莫名亲人……",
                "0_G034": "【美游】或许有点可爱呢。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "很好吃……",
                "0_G111": "掺进牛奶一起喝感觉也不错呢。"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "感谢您的奉纳。",
                "0_G121": "……需要御朱印之类的吗？"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "祝您生日快乐。",
                "0_H011": "这是第几次，",
                "0_H012": "像这样为御主庆祝生日了呢？",
                "0_H013": "我很高兴随着年龄的增长，回忆也会逐渐增加。",
                "0_H014": "愿今后……御主的未来也能幸福长久。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "外面好像在举办祭典呢。",
                "0_H021": "别忘了去参加哦。"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "您的职责是不是还没有完成呢？"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "所谓的巫女，就是立于人与神之间的人。",
                "0_H041": "代替不会言语的神，负责将神的意志传达给世人。",
                "0_H042": "也就是说……我的上司是神，可以这么理解吧。",
                "0_H043": "……虽然我完全不知道究竟是哪位神。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "如果您有命令，还请随便吩咐。",
                "0_H051": "只要不违背伊莉雅的意志，我都会迅速执行。"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西吗？",
                "0_H061": "伊莉……",
                "0_H062": "啊，是指伊莉雅以外吗……",
                "0_H063": "那个……铃铛长崎蛋糕……之类的？",
                "0_H064": "我觉得它的外形很可爱。",
                "0_H065": "在食物中大概可以排世界第一。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "【美游】讨厌的东西吗？",
                "0_H071": "没有特别讨厌的……硬要说的话……",
                "0_H072": "硬要说的话……",
                "0_H073": "……",
                "0_H074": "【蓝宝石】看来还是想不出来呢。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "我没有能够献给圣杯的愿望。",
                "0_H081": "如果真有什么无论如何都想实现的愿望、想要的未来，我希望靠自己的力量去获得。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "既然称作巫女，我想应该是以神道为基础的吧……",
                "0_H091": "但那个村子的祭祀仪式其实各方面都很混乱。",
                "0_H092": "不过只要信仰是真实的，祈祷的形式或许无关紧要吧。",
                "0_H093": "……正因为是真实的，才更麻烦。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "巫女舞吗？",
                "0_H101": "我不跳。",
                "0_H102": "……不，准确地说，是我还没熟练到足以表演给御主看，所以不能献丑。",
                "0_H103": "……即使这样也没关系？",
                "0_H104": "……我不跳。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "从人类或自然，声音或光……森罗万象所有事物中找到伊莉雅的思想。",
                "0_H111": "我称之为泛伊莉雅论。",
                "0_H112": "御主要不要也练习一下？",
                "0_H113": "正好，那边有一支铅笔掉在地上……",
                "0_H114": "请吧。",
                "0_H115": "试着从它身上找到伊莉雅吧。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "其实从很早以前起，我就从御主的身上感受到了些微伊莉雅感。",
                "0_H121": "原来如此，或许正因为自身包含着伊莉雅，才不容易从其他东西身上发现伊莉雅吧。",
                "0_H122": "至于这算不算好事……还真不好判断。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "咦，你说我和伊莉雅……很像吗？",
                "0_H131": "这还是……第一次有人这么评价我呢。",
                "0_H132": "不过……是啊。我一直都希望自己能变得像伊莉雅一样。",
                "0_H133": "就像那颗总是会为我带来希望的启明星。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "【美游】果然还是真的伊莉雅最好……",
                "0_H171": "那柔软的触感、令人安心的体温、轻轻拂过耳边的甜美声音……",
                "0_H172": "这一切都是无可替代的至宝……",
                "0_H173": "啊，伊莉雅，等一下。",
                "0_H174": "【蓝宝石】被她逃掉了呢。",
                "0_H175": "那逃跑的速度，不愧是正牌货呢。"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "【蓝宝石】从泛伊莉雅论的角度来思考的话，克洛伊大人该怎么算呢？",
                "0_H181": "【美游】这是个困难的议题呢……",
                "0_H182": "虽然小黑本来就是无限接近伊莉雅的存在，所以不用寻找也充满了伊莉雅感……",
                "0_H183": "唔……",
                "0_H184": "无论怎么想，小黑对我来说终究还是小黑。",
                "0_H185": "【蓝宝石】那也是一种亲爱的形式吧。"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "虽然不太明白，但还是受命担任巫女了。我是美游。",
                "0_S011": "暂时好像也没什么事可做，所以我打算先在附近采集妖精。",
                "0_S012": "美游大人，收集这种来历不明的东西是否不太合适呢……"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "追上去！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "【蓝宝石】目标，捕捉。"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "要上了。……嘿！"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "神稚儿奥义……乳白色光束！"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "那是一个无垢的世界。",
                "2_B051": "是没有黑暗的乳白色反转银河。",
                "2_B052": "来吧，一起融化在一起吧……",
                "2_B053": "贯穿日轮的星河朔月。"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "这牛奶，真好喝……"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "这样一来，就还能继续努力。"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "【蓝宝石】巫女大人，该履行职责了。 【美游】嗯，必须让世界充满伊莉雅才行。"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "净化这片土地。让它变得雪白。"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "【蓝宝石】战斗结束。真精彩，巫女大人。 【美游】还远远不够。去寻找更多伊莉雅吧。"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "好多伊莉雅……好幸福……"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "为什么……！？"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "被玷污了……！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "你在哪里……伊莉雅……"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "看不见，月亮……"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "伊莉雅。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "伊莉雅……？"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "伊莉雅！"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "好美……"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "要不要试着溺入牛奶？"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "沉没，直到底部。"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "愿望此刻将成形……"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "我感受到伊莉雅的波动了……！"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "来吧，前往乳白色的天空……"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "就在里面，反省吧。"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "这样一来，就能重获新生了。"
            }
        },
        "2_B250": {
            "name": "宝具カード 4",
            "text": {
                "2_B250": "彼方之月啊，回应我。"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "冲淋，舒服吗？"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "更强……更强！"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "掉下来吧！"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "永不迷失的北极星。光辉降临此地！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "你也，成为伊莉雅吧。"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "感情在不断溢出……"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "走吧，伊莉雅。凭我们的能力，肯定不会输给任何人。"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "愿所有人都能充满伊莉雅……"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "【蓝宝石】无礼！"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": "【蓝宝石】竟敢对巫女大人做这种事……！"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "摇曳的树荫，西沉的夕阳。",
                "2_B801": "星光与虫鸣。",
                "2_B802": "万象的运行中……都有伊莉雅存在。",
                "2_B803": "贯穿日轮的星河朔月。"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "【蓝宝石】反转银河压力差极大。开放。"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "【蓝宝石】温度正好与体温一致。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "【蓝宝石】请瞻仰巫女大人的圣光。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "玩追逐游戏吗？"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "那边很危险。"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "净化之雨啊……！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "能感觉到伊莉雅浓度正在上升。",
                "2_G011": "这意味着世界又向和平迈进了一步。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "【美游】御主也能看见了吧。",
                "2_G041": "……没错。妖精就是伊莉雅。",
                "2_G042": "她一直在我身边为我加油。",
                "2_G043": "【蓝宝石】我们已经察觉了世界真正面貌。我们再也不会迷茫了。",
                "2_G044": "来吧，巫女大人……。",
                "2_G045": "【美游】嗯。将世界……染成乳白色吧！"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "【美游】我似乎做了一个短暂的梦。一个非常快乐的梦……",
                "2_G051": "还是说，那是现实，现在才是梦呢……？",
                "2_G052": "【蓝宝石】怎么了，美游大人？",
                "2_G053": "伊莉雅大人和克洛伊大人正在那边等您哦。",
                "2_G054": "【美游】啊……嗯，我就过去！",
                "2_G055": "……是啊。",
                "2_G056": "是梦还是现实，都无所谓。",
                "2_G057": "有伊莉雅在，也有小黑在。",
                "2_G058": "只要这样，一定就会像做梦一样快乐。"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "灵基越强，思念也会变得越强呢。"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "伊莉雅也要吃吗？",
                "2_G121": "不要吗？　明明很好吃啊。"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "祝您生日快乐。",
                "2_H011": "这是第几次，",
                "2_H012": "像这样为御主庆祝生日了呢？",
                "2_H013": "我很高兴随着年龄的增长，回忆也会逐渐增加。",
                "2_H014": "愿今后……御主的未来也能幸福长久。"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "外面好像在举办祭典呢。",
                "2_H021": "别忘了去参加哦。"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "您的职责是不是还没有完成呢？"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "所谓的巫女，就是立于人与神之间的人。",
                "2_H041": "代替不会言语的神，负责将神的意志传达给世人。",
                "2_H042": "也就是说……我的上司是神，可以这么理解吧。",
                "2_H043": "……虽然我完全不知道究竟是哪位神。"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "如果您有命令，还请随便吩咐。",
                "2_H051": "只要不违背伊莉雅的意志，我都会迅速执行。"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的东西吗？",
                "2_H061": "伊莉……",
                "2_H062": "啊，是指伊莉雅以外吗……",
                "2_H063": "那个……铃铛长崎蛋糕……之类的？",
                "2_H064": "我觉得它的外形很可爱。",
                "2_H065": "在食物中大概可以排世界第一。"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "【美游】讨厌的东西吗？",
                "2_H071": "没有特别讨厌的……硬要说的话……",
                "2_H072": "硬要说的话……",
                "2_H073": "……",
                "2_H074": "【蓝宝石】看来还是想不出来呢。"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "我没有能够献给圣杯的愿望。",
                "2_H081": "如果真有什么无论如何都想实现的愿望、想要的未来，我希望靠自己的力量去获得。"
            }
        },
        "2_H090": {
            "name": "絆Lv.1",
            "text": {
                "2_H090": "既然称作巫女，我想应该是以神道为基础的吧……",
                "2_H091": "但那个村子的祭祀仪式其实各方面都很混乱。",
                "2_H092": "不过只要信仰是真实的，祈祷的形式或许无关紧要吧。",
                "2_H093": "……正因为是真实的，才更麻烦。"
            }
        },
        "2_H100": {
            "name": "絆Lv.2",
            "text": {
                "2_H100": "巫女舞吗？",
                "2_H101": "我不跳。",
                "2_H102": "……不，准确地说，是我还没熟练到足以表演给御主看，所以不能献丑。",
                "2_H103": "……即使这样也没关系？",
                "2_H104": "……我不跳。"
            }
        },
        "2_H110": {
            "name": "絆Lv.3",
            "text": {
                "2_H110": "从人类或自然，声音或光……森罗万象所有事物中找到伊莉雅的思想。",
                "2_H111": "我称之为泛伊莉雅论。",
                "2_H112": "御主要不要也练习一下？",
                "2_H113": "正好，那边有一支铅笔掉在地上……",
                "2_H114": "请吧。",
                "2_H115": "试着从它身上找到伊莉雅吧。"
            }
        },
        "2_H120": {
            "name": "絆Lv.4",
            "text": {
                "2_H120": "其实从很早以前起，我就从御主的身上感受到了些微伊莉雅感。",
                "2_H121": "原来如此，或许正因为自身包含着伊莉雅，才不容易从其他东西身上发现伊莉雅吧。",
                "2_H122": "至于这算不算好事……还真不好判断。"
            }
        },
        "2_H130": {
            "name": "絆Lv.5",
            "text": {
                "2_H130": "咦，你说我和伊莉雅……很像吗？",
                "2_H131": "这还是……第一次有人这么评价我呢。",
                "2_H132": "不过……是啊。我一直都希望自己能变得像伊莉雅一样。",
                "2_H133": "就像那颗总是会为我带来希望的启明星。"
            }
        },
        "2_H170": {
            "name": "会話 4",
            "text": {
                "2_H170": "【美游】果然还是真的伊莉雅最好……",
                "2_H171": "那柔软的触感、令人安心的体温、轻轻拂过耳边的甜美声音……",
                "2_H172": "这一切都是无可替代的至宝……",
                "2_H173": "啊，伊莉雅，等一下。",
                "2_H174": "【蓝宝石】被她逃掉了呢。",
                "2_H175": "那逃跑的速度，不愧是正牌货呢。"
            }
        },
        "2_H180": {
            "name": "会話 5",
            "text": {
                "2_H180": "【蓝宝石】从泛伊莉雅论的角度来思考的话，克洛伊大人该怎么算呢？",
                "2_H181": "【美游】这是个困难的议题呢……",
                "2_H182": "虽然小黑本来就是无限接近伊莉雅的存在，所以不用寻找也充满了伊莉雅感……",
                "2_H183": "唔……",
                "2_H184": "无论怎么想，小黑对我来说终究还是小黑。",
                "2_H185": "【蓝宝石】那也是一种亲爱的形式吧。"
            }
        }
    },
    "ChrVoice_ids": [
        "306000"
    ]
}