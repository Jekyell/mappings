{
  "id": 9948050,
  "name": "グンママリー",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "认清自己的分量吧！"
      },
      "raw_text": {
        "0_B010": "身の程を知りなさい！"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "就只有这点程度吗？"
      },
      "raw_text": {
        "0_B020": "そんなものなのかしら？"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "你躲得开吗！"
      },
      "raw_text": {
        "0_B030": "かわせるかしら！"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "还会冒出更多星星呢！"
      },
      "raw_text": {
        "0_B040": "さらに星が出るわね！"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "就稍微陪你玩玩吧。"
      },
      "raw_text": {
        "0_B080": "軽く遊んであげましょう。"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "无论做什么都是徒劳，徒劳！"
      },
      "raw_text": {
        "0_B090": "何をしても無駄よ、無駄！"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "……适可而止吧！"
      },
      "raw_text": {
        "0_B150": "……いい加減になさい！"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "这样的……这样的结果……"
      },
      "raw_text": {
        "0_B160": "こんな……こんな結果……"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "在那里吗！"
      },
      "raw_text": {
        "0_B410": "そこか！"
      }
    },
    "0_B420": {
      "name": "0_B420",
      "text": {
        "0_B420": "别想逃！"
      },
      "raw_text": {
        "0_B420": "逃がさん！"
      }
    },
    "0_B430": {
      "name": "0_B430",
      "text": {
        "0_B430": "抓住了！命中了！"
      },
      "raw_text": {
        "0_B430": "捉えた！当たった！"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "会冒出星星呢。"
      },
      "raw_text": {
        "0_B440": "星が出るわね。"
      }
    },
    "0_B480": {
      "name": "0_B480",
      "text": {
        "0_B480": "未免也太快了啊。"
      },
      "raw_text": {
        "0_B480": "あまりにも早かったな。"
      }
    },
    "0_B490": {
      "name": "0_B490",
      "text": {
        "0_B490": "奉劝你别碰我！"
      },
      "raw_text": {
        "0_B490": "私には触れないことだ！"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "会是谁先倒下呢，真有看头啊！"
      },
      "raw_text": {
        "0_B840": "誰から落ちるか、見ものだな！"
      }
    },
    "0_B910": {
      "name": "0_B910",
      "text": {
        "0_B910": "现在是东张西望的时候吗！"
      },
      "raw_text": {
        "0_B910": "よそ見など、している場合か！"
      }
    },
    "0_B920": {
      "name": "0_B920",
      "text": {
        "0_B920": "集中精神吧。"
      },
      "raw_text": {
        "0_B920": "集中するがいい。"
      }
    }
  }
}
