{
  "id": 109812230,
  "name": "",
  "voices": {
    "0_C010": {
      "name": "BATTLE IN NEWYORK 2020 9",
      "text": {
        "0_C010": "Present，start。 令人内心悸动不已呢。"
      }
    },
    "0_C020": {
      "name": "BATTLE IN NEWYORK 2020 10",
      "text": {
        "0_C020": "祝您有好运。 抽奖池还是攒着一起抽比较划算。"
      }
    },
    "0_C030": {
      "name": "BATTLE IN NEWYORK 2020 11",
      "text": {
        "0_C030": "有预感了？ 放心吧，那是错觉。"
      }
    },
    "0_C040": {
      "name": "BATTLE IN NEWYORK 2020 12",
      "text": {
        "0_C040": "比拼抽空奖池数的多少是愚蠢的行为。 真正重要的，是通宵达旦完成一切后的您的笑容。"
      }
    },
    "0_C050": {
      "name": "BATTLE IN NEWYORK 2020 13",
      "text": {
        "0_C050": "Forgotten。 请期待闪电般的邂逅。"
      }
    },
    "0_C060": {
      "name": "BATTLE IN NEWYORK 2020 14",
      "text": {
        "0_C060": "命运会犹如倾盆大雨般降下。 做好拍摄纪念照的准备了吗？"
      }
    },
    "0_C110": {
      "name": "BATTLE IN NEWYORK 2020 15",
      "text": {
        "0_C110": "回想起这次抽奖，一定会流下眼泪。 我是杜木兹。"
      }
    },
    "0_C120": {
      "name": "BATTLE IN NEWYORK 2020 16",
      "text": {
        "0_C120": "难受的时候，痛苦的时候，就呼唤我的名字吧。 不会发生什么的。"
      }
    },
    "0_C130": {
      "name": "BATTLE IN NEWYORK 2020 17",
      "text": {
        "0_C130": "做了一个自己沉溺于素材之海的梦。 那只是个梦。"
      }
    },
    "0_C140": {
      "name": "BATTLE IN NEWYORK 2020 18",
      "text": {
        "0_C140": "Good joke。 不要放弃，再抽一次吧。"
      }
    },
    "0_C150": {
      "name": "BATTLE IN NEWYORK 2020 19",
      "text": {
        "0_C150": "Auto mutton。 太美妙了。我的肉仿佛也在燃烧。"
      }
    },
    "0_C160": {
      "name": "BATTLE IN NEWYORK 2020 20",
      "text": {
        "0_C160": "Congratulations。 美丽到令人觉得残酷。 是否该考虑参选戛纳呢？"
      }
    },
    "0_N010": {
      "name": "BATTLE IN NEWYORK 2020 1",
      "text": {
        "0_N010": "您好，我是闪耀之羊，杜木兹。",
        "0_N011": "奖池是好文明。我的新欢阿蒂拉·Santa也是这么说的。",
        "0_N012": "我们如此般配，就算说我们是夫妻也不为过吧。"
      }
    },
    "0_N020": {
      "name": "BATTLE IN NEWYORK 2020 2",
      "text": {
        "0_N020": "您通过战斗赚取抽奖券了吗？",
        "0_N021": "简直就是光与暗的endless battle。",
        "0_N022": "还是多存一些为好。"
      }
    },
    "0_N030": {
      "name": "BATTLE IN NEWYORK 2020 3",
      "text": {
        "0_N030": "今天也来了吗。",
        "0_N031": "真是兴致高涨呢。"
      }
    },
    "0_N040": {
      "name": "BATTLE IN NEWYORK 2020 4",
      "text": {
        "0_N040": "奖池究竟从何而来又将去往何处。",
        "0_N041": "真是个普遍的主题呢。",
        "0_N042": "但就算问我，我也不知道该怎么回答。"
      }
    },
    "0_N050": {
      "name": "BATTLE IN NEWYORK 2020 5",
      "text": {
        "0_N050": "您知道所谓的帮助信息吗？",
        "0_N051": "大部分谜题都能靠那个解决。",
        "0_N052": "如果觉得困了，就去阅读那个吧。"
      }
    },
    "0_N060": {
      "name": "BATTLE IN NEWYORK 2020 6",
      "text": {
        "0_N060": "The end。"
      }
    },
    "0_N070": {
      "name": "BATTLE IN NEWYORK 2020 7",
      "text": {
        "0_N070": "The end。"
      }
    },
    "0_N080": {
      "name": "BATTLE IN NEWYORK 2020 8",
      "text": {
        "0_N080": "抽奖券好像还有剩呢。",
        "0_N081": "就算留着，明天也会成为废纸。",
        "0_N082": "还是现在用掉为好吧？"
      }
    }
  },
  "ChrVoice_ids": [
    "109812230"
  ]
}
