  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "滑扭、滑扭、滑扭扭……"
      },
      "raw_text": {
        "0_B010": "にょろっ、にょろっ、にょろぉん……"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "融为一体扭噗！"
      },
      "raw_text": {
        "0_B020": "とろけて混ざるにょっぷ！"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "扭扭扭扭扭扭扭扭，扭——！"
      },
      "raw_text": {
        "0_B030": "にょにょにょにょにょにょにょにょ、にょにょーん！"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "齐心协力，呼唤同伴！"
      },
      "raw_text": {
        "0_B040": "力を合わせる一五八人呼ぶ！"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "史莱——……扭噗！"
      },
      "raw_text": {
        "0_B080": "すらー……にょぷぅ！"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "滑溜滑溜滑溜——！"
      },
      "raw_text": {
        "0_B090": "にゅるにゅるにゅるーん！"
      }
    },
    "0_B140": {
      "name": "0_B140",
      "text": {
        "0_B140": "看招扭！"
      },
      "raw_text": {
        "0_B140": "にゃろっ！"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "扭溜、扭溜、扭溜。"
      },
      "raw_text": {
        "0_B150": "Nyolong nyolong nyolong."
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "扭扭扭扭……滑溜——。"
      },
      "raw_text": {
        "0_B160": "にょにょにょにょ……にゅるーん。"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "扭啵扭啵扭啵，扭噗！"
      },
      "raw_text": {
        "0_B440": "Нёво-нёво-нёво, нёп-пум!"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "融合进化！超级史莱姆扭噗——！"
      },
      "raw_text": {
        "0_B840": "融合進化！メガスラニョーップ！"
      }
    }
  }
