{
    "id": 1102100,
    "collectionNo": 454,
    "name": "藤堂平助",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "犹如疾风！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "休想得逞！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "别想逃跑！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "如星辰般，闪耀爆裂吧！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "快过所有人，先于所有人，冲在所有人之前……",
                "0_B051": "我就是魁之一番星！",
                "0_B052": "藤堂……平助啊啊啊啊！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "义足的状态没问题。"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "……好！"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "由我打头阵！　八番队，跟我上！"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "冲进去！　由我来开路！"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "要追击就交给我吧。放心，我还能行。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "好了，去下个地方吧。八番队，前进！"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "就凭这种程度！"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "身体……就像要四分五裂了！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "已经不需要，逃跑时留下的伤痕了……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "纵使七度死去，我也……"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "知道了。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "明白。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "是。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "这招如何！"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "嘿！哈！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "别小看我哦！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "嗯，随时都能冲。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "没关系，能行。"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "思想准备……已经做好了。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "得手了！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "就是那里！"
            }
        },
        "0_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "0_B2440": "要上了！　粉碎……散落吧！"
            }
        },
        "0_B250": {
            "name": "宝具カード 4",
            "text": {
                "0_B250": "哪怕只有一瞬，也要如星辰般……！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "贴！斩！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "喷射剑！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "劈斩！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "要撑住啊，兼重！　哈！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "开始冲吧。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "请您看好了，伊东老师。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "我就是新选组八番队队长，魁之藤堂平助！"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "我可不擅长干等着。赶紧动手吧。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "是我们赢了，劝你们还是别再继续了为好哦。"
            }
        },
        "0_B530": {
            "name": "勝利 4",
            "text": {
                "0_B530": "结束了吗。那我先告辞了。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "呜……！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "可恶啊啊啊啊！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "可恶！　手动不了了……"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "对不起……大家……"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "笔直地，一心望着前方……",
                "0_B801": "没错！",
                "0_B802": "犹如闪耀在那片天空中的北辰！"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "不好意思了，但请你跟我一起走吧！",
                "0_B811": "直到这个世界的尽头！",
                "0_B812": "魁·一番星！"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "我！　现在确实……",
                "0_B821": "就在这里！",
                "0_B822": "再见了，大家……"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "这就是我的……撒手锏！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "你们几个，认命吧。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "呼……哈！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "吃我这招！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "碎星！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "嘿呀！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "嗯，义手的状态也不错。"
            }
        },
        "0_G040": {
            "name": "霊基再臨 1",
            "text": {
                "0_G040": "没想到我竟然还能再次披上这件羽织……",
                "0_G041": "虽然我也觉得自己有什么脸，但大家依然接纳了我。",
                "0_G042": "将摇摆不定的我，接纳为新选组的队士……"
            }
        },
        "0_G050": {
            "name": "霊基再臨 2",
            "text": {
                "0_G050": "看到现在的我，大家究竟会怎么想呢。",
                "0_G051": "那一天，对一切感到绝望而死的我，又在这里挥剑。",
                "0_G052": "他们会笑我，会谴责我，还是压根就不记得我这种人了呢。",
                "0_G053": "但是，我还想再次，再试一次。",
                "0_G054": "虽然我只是个没能成为新选组，也没能成为御陵卫士的半吊子，但我想再次，在这里……",
                "0_G055": "然后如果有朝一日还能再次相见的话，届时还请……",
                "0_G056": "——裁决我吧。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "谢谢……",
                "0_G111": "干嘛啦，道谢我还是会的。"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "没事……我还能继续。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "今天是御主的生日？",
                "0_H011": "怎么不早说啊。要是早知道，我还能给你挑件衣服什么的……",
                "0_H012": "对了，陪我走一趟。我们一起去买吧。",
                "0_H013": "放心吧，我还是有点钱的。",
                "0_H014": "来，走吧走吧。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "你说活动？",
                "0_H021": "既然如此，就赶紧出门吧。",
                "0_H022": "不用做什么准备啦，快点快点！"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "战斗吗？",
                "0_H031": "那头阵就交给我吧。好，上吧！"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主从吗……",
                "0_H041": "我不太想谈这个。毕竟我……",
                "0_H042": "不，没什么。我先走了。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "喂，你真的要用我吗？",
                "0_H051": "不，毕竟你是御主，想怎么使唤我都行。",
                "0_H052": "但我不希望因为我的缘故，让你被别人说什么。"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西？",
                "0_H061": "现在的话，是啊……是我在小卖部买的巧克力冰淇淋。",
                "0_H062": "那个超级好吃。",
                "0_H063": "竟然能随时吃到那种东西，这真是个好时代啊。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "与其说是讨厌，倒不如说我不喜欢密谈、背后说人坏话之类的。",
                "0_H071": "有什么想说的就堂堂正正当面说出来啊。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "什么愿望都能实现的圣杯吗。",
                "0_H081": "这样的话，希望能让大家……",
                "0_H082": "不，这么方便的事……怎么可能存在嘛。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "魁老师？",
                "0_H091": "啊，就是大家称呼我的那个吧。",
                "0_H092": "别这么叫。我本来就不是当什么老师的料啦。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "我死时身体都支离破碎了。",
                "0_H101": "成为从者时是强行将身体拼接了起来，才会变成这个样子。",
                "0_H102": "但多亏了魔力的流动，倒也没什么不方便的。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "除北辰一刀流以外，我还拿到了炮术免许，所以也很擅长使用火药。",
                "0_H111": "多亏了这个，我在义手里装了一门炮。",
                "0_H112": "到关键时刻还可以用这玩意儿轰上一发。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "接下来我要说的全都是编的，你不用当真。",
                "0_H121": "其实我是某位藩主的私生子，从出生起就没有被任何人需要过。",
                "0_H122": "我根本没见过父亲，而母亲则只会讲述那不知是真是假的父亲的事。",
                "0_H123": "她就这样一直说着父亲总会有一天会来接她的话，最后死去了……",
                "0_H124": "那个，你需要我吗……？",
                "0_H125": "抱歉，突然说这种奇怪的话……忘了吧。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "在一心望着前方，不停挥剑的那段时期。",
                "0_H131": "我究竟在哪里走错了，还是说，我想相信自己是走错了呢。",
                "0_H132": "然后，我开始逃避自己。",
                "0_H133": "可是，当看到总是径直望着前方、不断前进的你，不，是看到这样的御主后，我想起来了。",
                "0_H134": "想起了那一心望着前方时的自己。",
                "0_H135": "所以，虽然让你见到了我很多丢脸的样子，但我依然很高兴能和你缔结契约。",
                "0_H136": "可恶，这种话真让人不好意思……",
                "0_H137": "干嘛啦，就算事到如今你想解除契约也没门哦。",
                "0_H138": "陪我到……最后吧。"
            }
        },
        "0_H180": {
            "name": "会話 4",
            "text": {
                "0_H180": "土方先生，我果然无法喜欢你。",
                "0_H181": "但是，除了你以外，没人能胜任新选组的副长。",
                "0_H182": "所以我会一直看着你。",
                "0_H183": "一直……看着你……"
            }
        },
        "0_H190": {
            "name": "会話 5",
            "text": {
                "0_H190": "冲田，你还是一点都没变……",
                "0_H191": "不，明显变了。那是什么打扮？",
                "0_H192": "泳装？　喷气背包？　跟我一样？",
                "0_H193": "我这只是义足，别把我们相提并论啦！"
            }
        },
        "0_H210": {
            "name": "会話 6",
            "text": {
                "0_H210": "那是永仓先生……？",
                "0_H211": "呃，竟然那么老了啊。",
                "0_H212": "不，虽然我完全没见过，但那的确是永仓先生。",
                "0_H213": "该怎么说呢，毕竟他个人风格太强烈了嘛。"
            }
        },
        "0_H230": {
            "name": "会話 7",
            "text": {
                "0_H230": "山、山南老师也在这里……",
                "0_H231": "为、为什么事到如今您还会回到新选组……",
                "0_H232": "不，这话轮不到我来说吧。",
                "0_H233": "而且伊东老师以前总是说，要是山南还活着的话……",
                "0_H234": "所以，请您再次助我们一臂之力吧。"
            }
        },
        "0_H260": {
            "name": "会話 8",
            "text": {
                "0_H260": "我的刀吗？",
                "0_H261": "是上总介兼重。",
                "0_H262": "虽然在池田屋变得破破烂烂了，但还是这把刀用起来最安心。",
                "0_H263": "我知道，你想说我配不上这把刀吧。",
                "0_H264": "我也这么觉得。"
            }
        },
        "0_H270": {
            "name": "会話 9",
            "text": {
                "0_H270": "自油小路以来许久未见呢，原田先生。",
                "0_H271": "不是在讽刺你啦。",
                "0_H272": "毕竟你也过得非常辛苦吧。",
                "0_H273": "嗯，同为背叛者，让我们重新来过吧。"
            },
            "raw_text": {
                "0_H270": "油の工事以来ですね、原田さん。別に嫌味じゃないですよ。そっちはそっちで大変だったでしょうから。ええ。お互い裏切り者同士。もう一度やり直しましょう。",
                "0_H271": "",
                "0_H272": "",
                "0_H273": ""
            }
        },
        "0_H300": {
            "name": "会話 10",
            "text": {
                "0_H300": "伊东老师……",
                "0_H301": "虽然您没有叫我的事令我有些不甘心，但以老师的性格，其中一定有什么深意吧。",
                "0_H302": "而且，我也没有资格说什么怨言。",
                "0_H303": "但是……",
                "0_H304": "即便如此，我还是希望您能叫上我……"
            },
            "raw_text": {
                "0_H300": "伊藤先生。僕を呼んでくれなかったのは少し口惜しいですが。先生のことだ。きっと深いお考えがあってのことだったんでしょうね。それに恨み言を言う資格も僕にはない。でも。それでも僕は。呼んで欲しかった。",
                "0_H301": "",
                "0_H302": "",
                "0_H303": "",
                "0_H304": ""
            }
        },
        "0_H310": {
            "name": "会話 11",
            "text": {
                "0_H310": "服部先生，我听说了。",
                "0_H311": "听说您面对迦勒底寸步不让，作为御陵卫士打了一场精彩的战斗吧。",
                "0_H312": "……我也，我也为您感到骄傲。"
            },
            "raw_text": {
                "0_H310": "服部さん、話は聞きました。カルデアを相手に一歩も引かず、五龍勇士として見事な戦いぶりを披露したそうですね。僕も、僕も誇りに思います。",
                "0_H311": "",
                "0_H312": ""
            }
        },
        "0_H320": {
            "name": "会話 12",
            "text": {
                "0_H320": "近藤先生，我果然是个半吊子。",
                "0_H321": "逃避这样的自己，做出了那种事情。",
                "0_H322": "即便如此，您也没有抛弃我。",
                "0_H323": "我知道的，当时也是这样。",
                "0_H324": "我一直……都知道。"
            },
            "raw_text": {
                "0_H320": "近藤さん。やっぱり僕は半端者でした。そんな自分から目をそらしてあんなことをしてしまった。それでもあなたは僕を見捨てなかった。分かっていたんです。あの時もそうだったって。分かっていたんです。",
                "0_H321": "",
                "0_H322": "",
                "0_H323": "",
                "0_H324": ""
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "新选组八番队队长，藤堂平助。",
                "0_S011": "职阶是……复仇者吗。",
                "0_S012": "不，没什么。既然应召唤而来，我自会竭尽全力。",
                "0_S013": "我习惯打头阵，你尽管差遣我吧。"
            }
        },
        "1_B010": {
            "name": "アタック 1",
            "text": {
                "1_B010": "太碍事了！"
            }
        },
        "1_B020": {
            "name": "アタック 2",
            "text": {
                "1_B020": "给我让开！"
            }
        },
        "1_B030": {
            "name": "アタック 3",
            "text": {
                "1_B030": "承受痛苦吧！"
            }
        },
        "1_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "1_B040": "撕裂切开！　然后轰飞！"
            }
        },
        "1_B050": {
            "name": "宝具 1",
            "text": {
                "1_B050": "可恶，可恶，可恶可恶可恶……",
                "1_B051": "可恶啊啊啊啊啊啊！"
            }
        },
        "1_B080": {
            "name": "スキル 1",
            "text": {
                "1_B080": "休想活着回去。"
            }
        },
        "1_B090": {
            "name": "スキル 2",
            "text": {
                "1_B090": "别想就这么算了。"
            }
        },
        "1_B100": {
            "name": "開始 1",
            "text": {
                "1_B100": "我要把大家……把大家全都杀掉！"
            }
        },
        "1_B110": {
            "name": "開始 2",
            "text": {
                "1_B110": "休想逃跑……休想……！"
            }
        },
        "1_B120": {
            "name": "勝利 1",
            "text": {
                "1_B120": "赢了……吗……呜！　身体……！"
            }
        },
        "1_B130": {
            "name": "勝利 2",
            "text": {
                "1_B130": "杀完了。这样总行了吧，再见了。"
            }
        },
        "1_B140": {
            "name": "ダメージ 2",
            "text": {
                "1_B140": "可恶啊！"
            }
        },
        "1_B150": {
            "name": "ダメージ 1",
            "text": {
                "1_B150": "怎么可能……有这种事啊……"
            }
        },
        "1_B160": {
            "name": "戦闘不能 1",
            "text": {
                "1_B160": "结束了吗……竟然如此轻易……"
            }
        },
        "1_B170": {
            "name": "戦闘不能 2",
            "text": {
                "1_B170": "身体已经……动不了……了……"
            }
        },
        "1_B180": {
            "name": "コマンドカード 1",
            "text": {
                "1_B180": "我知道。"
            }
        },
        "1_B190": {
            "name": "コマンドカード 2",
            "text": {
                "1_B190": "嗯。"
            }
        },
        "1_B200": {
            "name": "コマンドカード 3",
            "text": {
                "1_B200": "行了啦。"
            }
        },
        "1_B2010": {
            "name": "アタック 10",
            "text": {
                "1_B2010": "呀——！"
            }
        },
        "1_B2020": {
            "name": "アタック 11",
            "text": {
                "1_B2020": "看招！"
            }
        },
        "1_B2030": {
            "name": "アタック 12",
            "text": {
                "1_B2030": "你这混蛋！"
            }
        },
        "1_B210": {
            "name": "宝具カード 1",
            "text": {
                "1_B210": "呜……知道了……"
            }
        },
        "1_B220": {
            "name": "宝具カード 2",
            "text": {
                "1_B220": "行啊，也就是要把我当弃子吧。"
            }
        },
        "1_B230": {
            "name": "宝具カード 3",
            "text": {
                "1_B230": "同归于尽。"
            }
        },
        "1_B2410": {
            "name": "アタック 13",
            "text": {
                "1_B2410": "给我炸开！"
            }
        },
        "1_B2420": {
            "name": "アタック 14",
            "text": {
                "1_B2420": "切开！"
            }
        },
        "1_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "1_B2440": "唯有豁出性命，才能绝处逢生！"
            }
        },
        "1_B250": {
            "name": "宝具カード 4",
            "text": {
                "1_B250": "一定要……解决掉。"
            }
        },
        "1_B410": {
            "name": "アタック 4",
            "text": {
                "1_B410": "哭喊吧！"
            }
        },
        "1_B420": {
            "name": "アタック 5",
            "text": {
                "1_B420": "去死吧！"
            }
        },
        "1_B430": {
            "name": "アタック 6",
            "text": {
                "1_B430": "休想逃跑！"
            }
        },
        "1_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "1_B440": "看着……我啊啊啊啊啊！"
            }
        },
        "1_B480": {
            "name": "スキル 3",
            "text": {
                "1_B480": "腿，没问题呢。"
            }
        },
        "1_B490": {
            "name": "スキル 4",
            "text": {
                "1_B490": "我来做你的对手。"
            }
        },
        "1_B500": {
            "name": "開始 3",
            "text": {
                "1_B500": "好啊，就打到一方死去为止吧。"
            }
        },
        "1_B510": {
            "name": "開始 4",
            "text": {
                "1_B510": "不过来的话，我就上了哦！"
            }
        },
        "1_B520": {
            "name": "勝利 3",
            "text": {
                "1_B520": "哈哈哈……成功了，成功了。我终于，哈、哈哈哈哈哈……！"
            }
        },
        "1_B530": {
            "name": "勝利 4",
            "text": {
                "1_B530": "对不起……没能遏制住。"
            }
        },
        "1_B540": {
            "name": "ダメージ 4",
            "text": {
                "1_B540": "什么！？"
            }
        },
        "1_B550": {
            "name": "ダメージ 3",
            "text": {
                "1_B550": "啊——！"
            }
        },
        "1_B560": {
            "name": "戦闘不能 3",
            "text": {
                "1_B560": "绝不饶恕，绝对不会，饶恕你们！"
            }
        },
        "1_B570": {
            "name": "戦闘不能 4",
            "text": {
                "1_B570": "我到底在……做什么……"
            }
        },
        "1_B800": {
            "name": "宝具 2",
            "text": {
                "1_B800": "身体，已经，撑不住了……",
                "1_B801": "但要死……",
                "1_B802": "也要把你带上！"
            }
        },
        "1_B810": {
            "name": "宝具 3",
            "text": {
                "1_B810": "直到你我中，",
                "1_B811": "有一个彻底粉碎为止，",
                "1_B812": "我都会一直跑下去啊啊啊啊啊！"
            }
        },
        "1_B820": {
            "name": "宝具 4",
            "text": {
                "1_B820": "真奇怪啊，星星，消失了……",
                "1_B821": "原来如此，这就是，终结……啊……"
            }
        },
        "1_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "1_B840": "休想……得逞啊啊啊啊！"
            }
        },
        "1_B880": {
            "name": "スキル 5",
            "text": {
                "1_B880": "别逃哦！"
            }
        },
        "1_B890": {
            "name": "スキル 6",
            "text": {
                "1_B890": "哈——！"
            }
        },
        "1_B910": {
            "name": "アタック 7",
            "text": {
                "1_B910": "给我滚！"
            }
        },
        "1_B920": {
            "name": "アタック 8",
            "text": {
                "1_B920": "消失吧！"
            }
        },
        "1_B930": {
            "name": "アタック 9",
            "text": {
                "1_B930": "四分五裂吧！"
            }
        },
        "1_G010": {
            "name": "レベルアップ 1",
            "text": {
                "1_G010": "嗯，义手的状态也不错。"
            }
        },
        "1_G020": {
            "name": "霊基再臨 2",
            "text": {
                "1_G020": "这副身体的时候，精神也会变得有些混乱。",
                "1_G021": "尤其在战斗时格外严重。",
                "1_G022": "会无法完全遏制从心底涌上来的感情。",
                "1_G023": "所以……",
                "1_G024": "还是别离我太近哦。"
            }
        },
        "1_G030": {
            "name": "霊基再臨 1",
            "text": {
                "1_G030": "呜……别、别靠近我！",
                "1_G031": "只要稍等一会儿就会平复下来了！",
                "1_G032": "……呼。",
                "1_G033": "这身体的形式与我原本的灵基相去甚远。",
                "1_G034": "一定要说的话，就是一副东拼西凑的身体。",
                "1_G035": "所以让我一个人待一会儿吧。"
            }
        },
        "1_G110": {
            "name": "レベルアップ 2",
            "text": {
                "1_G110": "谢谢……",
                "1_G111": "干嘛啦，道谢我还是会的。"
            }
        },
        "1_G120": {
            "name": "レベルアップ 3",
            "text": {
                "1_G120": "没事……我还能继续。"
            }
        },
        "1_H010": {
            "name": "誕生日",
            "text": {
                "1_H010": "今天是御主的生日？",
                "1_H011": "怎么不早说啊。要是早知道，我还能给你挑件衣服什么的……",
                "1_H012": "对了，陪我走一趟。我们一起去买吧。",
                "1_H013": "放心吧，我还是有点钱的。",
                "1_H014": "来，走吧走吧。"
            }
        },
        "1_H020": {
            "name": "イベント開催中",
            "text": {
                "1_H020": "你说活动？",
                "1_H021": "既然如此，就赶紧出门吧。",
                "1_H022": "不用做什么准备啦，快点快点！"
            }
        },
        "1_H030": {
            "name": "会話 1",
            "text": {
                "1_H030": "战斗吗？",
                "1_H031": "那头阵就交给我吧。好，上吧！"
            }
        },
        "1_H040": {
            "name": "会話 2",
            "text": {
                "1_H040": "主从吗……",
                "1_H041": "我不太想谈这个。毕竟我……",
                "1_H042": "不，没什么。我先走了。"
            }
        },
        "1_H050": {
            "name": "会話 3",
            "text": {
                "1_H050": "喂，你真的要用我吗？",
                "1_H051": "不，毕竟你是御主，想怎么使唤我都行。",
                "1_H052": "但我不希望因为我的缘故，让你被别人说什么。"
            }
        },
        "1_H060": {
            "name": "好きなこと",
            "text": {
                "1_H060": "喜欢的东西？",
                "1_H061": "现在的话，是啊……是我在小卖部买的巧克力冰淇淋。",
                "1_H062": "那个超级好吃。",
                "1_H063": "竟然能随时吃到那种东西，这真是个好时代啊。"
            }
        },
        "1_H070": {
            "name": "嫌いなこと",
            "text": {
                "1_H070": "与其说是讨厌，倒不如说我不喜欢密谈、背后说人坏话之类的。",
                "1_H071": "有什么想说的就堂堂正正当面说出来啊。"
            }
        },
        "1_H080": {
            "name": "聖杯について",
            "text": {
                "1_H080": "什么愿望都能实现的圣杯吗。",
                "1_H081": "这样的话，希望能让大家……",
                "1_H082": "不，这么方便的事……怎么可能存在嘛。"
            }
        },
        "1_H090": {
            "name": "絆Lv.1",
            "text": {
                "1_H090": "魁老师？",
                "1_H091": "啊，就是大家称呼我的那个吧。",
                "1_H092": "别这么叫。我本来就不是当什么老师的料啦。"
            }
        },
        "1_H100": {
            "name": "絆Lv.2",
            "text": {
                "1_H100": "我死时身体都支离破碎了。",
                "1_H101": "成为从者时是强行将身体拼接了起来，才会变成这个样子。",
                "1_H102": "但多亏了魔力的流动，倒也没什么不方便的。"
            }
        },
        "1_H110": {
            "name": "絆Lv.3",
            "text": {
                "1_H110": "除北辰一刀流以外，我还拿到了炮术免许，所以也很擅长使用火药。",
                "1_H111": "多亏了这个，我在义手里装了一门炮。",
                "1_H112": "到关键时刻还可以用这玩意儿轰上一发。"
            }
        },
        "1_H120": {
            "name": "絆Lv.4",
            "text": {
                "1_H120": "接下来我要说的全都是编的，你不用当真。",
                "1_H121": "其实我是某位藩主的私生子，从出生起就没有被任何人需要过。",
                "1_H122": "我根本没见过父亲，而母亲则只会讲述那不知是真是假的父亲的事。",
                "1_H123": "她就这样一直说着父亲总会有一天会来接她的话，最后死去了……",
                "1_H124": "那个，你需要我吗……？",
                "1_H125": "抱歉，突然说这种奇怪的话……忘了吧。"
            }
        },
        "1_H130": {
            "name": "絆Lv.5",
            "text": {
                "1_H130": "在一心望着前方，不停挥剑的那段时期。",
                "1_H131": "我究竟在哪里走错了，还是说，我想相信自己是走错了呢。",
                "1_H132": "然后，我开始逃避自己。",
                "1_H133": "可是，当看到总是径直望着前方、不断前进的你，不，是看到这样的御主后，我想起来了。",
                "1_H134": "想起了那一心望着前方时的自己。",
                "1_H135": "所以，虽然让你见到了我很多丢脸的样子，但我依然很高兴能和你缔结契约。",
                "1_H136": "可恶，这种话真让人不好意思……",
                "1_H137": "干嘛啦，就算事到如今你想解除契约也没门哦。",
                "1_H138": "陪我到……最后吧。"
            }
        },
        "1_H180": {
            "name": "会話 4",
            "text": {
                "1_H180": "土方先生，我果然无法喜欢你。",
                "1_H181": "但是，除了你以外，没人能胜任新选组的副长。",
                "1_H182": "所以我会一直看着你。",
                "1_H183": "一直……看着你……"
            }
        },
        "1_H190": {
            "name": "会話 5",
            "text": {
                "1_H190": "冲田，你还是一点都没变……",
                "1_H191": "不，明显变了。那是什么打扮？",
                "1_H192": "泳装？　喷气背包？　跟我一样？",
                "1_H193": "我这只是义足，别把我们相提并论啦！"
            }
        },
        "1_H210": {
            "name": "会話 6",
            "text": {
                "1_H210": "那是永仓先生……？",
                "1_H211": "呃，竟然那么老了啊。",
                "1_H212": "不，虽然我完全没见过，但那的确是永仓先生。",
                "1_H213": "该怎么说呢，毕竟他个人风格太强烈了嘛。"
            }
        },
        "1_H230": {
            "name": "会話 7",
            "text": {
                "1_H230": "山、山南老师也在这里……",
                "1_H231": "为、为什么事到如今您还会回到新选组……",
                "1_H232": "不，这话轮不到我来说吧。",
                "1_H233": "而且伊东老师以前总是说，要是山南还活着的话……",
                "1_H234": "所以，请您再次助我们一臂之力吧。"
            }
        },
        "1_H260": {
            "name": "会話 8",
            "text": {
                "1_H260": "我的刀吗？",
                "1_H261": "是上总介兼重。",
                "1_H262": "虽然在池田屋变得破破烂烂了，但还是这把刀用起来最安心。",
                "1_H263": "我知道，你想说我配不上这把刀吧。",
                "1_H264": "我也这么觉得。"
            }
        },
        "1_H270": {
            "name": "会話 9",
            "text": {
                "1_H270": "自油小路以来许久未见呢，原田先生。",
                "1_H271": "不是在讽刺你啦。",
                "1_H272": "毕竟你也过得非常辛苦吧。",
                "1_H273": "嗯，同为背叛者，让我们重新来过吧。"
            },
            "raw_text": {
                "1_H270": "油の工事以来ですね、原田さん。別に嫌味じゃないですよ。そっちはそっちで大変だったでしょうから。ええ。お互い裏切り者同士。もう一度やり直しましょう。",
                "1_H271": "",
                "1_H272": "",
                "1_H273": ""
            }
        },
        "1_H300": {
            "name": "会話 10",
            "text": {
                "1_H300": "伊东老师……",
                "1_H301": "虽然您没有叫我的事令我有些不甘心，但以老师的性格，其中一定有什么深意吧。",
                "1_H302": "而且，我也没有资格说什么怨言。",
                "1_H303": "但是……",
                "1_H304": "即便如此，我还是希望您能叫上我……"
            },
            "raw_text": {
                "1_H300": "伊藤先生。僕を呼んでくれなかったのは少し口惜しいですが。先生のことだ。きっと深いお考えがあってのことだったんでしょうね。それに恨み言を言う資格も僕にはない。でも。それでも僕は。呼んで欲しかった。",
                "1_H301": "",
                "1_H302": "",
                "1_H303": "",
                "1_H304": ""
            }
        },
        "1_H310": {
            "name": "会話 11",
            "text": {
                "1_H310": "服部先生，我听说了。",
                "1_H311": "听说您面对迦勒底寸步不让，作为御陵卫士打了一场精彩的战斗吧。",
                "1_H312": "……我也，我也为您感到骄傲。"
            },
            "raw_text": {
                "1_H310": "服部さん、話は聞きました。カルデアを相手に一歩も引かず、五龍勇士として見事な戦いぶりを披露したそうですね。僕も、僕も誇りに思います。",
                "1_H311": "",
                "1_H312": ""
            }
        },
        "1_H320": {
            "name": "会話 12",
            "text": {
                "1_H320": "近藤先生，我果然是个半吊子。",
                "1_H321": "逃避这样的自己，做出了那种事情。",
                "1_H322": "即便如此，您也没有抛弃我。",
                "1_H323": "我知道的，当时也是这样。",
                "1_H324": "我一直……都知道。"
            },
            "raw_text": {
                "1_H320": "近藤さん。やっぱり僕は半端者でした。そんな自分から目をそらしてあんなことをしてしまった。それでもあなたは僕を見捨てなかった。分かっていたんです。あの時もそうだったって。分かっていたんです。",
                "1_H321": "",
                "1_H322": "",
                "1_H323": "",
                "1_H324": ""
            }
        }
    },
    "ChrVoice_ids": [
        "1102100"
    ]
}