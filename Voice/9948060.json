{
  "id": 9948060,
  "name": "Enemy 9948060",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "放！"
      },
      "raw_text": {
        "0_B010": "放て！"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "在那里吗。"
      },
      "raw_text": {
        "0_B020": "そこか。"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "休想逃跑。"
      },
      "raw_text": {
        "0_B030": "逃がしはせぬ。"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "真言，虚空藏求闻持！"
      },
      "raw_text": {
        "0_B040": "神言、虚空蔵、愚問じを！"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "由我张角来平定天下。"
      },
      "raw_text": {
        "0_B080": "長兄が天下を制い。"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "无论多少次，都给我复活吧……"
      },
      "raw_text": {
        "0_B160": "幾度なりとて、蘇れ……"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "老夫这副残躯……也撑不住了吗……"
      },
      "raw_text": {
        "0_B170": "足の枯れ葉…乙蔵様。"
      }
    },
    "0_B300": {
      "name": "0_B300",
      "text": {
        "0_B300": "正是此刻，永生之命已尽入我张角囊中。"
      },
      "raw_text": {
        "0_B300": "今こそ、永遠の命はこの長兄が手中に。"
      }
    },
    "0_B310": {
      "name": "0_B310",
      "text": {
        "0_B310": "啊啊……天下啊，庆贺我张角的再临吧！"
      },
      "raw_text": {
        "0_B310": "ああ……天下よ、この長兄が再臨を祝え！"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "在老夫的蛊毒下断气吧！"
      },
      "raw_text": {
        "0_B410": "我が小虫にて生き耐えよ。"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "南无阿迦舍揭婆耶，唵阿利迦摩利慕利娑婆诃！"
      },
      "raw_text": {
        "0_B440": "のうぼう、あかじゃからばや、おんありきゃ、まりぼりそあか！"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "天下啊，跪拜吧！臣服于我张角的智谋面前！"
      },
      "raw_text": {
        "0_B840": "天下よ、不死を堕ちよ。この長兄が地の前に"
      }
    }
  }
}
