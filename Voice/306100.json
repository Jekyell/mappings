{
    "id": 306100,
    "collectionNo": 455,
    "name": "原田左之助",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "看招……吧！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "我这人的脚习惯不太好。"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "看招！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "咚！咚！咚——！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "好了，又要死不掉了吗……",
                "0_B051": "看招看招看招看招！看招！",
                "0_B052": "死未遂一文字——！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "不用担心，我对自己的狗屎运还是很有自信的。"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "这里可不能退呢。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "是负责殿后吧，明白了。 该出击了，准备豁命吧，十番队，别丢了名声！"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "想用箭矢还是火枪都随意。只要你们能杀得了我。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "好，没有追兵了吧。 十番队，该收队了，但千万别松懈哦。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "又没死成吗。 哼……连我都佩服自己的狗屎运总是用不完呢。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "啧"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "好痛啊，蠢材。"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "什么嘛，我也要死了吗……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "不好意思，我去稍微死一下。"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "要上了。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "说得对。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "好。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "还有这招。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "呀！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "看招看招，喝啊！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "连我自己都觉得这样做挺痛的哦。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "有本事就试着杀杀看呀。"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "又要死不成了吗。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "旋转旋转旋转！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "翻涌吧！"
            }
        },
        "0_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "0_B2440": "休想完好无损地回去，蠢材！"
            }
        },
        "0_B250": {
            "name": "宝具カード 4",
            "text": {
                "0_B250": "没办法，闹个天翻地覆吧。"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "让开。"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "这距离还真够得着。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "没错！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "用尽全力，猛击！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "站到最后的一定是我。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "好，明白了。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "喂，想去哪儿，已经无路可逃了哦。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "看来这里也不能退呢。好，我做好思想准备了。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "都收拾干净了，老大。 放心吧，只要有我陪着，就算你想死，我也不会让你死的。"
            }
        },
        "0_B530": {
            "name": "勝利 4",
            "text": {
                "0_B530": "这就是原田左之助的枪，给我记住。 ……不过，已经为时已晚了吧。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "好痛。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "呜哇——！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "死在这里或许也不坏。不，还是不好。"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "风声……已经听不见了……"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "这就是死未遂的一文字……",
                "0_B801": "没错……无论是谁……",
                "0_B802": "都休想杀死我……！"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "这里就是死未遂左之助大展身手的舞台……",
                "0_B811": "敢来碍事的家伙休想活着回去！",
                "0_B812": "死未遂一文字！"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "该活着的死了，该死的却活着……",
                "0_B821": "真是世事难料啊！",
                "0_B822": "死未遂一文字——！"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "一下、二下……三下！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "不过，用力过猛也不好。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "呵欠……哎哟，不好意思，有点松懈了。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "看招看招！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "嘿！哈！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "给我滚一边去。"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "拿了多少报酬我就会干好多少活，尽管期待吧。"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "这把枪就算在狭窄的地方也能拆开使用，非常方便哦。",
                "0_G021": "不过相应的，需要花点工夫才能用顺手，所以我并不推荐使用哦。"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "这身打扮吗？",
                "0_G031": "不，毕竟总不能穿着队服到处晃悠，所以我去街上挑了件。怎么了？",
                "0_G032": "很适合我？",
                "0_G033": "……是吗。"
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "队服我也有，但那就像工作服，只有鼓起干劲时才会穿。",
                "0_G041": "要是有这类需求时随时告诉我，我也会做好思想准备的。"
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "我一直觉得何时死去都无所谓，所以不断地胡来，可即便如此还是没死成、没死成、没死成……",
                "0_G051": "以为好不容易终于死了，却成了什么从者，又没死成。",
                "0_G052": "但我从没想过有朝一日我竟会觉得这样也挺好。",
                "0_G053": "嗯，这次我就为我自己挥舞这把枪吧。",
                "0_G054": "而且都到了这份上，不如干脆一路没死成到极限吧。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "谢啦，那我就收下啦。"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "我不讨厌活动身体，锻炼也一样，所以尽管放马过来吧。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "今天好像是御主的生日吧。",
                "0_H011": "祝你生日快乐。虽然这东西并不贵重，但请收下吧。",
                "0_H012": "嗯，我会让你明年也平安迎来这一天的，所以你就放心长岁数吧。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "真吵闹呢，是祭典之类的吗。要出门的话，我愿意奉陪哦。",
                "0_H021": "因为我并不讨厌热闹嘛。"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "出任务吗，明白了。",
                "0_H031": "十番队，该出场了，去死中求生吧。"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主从吗？",
                "0_H041": "这个嘛，我也不想藏着什么心思干活，差遣我时希望能痛快点。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "御主吗，嗯，我喜欢啊。",
                "0_H051": "啊，不，不是那种意思，是作为一个人的喜欢。",
                "0_H052": "毕竟在自己讨厌的人手下干活是很累人的。"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "说到喜欢的东西，以前应该只有酒吧，但来这里以后，感谢你让我尝到了各种美味的东西。",
                "0_H061": "尤其是那种叫咖喱饭的东西，真好吃呢。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "虽然算不上讨厌，但我不太擅长应付善人。",
                "0_H071": "该怎么说呢……这大概是性情使然吧。",
                "0_H072": "啊，御主另当别论哦。因为你已经不是那种次元了。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "向圣杯许愿吗？",
                "0_H081": "这个嘛，倒也没什么特别想要的……",
                "0_H082": "对了，向着大陆以西，去到能抵达的极限如何？",
                "0_H083": "不过这个愿望好像用不着圣杯吧。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "有什么事吗？",
                "0_H091": "没事的话我先告辞了。我们还没熟到套近乎的程度。",
                "0_H092": "……所以才要谈？",
                "0_H093": "这个嘛……或许也对。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "说到新选组里的枪兵，确实也就我了吧。",
                "0_H101": "倒也不是没有其他使枪的人，但基本都比我死得早。",
                "0_H102": "毕竟只是比普通人稍微擅长点刀枪，是无法在那个时代活下来的嘛。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "我学过几种枪术，但我似乎不太擅长讲究什么流派什么规矩之类的。",
                "0_H111": "总之，我算自成一派吧。",
                "0_H112": "所以我不适合指南或是教别人东西，还请放过我吧。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "想死的人死不了，却从想活的人先开始死。",
                "0_H121": "虽然常有人这么说，但在我看来，该死的人总会死，该活的人总会活。",
                "0_H122": "那是个仅凭人的感情无力改变，只能在巨大的洪流中挣扎的时代啦。",
                "0_H123": "从这个角度来说，虽然我不知道御主的时代是否正确，但至少我觉得不赖。",
                "0_H124": "没错，正因为这个时代不赖，御主，我才不想让你死。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "我是个叛徒。",
                "0_H131": "背叛了新选组的伙伴、背叛了侍奉幕府的责任，最后还背叛了自己。 就这么不断背叛并活着、活着、没有死去一路漂泊，最后在遥远大陆的天空下看着云朵结束了人生。",
                "0_H132": "奇妙的是，我什么感觉都没有。",
                "0_H133": "如果能流下一滴眼泪，或许我还能信服地结束人生，可我什么感觉都没有，什么都没有。",
                "0_H134": "但是这次死时，我应该能哭出来吧。",
                "0_H135": "因为我死的时候，就是御主死的时候嘛。",
                "0_H136": "不过，我可不会让你轻易死掉哦，毕竟有我这个死未遂的左之助跟着嘛。",
                "0_H137": "嗯，让我们一起品尝想死也死不了的痛苦吧。",
                "0_H138": "直到彼此都死去为止哦。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "好久不见，冲田前辈。",
                "0_H171": "身体状况……看起来还不错呢。",
                "0_H172": "新选组的先锋果然还得是前辈才行。",
                "0_H173": "嗯，一如既往，殿后的工作就交给我吧。"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "副长，好久不见。",
                "0_H181": "那时该怎么说呢……",
                "0_H182": "对不起。",
                "0_H183": "虽然我还有很多话想说，不过先说一句吧。",
                "0_H184": "嗯，这一次我会陪您走到最后。"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "斋藤先生，听说您活了相当久吧。",
                "0_H191": "其实那之后我四处漂泊，也活了挺久的。",
                "0_H192": "什么？　您以为我已经死了？",
                "0_H193": "……这也太过分了吧。"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "什么嘛，你还活着啊，新八。",
                "0_H201": "不过你还真是变老了呢……",
                "0_H202": "怎么，有意见？",
                "0_H203": "啊，不用在意，我和他关系并不紧张，只是这家伙总是唠叨着让我别那么拘谨，我才这么跟他说话啦。"
            }
        },
        "0_H230": {
            "name": "会話 8",
            "text": {
                "0_H230": "山南老师，上次的事……",
                "0_H231": "不对，现在还提这些干什么。",
                "0_H232": "我也在经历了很多之后回来了，这次就让彼此一起痛痛快快地干一场吧。"
            }
        },
        "0_H240": {
            "name": "会話 9",
            "text": {
                "0_H240": "听说这里有位本家的宝藏院流枪术使吧。",
                "0_H241": "不好意思，但能否麻烦你帮我引荐一下？",
                "0_H242": "作为使长枪的人，肯定很想请他指点一二啦。"
            }
        },
        "0_H250": {
            "name": "会話 10",
            "text": {
                "0_H250": "那就是希腊的不死身的大英雄吗？",
                "0_H251": "我虽然叫死未遂的左之助，但这不死身根本不是同一个次元的啊。",
                "0_H252": "我开始担心自己能否在这里混下去了。",
                "0_H253": "……不，我会努力的。"
            }
        },
        "0_H260": {
            "name": "会話 11",
            "text": {
                "0_H260": "话说老大，能占用你一点时间吗？　那个穿红T恤的女人一直吵着让我加入她的乐队啦。",
                "0_H261": "能不能帮我说说她？",
                "0_H262": "什么？　信长公？　她吗？",
                "0_H263": "……哎，原来如此。"
            }
        },
        "0_H290": {
            "name": "会話 12",
            "text": {
                "0_H290": "平助，有些无法挽回的事就不用挽回了吧。",
                "0_H291": "没事，我和你也差不多。",
                "0_H292": "你我作为叛徒，干脆丢人丢到底吧。"
            },
            "raw_text": {
                "0_H290": "エスケ、取り返しのつかないことは取り返さなくていいんじゃないか。なに、俺もお前と似たようなもんだ。お互い裏切り者らしく、せいぜい恥を晒すとしようや。",
