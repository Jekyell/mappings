{
    "id": 1102200,
    "collectionNo": 458,
    "name": "终焉的伊丽莎白",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "哈！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "嘿！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "是那里吧！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "成为星球的供品吧。"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "染血的大地，染血的我，",
                "0_B051": "将此身献给赤红之星吧。",
                "0_B052": "出现吧，终焉的三首怪兽，再临！",
                "0_B053": "干掉他们！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "ＬＡ～♪"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "鲜血行星。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "战斗开始。让我们祈祷胜利吧。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "献上平静的祈祷。为敌人镇魂。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "胜利了。 不过，既然以王之名起誓，肯定不能输呢。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "是祈祷传达到了吗，还是说这就是我的实力呢。 不过，无论哪种都无所谓啦。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "好痛。"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "呜……！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "……伊丽莎……回来吧……今天的晚饭是……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "到此为止了吗……我的巡礼也到此为止了……到也不赖呢……"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "好。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "可以哦。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "悉听尊便。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "虽然会弄脏。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "投掷。"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "我要扔了哦。"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "召唤吾等之王吧。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "那么，让星球枯萎吧。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "伊丽莎球棒！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "宴会的时间。"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "振作一点，伊丽莎！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "南瓜ＵＦＯ！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "坠落吧，南瓜！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "鲜血光炮！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "来自以太宇宙的闪耀长枪啊。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "向三首起誓。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "在伊丽莎白的名下。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "呵呵……居然要战斗……不过，这也是使命吧。我来做……"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "成功啦！ ……咳咳。总之，无论什么时候，胜利都是令人高兴的。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "一点也不痛。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "就凭这种程度……！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "我困了，所以先睡了。晚安。"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "战斗好像也很亏呢。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "祈祷的尽头便是终结。",
                "0_B801": "没错，三首之王要回来了！",
                "0_B802": "终焉的三首怪兽，再临！",
                "0_B803": "……也就是续篇吗。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "阿尔西亚、帕弗尼斯、艾斯克雷尔斯。",
                "0_B811": "带来终结的邪龙王，",
                "0_B812": "此刻在这里展现你那伟大的身姿吧……",
                "0_B813": "终焉的三首怪兽，再临！"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "我一直都在想，为了召唤三首之王，",
                "0_B821": "难道每次都必须洗澡吗？",
                "0_B822": "终焉的三首怪兽，再临！",
                "0_B823": "要是她偶尔不来该怎么办啊……"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "贯穿到尽头吧！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "祈祷吧。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "伊丽莎锤！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "王之铁锤！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "失礼了哦。"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "升级……啊。",
                "0_G011": "原来如此。这就是……"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "没有哦，我就一身行头。"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "没有变化，请继续多关照哦。"
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "终于要来了哦，终于……",
                "0_G041": "呵呵呵。"
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "嗯，就是这样，辛苦你了。",
                "0_G051": "要继续走下去的话，必须稍微努力一下才行呢。",
                "0_G052": "能看到这样的景色，全都是多亏了你和女儿。",
                "0_G053": "非常感谢。",
                "0_G054": "呵呵呵，我会祈祷你们两个能得到幸福。",
                "0_G055": "因为，我是巫女嘛。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "非常感谢。",
                "0_G111": "成长是件令人高兴的事呢。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "哎呀，是你的生日呀。",
                "0_H011": "生日快乐！",
                "0_H012": "来来，你是今天的主角，御主就好好坐着，等着接受庆祝吧。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "好像在举办某种叫活动的东西呢。",
                "0_H021": "虽然我不太了解……"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "该出击了，加油吧。"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "嗯，我是侍从哦。",
                "0_H041": "因为我已经习惯了这样的立场，所以完全没问题。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和御主的关系吗……",
                "0_H051": "应该不只是单纯的主从吧？",
                "0_H052": "……对吧？"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的事情吗？",
                "0_H061": "冥想、祈祷。",
                "0_H062": "还有在此期间偷偷睡觉。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的事情吗？",
                "0_H071": "大概就是倾尽一生的项目迎来终结吧……"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯吗？",
                "0_H081": "是啊，就将此设定为探索的目标吧。",
                "0_H082": "至于怎么使用，还是以后再考虑吧。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "是的，有什么事吗？"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "茶吗？",
                "0_H101": "不错，那我就不客气了。",
                "0_H102": "我想要红茶。红色的比较好吧。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "职阶虽然是复仇者，但我并没有对什么怀有怨恨。",
                "0_H111": "真正怨恨的，是与我相连的伊丽莎王。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "御主，这真是个有趣的职阶呢。",
                "0_H121": "不能战斗，却又不能不战斗。",
                "0_H122": "能做的只有下达一定的指示、待在身边，并祈祷。",
                "0_H123": "……我觉得这是个好职阶哦。因为我也差不多。",
                "0_H124": "我们两个真像呢。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "我的人生有大概一半都是为了复活邪恶之龙，所以在失去了这个的现在，我的灵魂也燃尽了。",
                "0_H131": "过去甚至连喜欢什么、讨厌什么这类事也模糊不清。",
                "0_H132": "但多亏了御主，这个问题似乎总算能解决了。",
                "0_H133": "接下来……",
                "0_H134": "是啊，能不能给我一个户籍之类的？"
            }
        },
        "0_H1600": {
            "name": "絆Lv.4",
            "text": {
                "0_H1600": "伊丽莎王虽然倒下并被封印了，但她的形态依然残留在我的灵基中。",
                "0_H1601": "只要消耗一定程度的魔力，就能够让她显现。",
                "0_H1602": "没错，就是我现在使用的宝具。",
                "0_H1603": "当然，无论用多少次都没有复活的风险，所以请放心吧，嗯。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "嗯，完美的伊丽莎白也来了呀。",
                "0_H171": "这很好。身为母亲，我感到很自豪。",
                "0_H172": "……但更重要的是，你那身打扮是怎么回事。",
                "0_H173": "妈妈可不承认那种朋克哦！",
                "0_H174": "你更适合穿这种歌姬系的！"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "哎呀，居然有这么多和我一样的……",
                "0_H181": "一样的人？　有这么多……",
                "0_H182": "好多啊，太多了。",
                "0_H183": "是不是有点多过头了……？"
            }
        },
        "0_H1800": {
            "name": "絆Lv.5",
            "text": {
                "0_H1800": "我相当于一直与伊丽莎王共同生活至今。",
                "0_H1801": "所以我本以为只要她毁灭了，我也会随之消失。",
                "0_H1802": "没想到如今却身处迦勒底。",
                "0_H1803": "人生还真是不可思议呢。",
                "0_H1804": "还有……我已经没有其他的容身之处了，所以我会一辈子跟着你哦。"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "您是御主的母亲啊。",
                "0_H191": "您太客气了。",
                "0_H192": "话说，我想和您商量一下有关孩子不良行为的问题……"
            }
        },
        "0_I010": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 1",
            "text": {
                "0_I010": "让我们祈祷吧，直到终结之时。",
                "0_I011": "……大概就是这种感觉，总之这里是商店。"
            }
        },
        "0_I020": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 2",
            "text": {
                "0_I020": "欢迎光临。",
                "0_I021": "我是负责看店的终结的伊丽莎白。",
                "0_I022": "请不要客气。",
                "0_I023": "来吧，来吧。"
            }
        },
        "0_I030": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 3",
            "text": {
                "0_I030": "是要兑换吧。",
                "0_I031": "另外我换个话题，那孩子还好吗？"
            }
        },
        "0_I040": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 4",
            "text": {
                "0_I040": "嘿咻。",
                "0_I041": "……顺便问一句，你需要我们教团的教典之类的吗？"
            }
        },
        "0_I050": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 5",
            "text": {
                "0_I050": "那么，我来做个兑换的祈祷吧。",
                "0_I051": "……嘟嘟囔囔。"
            }
        },
        "0_I060": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 6",
            "text": {
                "0_I060": "星球得救了。",
                "0_I061": "我也算得救了吗？",
                "0_I062": "无论如何，伊丽莎白也变强了。",
                "0_I063": "而遗憾……",
                "0_I064": "还挺多的，所以请你再奉陪一阵子吧。"
            }
        },
        "0_I070": {
            "name": "ファイナル・ハロウィン2025\n～パンプキンプラネットに輝く歌姫～ 7",
            "text": {
                "0_I070": "不要为我祈祷，请为伊丽莎王祈祷吧。",
                "0_I071": "她虽然是只凶恶的怪兽，但即便如此，她也怀着眷恋他人的心情。"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "于是我再次被召唤了。我是终结的伊丽莎。",
                "0_S011": "是将星球之血……",
                "0_S012": "不，是简称伊丽莎王的巫女。",
                "0_S013": "很复杂吗？　确实很复杂呢。",
                "0_S014": "不过，你一定会习惯的。嗯。"
            }
        }
    },
    "ChrVoice_ids": [
        "109833734",
        "1102200"
    ]
}