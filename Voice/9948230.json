{
  "id": 9948230,
  "name": "三好長慶",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "释放！"
      },
      "raw_text": {
        "0_B010": "放て！"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "在那里吗。"
      },
      "raw_text": {
        "0_B020": "そこか。"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "休想逃走。"
      },
      "raw_text": {
        "0_B030": "逃がしはせぬ。"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "真言、虚空藏、求闻持！"
      },
      "raw_text": {
        "0_B040": "神言、虚空蔵、愚問じを！"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "南无·阿迦舍揭婆耶，唵·阿利迦·摩利慕利·娑婆诃！"
      },
      "raw_text": {
        "0_B440": "のうぼう、あかじゃからばや、おんありきゃ、まりぼりそわか！"
      }
    }
  }
}
