        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "喵喵喵——！"
            },
            "raw_text": {
                "0_B150": "にゃんにゃんにゃーん！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "哈啊……我原来，没有被爱着呀。"
            },
            "raw_text": {
                "0_B160": "はぁ……私は、愛されていなかったのですね。"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "是的。亚利亚会反省的。呜呜……"
            },
            "raw_text": {
                "0_B170": "はい。アリア反省します。カスーン。"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
