        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "妖气转变，以炎熔炼。接招——"
            },
            "raw_text": {
                "0_B040": "妖気転変、これ炎溶かす。そーれ。"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "拥抱岁月，懒觉到此为止，",
                "0_B051": "恋火无限蔓延。",
                "0_B052": "随吾之思念，吞噬一切吧，",
                "0_B053": "解剖一闪，空弹回归！"
            },
            "raw_text": {
                "0_B050": "年を抱きて、だみんは終わり？",
                "0_B051": "恋火は無限に広がりますの。",
                "0_B052": "我が想いにより、全て飲み込め！",
                "0_B053": "解剖一閃！空弾回帰！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": ""
            },
            "raw_text": {
                "0_B080": "えい！"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "加油、加油、主人。"
            },
            "raw_text": {
                "0_B090": "ふれー、ふれー、主様。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "哎呀～这是要开始什么呢？"
            },
            "raw_text": {
                "0_B100": "おろー、何が始まるのでしょうか。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "好～我要加油了哦～"
            },
            "raw_text": {
                "0_B110": "はーい、頑張っちゃいますねー。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "那个，已经赢了吗？太好了。战斗真的好可怕呀。"
            },
            "raw_text": {
                "0_B120": "えっと、もう勝っちゃったんですか？よかった。戦いは怖いですね。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "又被大家爱护了，太好了。主人，您也要好好爱我哦。"
            },
            "raw_text": {
                "0_B130": "また愛されました。よかったです。主様も、ちゃんと愛してくださいね。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": ""
            },
            "raw_text": {
                "0_B140": "ポン。"
