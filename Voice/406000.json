        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "那么，就请您过目吧。"
            },
            "raw_text": {
                "0_B210": "では、お目にかけますね。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "宝具，开账！"
            },
            "raw_text": {
                "0_B220": "宝具、開帳！"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "宝具会长～"
            },
            "raw_text": {
                "0_B230": "宝具会長ー。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "啊，哇哇哇哇哇。"
            },
            "raw_text": {
                "0_B2410": "啊，哇哇哇哇哇。"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "铃酱，拜托你啦。"
            },
            "raw_text": {
                "0_B2420": "りんちゃん、お願いします"
