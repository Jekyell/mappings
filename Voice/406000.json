        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "空空空。"
            },
            "raw_text": {
                "0_B420": "コンコンコン。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "下雨了哦～"
            },
            "raw_text": {
                "0_B430": "雨ですよー。"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "九尾之炎化为歌谣——"
            },
            "raw_text": {
                "0_B440": "九尾の炎は歌になりー。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "一起加油吧，哦～"
            },
            "raw_text": {
                "0_B480": "頑張りましょう、おー。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "会一直陪着您的哦。"
            },
            "raw_text": {
                "0_B490": "ずっと一緒ですよ。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "哎嘿，呵呵呵……主人，请对我说一声“玉藻～请～”吧～"
            },
            "raw_text": {
                "0_B500": "うふ、うふふ……主様、たまもはーいどーって言ってくださいませー。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "我不太擅长战斗呢。因为爱惜我的人们都会替我战斗的。"
            },
            "raw_text": {
                "0_B510": "私はあまり戦わないです。私を大事に思う方々が戦ってくれるので。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "又能见到美丽的事物了。非常感谢大家。"
            },
            "raw_text": {
                "0_B520": "美しいものを、また見ることができました。ありがとうございます、皆様。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "没、没事的。"
            },
            "raw_text": {
                "0_B540": "へ、平気です。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": ""
            },
            "raw_text": {
                "0_B550": "だーめー！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "主人，对不起。我是一只没用的玉藻。"
            },
            "raw_text": {
                "0_B560": "主様、ごめんなさい。私はダメなタマモでした。"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "我先退下啦。"
            },
            "raw_text": {
                "0_B570": "下がりますね。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "大家早上好呀。",
                "0_B801": "今宵之年乃吾之烧酒。",
                "0_B802": "倾注爱意奔行而去，",
                "0_B803": "解剖一胜，空碗回归！",
                "0_B804": "那么，我开动了。"
            },
            "raw_text": {
                "0_B800": "おはようございます、皆々様。",
                "0_B801": "今宵の年は我が焼酎。",
                "0_B802": "愛を注いで走らせて。",
                "0_B803": "解剖一勝、空丼回帰！",
                "0_B804": "それでは、いただきます。"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "啦啦啦～"
            },
            "raw_text": {
                "0_B880": "らららー。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "出嫁了哦。"
            },
            "raw_text": {
                "0_B910": "嫁入りです。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "砰——！"
            },
            "raw_text": {
                "0_B920": "ばっきゅーん！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "你好呀。"
            },
            "raw_text": {
                "0_B930": "こんにちは。"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "会成长啊。身高不会变高吗？原来是这样啊。",
                "0_G011": "",
                "0_G012": ""
            },
            "raw_text": {
                "0_G010": "成長するのですね。背は高くならない？そうでしたか。",
                "0_G011": "",
                "0_G012": ""
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "请满怀期待地等待下一次吧。其实，我也不知道接下来会变成什么样的衣服呢。",
                "0_G021": ""
            },
            "raw_text": {
                "0_G020": "次を楽しみにお待ちくださいませ。実のところ、私もどんな服になるのかわからないのです。",
                "0_G021": ""
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "哎呀？哎呀哎呀？这难道是配合主公大人的时代而换上的灵基？也就是说，换上这套衣服的话，无论在何处与主公大人相伴，都不会显得不自然了呢。好开心。来，主公大人。虽然有些心急，不过我有想去的地方了呢。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            },
            "raw_text": {
                "0_G030": "あら？あらあらあら？これは、もしかして、主様の時代に合わせた礼儀でしょうか？つまり、これならどこで主様と寄り添っても、不自然ではないのですね。嬉しい。さ、主様。早速ですが、私、行きたいところがございまして。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "嚼嚼。嗯～好吃。",
                "0_G111": ""
            },
            "raw_text": {
                "0_G110": "むしゃむしゃ。んー、おいしい。",
                "0_G111": ""
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "哎呀呀，哎呀呀呀。是您的生日吗？您的降生既尊贵又美好哦。不过，您也不必刻意强求自己去立下丰功伟业。只要主公大人活着且幸福，便没有比这更大的喜悦了。呵呵。总之，祝您生日快乐，主公大人。",
                "0_H011": "",
                "0_H012": "",
                "0_H013": "",
                "0_H014": "",
                "0_H015": ""
            },
            "raw_text": {
                "0_H010": "まあまあ、まあまあまあ。お誕生日でしたか。あなたが生まれたことは尊く、そして素晴らしいことですわ。でも、立派なことをしようと意識しなくてもいいのです。主様が生きて幸せであるなら、それに勝る喜びはございません。うふふ。つまり、おめでとうございます、主様。",
                "0_H011": "",
                "0_H012": "",
                "0_H013": "",
                "0_H014": "",
                "0_H015": ""
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "是庆典呢，主公大人。来，请进请进。",
                "0_H021": ""
            },
            "raw_text": {
                "0_H020": "お祭りでございますね、主様。さ、どうぞどうぞ。",
                "0_H021": ""
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "主公大人，要不要去外面走走？亚利亚愿意随侍左右。",
                "0_H031": ""
            },
            "raw_text": {
                "0_H030": "主様、お外に行きませんか？アリア、お供いたします。",
                "0_H031": ""
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主仆。好的。那是当然，我玉藻亚利亚，一定会好好侍奉主公大人的。",
                "0_H041": "",
                "0_H042": ""
            },
            "raw_text": {
                "0_H040": "しゅちゅう。はい。もちろん、このたまもありや。主様にお仕えいたします。",
                "0_H041": "",
                "0_H042": ""
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "与主公大人的关系……我认为相当良好哦。",
                "0_H051": ""
            },
            "raw_text": {
                "0_H050": "主様との関係……とっても良好だと思いますの。",
                "0_H051": ""
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的事物，是收集美丽的东西。可以的话，要看看我的收藏吗？",
                "0_H061": "",
                "0_H062": ""
            },
            "raw_text": {
                "0_H060": "好きなことは、美しいものを集めることですの。よろしければ、コレクション、ご覧になります？",
                "0_H061": "",
                "0_H062": ""
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的事物吗？不美丽的东西吧？不过这世界上不美丽的东西其实并没有那么多哦。所以，我想我讨厌的东西并不多呢。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            },
            "raw_text": {
                "0_H070": "嫌いなものは？ 美しくないものでしょうか？ でも美しくないものって世界にはそんなにありませんのよ。 ですから、嫌いなものはあまりないと思います。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯。希望能由它告诉我世上的美丽之物呢。至于收集的事，亚利亚会努力的。",
                "0_H081": "",
                "0_H082": ""
            },
            "raw_text": {
                "0_H080": "聖杯。世の中の美しいものを、私に教えていただければと思います。集めるのは、アリアが頑張りますので。",
                "0_H081": "",
                "0_H082": ""
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "好～的，我是珠绪亚利亚。"
            },
            "raw_text": {
                "0_H090": "はーい、珠緒アリアでございます。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "怎么了吗，主公大人。我的脸上沾了什么东西吗？",
                "0_H101": ""
            },
            "raw_text": {
                "0_H100": "どうしました、主様。私の顔に、何かついてます？",
                "0_H101": ""
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "主公大人，主公大人。呵呵，我们一起走吧。无论去哪儿我都会奉陪的。",
                "0_H111": "",
                "0_H112": ""
            },
            "raw_text": {
                "0_H110": "主様、主様。うふふ、ご一緒に参りましょう。どこでもお付き合いいたします。",
                "0_H111": "",
                "0_H112": ""
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "要问我为什么是骑兵，大概是因为爱上我的人都会跪倒在我面前吧？唔……总觉得形象有点不太好呢。",
                "0_H121": ""
            },
            "raw_text": {
                "0_H120": "私がなぜライダーなのかというと、多分私を愛した方がひざまずいてしまうせいでしょうか。うーん、ちょっとイメージが悪い気が。",
                "0_H121": ""
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "主公大人，方便的话能把背借我靠一下吗？非常感谢。虽然我之前一直想不通自己为何是骑兵，但如果能像这样托身于主公大人，那倒也不坏呢。请您务必永远爱着我。因为我也会永远爱着您的。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": "",
                "0_H135": "",
                "0_H136": "",
                "0_H137": ""
            },
            "raw_text": {
                "0_H130": "主様、よろしければ背中を貸していただけませんか？ありがとうございます。ライダーなのが納得いかなかったですけれど、こうして主様に身を預けられるのなら、それもよしですね。どうか私をいつまでも愛してくださいませ。いつまでも愛しますので。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": "",
                "0_H135": "",
                "0_H136": "",
                "0_H137": ""
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "那位大人就是挑水……不对，是玉藻前大人的姿态呢。从其他玉藻九尾的角度来看，毕竟她是我们的原型，所以会成为敬仰、死心、嫉妒、嘲弄、憎恨、愤慨等感情的对象吧。至于我嘛，怎么说呢，算是憧憬吧。我也曾梦想过变成那种姿态呢。虽然那是很久很久以前，在本人知晓自己的真身之前的事了就是了。",
                "0_H171": "",
                "0_H172": "",
                "0_H173": "",
                "0_H174": "",
                "0_H175": "",
                "0_H176": ""
            },
            "raw_text": {
                "0_H170": "あちらのお方が水汲め、いえ、玉藻の前、の姿なのですね。他の玉藻ラインから見れば、私たちの元になりますので。敬い、諦め、妬み、笑い、憎しみ、憤り、などの対象になっていると思います。私の場合は、なんというか、憧れ、というか。私は、あんな姿になることを夢見ておりました。とても昔の、本人が己の正体を知る前のこと、ですけどね。",
                "0_H171": "",
                "0_H172": "",
                "0_H173": "",
                "0_H174": "",
                "0_H175": "",
                "0_H176": ""
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "玉藻九尾之一，玉藻猫。和那位交流时，脑袋都会变得轻飘飘的呢。不过，明明是个狂战士，做饭的手艺却是天才级别的呢。真不可思议。",
                "0_H181": "",
                "0_H182": ""
            },
            "raw_text": {
                "0_H180": "たまもナインが1尾、たまもキャット。あの音会話していると、頭がふわふわしてきちゃいます。でも、バーサーカーなのに、お料理は天才的なのですよね。不思議。",
                "0_H181": "",
                "0_H182": ""
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "哎呀？那位难道不是玉藻吗？不是玉藻维奇？也就是说，只是萍水相逢的陌生人？世上还真有这等奇事呢。咦？而且还有光与暗两只？真、真是满是不可思议呢～",
                "0_H191": "",
                "0_H192": "",
                "0_H193": "",
                "0_H194": "",
                "0_H195": ""
            },
            "raw_text": {
                "0_H190": "あら？あちらはタマモではないのでしょうか？タマモビッチではなく？つまり、他人の空に？不思議なこともあるものですね。あれ？しかも、光と闇、二頭いるんですの？ふ、不思議だらけですわー。",
                "0_H191": "",
                "0_H192": "",
                "0_H193": "",
                "0_H194": "",
                "0_H195": ""
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "那位宛如皎白明月般的大人是……哎呀，名叫宫本伊织大人吗？呵呵。让人感觉非常亲切，简直不像是初次见面呢。具体来说，就像是我在旁边加油鼓劲，那位大人就唰唰唰地把敌人斩于刀下似的。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": ""
            },
            "raw_text": {
                "0_H200": "あちらの真っ白いお月様のような方は。あら、宮本伊織様とおっしゃるのですか。うふん。初めてお目にかかったとは思えないほど、親しみやすい感じです。具体的には、私が応援すると、あの方がバッサバッサと敵を切っていくような。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "日本武尊大人。真是位宛如流水般清澈的大人呢。不过，对方好像正一脸不可思议地看着我呢。怎么了吗？挥挥手看看吧。你好呀～啊，回挥手了呢。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": "",
                "0_H215": "",
                "0_H216": ""
            },
            "raw_text": {
                "0_H210": "ヤマトタケル様。流れる水のように清らかなお方ですね。でも、不思議そうに私を見ていらっしゃいます。どうしたのでしょう。手を振ってみましょう。こんにちは。あ、振り返してくれました。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": "",
                "0_H215": "",
                "0_H216": ""
            }
        },
        "0_H2100": {
            "name": "会話 1 (絆Lv.5以上)",
            "text": {
                "0_H2100": "主公大人，主公大人。可以的话，要不要与我幽会呢？呃，也就是所谓的约会啦。",
                "0_H2101": "",
                "0_H2102": ""
            },
            "raw_text": {
                "0_H2100": "主様、主様。よろしければ、相引きいたしませんか？えっと、デートとも申しますけど。",
                "0_H2101": "",
                "0_H2102": ""
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "咦？咦咦？咦咦咦？这里是……呃，迦勒底吗？原来如此，我被召唤了啊。好的，那么请允许我做个自我介绍。我名叫玉藻亚利亚。虽然只是只稍微机灵点的小狐狸，但我一定会为了协助御主——主公大人，全心全意地侍奉您的。作为交换，主公大人，请一定要让我看看美丽的事物哦。",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": "",
                "0_S016": "",
                "0_S017": ""
            },
            "raw_text": {
                "0_S010": "あれ？あれれ？あれれれ？ここは、えっと、カルデアですか？なるほど、私召喚されたのですね。はい、それならば自己紹介を。私、タマモ・アリアと申します。少しばかりさかしいだけの小狐ですけど、マスター、主様のお役に立つために、誠心誠意、尽くさせていただきます。その代わり、主様、美しいものを見せてくださいましね。",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": "",
                "0_S016": "",
                "0_S017": ""
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "说得对呢。"
            },
            "raw_text": {
                "2_B010": "そうね。"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "快跑快跑。"
            },
            "raw_text": {
                "2_B020": "走走。"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "拜托了哦。"
            },
            "raw_text": {
                "2_B030": "お願いね。"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "这座城市是属于我的。"
            },
            "raw_text": {
                "2_B040": "この都市は私のもの。"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "蒙天地与人之爱而生长的大葱。",
                "2_B051": "这才是亚利亚最珍贵的宝物。",
                "2_B052": "解剖一书，空碗解禁！"
            },
            "raw_text": {
                "2_B050": "天と地と、人に愛され育つそう。",
                "2_B051": "こちらこそが私の、とっておきの宝物！",
                "2_B052": "解剖一勝、空丼解禁！"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "楚楚可怜吗？"
            },
            "raw_text": {
                "2_B080": "カレンですか。"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "可爱吗？"
            },
            "raw_text": {
                "2_B090": "愛らしいですか？"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "既然穿了礼服，我就会优雅地战斗哦。呵呵呵。"
            },
            "raw_text": {
                "2_B100": "ドレスなので、優雅に戦いますね。ふふふ。"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "那么，能请您与我共舞一曲吗？"
            },
            "raw_text": {
                "2_B110": "それでは、踊っていただけますか？"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "主人，我表现得优雅吗？真开心。"
            },
            "raw_text": {
                "2_B120": "主様、私優雅でしたか？嬉しい"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "赢了。嗯——……耶！"
            },
            "raw_text": {
                "2_B130": "勝ちました。えーっと……ブイ、ですの。"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": ""
            },
            "raw_text": {
                "2_B140": "ポン。"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "喵喵喵——！"
            },
            "raw_text": {
                "2_B150": "にゃんにゃんにゃーん！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "哈啊……我原来，没有被爱着呀。"
            },
            "raw_text": {
                "2_B160": "はぁ……私は、愛されていなかったのですね。"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "是的。亚利亚会反省的。呜呜……"
            },
            "raw_text": {
                "2_B170": "はい。アリア反省します。カスーン。"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": ""
            },
            "raw_text": {
                "2_B180": "はーい。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "明白啦。"
            },
            "raw_text": {
                "2_B190": "かしこです。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "哔哔。"
            },
            "raw_text": {
                "2_B200": "Pipin."
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "千代盛放。"
            },
            "raw_text": {
                "2_B2010": "千代咲。"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "升天去吧。"
            },
            "raw_text": {
                "2_B2020": "天へ行く"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "将满腔思念……"
            },
            "raw_text": {
                "2_B2030": "思いの丈を。"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "那么，就请您过目吧。"
            },
            "raw_text": {
                "2_B210": "では、お目にかけますね。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "宝具，开账！"
            },
            "raw_text": {
                "2_B220": "宝具、開帳！"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "宝具会长～"
            },
            "raw_text": {
                "2_B230": "ホーグ会長ー。"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "沐浴在绚烂之中。"
            },
            "raw_text": {
                "2_B2410": "絢爛に包まれ。"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "水母之糖。"
            },
            "raw_text": {
                "2_B2420": "海月の飴。"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "水母之刺。"
            },
            "raw_text": {
                "2_B2430": "水母のトゲ。"
            }
        },
        "2_B2810": {
            "name": "アタック 16",
            "text": {
                "2_B2810": "我去去就来哦。"
            },
            "raw_text": {
                "2_B2810": "行ってきますの。"
            }
        },
        "2_B2820": {
            "name": "アタック 17",
            "text": {
                "2_B2820": "很开心。"
            },
            "raw_text": {
                "2_B2820": "楽しいです。"
            }
        },
        "2_B2830": {
            "name": "アタック 18",
            "text": {
                "2_B2830": ""
            },
            "raw_text": {
                "2_B2830": ""
            }
        },
        "2_B3010": {
            "name": "アタック 19",
            "text": {
                "2_B3010": "再见啦。"
            },
            "raw_text": {
                "2_B3010": "さよならですの。"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "一口吞掉哦。"
            },
            "raw_text": {
                "2_B410": "丸呑みですの。"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "请消失吧。"
            },
            "raw_text": {
                "2_B420": "消えてくださいね。"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "水源丰沛。"
            },
            "raw_text": {
                "2_B430": "水は豊かに。"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "想永远被爱着呀。"
            },
            "raw_text": {
                "2_B440": "いつまでも愛されたいですの。"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "恋慕我吗？"
            },
            "raw_text": {
                "2_B480": "恋しいですか？"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "晚安。"
            },
            "raw_text": {
                "2_B490": "おやすみなさい。"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "没、没事的。"
            },
            "raw_text": {
                "2_B540": "へ、平気です。"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": ""
            },
            "raw_text": {
                "2_B550": "だーめー！"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "主人，对不起。我是一只没用的玉藻。"
            },
            "raw_text": {
                "2_B560": "主様、ごめんなさい。私はダメなタマモでした。"
            }
        },
        "2_B570": {
            "name": "戦闘不能 4",
            "text": {
                "2_B570": "我先退下啦。"
            },
            "raw_text": {
                "2_B570": "下がりますね。"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "人爱吾而得满足。",
                "2_B801": "吾爱万物而得满足。",
                "2_B802": "随拥抱一同沉眠吧。",
                "2_B803": "解剖一胜，空碗回归！"
            },
            "raw_text": {
                "2_B800": "きっと、我を愛し満たされる。",
                "2_B801": "我、全てを愛し満たされる。",
                "2_B802": "抱擁と共に眠りましょう。",
                "2_B803": "解剖一勝、空弾回帰！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "铃酱乖哦乖哦。"
            },
            "raw_text": {
                "2_B880": "りんちゃんよしよし。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "要闪闪发光了呢～"
            },
            "raw_text": {
                "2_B890": "輝きますねー。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "水丹灵酒。"
            },
            "raw_text": {
                "2_B910": "水丹霊酒。"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "从天而降哦。"
            },
            "raw_text": {
                "2_B920": "空からですの。"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "风雨如甲斐之势！"
            },
            "raw_text": {
                "2_B930": "風雨甲斐の如し！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "多谢款待。"
            },
            "raw_text": {
                "2_G010": "ごちそうさまでした。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "哇，天哪。这就是比我曾经生活的地方还要遥远的国度的服饰，也就是所谓的礼服洋装吧。好开心。能以这么棒的灵基与主公大人并肩作战。啊，不过比起战斗，其实我更想跳跳舞呢。主公大人，那个，我跳舞不太在行……还请您好好引领我哦。",
                "2_G041": "",
                "2_G042": "",
                "2_G043": "",
                "2_G044": "",
                "2_G045": ""
            },
            "raw_text": {
                "2_G040": "わあ、まあ。これは、私が住んでいた場所より遥か彼方にある国の衣装、ドレスというものですね。嬉しい。こんな素敵な礼器で、主様と共に戦えるなんて。あ、でも、戦うより本当は踊ったりしたいですけど。主様、その、踊りはあまりうまくないですけど。どうか、リードしてくださいませ。",
                "2_G041": "",
                "2_G042": "",
                "2_G043": "",
                "2_G044": "",
                "2_G045": ""
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "吞噬都市，受万人爱戴、侍奉。想将整座城市都据为己有。这就是贪得无厌的我。是的，也就是说我看着这样，可一旦为非作歹起来，便会一落千丈坠入深渊，彻底堕落到底呢。这便是所谓的玉藻宿命。因此，主公大人，请千万不要松开我的手。因为我……想要一直深爱着您啊。",
                "2_G051": "",
                "2_G052": "",
                "2_G053": "",
                "2_G054": "",
                "2_G055": ""
            },
            "raw_text": {
                "2_G050": "都市を飲み込み、誰もに愛され、かしずかれ。都市すべてを私のものにしたい。そんな欲張りが私なのです。ええ、つまり私、こう見えて悪行三昧をしてしまえば、一点奈落の底、落ちるところまで落ちてしまいますの。それが、賜物宿命というものです。ですから主様、どうかその手を離さないでくださいませ。私、あなたを愛し続けたいのですから。",
                "2_G051": "",
                "2_G052": "",
                "2_G053": "",
                "2_G054": "",
                "2_G055": ""
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "我也想用种火做饭，不行吗？"
            },
            "raw_text": {
                "2_G110": "私も、種火を使って料理したいのですが、ダメですの？"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "哎呀呀，哎呀呀呀。是您的生日吗？您的降生既尊贵又美好哦。不过，您也不必刻意强求自己去立下丰功伟业。只要主公大人活着且幸福，便没有比这更大的喜悦了。呵呵。总之，祝您生日快乐，主公大人。",
                "2_H011": "",
                "2_H012": "",
                "2_H013": "",
                "2_H014": "",
                "2_H015": ""
            },
            "raw_text": {
                "2_H010": "まあまあ、まあまあまあ。お誕生日でしたか。あなたが生まれたことは尊く、そして素晴らしいことですわ。でも、立派なことをしようと意識しなくてもいいのです。主様が生きて幸せであるなら、それに勝る喜びはございません。うふふ。つまり、おめでとうございます、主様。",
                "2_H011": "",
                "2_H012": "",
                "2_H013": "",
                "2_H014": "",
                "2_H015": ""
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "是庆典呢，主公大人。来，请进请进。",
                "2_H021": ""
            },
            "raw_text": {
                "2_H020": "お祭りでございますね、主様。さ、どうぞどうぞ。",
                "2_H021": ""
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "主公大人，要不要去外面走走？亚利亚愿意随侍左右。",
                "2_H031": ""
            },
            "raw_text": {
                "2_H030": "主様、お外に行きませんか？アリア、お供いたします。",
                "2_H031": ""
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "主仆。好的。那是当然，我玉藻亚利亚，一定会好好侍奉主公大人的。",
                "2_H041": "",
                "2_H042": ""
            },
            "raw_text": {
                "2_H040": "しゅちゅう。はい。もちろん、このたまもありや。主様にお仕えいたします。",
                "2_H041": "",
                "2_H042": ""
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "与主公大人的关系……我认为相当良好哦。",
                "2_H051": ""
            },
            "raw_text": {
                "2_H050": "主様との関係……とっても良好だと思いますの。",
                "2_H051": ""
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的事物，是收集美丽的东西。可以的话，要看看我的收藏吗？",
                "2_H061": "",
                "2_H062": ""
            },
            "raw_text": {
                "2_H060": "好きなことは、美しいものを集めることですの。よろしければ、コレクション、ご覧になります？",
                "2_H061": "",
                "2_H062": ""
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "讨厌的事物吗？不美丽的东西吧？不过这世界上不美丽的东西其实并没有那么多哦。所以，我想我讨厌的东西并不多呢。",
                "2_H071": "",
                "2_H072": "",
                "2_H073": ""
            },
            "raw_text": {
                "2_H070": "嫌いなものは？ 美しくないものでしょうか？ でも美しくないものって世界にはそんなにありませんのよ。 ですから、嫌いなものはあまりないと思います。",
                "2_H071": "",
                "2_H072": "",
                "2_H073": ""
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "圣杯。希望能由它告诉我世上的美丽之物呢。至于收集的事，亚利亚会努力的。",
                "2_H081": "",
                "2_H082": ""
            },
            "raw_text": {
                "2_H080": "聖杯。世の中の美しいものを、私に教えていただければと思います。集めるのは、アリアが頑張りますので。",
                "2_H081": "",
                "2_H082": ""
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "我呀，想和主公大人变得更加更加要好呢。"
            },
            "raw_text": {
                "2_H20090": "私、主様と、もっともっと仲良くなりたいです。"
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "主公大人，要枕在我的膝盖上小睡片刻吗？"
            },
            "raw_text": {
                "2_H20100": "主様、私のお膝で眠りませんか？"
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "我虽然外表略显幼小，但精神上可是不折不扣的成年人哦。所以，请不要把我归入小孩子的范畴嘛。",
                "2_H20111": ""
            },
            "raw_text": {
                "2_H20110": "私、姿はやや幼いですが、精神的には立派な大人ですの。なので、子供のカテゴリーには入れないでくださいませ。",
                "2_H20111": ""
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "主公大人喜欢美丽的事物吗？我非常喜欢哦。喜欢到恨不得把所有美丽之物都留在身边装点起来呢。主公大人也拥有着一副极其美丽的灵魂哦。呵呵呵。",
                "2_H20121": "",
                "2_H20122": "",
                "2_H20123": "",
                "2_H20124": ""
            },
            "raw_text": {
                "2_H20120": "主様は、美しいものが好きですか？私は大好きです。そういうものをすべて手元に置いて、飾りたくなってしまうほどに。主様も、とても美しい魂をお持ちですよ。ふふふ。",
                "2_H20121": "",
                "2_H20122": "",
                "2_H20123": "",
                "2_H20124": ""
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "其实，我原本是打算把主公大人带回家的。留在身边一直疼爱赏玩的话一定会很幸福，我曾经是这么想的。但是，主公大人若是被拘于身边，光芒一定就会黯淡下去吧。唯有一往无前地奔跑，才是真正的您。所以，只要我跟上去就好了。啊，顺带一提，这种场合下的“跟上去”，指的是“附身”的“附”哦。",
                "2_H20131": "",
                "2_H20132": "",
                "2_H20133": "",
                "2_H20134": "",
                "2_H20135": "",
                "2_H20136": ""
            },
            "raw_text": {
                "2_H20130": "私、実は主様を連れて帰ろうと思っていましたの。手元に置いて、いつまでも愛でられれば幸福だと、そう思っていました。でも、主様はきっと、手元に置いてしまえば、輝きが薄れてしまう方。どこまでも前を向いて走ってこそのあなた。だから、私がついていってしまえばいいのです。あ、この場合の、ついていって、は、とりつく、の、つく、ですので。",
                "2_H20131": "",
                "2_H20132": "",
                "2_H20133": "",
                "2_H20134": "",
                "2_H20135": "",
                "2_H20136": ""
            }
        },
        "2_H2100": {
            "name": "会話 1 (絆Lv.5以上)",
            "text": {
                "2_H2100": "主公大人，主公大人。可以的话，要不要与我幽会呢？呃，也就是所谓的约会啦。",
                "2_H2101": "",
                "2_H2102": ""
            },
            "raw_text": {
                "2_H2100": "主様、主様。よろしければ、相引きいたしませんか？えっと、デートとも申しますけど。",
                "2_H2101": "",
                "2_H2102": ""
            }
        },
        "2_H220": {
            "name": "会話 4",
            "text": {
                "2_H220": "真是的，我可不是小孩子了。不、不过嘛？要是只是一起吃点点心的话，倒也没什么关系啦。",
                "2_H221": ""
            },
            "raw_text": {
                "2_H220": "もう、私、子供ではありませんの。ま、もう？一緒に、お菓子くらいなら、食べても問題ないですけど。",
                "2_H221": ""
            }
        },
        "2_H230": {
            "name": "会話 5",
            "text": {
                "2_H230": "哎呀，那位大人。清秀又艳丽，看似身份高贵呢。原来如此，是异国的王妃殿下啊。既然我也穿上了这件礼服，就得好好向她学习才行呢。首先就从屈膝礼的姿势开始吧。",
                "2_H231": "",
                "2_H232": "",
                "2_H233": "",
                "2_H234": ""
            },
            "raw_text": {
                "2_H230": "まあ、あちらのお方。清楚で艶やか、高貴なご身分そうな。なるほど、異国のお妃様でしたか。私も、このドレスを着ている以上、見習いたいですの。ひとまず、カーテシーのやり方など。",
                "2_H231": "",
                "2_H232": "",
                "2_H233": "",
                "2_H234": ""
            }
        },
        "2_H240": {
            "name": "会話 6",
            "text": {
                "2_H240": "是异国王妃殿下的Alter小姐呢。多么妖艳动人呀。呜呜，看来对我来说还为时尚早呢。不过，我总有一天也会变成那位大人那样……对，成为倾国的恶女！诶，不行吗？为什么呀？",
                "2_H241": "",
                "2_H242": "",
                "2_H243": "",
                "2_H244": "",
                "2_H245": "",
                "2_H246": ""
            },
            "raw_text": {
                "2_H240": "異国のお妃様のオルタさんですの。なんて艶やかな。うう、私にはまだ早いみたいですの。でも、私もいつか、あの方みたいになって。そう、警告の悪女となるのです。え、ダメ？なんでですの？",
                "2_H241": "",
                "2_H242": "",
                "2_H243": "",
                "2_H244": "",
                "2_H245": "",
                "2_H246": ""
            }
        }
    },
    "ChrVoice_ids": [
        "406000"
    ]
}