        },
        "0_B2820": {
            "name": "アタック 17",
            "text": {
                "0_B2820": "好开心。"
            },
            "raw_text": {
                "0_B2820": "たのしい。"
            }
        },
        "0_B2830": {
            "name": "アタック 18",
            "text": {
                "0_B2830": "嘿、嘿、嘿——！"
            },
            "raw_text": {
