{
  "id": 9948240,
  "name": "ダイナマイト利休",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "宛如行云流水。"
      },
      "raw_text": {
        "0_B010": "幸運流水が如く。"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "从者，利休。"
      },
      "raw_text": {
        "0_B020": "ザバットリキュウ。"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "这可不好。"
      },
      "raw_text": {
        "0_B030": "これ、よくない。"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "炸裂的一盏茶，请尽情享用。"
      },
      "raw_text": {
        "0_B040": "ダイナマイツな一服、存分にお楽しみを。"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "呵呵，变得有意思起来了。"
      },
      "raw_text": {
        "0_B080": "ふふ、面白うなって参りました。"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "利休，热烈欢迎！"
      },
      "raw_text": {
        "0_B090": "璃丘、熱烈歓迎！"
      }
    },
    "0_B120": {
      "name": "0_B120",
      "text": {
        "0_B120": "性感・美丽・炸裂・利休。"
      },
      "raw_text": {
        "0_B120": "セクシー・ビューティーダイナマイト・リキュウ。"
      }
    },
    "0_B130": {
      "name": "0_B130",
      "text": {
        "0_B130": "我利休已炸裂地达成了一座建立。"
      },
      "raw_text": {
        "0_B130": "ダイナマイトに一座混流、離宮、成し遂げましてございます。"
      }
    },
    "0_B140": {
      "name": "0_B140",
      "text": {
        "0_B140": "哦？"
      },
      "raw_text": {
        "0_B140": "胡？"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "仅凭那种程度，可远远不够……"
      },
      "raw_text": {
        "0_B150": "その程度ではとてもとても……"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "且回归漆黑之中吧。"
      },
      "raw_text": {
        "0_B160": "黒木に帰るといたしましょう。"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "美丽之物，终归虚幻。"
      },
      "raw_text": {
        "0_B170": "美しきは、儚きと。"
      }
    },
    "0_B180": {
      "name": "0_B180",
      "text": {
        "0_B180": "呵呵呵呵。"
      },
      "raw_text": {
        "0_B180": "フフフフ。"
      }
    },
    "0_B190": {
      "name": "0_B190",
      "text": {
        "0_B190": "性感。"
      },
      "raw_text": {
        "0_B190": "セクシー。"
      }
    },
    "0_B200": {
      "name": "0_B200",
      "text": {
        "0_B200": "炸裂。"
      },
      "raw_text": {
        "0_B200": "ダイナマイツ。"
      }
    },
    "0_B2010": {
      "name": "0_B2010",
      "text": {
        "0_B2010": "利休重力子！"
      },
      "raw_text": {
        "0_B2010": "リキュー・グラビトン！"
      }
    },
    "0_B2020": {
      "name": "0_B2020",
      "text": {
        "0_B2020": "火箭流星拳！"
      },
      "raw_text": {
        "0_B2020": "ロケット流星パンチ！"
      }
    },
    "0_B2030": {
      "name": "0_B2030",
      "text": {
        "0_B2030": "喝破粉碎！"
      },
      "raw_text": {
        "0_B2030": "かっぱ粉砕！"
      }
    },
    "0_B210": {
      "name": "0_B210",
      "text": {
        "0_B210": "哦，利休心中的火焰被点燃了呢。"
      },
      "raw_text": {
        "0_B210": "ほう、利休のハートに火がつきましたぞ。"
      }
    },
    "0_B220": {
      "name": "0_B220",
      "text": {
        "0_B220": "瞬间来电了呢。"
      },
      "raw_text": {
        "0_B220": "ビビッと、きました。"
      }
    },
    "0_B230": {
      "name": "0_B230",
      "text": {
        "0_B230": "将遍及世间的一切漆黑，汇聚于此。"
      },
      "raw_text": {
        "0_B230": "あまねく黒き王、ここに。"
      }
    },
    "0_B2410": {
      "name": "0_B2410",
      "text": {
        "0_B2410": "哼哼哼哼，哼！"
      },
      "raw_text": {
        "0_B2410": "フンフンフンフン、フンッ！"
      }
    },
    "0_B2420": {
      "name": "0_B2420",
      "text": {
        "0_B2420": "实在碍事！"
      },
      "raw_text": {
        "0_B2420": "邪魔に、ございます！"
      }
    },
    "0_B2430": {
      "name": "0_B2430",
      "text": {
        "0_B2430": "利休一千！"
      },
      "raw_text": {
        "0_B2430": "離宮サウザンド！"
      }
    },
    "0_B2440": {
      "name": "0_B2440",
      "text": {
        "0_B2440": "唯有性感，唯有炸裂！"
      },
      "raw_text": {
        "0_B2440": "ただセクシーに、ダイナマイツに！"
      }
    },
    "0_B250": {
      "name": "0_B250",
      "text": {
        "0_B250": "炸裂地遵命了。"
      },
      "raw_text": {
        "0_B250": "ダイナマイツに承知いたしました。"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "简直不值一提。"
      },
      "raw_text": {
        "0_B410": "お話になりますん。"
      }
    },
    "0_B420": {
      "name": "0_B420",
      "text": {
        "0_B420": "请容我一观！"
      },
      "raw_text": {
        "0_B420": "拝見いたします！"
      }
    },
    "0_B430": {
      "name": "0_B430",
      "text": {
        "0_B430": "性感美丽！"
      },
      "raw_text": {
        "0_B430": "セクシービューティー！"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "一千利休光束！"
      },
      "raw_text": {
        "0_B440": "ワンサウザンドリキュウビーム！"
      }
    },
    "0_B480": {
      "name": "0_B480",
      "text": {
        "0_B480": "肩膀略微有些酸痛呢。"
      },
      "raw_text": {
        "0_B480": "いささか肩が凝りまするな。"
      }
    },
    "0_B490": {
      "name": "0_B490",
      "text": {
        "0_B490": "……利休，炸裂无聊。"
      },
      "raw_text": {
        "0_B490": "……利休、ダイナマイツ退屈。"
      }
    },
    "0_B520": {
      "name": "0_B520",
      "text": {
        "0_B520": "呼……稍微有些太热，身子都发烫了呢。去沐浴冲洗一番汗水吧。"
      },
      "raw_text": {
        "0_B520": "ふぅ……いささか暑くなりすぎて、体が火照ってしまいました。湯浴みにて、汗を流すといたしましょうか。"
      }
    },
    "0_B530": {
      "name": "0_B530",
      "text": {
        "0_B530": "无论何物，在这利休之美面前都将失去其价值。故而名为炸裂利休！"
      },
      "raw_text": {
        "0_B530": "いかなるものも、この離宮の美の前では、その価値を失いまする。故にダイナマイト離宮！"
      }
    },
    "0_B540": {
      "name": "0_B540",
      "text": {
        "0_B540": "刚才发生什么了吗？"
      },
      "raw_text": {
        "0_B540": "今何か？"
      }
    },
    "0_B550": {
      "name": "0_B550",
      "text": {
        "0_B550": "可恶可恶可恶啊！"
      },
      "raw_text": {
        "0_B550": "おのれおのれおのれいっ！"
      }
    },
    "0_B560": {
      "name": "0_B560",
      "text": {
        "0_B560": "炸裂利休，爆散！"
      },
      "raw_text": {
        "0_B560": "ダイナマイトリキュー、爆散！"
      }
    },
    "0_B570": {
      "name": "0_B570",
      "text": {
        "0_B570": "……利休，这就从头来过。"
      },
      "raw_text": {
        "0_B570": "……離宮、一から出直しまする。"
      }
    },
    "0_B800": {
      "name": "0_B800",
      "text": {
        "0_B800": "万物浑然交融……"
      },
      "raw_text": {
        "0_B800": "すべては渾然と……"
      }
    },
    "0_B801": {
      "name": "0_B801",
      "text": {
        "0_B801": "故而，合为一体。"
      },
      "raw_text": {
        "0_B801": "ゆえ、一体に。"
      }
    },
    "0_B802": {
      "name": "0_B802",
      "text": {
        "0_B802": "涅槃寂静，万物一如！"
      },
      "raw_text": {
        "0_B802": "涅槃寂静、万物一如！"
      }
    },
    "0_B803": {
      "name": "0_B803",
      "text": {
        "0_B803": "尽数归往那漆黑的虚空之中。"
      },
      "raw_text": {
        "0_B803": "そうは黒けき虚空へと。"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "虚心坦怀，臻至漆黑吧！喝啊！"
      },
      "raw_text": {
        "0_B840": "巨神断界、黒きに至れ！はぁっ！"
      }
    },
    "0_B880": {
      "name": "0_B880",
      "text": {
        "0_B880": "请容我见识一番您的手艺吧。"
      },
      "raw_text": {
        "0_B880": "お手前、拝見しとうございます。"
      }
    },
    "0_B890": {
      "name": "0_B890",
      "text": {
        "0_B890": "无需客气。"
      },
      "raw_text": {
        "0_B890": "遠慮は無用。"
      }
    },
    "0_B910": {
      "name": "0_B910",
      "text": {
        "0_B910": "百万吨利休飞踢！"
      },
      "raw_text": {
        "0_B910": "メガトン雷球キック！"
      }
    },
    "0_B920": {
      "name": "0_B920",
      "text": {
        "0_B920": "唔嗯！"
      },
      "raw_text": {
        "0_B920": "ぬうん！"
      }
    },
    "0_B930": {
      "name": "0_B930",
      "text": {
        "0_B930": "接招！"
      },
      "raw_text": {
        "0_B930": "ソル！"
      }
    }
  }
}
