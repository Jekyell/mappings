{
    "id": 405800,
    "collectionNo": 446,
    "name": "クリームヒルト",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "该上了！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "这家伙！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "受不了！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "哎，等等，你怎么在啊——！？"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "配得上反派千金这个称号的究竟是谁呢！",
                "0_B051": "没错，当然是我克里姆希尔德！",
                "0_B052": "好了，去吧，我的骑士们！",
                "0_B053": "回应我的呐喊吧，海骑士们啊！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "给我闭嘴！"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "就是说嘛！"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "没问题。像个反派，华丽地！"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "好吧，我就扮演反派给你们看好了。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "很好，大获全胜。 来，为胜利欢呼吧！"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "我很强，我的骑士们当然也很强哦。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "毫发无伤啦！"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "呀——！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "裙子都弄脏了，我回去了！"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "好痛好痛……真是的，太粗暴了啦！"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "嗯。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "明白了。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "哎呀，这样吗？"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "来吧，巨齿！"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "那我就收下啦！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "这是少女的修养哦！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "骑士团，准备宝具！"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "该用宝具了吧。"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "来吧，要上了！"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "双钻头！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "碾过去吧。"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "哎呀，刚才有什么东西吗？"
            }
        },
        "0_B250": {
            "name": "宝具カード 4",
            "text": {
                "0_B250": "都跟我来～！"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "骑士团，全体攻击！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "骑士团！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "突击！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "无礼之徒！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "甩了一招巴尔蒙克就消失了——！？"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "真有意思！"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "那我就高声大笑给你听吧！"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "啦啦啦啦啦～♪ ……你听见了吧？　我要杀了你。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "那就出发吧。这就是所谓千金的战场。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "阳光好强啊。 来人啊，把伞拿来。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "哼！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "都说不行了啦——！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "我、我稍微休息一下哦……啊呼～。"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "我先后退一会儿，就一会儿哦！"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "来吧，以一当千的骑士们！",
                "0_B801": "现在正是挥洒你们力量的时候！",
                "0_B802": "为了我这位伟大的反派千金！",
                "0_B803": "回应我的呐喊吧，海骑士们啊！",
                "0_B804": "呵呵呵呵，真是活该呢。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "克里姆希尔德骑士团，出击！",
                "0_B811": "圆桌鲨骑士们，给我大干一场！",
                "0_B812": "鲨鱼群殴，",
                "0_B813": "这才是最聪明的战术！",
                "0_B814": "知道厉害了吧～！"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "好了，一如既往，骑士团出动！",
                "0_B821": "哎？　咦？　怎么多了一个人？",
                "0_B822": "慢着，那是齐格飞……",
                "0_B823": "亲爱的你到底在干什么啦——！？"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "请等一下……我叫你等一下啦！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "骑士团，列队！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "鲨鱼切割！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "鲨鱼粉碎！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "印象真差呢！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "升级？",
                "0_G011": "唔。"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "嗷呜～，我要吃掉你啦～！",
                "0_G021": "……刚才的事就当没看见。就这么办，明白了吗？",
                "0_G022": "明～白～了～吗～？"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "……你那是什么眼神？",
                "0_G031": "这可是鲨骑士们送我的倾注心意的礼物啦！",
                "0_G032": "这个很可爱吧？"
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "最后肯定还是选白色呢。让这身洁白无瑕的泳装染上鲜红。",
                "0_G041": "这才是身为从者的决心吗？",
                "0_G042": "……是这样吧？"
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "哎呀，难道说夏天也快要结束了？",
                "0_G051": "还是说其实才刚刚开始？",
                "0_G052": "快乐的时光总是转瞬即逝呢。",
                "0_G053": "嗯，没错。我很快乐。这点我还是愿意坦率承认的。",
                "0_G054": "……也是。或许偶尔说出来也不错呢。",
                "0_G055": "御主，一直以来谢谢你。努力的你真的很棒哦。",
                "0_G056": "呵呵呵……一定要听姐姐大人的话哦。明白了吗？"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "鲨骑士们也很高兴呢。 这是好事哦。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "呵呵，今天是你的生日吧？",
                "0_H011": "难得的机会，要不要我帮你抹点防晒油？",
                "0_H012": "开玩笑啦，开玩笑的，呵呵呵。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "正在举办活动哦，御主",
                "0_H021": "你肯定会努力的吧？"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "好了，该出击了。",
                "0_H031": "难得的夏天，动作快一点～。"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主从……",
                "0_H041": "肯定不是吧。",
                "0_H042": "……对吧？"
            }
        },
        "0_H050": {
            "name": "会話 3 男性主人公選択時",
            "text": {
                "0_H050": "和御主的关系啊。",
                "0_H051": "嗯，大概就像姐姐和弟弟一样吧……"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的事情？",
                "0_H061": "既然是反派千金，当然就是高声大笑吧。",
                "0_H062": "噢～呵呵呵呵！",
                "0_H063": "……怎么感觉我的高声大笑有些不太对……"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的事情？",
                "0_H071": "大概因为穿着泳装吧，除了晒黑之外，倒是没什么。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯？",
                "0_H081": "唔～，是啊。大概是希望自己永远都不会晒黑吧。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "哎呀，御主。怎么了？"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "听说主题是反派千金哦。",
                "0_H101": "反派这个说法虽然有点失礼，但千金很不错呢。",
                "0_H102": "毕竟我本来就是公主嘛。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "鲨骑士？",
                "0_H111": "……是不知不觉跟来的……",
                "0_H112": "我也很纳闷，但还是决定不去深究了。",
                "0_H113": "毕竟你想啊，这里是迦勒底嘛。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "御主，我有事想和你商量。",
                "0_H121": "我是不会让自己晒黑的。",
                "0_H122": "但我也不打算让人帮我在背上涂防晒油。",
                "0_H123": "该怎么办，快思考啦。",
                "0_H124": "用魔术之类的想办法？",
                "0_H125": "真是的，总是依赖魔术可是长不大的哦。",
                "0_H126": "……总觉得刚才这番说教有点不太对……"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "坦白告诉你吧。其实我克里姆希尔德也不知道什么才是反派千金。",
                "0_H131": "不过，既然那么多人都用近乎崇拜的眼神看着我，这样也不错。",
                "0_H132": "还是说，他们只是因为我太漂亮，才会看入迷？",
                "0_H133": "……你那「这个人事到如今还在说些什么呢」的眼神是什么意思啦。",
                "0_H134": "啊，我漂亮？",
                "0_H135": "这样啊。嗯，这我当然知道。",
                "0_H136": "……不过，还是谢谢你。"
            }
        },
        "0_H220": {
            "name": "会話 9",
            "text": {
                "0_H220": "话说御主，我有事想要抗议。",
                "0_H221": "就是这孩子，对，是汉斯啦。",
                "0_H222": "不对，现在还是齐格吧。",
                "0_H223": "差不多也该给这孩子准备泳装或是铠甲了吧！",
                "0_H224": "嗯，尤其是铠甲比较好。",
                "0_H225": "因为这孩子一不留神就会到处冲，所以最好给他一套结实到离谱笨重到离谱的铠甲！"
            }
        },
        "0_H230": {
            "name": "会話 10",
            "text": {
                "0_H230": "那位是玛丽·安托瓦内特？",
                "0_H231": "……原来如此，真正的反派千金说不定就是那种类型的人吧……",
                "0_H232": "不过那位并不是千金，而是王后……",
                "0_H233": "哎，我是在夸她哦。毕竟反派千金是主角嘛。"
            }
        },
        "0_H240": {
            "name": "会話 11",
            "text": {
                "0_H240": "啊，Passionlip啊。",
                "0_H241": "虽然我好像和她当过一阵子对手，但结束后就没什么问题了。",
                "0_H242": "御主，你有认真夸奖过她的泳装吗？",
                "0_H243": "夸过了？",
                "0_H244": "是吗，好乖。"
            }
        },
        "0_H5050": {
            "name": "会話 3 女性主人公選択時",
            "text": {
                "0_H5050": "和御主的关系啊。",
                "0_H5051": "嗯，大概就像姐姐和妹妹一样吧……"
            }
        },
        "0_H7170": {
            "name": "会話 4",
            "text": {
                "0_H7170": "哎呀，御主。",
                "0_H7171": "齐格飞也在一起啊？",
                "0_H7172": "唔……好吧，也行。"
            }
        },
        "0_H7180": {
            "name": "会話 5",
            "text": {
                "0_H7180": "那边那位眼镜闪闪发亮的废柴先生？",
                "0_H7181": "能替我和御主泡杯茶吗？"
            }
        },
        "0_H7190": {
            "name": "会話 6",
            "text": {
                "0_H7190": "我有一支虽然有点傻,但非常可靠的骑士团。",
                "0_H7191": "所以就算不依赖齐格飞也完全没问题哦！",
                "0_H7192": "……那是什么眼神啊，御主？",
                "0_H7193": "又进入麻烦模式了……？",
                "0_H7194": "你说谁麻烦啊！？"
            }
        },
        "0_H7200": {
            "name": "会話 7",
            "text": {
                "0_H7200": "我有主意了。",
                "0_H7201": "你们两个，拿好遮阳伞跟我来。",
                "0_H7202": "你们要时刻保护我避免我晒黑哦。",
                "0_H7203": "反正我是不会擦防晒油的。",
                "0_H7204": "那边的高个子干嘛一副松了口气的样子？",
                "0_H7205": "……算了，无关紧要啦……"
            }
        },
        "0_H7210": {
            "name": "会話 8",
            "text": {
                "0_H7210": "果然还是会在意晒黑呢。",
                "0_H7211": "……综上所述，帮我涂防晒油吧。",
                "0_H7212": "你问由谁涂？",
                "0_H7213": "御主反正肯定不会涂吧。",
                "0_H7214": "所以……那个……",
                "0_H7215": "还、还是算了。",
                "0_H7216": "事已至此，就算晒黑一点也认了！"
            }
        },
        "0_N010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 1",
            "text": {
                "0_N010": "这是奖励。",
                "0_N011": "我就赏你一件很有反派千金风范的东西吧。"
            }
        },
        "0_N020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 2",
            "text": {
                "0_N020": "哦～呵呵呵！",
                "0_N021": "……这种高声大笑好像太有年代感了吧。",
                "0_N022": "真想换一种更合适一点的笑法呢……"
            }
        },
        "0_N030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 3",
            "text": {
                "0_N030": "关于转生之后成了克里姆希尔德这档子事？",
                "0_N031": "那总之我建议先干掉那个叫哈根的家伙。",
                "0_N032": "先从这里开始做起。"
            }
        },
        "0_N040": {
