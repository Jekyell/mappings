        "0_H1800": {
            "name": "牵绊Lv.5 (奏章Ⅱ通关后)",
            "text": {
                "0_H1800": "你，有什么感觉。",
                "0_H1801": "你自己……",
                "0_H1802": "在这场旅途中战斗，战斗，不停战斗……",
                "0_H1803": "……不，不用了。",
                "0_H1804": "不用回答了。",
                "0_H1805": "……哈？",
                "0_H1806": "不，不是啦，我没在为你担心！　忘了吧！"
            }
        },
        "0_H190": {
            "name": "对话 6",
            "text": {
                "0_H190": "……怎么，是静谧啊。",
                "0_H191": "我？",
                "0_H192": "我并没打算去什么地方……",
                "0_H193": "带我去看各设施？",
                "0_H194": "不，不用，没事，没关系。",
                "0_H195": "下次再说吧。"
            }
        },
        "0_H200": {
            "name": "对话 7",
            "text": {
                "0_H200": "初代大人！",
