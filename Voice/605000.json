        },
        "0_H080": {
            "name": "关于圣杯",
            "text": {
                "0_H080": "如果圣杯真的能实现愿望的话……",
                "0_H081": "不，没什么。"
            }
        },
        "0_H090": {
            "name": "牵绊Lv.1",
            "text": {
                "0_H090": "没想到又见到你了。",
                "0_H091": "……不，是我自言自语而已。"
            }
        },
        "0_H100": {
            "name": "牵绊Lv.2",
            "text": {
                "0_H100": "我不打算与你亲近。",
                "0_H101": "但任务我自会完成，仅此而已。"
            }
        },
        "0_H1000": {
            "name": "牵绊Lv.1 (奏章Ⅱ通关后)",
            "text": {
                "0_H1000": "没想到又见到你了。",
                "0_H1001": "……而且这次是我正规的御主。",
                "0_H1002": "巧合这种东西还真是，该怎么说呢。",
                "0_H1003": "让人受不了。"
            }
        },
        "0_H110": {
            "name": "牵绊Lv.3",
            "text": {
                "0_H110": "怎么？",
                "0_H111": "吃饭？",
                "0_H112": "……英灵不需要饮食。",
                "0_H113": "你不知道吗？"
            }
        },
        "0_H120": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H120": "……我知道了。",
                "0_H121": "我陪你去吃饭。",
                "0_H122": "但是，只能午饭晚饭二选一。明白了吗？"
            }
        },
        "0_H1200": {
            "name": "牵绊Lv.2 (奏章Ⅱ通关后)",
            "text": {
                "0_H1200": "我不打算与你亲近。",
                "0_H1201": "但任务我自会完成，仅此而已。",
                "0_H1202": "……仅此而已哦。"
            }
        },
        "0_H130": {
            "name": "牵绊Lv.5",
            "text": {
                "0_H130": "你，有什么感觉。",
