            "name": "開始 2 ビビッド・サマー",
            "text": {
                "11_B110": "要上了。"
            },
            "raw_text": {
                "11_B110": "やるぞ。"
            }
        },
        "11_B120": {
            "name": "勝利 1 ビビッド・サマー",
            "text": {
                "11_B120": "大致就这种感觉吧。"
            },
            "raw_text": {
                "11_B120": "ざっとこんなとこだ。"
            }
        },
        "11_B130": {
            "name": "勝利 2 ビビッド・サマー",
            "text": {
                "11_B130": "加速结束，战斗结束。"
            },
            "raw_text": {
                "11_B130": "加速終了、戦闘終了。"
            }
        },
        "11_B140": {
            "name": "ダメージ 2 ビビッド・サマー",
            "text": {
                "11_B140": "好痛。"
            },
            "raw_text": {
                "11_B140": "あいた。"
            }
        },
        "11_B150": {
            "name": "ダメージ 1 ビビッド・サマー",
            "text": {
                "11_B150": "那是什么啊。"
            },
            "raw_text": {
                "11_B150": "なんだそれ。"
            }
        },
        "11_B160": {
            "name": "戦闘不能 1 ビビッド・サマー",
            "text": {
                "11_B160": "是我大意了吗。"
            },
            "raw_text": {
                "11_B160": "油断したのか。"
            }
        },
        "11_B170": {
            "name": "戦闘不能 2 ビビッド・サマー",
            "text": {
                "11_B170": "可恶。"
            },
            "raw_text": {
                "11_B170": "ちっくしょう。"
            }
        },
        "11_B180": {
            "name": "コマンドカード 1 ビビッド・サマー",
            "text": {
                "11_B180": ""
            },
            "raw_text": {
                "11_B180": "うん。"
            }
        },
        "11_B190": {
            "name": "コマンドカード 2 ビビッド・サマー",
            "text": {
                "11_B190": ""
            },
            "raw_text": {
                "11_B190": "ああ。"
            }
        },
        "11_B200": {
            "name": "コマンドカード 3 ビビッド・サマー",
            "text": {
                "11_B200": "知道了。"
            },
            "raw_text": {
                "11_B200": "わったよ。"
            }
        },
        "11_B2010": {
            "name": "アタック 10 ビビッド・サマー",
            "text": {
                "11_B2010": "哈，怎么样！"
            },
            "raw_text": {
                "11_B2010": "やっ、どうだ。"
            }
        },
        "11_B2020": {
            "name": "アタック 11 ビビッド・サマー",
            "text": {
                "11_B2020": "加速分身，哈！"
            },
            "raw_text": {
                "11_B2020": "家族分身、はっ。"
            }
        },
        "11_B2030": {
            "name": "アタック 12 ビビッド・サマー",
            "text": {
                "11_B2030": "你看得清吗！"
            },
            "raw_text": {
                "11_B2030": "見切れるかよ。"
            }
        },
        "11_B210": {
            "name": "宝具カード 1 ビビッド・サマー",
            "text": {
                "11_B210": ""
            },
            "raw_text": {
                "11_B210": "おう。"
            }
        },
        "11_B220": {
            "name": "宝具カード 2 ビビッド・サマー",
            "text": {
                "11_B220": "这可是压箱底的绝招。"
            },
            "raw_text": {
                "11_B220": "とっておきだ。"
            }
        },
        "11_B230": {
            "name": "宝具カード 3 ビビッド・サマー",
            "text": {
                "11_B230": "让你见识一下。"
            },
            "raw_text": {
                "11_B230": "見せてやる。"
            }
        },
        "11_B2410": {
            "name": "アタック 13 ビビッド・サマー",
            "text": {
                "11_B2410": "大方奉送啦！"
            },
            "raw_text": {
                "11_B2410": "大盤振る舞いだ。"
            }
        },
        "11_B2420": {
            "name": "アタック 14 ビビッド・サマー",
            "text": {
                "11_B2420": "给我好好挨这招！"
            },
            "raw_text": {
                "11_B2420": "ちゃんとくらえ。"
            }
        },
        "11_B250": {
            "name": "宝具カード 4 ビビッド・サマー",
            "text": {
                "11_B250": "超高速，要上了。"
            },
            "raw_text": {
                "11_B250": "超高速行くぜ。"
            }
        },
        "11_B410": {
            "name": "アタック 4 ビビッド・サマー",
            "text": {
                "11_B410": ""
            },
            "raw_text": {
                "11_B410": "そらあ。"
            }
        },
        "11_B420": {
            "name": "アタック 5 ビビッド・サマー",
            "text": {
                "11_B420": "得手了。"
            },
            "raw_text": {
                "11_B420": "いただき。"
            }
        },
        "11_B430": {
            "name": "アタック 6 ビビッド・サマー",
            "text": {
                "11_B430": "斩首。"
            },
            "raw_text": {
                "11_B430": "首刈り。"
            }
        },
        "11_B440": {
            "name": "エクストラアタック 2 ビビッド・サマー",
            "text": {
                "11_B440": "用这招一决胜负！"
            },
            "raw_text": {
                "11_B440": "こいつで決まりだ。"
            }
        },
        "11_B480": {
            "name": "スキル 3 ビビッド・サマー",
            "text": {
                "11_B480": "跟上。"
            },
            "raw_text": {
                "11_B480": "ついてこい。"
            }
        },
        "11_B490": {
            "name": "スキル 4 ビビッド・サマー",
            "text": {
                "11_B490": "加速准备。"
            },
            "raw_text": {
                "11_B490": "加速準備。"
            }
        },
        "11_B500": {
            "name": "開始 3 ビビッド・サマー",
            "text": {
                "11_B500": "真碍事。"
            },
            "raw_text": {
                "11_B500": "邪魔だな。"
            }
        },
        "11_B510": {
            "name": "開始 4 ビビッド・サマー",
            "text": {
                "11_B510": "给我让开。"
            },
            "raw_text": {
                "11_B510": "どけよ。"
            }
        },
        "11_B520": {
            "name": "勝利 3 ビビッド・サマー",
            "text": {
                "11_B520": "跟你说别太往前冲，说了你也不听吧，你这家伙。"
            },
            "raw_text": {
                "11_B520": "あんまり前に出過ぎるなよって言っても聞かないよな、お前。"
            }
        },
        "11_B530": {
            "name": "勝利 4 ビビッド・サマー",
            "text": {
                "11_B530": "去下一个地方吧。"
            },
            "raw_text": {
                "11_B530": "次行こうぜ。"
            }
        },
        "11_B540": {
            "name": "ダメージ 4 ビビッド・サマー",
            "text": {
                "11_B540": ""
            },
            "raw_text": {
                "11_B540": "ちっ。"
            }
        },
        "11_B550": {
            "name": "ダメージ 3 ビビッド・サマー",
            "text": {
                "11_B550": "真的假的啊——"
            },
            "raw_text": {
                "11_B550": "マジかー。"
            }
        },
        "11_B560": {
            "name": "戦闘不能 3 ビビッド・サマー",
            "text": {
                "11_B560": "开玩笑的吧。"
            },
            "raw_text": {
                "11_B560": "嘘だろう。"
            }
        },
        "11_B570": {
            "name": "戦闘不能 4 ビビッド・サマー",
            "text": {
                "11_B570": "御主，快逃。"
            },
            "raw_text": {
                "11_B570": "まさ逃げろ。"
            }
        },
        "11_B840": {
            "name": "エクストラアタック 3 ビビッド・サマー",
            "text": {
                "11_B840": "能追得上我吗！"
            },
            "raw_text": {
                "11_B840": "俺に！ 追いつけるかよ。"
            }
        },
        "11_B880": {
            "name": "スキル 5 ビビッド・サマー",
            "text": {
                "11_B880": "刘海。"
            },
            "raw_text": {
                "11_B880": "前髪。"
            }
        },
        "11_B890": {
            "name": "スキル 6 ビビッド・サマー",
            "text": {
                "11_B890": ""
            },
            "raw_text": {
                "11_B890": "よし。"
            }
        },
        "11_B910": {
            "name": "アタック 7 ビビッド・サマー",
            "text": {
                "11_B910": ""
            },
            "raw_text": {
                "11_B910": "おおっはっ。"
            }
        },
        "11_B920": {
            "name": "アタック 8 ビビッド・サマー",
            "text": {
                "11_B920": "看招看招。"
            },
            "raw_text": {
                "11_B920": "そらそら。"
            }
        },
        "11_B930": {
            "name": "アタック 9 ビビッド・サマー",
            "text": {
                "11_B930": "哼，看招！"
            },
            "raw_text": {
                "11_B930": "ふん、そりゃ。"
            }
        },
        "11_G010": {
            "name": "レベルアップ 1 ビビッド・サマー",
            "text": {
                "11_G010": "这样啊。"
            },
            "raw_text": {
                "11_G010": "そうか。"
            }
        },
        "11_G060": {
            "name": "霊衣開放 ビビッド・サマー",
            "text": {
                "11_G060": "灵衣，给我的？嘿，是这种感觉啊。行啊，既然说是夏日装束，那我就穿上吧。再次请多关照啦。",
                "11_G061": "",
                "11_G062": "",
                "11_G063": ""
            },
            "raw_text": {
                "11_G060": "レイ、俺にか？へえ、こういう感じなんだな。いいぜ、夏の予想言ってんなら着てやるよ。改めてよろしくだ。",
                "11_G061": "",
                "11_G062": "",
                "11_G063": ""
            }
        },
        "11_G110": {
            "name": "レベルアップ 2 ビビッド・サマー",
            "text": {
                "11_G110": ""
            },
            "raw_text": {
                "11_G110": "……ふむ。"
            }
        },
        "11_G120": {
            "name": "レベルアップ 3 ビビッド・サマー",
            "text": {
                "11_G120": "别老乱摸。"
            },
            "raw_text": {
                "11_G120": "あんまり触るな。"
            }
        },
        "11_H9000": {
            "name": "霊衣について ビビッド・サマー",
            "text": {
                "11_H9000": "问灵衣怎么样？嗯……要说方便行动的程度，和平时没两样啊。『……好可爱』？你在说什么呢，你。",
                "11_H9001": "",
                "11_H9002": "",
                "11_H9003": "",
                "11_H9004": ""
            },
            "raw_text": {
                "11_H9000": "レイはどうかってうーん。動きやすさ で言うと 普段と変わんねえな は 可愛い。 何言ってんだ。お前。",
                "11_H9001": "",
                "11_H9002": "",
                "11_H9003": "",
                "11_H9004": ""
            }
        }
    },
