{
    "id": 106300,
    "collectionNo": 445,
    "name": "パッションリップ",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "看招～！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "怎么样！？"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "跳跃、踢踹、定胜负！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "阳光的浪漫！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "蜂巢编码，开始。",
                "0_B051": "无论多么坚硬的躯体，都敌不过我的双手！",
                "0_B052": "爱憎活泼！",
                "0_B053": "纵使爱会招致苦难！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "废弃＆崩溃哦！"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "虽然成不了白天鹅！"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "那些就是敌人吗？ 那个……看起来好像很弱，我可以收拾掉吗？"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "真是的，竟然不吸取教训还来碍事……！ 我可不会手下留情哦！"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "比预想的花了更多时间呢…… 坏人们就在我的胸口好好反省吧！"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "大家都没受伤，真是太好了。 看来我的爪子也不是一无是处的呢！"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "呀——！"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "才不痛呢……！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "我输掉了吧……得更加努力才行……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "难得您选择了我……对不起，御主。"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "啊哇哇哇！"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "这就来～～！"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "让您久等啦！"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "咚咚～！　咚咚～！"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "瞄准射击！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "要打中啊——！"
            }
        },
        "0_B2080": {
            "name": "スキル 7",
            "text": {
                "0_B2080": "我也是能做到的……！"
            }
        },
        "0_B2090": {
            "name": "スキル 8",
            "text": {
                "0_B2090": "就算使出全力也不会坏掉！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "如鲜花般可爱！"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "决不会将这种心情交给任何人！"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "碍事的家伙就该接受惩罚吧……？"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "预备～！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "我不擅长这个～！"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "把你当球一样耍！"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "呀呀呀呀呀呀，嘿～！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "重量就是力量嘛！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "要可爱地！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "轴转步！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "Passion，粉碎——！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "就用这个小包接住！"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "这个垫子如何？"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "海滩上可不适合有垃圾！ 坏人们就该被一并揉起来变成一小粒！"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "谢谢您为我声援！ 今天我比平时高兴两倍……不，是高兴十倍！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "虽然很疼很不甘心……但我有帮上您的忙吗……？ 如果有帮上……那就太好了。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "欢迎来到蜜蜂的迷宫。",
                "0_B801": "受难之花宛如牢笼，捕获之爱不会放开！",
                "0_B802": "承受吧！",
                "0_B803": "跃动Passion拳！"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "呵呵……在那里吧？",
                "0_B811": "怎么能抵抗呢。把你切碎、压紧，做成一口大小。",
                "0_B812": "这就是你的命运。",
                "0_B813": "呵呵，身体和心灵都变得硬邦邦♡"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "比平时都要温柔吧？"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "接下来就拜托您了！"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "您就是我的王子殿下！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "面带笑容，开心地☆"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "来了，来了，来了～！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "不会弄掉哦！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "太好了，升级了！",
                "0_G011": "夏天才刚刚开始吧！"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "啊唔啊唔……",
                "0_G111": "已经吃不下了……明天再拜托您了……"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "非常感谢！",
                "0_G121": "能被您依赖，我真的非常开心！"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "我一直在热切地期待着这一天！",
                "0_H011": "今天是您的生日吧！",
                "0_H012": "没错，我已经不是只会做出敲都敲不碎饼干的那个我了。",
                "0_H013": "既然不擅长烹饪，就干脆放弃，改用体验来决胜负！",
                "0_H014": "身为御主，肯定少不了带有梦想、希望和一点点可怕的体验吧？",
                "0_H015": "要不要试试结合艺术体操和童话的全新模拟呢？"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "咦，活动已经开始了吗？",
                "0_H021": "御主，您知道吗？"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "唉……休息时间结束了呢……",
                "0_H031": "不过偷懒可不好呢！　重新振作精神出击吧！"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "我一个人的话就很容易做过火……",
                "0_H041": "所以请尽管向我下达指示哦，御主！"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "虽然称呼有很多种，认真时叫御主，平时加敬称。",
                "0_H051": "然后……两人独处时……",
                "0_H052": "那个……那个……",
                "0_H053": "不行，完全想不出来～！　好想要只属于我的特别称呼啊～～！"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西是……那个……",
                "0_H061": "对不起……就算换上了泳装，我最擅长的还是破坏……我觉得特别开心……",
                "0_H062": "不过，我会干掉的只有坏人哦！",
                "0_H063": "毕竟在SAKURA FIVE中能干脆利落破坏并收拾对手的只有我一个嘛！"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的东西……",
                "0_H071": "以前我害怕他人的目光，现在则讨厌自己的软弱。",
                "0_H072": "毕竟我不想糟蹋这么可爱的泳装嘛！"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "希望圣杯实现的愿望吗？",
                "0_H081": "如果能有七位左右优秀的侍从，我会很开心的……",
                "0_H082": "哎，有事吗，黑胡子先生。您也想进我的小包吗？"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "好不容易获得了强大的灵基，目标当然也要设定得远大一点才不浪费……",
                "0_H091": "比方说……从坚硬巨大有力气的SAKURA FIVE，改成最可爱的SAKURA FIVE……？",
                "0_H092": "啊哇哇……刚才那个只是目标，只是目标啦！"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "购物的时候就交给我吧！",
                "0_H101": "不管有多少行李，我都能收起来！",
                "0_H102": "别说店里的所有商品了，我甚至可以连整家店都一并收起来哦♡"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "我之所以喜欢艺术体操，大概是由于对自由身体的向往吧。",
                "0_H111": "我现在偶尔也会想……如果自己能像Melt那样苗条就好了，但我就是我。",
                "0_H112": "而且双手稳定之后，很多大胆的动作也能做到了，总觉得就像打开了新大门呢！"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "魔镜啊魔镜，世界上最美丽的～～",
                "0_H121": "没错，是Passionlip女王！",
                "0_H122": "胆敢反对的坏御主就会被拎起来丢进小包里～！",
                "0_H123": "呵呵。不断重现童话故事之后，对反派也产生兴趣了呢。",
                "0_H124": "在成为这个灵基以后，我一直在笑呢。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "从前的我，一直渴望得到只对我一个人温柔的理想王子殿下。",
                "0_H131": "可那其实只是幼稚的自我陶醉，我只是希望有人保护没用的自己罢了。",
                "0_H132": "时而鼓励，时而纠正，时而相互扶持。这才是真正的恋人，真正的王子殿下。",
                "0_H133": "虽然这份感情或许会随着这个灵基一起消失。",
                "0_H134": "但我有成为配得上您的公主吗？"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "我总觉得迦勒底的各位太纵容ＢＢ了。",
                "0_H171": "她是个总喜欢用毫无必要的工作量折腾大家的麻烦ＡＩ！",
                "0_H172": "要是她再敢拿出新的灵基，届时我们SAKURA FIVE一定会团结一致，好好教训她一顿！"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "我不会再让Meltryllis摆出一副自己是SAKURA FIVE代表的架子了！",
                "0_H181": "因为，我也换上泳装了嘛！"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "原来Protea竟然能正常说话啊……",
                "0_H191": "明明以前几乎无法和任何人交流，却和御主那么聊得来啊。唔～。",
                "0_H192": "……不过，她应该算不上我的对手吧？",
                "0_H193": "毕竟Protea的内心还是个小女孩。",
                "0_H194": "就算真成了对手，也没有问题啦。"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "克里姆希尔德小姐为什么要那么不坦率呢？",
                "0_H201": "喜欢的话，直接说喜欢不就好了……",
                "0_H202": "身心都是彻头彻尾的反派千金呢。"
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "湿度太高的城市不太好吧……",
                "0_H211": "感觉会导致电子器械发生故障……",
                "0_H212": "而且自带大型重机的特性和我撞人设了……",
                "0_H213": "我可以将那个分解得连一点都不剩吗……？"
            }
        },
        "0_H220": {
            "name": "会話 9",
            "text": {
                "0_H220": "岸波也在这里呢。",
                "0_H221": "那位没有靠暴力，而是通过理解战斗对手结束了圣杯战争，是我们所有人的恩人。",
                "0_H222": "现在的话，我应该能更为自然地为当时的事向那位道谢了吧……",
                "0_H223": "……不过，那位能看穿秘密花园的技能倒是还在呢……"
            }
        },
        "0_H230": {
            "name": "会話 10",
            "text": {
                "0_H230": "当看到珀西瓦尔先生时，不知为何，我的脑海里就会浮现很奇怪的画面……",
                "0_H231": "类似于在一个四周围着绳索的地方压倒对手大声叫喊……",
                "0_H232": "我难道有些欲求不满吗……"
            }
        },
        "0_H240": {
            "name": "会話 11",
            "text": {
                "0_H240": "您说我常与埃列什基伽勒聊天？",
                "0_H241": "嗯，没错。连我都觉得不可思议，但我和埃列什基伽勒真的很合得来。",
                "0_H242": "但当我对Melt说，这或许是因为我们都有点内向吧，她居然回复说，",
                "0_H243": "「你内向？　别闹了，这话荒谬到我都能用鞋跟烧开水了」……",
                "0_H244": ""
            }
        },
        "0_H250": {
            "name": "会話 12",
            "text": {
                "0_H250": "实不相瞒，这套泳装灵基是爱迪生先生为我准备的。",
                "0_H251": "准确地说，是他将设计和资源提供给了ＢＢ，才成了现在这样。",
                "0_H252": "但当我向他道谢时，他却露出非常温柔的表情说，「没什么。我只是觉得你有这种资格」。",
                "0_H253": "呵呵。明明长着狮子的脸，真不可思议呢。"
            }
        },
        "0_H260": {
            "name": "会話 13",
            "text": {
                "0_H260": "呼延灼小姐那种容易钻牛角尖、容易消沉的个性让人非常安心！",
                "0_H261": "因为这会让我觉得！　看来我也还不要紧！"
            }
        },
        "0_I010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 1",
            "text": {
                "0_I010": "欢迎光临！",
                "0_I011": "一听说轮到我表现，我就赶来了！",
                "0_I012": "这是我人生第一次当店员，我一定会好好干的！"
            }
        },
        "0_I020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 2",
            "text": {
                "0_I020": "这里好像没有什么可爱的商品呢……",
                "0_I021": "虽然实用性确实很重要，不过我觉得设计也一样重要……",
                "0_I022": "毕竟没人会想佩戴不喜欢的东西吧？"
            }
        },
        "0_I030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 3",
            "text": {
                "0_I030": "不过反派千金什么的也太没礼貌了吧。",
                "0_I031": "这种角色明明更适合Melt、Kazura或者ＢＢ吧！？"
            }
        },
        "0_I040": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 4",
            "text": {
                "0_I040": "好的，感谢您的购买！",
                "0_I041": "请一定要多多使用哦！"
            }
        },
        "0_I050": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 5",
            "text": {
                "0_I050": "啊，啊哇哇哇哇～！",
                "0_I051": "没控制好力道，把商品弄坏了～～！",
                "0_I052": "没、没关系，我会用我打工的钱赔偿的！"
            }
        },
        "0_I060": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 6",
            "text": {
                "0_I060": "呼～……呼～……啊！？",
                "0_I061": "我、我没睡，我没睡！",
                "0_I062": "只是刚吃完饭，有一点点犯困而已啦！"
            }
        },
        "0_I070": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 7",
            "text": {
                "0_I070": "特异点得到解决，商店也要关门了。",
                "0_I071": "很高兴能够认识克里姆希尔德小姐。",
                "0_I072": "我原本还以为她是和Melt差不多的那类人，结果完全不一样呢。",
                "0_I073": "她是一位非常认真、坦率、出色的人！"
            }
        },
        "0_I080": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 8",
            "text": {
                "0_I080": "那个……难道说您还有兑换道具没用完吗……？",
                "0_I081": "留着反正也没什么用，所以在这里全部用掉吧。",
                "0_I082": "这是我最后的看店时间哦！"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "呜哇啊啊啊，终于穿上梦寐以求的夏装啦～～！",
                "0_S011": "开心得都快死掉了～～～！　谢谢大家～～～！",
                "0_S012": "啊。对对对不起，现在应该先打招呼吧！",
                "0_S013": "我是爱憎的他人格，Passionlip。",
                "0_S014": "就算成为了新的灵基，他人格的本质也不会改变，双手依然这么大……",
                "0_S015": "不过，我会努力让大家觉得我的个性就是我的优点！",
                "0_S016": "以及我唯独不会输给Melt！",
                "0_S017": "毕竟肯定还是大的比较好嘛！"
            }
        },
        "1_B010": {
            "name": "アタック 1",
            "text": {
                "1_B010": "请看好了！"
            }
        },
        "1_B020": {
            "name": "アタック 2",
            "text": {
                "1_B020": "最喜欢了！"
            }
        },
        "1_B030": {
            "name": "アタック 3",
            "text": {
                "1_B030": "Un，deux，trois（1，2，3）！"
            }
        },
        "1_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "1_B040": "一、二、咚——！"
            }
        },
        "1_B050": {
            "name": "宝具 1",
            "text": {
                "1_B050": "就让我用热情的演出定胜负吧！",
                "1_B051": "斜劈、拼贴、改编！",
                "1_B052": "请注目！",
                "1_B053": "纵使爱会招致苦难！"
            }
        },
        "1_B080": {
            "name": "スキル 1",
            "text": {
                "1_B080": "像收入掌心一般！"
            }
        },
        "1_B090": {
            "name": "スキル 2",
            "text": {
                "1_B090": "轮到我表现了吧！"
            }
        },
        "1_B100": {
            "name": "開始 1",
            "text": {
                "1_B100": "一号选手，Passionlip，要上场了！"
            }
        },
        "1_B110": {
            "name": "開始 2",
            "text": {
                "1_B110": "但愿您能好好欣赏我的表演……"
            }
        },
        "1_B120": {
            "name": "勝利 1",
            "text": {
                "1_B120": "丝带的动作怎么样？ 希望看起来漂亮……"
            }
        },
        "1_B130": {
            "name": "勝利 2",
            "text": {
                "1_B130": "咦，已经结束了吗？ 比预定流程还早了一点呢……"
            }
        },
        "1_B140": {
            "name": "ダメージ 2",
            "text": {
                "1_B140": "我不会输！"
            }
        },
        "1_B150": {
            "name": "ダメージ 1",
            "text": {
                "1_B150": "啊哇哇，节奏……！"
            }
        },
        "1_B160": {
            "name": "戦闘不能 1",
            "text": {
                "1_B160": "啊哇哇，丝带松了…… 对不起，请让我重新来一次～！"
            }
        },
        "1_B170": {
            "name": "戦闘不能 2",
            "text": {
                "1_B170": "都是我的失误，对不起…… 不过下一次我一定会做到完美的！"
            }
        },
        "1_B180": {
            "name": "コマンドカード 1",
            "text": {
                "1_B180": "跟上节奏……"
            }
        },
        "1_B190": {
            "name": "コマンドカード 2",
            "text": {
                "1_B190": "舒展四肢……"
            }
        },
        "1_B200": {
            "name": "コマンドカード 3",
            "text": {
                "1_B200": "积蓄力量……"
            }
        },
        "1_B2010": {
            "name": "アタック 10",
            "text": {
                "1_B2010": "动作组Ｂ！"
            }
        },
        "1_B2020": {
            "name": "アタック 11",
            "text": {
                "1_B2020": "破坏Lip！"
            }
        },
        "1_B2030": {
            "name": "アタック 12",
            "text": {
                "1_B2030": "是要碎成粉末吧！"
            }
        },
        "1_B2080": {
            "name": "スキル 7",
            "text": {
                "1_B2080": "至少这一刻，我是主角！"
            }
        },
        "1_B2090": {
            "name": "スキル 8",
            "text": {
                "1_B2090": "我要拿出真本事了哦！"
            }
        },
        "1_B210": {
            "name": "宝具カード 1",
            "text": {
                "1_B210": "如鲜花般大胆！"
            }
        },
        "1_B220": {
            "name": "宝具カード 2",
            "text": {
                "1_B220": "开始收尾动作！"
            }
        },
        "1_B230": {
            "name": "宝具カード 3",
            "text": {
                "1_B230": "都是你的错哦……？"
            }
        },
        "1_B2410": {
            "name": "アタック 13",
            "text": {
                "1_B2410": "开始旋转！"
            }
        },
        "1_B2420": {
            "name": "アタック 14",
            "text": {
                "1_B2420": "就连指尖都要展现帅气！"
            }
        },
        "1_B2430": {
            "name": "アタック 15",
            "text": {
                "1_B2430": "这种程度我也能做到……！"
            }
        },
        "1_B2810": {
            "name": "アタック 16",
            "text": {
                "1_B2810": "就连脚尖都要展现优美！"
            }
        },
        "1_B410": {
            "name": "アタック 4",
            "text": {
                "1_B410": "三重月！"
            }
        },
        "1_B420": {
            "name": "アタック 5",
            "text": {
                "1_B420": "啦～啦啦～♪"
            }
        },
        "1_B430": {
            "name": "アタック 6",
            "text": {
                "1_B430": "把你卷进去吧！"
            }
        },
        "1_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "1_B440": "拿手绝技可不会手下留情！"
            }
        },
        "1_B480": {
            "name": "スキル 3",
            "text": {
                "1_B480": "获得中场休息时间啦☆"
            }
        },
        "1_B490": {
            "name": "スキル 4",
            "text": {
                "1_B490": "缓急、缓急。"
            }
        },
        "1_B500": {
            "name": "開始 3",
            "text": {
                "1_B500": "充满节奏感地击溃敌人！"
            }
        },
        "1_B520": {
            "name": "勝利 3",
            "text": {
                "1_B520": "表演结束！ 呼……为准备下一场，得检查一下器械才行……"
            }
        },
        "1_B560": {
            "name": "戦闘不能 3",
            "text": {
                "1_B560": "没能跟上节奏……都是对手不好……"
            }
        },
        "1_B800": {
            "name": "宝具 2",
            "text": {
                "1_B800": "啊，好像可以！　那我上了哦！",
                "1_B801": "无论你有多快，无论你有多远，",
                "1_B802": "这份爱都一定能传达到！",
                "1_B803": "跃动体操选手拳！"
            }
        },
        "1_B810": {
            "name": "宝具 3",
            "text": {
                "1_B810": "——我的双眼会拍下整个世界。",
                "1_B811": "对不起，被看到的其实是你哦！",
                "1_B812": "你已经逃不掉了！",
                "1_B813": "请成为我的俘虏吧！"
            }
        },
        "1_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "1_B840": "既然在那里，就紧紧～～捏起来！"
            }
        },
        "1_B880": {
            "name": "スキル 5",
            "text": {
                "1_B880": "加油、加油♪"
            }
        },
        "1_B890": {
            "name": "スキル 6",
            "text": {
                "1_B890": "一切都交给您了！"
            }
        },
        "1_B910": {
            "name": "アタック 7",
            "text": {
                "1_B910": "要捏扁吗？"
            }
        },
        "1_B920": {
            "name": "アタック 8",
            "text": {
                "1_B920": "动作组Ａ！"
            }
        },
        "1_B930": {
            "name": "アタック 9",
            "text": {
                "1_B930": "压扁吧♡"
            }
        },
        "1_G010": {
            "name": "レベルアップ 1",
            "text": {
                "1_G010": "已、已经升级到中级了吗！？",
                "1_G011": "看来得赶紧做热身运动才行！"
            }
        },
        "1_G020": {
            "name": "霊基再臨 2",
            "text": {
                "1_G020": "我好像渐渐找到只属于自己的行动方式了！",
                "1_G021": "虽然我常常偷懒，不过为了让自己的动作变得更优美，我会每天坚持训练的！"
            }
        },
        "1_G030": {
            "name": "霊基再臨 1",
            "text": {
                "1_G030": "这、这个再临很意外吗？",
                "1_G031": "不过，我一直非常向往很有女孩子风格的兴趣爱好……",
                "1_G032": "Melt喜欢芭蕾，Protea喜欢烹饪，Kazura喜欢魔术。",
                "1_G033": "大家都有各自的兴趣，所以我也决定尝试做自己喜欢的东西！",
                "1_G034": "就算如此巨大，我也会努力拿到最高分的！"
            }
        },
        "1_G110": {
            "name": "レベルアップ 2",
            "text": {
                "1_G110": "但愿提升的不只是力量，身体柔韧性也能进一步提升……",
                "1_G111": "咦，已经够柔软了？",
                "1_G112": "呵呵，还差得远呢，肯定是这样。"
            }
        },
        "1_G120": {
            "name": "レベルアップ 3",
            "text": {
                "1_G120": "目标是摆脱只能当坦克位的刻板印象！",
                "1_G121": "我可不会输给喜欢芭蕾的Melt哦！"
            }
        },
        "1_H010": {
            "name": "誕生日",
            "text": {
                "1_H010": "我一直在热切地期待着这一天！",
                "1_H011": "今天是您的生日吧！",
                "1_H012": "没错，我已经不是只会做出敲都敲不碎饼干的那个我了。",
                "1_H013": "既然不擅长烹饪，就干脆放弃，改用体验来决胜负！",
                "1_H014": "身为御主，肯定少不了带有梦想、希望和一点点可怕的体验吧？",
                "1_H015": "要不要试试结合艺术体操和童话的全新模拟呢？"
            }
        },
        "1_H020": {
            "name": "イベント開催中",
            "text": {
                "1_H020": "咦，活动已经开始了吗？",
                "1_H021": "御主，您知道吗？"
            }
        },
        "1_H030": {
            "name": "会話 1",
            "text": {
                "1_H030": "唉……休息时间结束了呢……",
                "1_H031": "不过偷懒可不好呢！　重新振作精神出击吧！"
            }
        },
        "1_H040": {
            "name": "会話 2",
            "text": {
                "1_H040": "我一个人的话就很容易做过火……",
                "1_H041": "所以请尽管向我下达指示哦，御主！"
            }
        },
        "1_H050": {
            "name": "会話 3",
            "text": {
                "1_H050": "虽然称呼有很多种，认真时叫御主，平时加敬称。",
                "1_H051": "然后……两人独处时……",
                "1_H052": "那个……那个……",
                "1_H053": "不行，完全想不出来～！　好想要只属于我的特别称呼啊～～！"
            }
        },
        "1_H060": {
            "name": "好きなこと",
            "text": {
                "1_H060": "喜欢的东西是……那个……",
                "1_H061": "对不起……就算换上了泳装，我最擅长的还是破坏……我觉得特别开心……",
                "1_H062": "不过，我会干掉的只有坏人哦！",
                "1_H063": "毕竟在SAKURA FIVE中能干脆利落破坏并收拾对手的只有我一个嘛！"
            }
        },
        "1_H070": {
            "name": "嫌いなこと",
            "text": {
                "1_H070": "讨厌的东西……",
                "1_H071": "以前我害怕他人的目光，现在则讨厌自己的软弱。",
                "1_H072": "毕竟我不想糟蹋这么可爱的泳装嘛！"
            }
        },
        "1_H080": {
            "name": "聖杯について",
            "text": {
                "1_H080": "希望圣杯实现的愿望吗？",
                "1_H081": "如果能有七位左右优秀的侍从，我会很开心的……",
                "1_H082": "哎，有事吗，黑胡子先生。您也想进我的小包吗？"
            }
        },
        "1_H090": {
            "name": "絆Lv.1",
            "text": {
                "1_H090": "好不容易获得了强大的灵基，目标当然也要设定得远大一点才不浪费……",
                "1_H091": "比方说……从坚硬巨大有力气的SAKURA FIVE，改成最可爱的SAKURA FIVE……？",
                "1_H092": "啊哇哇……刚才那个只是目标，只是目标啦！"
            }
        },
        "1_H100": {
            "name": "絆Lv.2",
            "text": {
                "1_H100": "购物的时候就交给我吧！",
                "1_H101": "不管有多少行李，我都能收起来！",
                "1_H102": "别说店里的所有商品了，我甚至可以连整家店都一并收起来哦♡"
            }
        },
        "1_H110": {
            "name": "絆Lv.3",
            "text": {
                "1_H110": "我之所以喜欢艺术体操，大概是由于对自由身体的向往吧。",
                "1_H111": "我现在偶尔也会想……如果自己能像Melt那样苗条就好了，但我就是我。",
                "1_H112": "而且双手稳定之后，很多大胆的动作也能做到了，总觉得就像打开了新大门呢！"
            }
        },
        "1_H120": {
            "name": "絆Lv.4",
            "text": {
                "1_H120": "魔镜啊魔镜，世界上最美丽的～～",
                "1_H121": "没错，是Passionlip女王！",
                "1_H122": "胆敢反对的坏御主就会被拎起来丢进小包里～！",
                "1_H123": "呵呵。不断重现童话故事之后，对反派也产生兴趣了呢。",
                "1_H124": "在成为这个灵基以后，我一直在笑呢。"
            }
        },
        "1_H130": {
            "name": "絆Lv.5",
            "text": {
                "1_H130": "从前的我，一直渴望得到只对我一个人温柔的理想王子殿下。",
                "1_H131": "可那其实只是幼稚的自我陶醉，我只是希望有人保护没用的自己罢了。",
                "1_H132": "时而鼓励，时而纠正，时而相互扶持。这才是真正的恋人，真正的王子殿下。",
                "1_H133": "虽然这份感情或许会随着这个灵基一起消失。",
                "1_H134": "但我有成为配得上您的公主吗？"
            }
        },
        "1_H270": {
            "name": "会話 4",
            "text": {
                "1_H270": "当我去模拟装置练习时，杜尔伽小姐竟然来观众席了。",
                "1_H271": "我询问她，是不是因为我的爪子是由女神杜尔迦的要素构成的呢？　结果是因为迦梨小姐对艺术体操很感兴趣……",
                "1_H272": "要是毁灭世界的舞蹈变成了艺术体操的话，请容我说声对不起！"
            }
        },
        "1_H280": {
            "name": "会話 5",
            "text": {
                "1_H280": "Kazura总是夸口说要超越ＢＢ，可到头来，她其实才是最像ＢＢ的那个吧。",
                "1_H281": "因为Kazura在宝具里变成大人后，穿上了连体紧身衣嘛。",
                "1_H282": "那种时装其实毫无必要吧？"
            }
        },
        "1_H290": {
            "name": "会話 6",
            "text": {
                "1_H290": "虽然我也有点羡慕魔法少女的样子，但您想啊，还是会有抵触心理吧……",
                "1_H291": "我觉得长大以后还能变成那副模样的人，百分百都是开朗而天真无邪的人啦……"
            }
        },
        "1_H300": {
            "name": "会話 7",
            "text": {
                "1_H300": "真让人吓了一跳……",
                "1_H301": "黄金ＢＢ……说是ＢＢ的究极形态，结果端出来的竟是金色的兔女郎装……",
                "1_H302": "一想到那种心机ＡＩ居然是我们的原型，我都想毫不犹豫地捏扁她了……",
                "1_H303": "之前还说什么「连体紧身衣是为了应对分级审核啦☆」……",
                "1_H304": "原来全都是借口啊……"
            }
        },
        "1_H310": {
            "name": "会話 8",
            "text": {
                "1_H310": "啊哇哇，是货真价实的古典芭蕾……！",
                "1_H311": "滑行般的步法、雕塑般完美的姿态，还有和御主完成的大双人舞！",
                "1_H312": "好羡慕啊……好漂亮啊……比Melt还要可爱一百倍呢……"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "沉睡的荆棘！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "会稍微刺一下哦？"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "包裹起来，发光！"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "美梦就做到这里吧！"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "公主编码，开始。",
                "2_B051": "荆棘之爪，冰霜之风。花苞之中是童话中的受难。",
                "2_B052": "品尝吧！",
                "2_B053": "纵使爱会招致苦难！"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "就由我来奉陪吧。"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "贵安。"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "还请手下留情…… 咦，被拜托的应该是我吗？"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "我要端庄优雅地战斗。因为我是公主嘛！"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "应该算是一场……华丽的胜利吧…… 您可以夸奖我吗，御主？"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "强大是理所当然的。 实现梦想的身姿可不会输给别人哦！"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "呜……！"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "不要妨碍我……！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "那个……我有点累了，可以去林中小屋睡一会儿吗……？"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "穿着礼服担任坦克位，这也太没人性了吧……"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "哎呀。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "哦呵呵。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "可以吗？"
            }
        },
        "2_B2010": {
            "name": "アタック 9",
            "text": {
                "2_B2010": "得先让你遭遇船难才行……！"
            }
        },
        "2_B2020": {
            "name": "アタック 10",
            "text": {
                "2_B2020": "温柔地……嘿！"
            }
        },
        "2_B2030": {
            "name": "アタック 11",
            "text": {
                "2_B2030": "这种程度应该没关系吧！"
            }
        },
        "2_B2080": {
            "name": "スキル 7",
            "text": {
                "2_B2080": "以我的方式！"
            }
        },
        "2_B2090": {
            "name": "スキル 8",
            "text": {
                "2_B2090": "全部击溃！"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "如鲜花般美丽。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "好、好的！　要全力以赴吧！？"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "原来，你不知道鲜花有多可怕啊……"
            }
        },
        "2_B2410": {
            "name": "アタック 12",
            "text": {
                "2_B2410": "这是我送给你的礼物！"
            }
        },
        "2_B2420": {
            "name": "アタック 13",
            "text": {
                "2_B2420": "不能吃剩哦。"
            }
        },
        "2_B2430": {
            "name": "アタック 14",
            "text": {
                "2_B2430": "舒服吗？"
            }
        },
        "2_B2810": {
            "name": "アタック 15",
            "text": {
                "2_B2810": "满意了吗……？"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "拇指姑娘就像这样！"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "呼……"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "现在的我什么都能做到……！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "晚安……"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "随时……都可以……"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "好，开始舞会吧。 ……不过得赶在王子殿下到来前结束才行！"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "虽然赢了，可总觉得缺了点什么…… 附近有没有七个小矮人呢……？"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "我好像有些太安分了……大家，对不起……"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "越来越兴奋了……！",
                "2_B801": "既然王子殿下不来，那我就主动去见他！",
                "2_B802": "捕获梦境！",
                "2_B803": "浪漫就从这里开始！"
            }
        },
        "2_B810": {
            "name": "宝具 3",
            "text": {
                "2_B810": "我已经忍耐到极限了！",
                "2_B811": "欺负人的害虫就该这样、这样、这样——！",
                "2_B812": "给我反省！",
                "2_B813": "愤怒Lip惩罚时间！"
            }
        },
        "2_B820": {
            "name": "宝具 4",
            "text": {
                "2_B820": "公主编码，开始。",
                "2_B821": "荆棘之爪，冰霜之风。花苞之中是童话中的受难哦。",
                "2_B822": "仔细品尝吧！",
                "2_B823": "纵使爱会招致苦难！"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "明天再来吧！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "任命你！"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "我会让你变得更强哦。"
            }
        },
        "2_B910": {
            "name": "アタック 6",
            "text": {
                "2_B910": "就在那里吧！"
            }
        },
        "2_B920": {
            "name": "アタック 7",
            "text": {
                "2_B920": "跳入水中！"
            }
        },
        "2_B930": {
            "name": "アタック 8",
            "text": {
                "2_B930": "王子殿下到手啦～！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "不是毒苹果，而是好吃的种火呢。",
                "2_G011": "当然，我会一点不剩地全部吃掉♡"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "礼裙！　这是公主殿下的礼裙吧！？",
                "2_G041": "好开心啊……我还以为在艺术体操之后就会从梦中醒来，我也会变回原来的自己……",
                "2_G042": "没想到非但没有醒来，甚至还实现了梦想。",
                "2_G043": "啊，不过真的可以穿成这样战斗吗……？",
                "2_G044": "我得抓紧思考不会弄破裙子的战斗方式才行……！"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "这真是个十分、十分快乐，美妙到就像在做梦的夏天呢。",
                "2_G051": "请容我再次谢谢您。",
                "2_G052": "虽然我总是在犯错，但为了回应您的声援，我不知不觉变成了全新的自己。",
                "2_G053": "我非常喜欢现在的这个我。",
                "2_G054": "所以今后也请您继续声援常常偷懒的我吧，御主。"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "以随处可见的庶民而言，你的这份贡品倒是不错。",
                "2_G111": "值得夸奖哦，御主。",
                "2_G112": "……不对，这就不是公主，而是女王了吧！？",
                "2_G113": "我又被ＢＢ骗了～～！"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "谢谢，向您表示感谢，御主。",
                "2_G121": "……我表现得还可以吗？",
                "2_G122": "果然还是这种语气比较适合我呢！"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "我一直在热切地期待着这一天！",
                "2_H011": "今天是您的生日吧！",
                "2_H012": "没错，我已经不是只会做出敲都敲不碎饼干的那个我了。",
                "2_H013": "既然不擅长烹饪，就干脆放弃，改用体验来决胜负！",
                "2_H014": "身为御主，肯定少不了带有梦想、希望和一点点可怕的体验吧？",
                "2_H015": "要不要试试结合艺术体操和童话的全新模拟呢？"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "咦，活动已经开始了吗？",
                "2_H021": "御主，您知道吗？"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "唉……休息时间结束了呢……",
                "2_H031": "不过偷懒可不好呢！　重新振作精神出击吧！"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "我一个人的话就很容易做过火……",
                "2_H041": "所以请尽管向我下达指示哦，御主！"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "虽然称呼有很多种，认真时叫御主，平时加敬称。",
                "2_H051": "然后……两人独处时……",
                "2_H052": "那个……那个……",
                "2_H053": "不行，完全想不出来～！　好想要只属于我的特别称呼啊～～！"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的东西是……那个……",
                "2_H061": "对不起……就算换上了泳装，我最擅长的还是破坏……我觉得特别开心……",
                "2_H062": "不过，我会干掉的只有坏人哦！",
                "2_H063": "毕竟在SAKURA FIVE中能干脆利落破坏并收拾对手的只有我一个嘛！"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "讨厌的东西……",
                "2_H071": "以前我害怕他人的目光，现在则讨厌自己的软弱。",
                "2_H072": "毕竟我不想糟蹋这么可爱的泳装嘛！"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "希望圣杯实现的愿望吗？",
                "2_H081": "如果能有七位左右优秀的侍从，我会很开心的……",
                "2_H082": "哎，有事吗，黑胡子先生。您也想进我的小包吗？"
            }
        },
        "2_H090": {
            "name": "絆Lv.1",
            "text": {
                "2_H090": "好不容易获得了强大的灵基，目标当然也要设定得远大一点才不浪费……",
                "2_H091": "比方说……从坚硬巨大有力气的SAKURA FIVE，改成最可爱的SAKURA FIVE……？",
                "2_H092": "啊哇哇……刚才那个只是目标，只是目标啦！"
            }
        },
        "2_H100": {
            "name": "絆Lv.2",
            "text": {
                "2_H100": "购物的时候就交给我吧！",
                "2_H101": "不管有多少行李，我都能收起来！",
                "2_H102": "别说店里的所有商品了，我甚至可以连整家店都一并收起来哦♡"
            }
        },
        "2_H110": {
            "name": "絆Lv.3",
            "text": {
                "2_H110": "我之所以喜欢艺术体操，大概是由于对自由身体的向往吧。",
                "2_H111": "我现在偶尔也会想……如果自己能像Melt那样苗条就好了，但我就是我。",
                "2_H112": "而且双手稳定之后，很多大胆的动作也能做到了，总觉得就像打开了新大门呢！"
            }
        },
        "2_H120": {
            "name": "絆Lv.4",
            "text": {
                "2_H120": "魔镜啊魔镜，世界上最美丽的～～",
                "2_H121": "没错，是Passionlip女王！",
                "2_H122": "胆敢反对的坏御主就会被拎起来丢进小包里～！",
                "2_H123": "呵呵。不断重现童话故事之后，对反派也产生兴趣了呢。",
                "2_H124": "在成为这个灵基以后，我一直在笑呢。"
            }
        },
        "2_H130": {
            "name": "絆Lv.5",
            "text": {
                "2_H130": "从前的我，一直渴望得到只对我一个人温柔的理想王子殿下。",
                "2_H131": "可那其实只是幼稚的自我陶醉，我只是希望有人保护没用的自己罢了。",
                "2_H132": "时而鼓励，时而纠正，时而相互扶持。这才是真正的恋人，真正的王子殿下。",
                "2_H133": "虽然这份感情或许会随着这个灵基一起消失。",
                "2_H134": "但我有成为配得上您的公主吗？"
            }
        },
        "2_H320": {
            "name": "会話 4",
            "text": {
                "2_H320": "不会吧，还有泳装的祈荒吗！？",
                "2_H321": "那算什么……以人鱼公主而言，各方面都太大了吧？",
                "2_H322": "她更该去演杰克与魔豆才对。",
                "2_H323": "咦？　真面目其实是名为蜃的龙？",
                "2_H324": "那就没问题了！　童话世界保住啦！"
            }
        },
        "2_H330": {
            "name": "会話 5",
            "text": {
                "2_H330": "罗宾先生，您为什么会穿着泳装啊？",
                "2_H331": "森林猎人可是您为数不多的优点，一离开森林，就只是个轻浮的帅哥了吧？",
                "2_H332": "请赶快回去，重新思考自己的角色啦。"
            }
        },
        "2_H340": {
            "name": "会話 6",
            "text": {
                "2_H340": "伊丽莎白小姐成了灰姑娘的从者？",
                "2_H341": "呵呵，是种全新的诠释呢。",
                "2_H342": "下次务必和我一起组队，说不定还能为舞会做预演呢。",
                "2_H343": "啊，对了。我心目中倒是有继母和坏姐姐的人选，要听吗？"
            }
        },
        "2_H350": {
            "name": "会話 7",
            "text": {
                "2_H350": "呀啊啊，浓雾与镜子的仙境，童话力简直不是一个等级的——！",
                "2_H351": "那就是现代的魔女吧！",
                "2_H352": "虽然浑身散发着冷静干练的气场，但骨子里一定是个嫌麻烦的人！",
                "2_H353": "我们是同类，所以我能看出来！"
            }
        },
        "2_H360": {
            "name": "会話 8",
            "text": {
                "2_H360": "童谣……在这个世界也呈现那种形态呢。",
                "2_H361": "虽然我也只是通过母亲的数据了解的……",
                "2_H362": "但真希望那个孩子能得到幸福……"
            }
        },
        "2_H370": {
            "name": "会話 9",
            "text": {
                "2_H370": "呜哇，呜哇啊啊啊啊！",
                "2_H371": "好厉害，刚才走廊里出现了一个微小特异点！",
                "2_H372": "有位王子殿下，是真真正正理想的王子殿下，还温柔地朝我使了个眼色呢！",
                "2_H373": "虽然现实中的王子殿下是御主……",
                "2_H374": "那个，我可以去观察一下理想的王子殿下吗？",
                "2_H375": "他好像叫奥伯龙先生……"
            }
        },
        "2_H380": {
            "name": "会話 10",
            "text": {
                "2_H380": "雨之魔女……",
                "2_H381": "据说她是位古老妖精的公主殿下。",
                "2_H382": "温柔又体贴，就算我犯了错，也不会露出厌烦的表情，而是陪着我一起收拾残局。",
                "2_H383": "如果我也能成为那样的公主就好了……"
            }
        },
        "2_H390": {
            "name": "会話 11",
            "text": {
                "2_H390": "魔女摩根。听说她曾是统治妖精国的女王。",
                "2_H391": "冰冷彻骨的眼神，以及完全不体贴别人的方面，简直和Melt一模一样，很可怕……",
                "2_H392": "可她与哈贝特洛特小姐的关系很好吧……",
                "2_H393": "到底是为什么呢……"
            }
        },
        "2_H400": {
            "name": "会話 12",
            "text": {
                "2_H400": "无论发生什么我都必须守护的人虽然是御主，但排在第二位的或许就是哈贝特洛特小姐了。",
                "2_H401": "在迦勒底里，只有她会细心保养我的嘴唇。",
                "2_H402": "还说“这么漂亮，藏起来太浪费了”。",
                "2_H403": "她的服饰制作技术固然高超，但最美好的还是那种体贴呢。"
            }
        }
    },
    "ChrVoice_ids": [
        "106300",
        "109829880"
    ]
}