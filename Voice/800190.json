{
    "id": 800190,
    "collectionNo": 0,
    "name": "マシュ・キリエライト",
    "voices": {
        "17_B010": {
            "name": "アタック 1",
            "text": {
                "17_B010": "我正在进行未来观测！"
            }
        },
        "17_B020": {
            "name": "アタック 2",
            "text": {
                "17_B020": "目标，绝不会失手！"
            }
        },
        "17_B030": {
            "name": "アタック 3",
            "text": {
                "17_B030": "盾，消散！"
            }
        },
        "17_B040": {
            "name": "エクストラアタック",
            "text": {
                "17_B040": "全力，一直线！"
            }
        },
        "17_B050": {
            "name": "宝具",
            "text": {
                "17_B050": "真名，刻铭。",
                "17_B051": "那是连接了诸多世界，诸多梦想的吾等之誓。",
                "17_B052": "证明吧！　构筑希望的人理之盾！",
                "17_B053": "这是连接众多世界、",
                "17_B054": "众多梦想的吾等之誓。",
                "17_B055": "证明吧，",
                "17_B056": "『构筑希望的人理之盾』！"
            }
        },
        "17_B080": {
            "name": "スキル 1",
            "text": {
                "17_B080": "领域装甲，展开！"
            }
        },
        "17_B090": {
            "name": "スキル 2",
            "text": {
                "17_B090": "生命距离弹，简易测定！"
            }
        },
        "17_B100": {
            "name": "開始 1",
            "text": {
                "17_B100": "心情冷静，思维清晰…… 好！　圣骑士盾兵，出击！"
            }
        },
        "17_B110": {
            "name": "開始 2",
            "text": {
                "17_B110": "灵基阶段，抵达最终色彩。 别以为你能贯穿这面盾！"
            }
        },
        "17_B120": {
            "name": "勝利 1",
            "text": {
                "17_B120": "周围的敌对、危险反应，全部消除。 呼——我们胜利了，御主！"
            }
        },
        "17_B130": {
            "name": "勝利 2",
            "text": {
                "17_B130": "这面盾是迦勒底之旅的成果，是我战斗意志的结晶。 可不能被轻易击破！"
            }
        },
        "17_B140": {
            "name": "ダメージ 2",
            "text": {
                "17_B140": "不算什么！"
            }
        },
        "17_B150": {
            "name": "ダメージ 1",
            "text": {
                "17_B150": "盾，展开！"
            }
        },
        "17_B160": {
            "name": "戦闘不能 1",
            "text": {
                "17_B160": "我一定会回来的！ 我的心还没有屈服……！"
            }
        },
        "17_B170": {
            "name": "戦闘不能 2",
            "text": {
                "17_B170": "暂时撤退！ 敌方战力的分析就麻烦您了！"
            }
        },
        "17_B180": {
            "name": "コマンドカード 1",
            "text": {
                "17_B180": "是！"
            }
        },
        "17_B190": {
            "name": "コマンドカード 2",
            "text": {
                "17_B190": "好～！"
            }
        },
        "17_B200": {
            "name": "コマンドカード 3",
            "text": {
                "17_B200": "非常准确呢！"
            }
        },
        "17_B2010": {
            "name": "アタック 10",
            "text": {
                "17_B2010": "哈—！"
            }
        },
        "17_B2020": {
            "name": "アタック 11",
            "text": {
                "17_B2020": "光辉的银之臂！"
            }
        },
        "17_B2030": {
            "name": "アタック 12",
            "text": {
                "17_B2030": "锋利，豪迈！"
            }
        },
        "17_B210": {
            "name": "宝具カード",
            "text": {
                "17_B210": "请交给我吧，御主！"
            }
        },
        "17_B220": {
            "name": "宝具カード",
            "text": {
                "17_B220": "请好好看着，所长！"
            }
        },
        "17_B230": {
            "name": "宝具カード",
            "text": {
                "17_B230": "圣剑，拔刀！"
            }
        },
        "17_B2410": {
            "name": "アタック 13",
            "text": {
                "17_B2410": "上！　下！"
            }
        },
        "17_B2420": {
            "name": "アタック 14",
            "text": {
                "17_B2420": "呼！呀—！"
            }
        },
        "17_B2430": {
            "name": "アタック 15",
            "text": {
                "17_B2430": "挥挥，挥！"
            }
        },
        "17_B250": {
            "name": "宝具カード",
            "text": {
                "17_B250": "即便，这不是正确的答案。"
            }
        },
        "17_B2810": {
            "name": "アタック 16",
            "text": {
                "17_B2810": "掀起，风暴！"
            }
        },
        "17_B2820": {
            "name": "アタック 17",
            "text": {
                "17_B2820": "休想逃跑！"
            }
        },
        "17_B2830": {
            "name": "アタック 18",
            "text": {
                "17_B2830": "坠落！"
            }
        },
        "17_B410": {
            "name": "アタック 4",
            "text": {
                "17_B410": "一、二！"
            }
        },
        "17_B420": {
            "name": "アタック 5",
            "text": {
                "17_B420": "这样，如何！"
            }
        },
        "17_B430": {
            "name": "アタック 6",
            "text": {
                "17_B430": "封印，控制！"
            }
        },
        "17_B440": {
            "name": "エクストラアタック",
            "text": {
                "17_B440": "强大、沉重、无所畏惧！"
            }
        },
        "17_B480": {
            "name": "スキル 3",
            "text": {
                "17_B480": "配合时机！"
            }
        },
        "17_B490": {
            "name": "スキル 4",
            "text": {
                "17_B490": "赌上盾兵之名！"
            }
        },
        "17_B500": {
            "name": "開始 3",
            "text": {
                "17_B500": "我会为了我想要的东西……！ 请指示，御主！"
            }
        },
        "17_B800": {
            "name": "宝具",
            "text": {
                "17_B800": "纵然傲慢，也要高声宣告。",
                "17_B801": "为了有朝一日能偿还失去的东西！",
                "17_B802": "引导之星啊，化为力量吧！"
            }
        },
        "17_B810": {
            "name": "宝具",
            "text": {
                "17_B810": "反悖论构造体，形成！",
                "17_B811": "刻寿测量针，设定。记录计数，由悖论转变为真理！",
                "17_B812": "阶层安全锁。",
                "17_B813": "准备发射！",
                "17_B814": "印证希望的人理之剑！",
                "17_B815": "成就标尺，设定。",
                "17_B816": "记录计数器，从悖论转向真说。"
            }
        },
        "17_B820": {
            "name": "宝具",
            "text": {
                "17_B820": "领域装甲，解除。",
                "17_B821": "将灵基形态换装为炮身形态，生命距离弹，装填！",
                "17_B822": "——不会失手！",
                "17_B823": "我们，要前往未来！"
            }
        },
        "17_B840": {
            "name": "エクストラアタック",
            "text": {
                "17_B840": "基列莱特～……",
                "17_B841": "究极，阻截——！"
            }
        },
        "17_B880": {
            "name": "スキル 5",
            "text": {
                "17_B880": "没关系……放心吧。"
            }
        },
        "17_B890": {
            "name": "スキル 6",
            "text": {
                "17_B890": "我获得勇气了！"
            }
        },
        "17_B910": {
            "name": "アタック 7",
            "text": {
                "17_B910": "盾，失衡！"
            }
        },
        "17_B920": {
            "name": "アタック 8",
            "text": {
                "17_B920": "从正面，重击！"
            }
        },
        "17_B930": {
            "name": "アタック 9",
            "text": {
                "17_B930": "预备！"
            }
        },
        "17_G010": {
            "name": "レベルアップ",
            "text": {
                "17_G010": "请交给我吧！",
                "17_G011": "我会承受住所有的攻击！"
            }
        },
        "17_G110": {
            "name": "レベルアップ",
            "text": {
                "17_G110": "等级提升了！",
                "17_G111": "不只是防御，攻击也请交给我吧！"
            }
        },
        "17_G120": {
            "name": "レベルアップ",
            "text": {
                "17_G120": "盾牌坚硬而灵活，炮击沉重而坚定。",
                "17_G121": "虽然学会的东西变多是很不容易的，但我会努力的。"
            }
        },
        "17_H010": {
            "name": "誕生日",
            "text": {
                "17_H010": "祝您生日快乐。",
                "17_H011": "这是一件非常值得庆祝的事，是否该设立一个举国欢庆的节日呢？"
            }
        },
        "17_H020": {
            "name": "イベント開催中",
            "text": {
                "17_H020": "确认特殊事象发生。前辈，赶紧走吧！",
                "17_H021": "让我们干劲十足地赢得稀有道具吧！"
            }
        },
        "17_H030": {
            "name": "会話 1",
            "text": {
                "17_H030": "出击准备就绪！ 请交给圣骑士吧！"
            }
        },
        "17_H040": {
            "name": "会話 2",
            "text": {
                "17_H040": "我迄今为止和前辈完成了许多作战。",
                "17_H041": "今后无论遇到什么样的作战，我都无所畏惧了。"
            }
        },
        "17_H050": {
            "name": "会話 3",
            "text": {
                "17_H050": "达·芬奇亲说，你们间的眼神交流已经很完美了。",
                "17_H051": "虽，虽然不太明白理由，但会有点不好意思呢。"
            }
        },
        "17_H060": {
            "name": "好きなこと",
            "text": {
                "17_H060": "喜欢的东西没有改变。",
                "17_H061": "天空的色彩和大地的气味。",
                "17_H062": "还有梦想明天。"
            }
        },
        "17_H3070": {
            "name": "嫌いなこと",
            "text": {
                "17_H3070": "讨厌的东西……",
                "17_H3071": "以前我并不清楚，但现在我能明确地说出来。",
                "17_H3072": "而且我也明白了即便讨厌，也未必需要敌对。",
                "17_H3073": "……是的。她大概又要讨厌我了吧。"
            }
        },
        "17_H9000": {
            "name": "霊衣について",
            "text": {
                "17_H9000": "圣骑士……",
                "17_H9001": "这个称号对我来说过于崇高，但我会努力不辜负这个名字的。",
                "17_H9002": "虽然灵基提升后会加重对御主的负担，但今后也请多关照。"
            }
        },
        "20_B010": {
            "name": "アタック 1 常夏の水着Ver.03",
            "text": {
                "20_B010": "恕我从上方冒犯了！"
            },
            "raw_text": {
                "20_B010": "上から失礼。"
            }
        },
        "20_B020": {
            "name": "アタック 2 常夏の水着Ver.03",
            "text": {
                "20_B020": "应该就在这附近。"
            },
            "raw_text": {
                "20_B020": "この辺りのはず。"
            }
        },
        "20_B030": {
            "name": "アタック 3 常夏の水着Ver.03",
            "text": {
                "20_B030": "哈、呀！"
            },
            "raw_text": {
                "20_B030": "えい、やあ。"
            }
        },
        "20_B040": {
            "name": "エクストラアタック 1 常夏の水着Ver.03",
            "text": {
                "20_B040": "结账请使用QP。"
            },
            "raw_text": {
                "20_B040": "お支払いはキューピーで。"
            }
        },
        "20_B050": {
            "name": "宝具 1 常夏の水着Ver.03",
            "text": {
                "20_B050": "我们的青空绝不会败给夏日的暴风雨。",
                "20_B051": "唯独这里，必须要死守住！",
                "20_B052": "冲啊—！",
                "20_B053": "夏日迦勒底！"
            },
            "raw_text": {
                "20_B050": "私たちの青空は、夏の嵐にも負けません。",
                "20_B051": "ここだけ神明改定です。",
                "20_B052": "行くぞー。",
                "20_B053": "サマー！カルデアス。"
            }
        },
        "20_B080": {
            "name": "スキル 1 常夏の水着Ver.03",
            "text": {
                "20_B080": "确认指令。"
            },
            "raw_text": {
                "20_B080": "オーダー確認します。"
            }
        },
        "20_B090": {
            "name": "スキル 2 常夏の水着Ver.03",
            "text": {
                "20_B090": "献上这个夏天最棒的——"
            },
            "raw_text": {
                "20_B090": "この夏で一番の。"
            }
        },
        "20_B100": {
            "name": "開始 1 常夏の水着Ver.03",
            "text": {
                "20_B100": "准备体操已经做完了。无论怎样的海浪都请交给我吧。"
            },
            "raw_text": {
                "20_B100": "準備体操は済ませています。どんな波でもお任せください。"
            }
        },
        "20_B110": {
            "name": "開始 2 常夏の水着Ver.03",
            "text": {
                "20_B110": "是的，大家的防波堤——盾兵帕拉汀，出击！"
            },
            "raw_text": {
                "20_B110": "そう、皆さんの防波堤 シールダー パラディン 出撃します。"
            }
        },
        "20_B120": {
            "name": "勝利 1 常夏の水着Ver.03",
            "text": {
                "20_B120": "海滩的清扫工作完成了。接下来就是继续购物了呢，前辈。"
            },
            "raw_text": {
                "20_B120": "浜辺の清掃完了しました。では買い物の続きですね。先輩。"
            }
        },
        "20_B130": {
            "name": "勝利 2 常夏の水着Ver.03",
            "text": {
                "20_B130": "呵呵，哪怕身穿泳装，帕拉丁也是绝不会输的。啊，虽然 Cost 可能会有点高就是了。"
            },
            "raw_text": {
                "20_B130": "ふふっ、水着であってもパラディーンは負けないのです。あ、コストは高いかもですが。"
            }
        },
        "20_B150": {
            "name": "ダメージ 1 常夏の水着Ver.03",
            "text": {
                "20_B150": "我、我会努力的。"
            },
            "raw_text": {
                "20_B150": "が頑張ります。"
            }
        },
        "20_B160": {
            "name": "戦闘不能 1 常夏の水着Ver.03",
            "text": {
                "20_B160": "体力分配失误了。我去稍微休息一下哦。"
            },
            "raw_text": {
                "20_B160": "スタミナ調整に失敗しました。少し休んできますね。"
            }
        },
        "20_B170": {
            "name": "戦闘不能 2 常夏の水着Ver.03",
            "text": {
                "20_B170": "怎么会这样。我还想更活跃一些呢。"
            },
            "raw_text": {
                "20_B170": "なんということでしょう。もっと活躍したかったな。"
            }
        },
        "20_B180": {
            "name": "コマンドカード 1 常夏の水着Ver.03",
            "text": {
                "20_B180": ""
            },
            "raw_text": {
                "20_B180": "はい。"
            }
        },
        "20_B190": {
            "name": "コマンドカード 2 常夏の水着Ver.03",
            "text": {
                "20_B190": "十分乐意。"
            },
            "raw_text": {
                "20_B190": "喜んで"
            }
        },
        "20_B200": {
            "name": "コマンドカード 3 常夏の水着Ver.03",
            "text": {
                "20_B200": "那是自然的。"
            },
            "raw_text": {
                "20_B200": "もちろんです。"
            }
        },
        "20_B2010": {
            "name": "アタック 10 常夏の水着Ver.03",
            "text": {
                "20_B2010": "稍微收敛一点。"
            },
            "raw_text": {
                "20_B2010": "控えめに。"
            }
        },
        "20_B2020": {
            "name": "アタック 11 常夏の水着Ver.03",
            "text": {
                "20_B2020": "请您赶紧回去吧。"
            },
            "raw_text": {
                "20_B2020": "もう、お帰りください。"
            }
        },
        "20_B2030": {
            "name": "アタック 12 常夏の水着Ver.03",
            "text": {
                "20_B2030": "不会手下留情！"
            },
            "raw_text": {
                "20_B2030": "活動はありません。"
            }
        },
        "20_B210": {
            "name": "宝具カード 1 常夏の水着Ver.03",
            "text": {
                "20_B210": "让您久等了。"
            },
            "raw_text": {
                "20_B210": "お待たせしました。"
            }
        },
        "20_B220": {
            "name": "宝具カード 2 常夏の水着Ver.03",
            "text": {
                "20_B220": "请看着我吧，御主。"
            },
            "raw_text": {
                "20_B220": "見ていてくださいね、マスター。"
            }
        },
        "20_B230": {
            "name": "宝具カード 3 常夏の水着Ver.03",
            "text": {
                "20_B230": "虽说是度假胜地，但也请恕我失礼了。"
            },
            "raw_text": {
                "20_B230": "リゾート地ですが、ご容赦を。"
            }
        },
        "20_B2410": {
            "name": "アタック 13 常夏の水着Ver.03",
            "text": {
                "20_B2410": "这是套餐服务！"
            },
            "raw_text": {
                "20_B2410": "セットメニューです。"
            }
        },
        "20_B2420": {
            "name": "アタック 14 常夏の水着Ver.03",
            "text": {
                "20_B2420": "要保持帅气！"
            },
            "raw_text": {
                "20_B2420": "スタイリッシュに。"
            }
        },
        "20_B2430": {
            "name": "アタック 15 常夏の水着Ver.03",
            "text": {
                "20_B2430": "真开心呢。"
            },
            "raw_text": {
                "20_B2430": "楽しいですね。"
            }
        },
        "20_B250": {
            "name": "宝具カード 4 常夏の水着Ver.03",
            "text": {
                "20_B250": "这可没有违反枪刀法哦。"
            },
            "raw_text": {
                "20_B250": "銃刀法違反ではありません。"
            }
        },
        "20_B2810": {
            "name": "アタック 16 常夏の水着Ver.03",
            "text": {
                "20_B2810": "要旋转喽～！"
            },
            "raw_text": {
                "20_B2810": "回りまーす。"
            }
        },
        "20_B2820": {
            "name": "アタック 17 常夏の水着Ver.03",
            "text": {
                "20_B2820": "切不可大意。"
            },
            "raw_text": {
                "20_B2820": "油断禁物です。"
            }
        },
        "20_B2830": {
            "name": "アタック 18 常夏の水着Ver.03",
            "text": {
                "20_B2830": "出乎您的意料了吗？"
            },
            "raw_text": {
                "20_B2830": "想定外でしたか。"
            }
        },
        "20_B410": {
            "name": "アタック 4 常夏の水着Ver.03",
            "text": {
                "20_B410": "恕我从侧面冒犯了！"
            },
            "raw_text": {
                "20_B410": "横から失礼。"
            }
        },
        "20_B420": {
            "name": "アタック 5 常夏の水着Ver.03",
            "text": {
                "20_B420": "这是您掉的东西。"
            },
            "raw_text": {
                "20_B420": "落とし物です。"
            }
        },
        "20_B430": {
            "name": "アタック 6 常夏の水着Ver.03",
            "text": {
                "20_B430": "不用找零了。"
            },
            "raw_text": {
                "20_B430": "お釣りは結構です。"
            }
        },
        "20_B440": {
            "name": "エクストラアタック 2 常夏の水着Ver.03",
            "text": {
                "20_B440": "我要赶去打工了。"
            },
            "raw_text": {
                "20_B440": "アルバイトに遅れますので。"
            }
        },
        "20_B480": {
            "name": "スキル 3 常夏の水着Ver.03",
            "text": {
                "20_B480": "您做好觉悟了吗？"
            },
            "raw_text": {
                "20_B480": "覚悟はお済みですか。"
            }
        },
        "20_B490": {
            "name": "スキル 4 常夏の水着Ver.03",
            "text": {
                "20_B490": "就由我来将他们扫平吧。"
            },
            "raw_text": {
                "20_B490": "蹴散らしてみせましょう。"
            }
        },
        "20_B500": {
            "name": "開始 3 常夏の水着Ver.03",
            "text": {
                "20_B500": "因为接下来还有兼职，我们就在五分钟内解决吧。"
            },
            "raw_text": {
                "20_B500": "アルバイトがありますので、五分以内に済ませましょう。"
            }
        },
        "20_B800": {
            "name": "宝具 2 常夏の水着Ver.03",
            "text": {
                "20_B800": "阿卡迪亚展开。",
                "20_B801": "在此树立理想乡的旗帜吧。",
                "20_B802": "没错，这是第三套泳装灵衣！"
            },
            "raw_text": {
                "20_B800": "アルカディア、展開。",
                "20_B801": "ここに理想郷の旗を立てましょう。",
                "20_B802": "そう！水着レイ、３着目です。"
            }
        },
        "20_B810": {
            "name": "宝具 3 常夏の水着Ver.03",
            "text": {
                "20_B810": "南海专用炮身形成。",
                "20_B811": "火器延长术式装填。",
                "20_B812": "目标，由障碍转为灾害。",
                "20_B813": "绝不让你妨碍……",
                "20_B814": "夏日守护·基里莱特！"
            },
            "raw_text": {
                "20_B810": "南海専用方針、形成。",
                "20_B811": "火気延長術式、装填。",
                "20_B812": "大将、障害から災害に。",
                "20_B813": "邪魔はさせない。",
                "20_B814": "サマーキープ！キリエライト。"
            }
        },
        "20_B820": {
            "name": "宝具 4 常夏の水着Ver.03",
            "text": {
                "20_B820": "防守就到此为止了。",
                "20_B821": "夏日转瞬即逝，要拉开与竞争对手的差距。",
                "20_B822": "推不动的话，就直接压倒！"
            },
            "raw_text": {
                "20_B820": "防衛はここまでです。",
                "20_B821": "夏は一瞬、ライバルに差をつけます。",
                "20_B822": "押してもダメなら、押し倒せー。"
            }
        },
        "20_B840": {
            "name": "エクストラアタック 3 常夏の水着Ver.03",
            "text": {
                "20_B840": "海滩的和平由我来守护。"
            },
            "raw_text": {
                "20_B840": "浜辺の平和は私が守る。"
            }
        },
        "20_B880": {
            "name": "スキル 5 常夏の水着Ver.03",
            "text": {
                "20_B880": "是预约过的客人呢。"
            },
            "raw_text": {
                "20_B880": "ご予約のお客様ですね。"
            }
        },
        "20_B890": {
            "name": "スキル 6 常夏の水着Ver.03",
            "text": {
                "20_B890": "就算是特大份也尽管放马过来吧。"
            },
            "raw_text": {
                "20_B890": "大盛りでもどんと来い。"
            }
        },
        "20_B910": {
            "name": "アタック 7 常夏の水着Ver.03",
            "text": {
                "20_B910": "请不要胡乱动弹。"
            },
            "raw_text": {
                "20_B910": "暴れないで。"
            }
        },
        "20_B920": {
            "name": "アタック 8 常夏の水着Ver.03",
            "text": {
                "20_B920": "贯穿吧！"
            },
            "raw_text": {
                "20_B920": "貫いて。"
            }
        },
        "20_B930": {
            "name": "アタック 9 常夏の水着Ver.03",
            "text": {
                "20_B930": ""
            },
            "raw_text": {
                "20_B930": "えへっ。"
            }
        },
        "20_G010": {
            "name": "レベルアップ 1 常夏の水着Ver.03",
            "text": {
                "20_G010": "请交给我吧。所有的攻击我都会替您接下的。",
                "20_G011": ""
            },
            "raw_text": {
                "20_G010": "お任せください。全ての攻撃を受けてみせます。",
                "20_G011": ""
            }
        },
        "20_G060": {
            "name": "霊衣開放 常夏の水着Ver.03",
            "text": {
                "20_G060": "感觉怎么样，前辈？这是哈贝特洛特小姐为我制作的、也很适合帕拉汀灵基的泳装。既优雅又清凉，同时还不失凛冽，是非常棒的设计。光是穿在身上就感到欢欣雀跃，比以往任何时候都更加期待夏日的大海了呢。",
                "20_G061": "",
                "20_G062": "",
                "20_G063": ""
            },
            "raw_text": {
                "20_G060": "どうですか？先輩 パラディーンの冷気にも合う水着をハベとロットさんが作ってくれました。優雅で涼しげ、それでいて 凛々しい 素晴らしいデザインです。着ているだけで心が弾むというか、今まで以上に 夏の海が楽しみになってきました。",
                "20_G061": "",
                "20_G062": "",
                "20_G063": ""
            }
        },
        "20_G110": {
            "name": "レベルアップ 2 常夏の水着Ver.03",
            "text": {
                "20_G110": "等级提升了。不仅是防御，攻击也请放心交给我吧。",
                "20_G111": ""
            },
            "raw_text": {
                "20_G110": "レベルアップです。防御だけでなく 攻撃もお任せください。",
                "20_G111": ""
            }
        },
        "20_G120": {
            "name": "レベルアップ 3 常夏の水着Ver.03",
            "text": {
                "20_G120": "盾牌要坚固且富有韧性。炮击要沉重且坚定不移。要掌握的东西变多了虽然很不容易，但我会加油的。",
                "20_G121": ""
            },
            "raw_text": {
                "20_G120": "盾は固くしなやかに。 砲撃は重く 揺るぎなく。 習得することが増えて大変ですが、頑張ります。",
                "20_G121": ""
            }
        },
        "20_H9000": {
            "name": "霊衣について 常夏の水着Ver.03",
            "text": {
                "20_H9000": "‘难得有这机会，就做成和奥尔加玛丽社长同款的吧。’——这是我从克里恩小姐那里收到的帽子。高雅感大幅提升了呢。我是不是看起来也稍微成熟了一些呢？",
                "20_H9001": "",
                "20_H9002": "",
                "20_H9003": ""
            },
            "raw_text": {
                "20_H9000": "この帽子はせっかくですから、オルガマリー 社長とお揃いにいたしましょうと。 ミスクレーンから頂きました。エレガントさが大アップです。私も少しは大人に見えるでしょうか。",
                "20_H9001": "",
                "20_H9002": "",
                "20_H9003": ""
            }
        }
    },
    "ChrVoice_ids": [
        "800190"
    ]
}