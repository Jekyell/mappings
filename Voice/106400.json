                "0_B430": "哈！嘿！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "Voltic Saber！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "立刻解决掉。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "Steel yourselves！"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "凭你这种货色还不配让我报上名号。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "让你见识一下黑之天然理心流吧。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "你……究竟为谁持剑……？"
            }
        },
        "0_B530": {
            "name": "勝利 4",
            "text": {
                "0_B530": "真遗憾，No escape。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "啧！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": ""
            },
            "raw_text": {
                "0_B550": "げええええええええ。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "别管我，前进……"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "在失去之后，才察觉……"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "【冲田】果然我们还是，",
                "0_B801": "【永仓】得这样才对嘛。",
                "0_B802": "【斋藤】一个个都这样。",
                "0_B803": "【原田】尽是些笨蛋呢。",
                "0_B804": "【藤堂】别把我算进去。",
                "0_B805": "【山南】那么各位。",
                "0_B806": "【土方】上吧。",
                "0_B807": "【近藤】这里……就是新选组啊啊啊！！"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "【近藤】我们铭刻于心的那一个字……",
                "0_B811": "唯有它，是毫无虚伪的真实……",
                "0_B812": "新选组，出阵！",
                "0_B813": "【全体】噢！",
                "0_B814": "【近藤】誓言留于彼方，诚仍在此处。"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "【近藤】大家的性命，",
                "0_B821": "就交给我吧……",
                "0_B822": "新选组，Engage！",
                "0_B823": "【冲田】喝！",
                "0_B824": "【永仓】噢啦！",
                "0_B825": "【斋藤】嘿！",
                "0_B826": "【原田】看招！",
                "0_B827": "【藤堂】喝！",
                "0_B828": "【山南】哈！",
                "0_B829": "【土方】噢噢噢噢噢！",
                "0_B10820": "【近藤】虎徹·BLADE——！"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "翻涌，狂暴吧！　真瓦津日！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "我的诚……"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "我能做到吗。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "接招！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "贯穿！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "Vanquish！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "呜……真瓦津日正在大闹。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "嗯，还能继续提升力量。"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "呵，这样也不错。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "生日什么的，",
                "0_H011": "实在是太无聊了。",
                "0_H012": "有工夫庆祝这种事，还不如去积累一些值得耗费年月的东西呢。",
                "0_H013": "是啊，那就先送你一招天然理心流的剑术吧。",
                "0_H014": "好了，拿起剑来。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "活动吗，",
                "0_H021": "那就准备一下好了。",
                "0_H022": "放心吧，我会把脸遮起来的。",
                "0_H023": "这样就算稍微放纵一点也不会有什么问题。",
                "0_H024": "什么？　你说反而会更显眼？"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "要出门的话，我陪你一起去吧。",
                "0_H031": "毕竟你身边可不太平。",
                "0_H032": "应该不会缺什么兵刃相交的对手。"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主从对我而言已是毫无意义的词语了。",
                "0_H041": "这把黑之剑只为斩杀自己的敌人而存。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "你要是觉得自己能够驾驭我，那就试试看吧。",
                "0_H051": "做不到的话，诚是不会出现在你面前的。"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西？",
                "0_H061": "是血。",
                "0_H062": "……呵，开玩笑啦。",
                "0_H063": "不，是啊，这把黑之虎彻说不定确实在渴求鲜血哦。",
                "0_H064": "要不要试试看呢？"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的东西？",
                "0_H071": "真要说的话，大概是萨摩那帮人吧。",
                "0_H072": "要是你那里有萨摩的人，记得告诉我。",
                "0_H073": "没事，不需要劳烦你动手。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "向圣杯许下的愿望吗。",
                "0_H081": "现在的我什么都没有。",
                "0_H082": "无论地位还是荣誉，对我来说都已是无用之物了。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "这个模样是本不可能存在的我的模样。",
                "0_H091": "连性情也发生了一些变质，还是向坏的方向。",
                "0_H092": "为了你自己，还是最好别随便向我搭话为好。",
                "0_H093": "明白了的话，就从我面前消失吧。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "我的剑能够操控真瓦津日神的力量，",
                "0_H101": "也就是所谓的黑之天然理心流。",
                "0_H102": "而我原本的剑，是啊，大概可以称作白之天然理心流吧。",
                "0_H103": "什么？　黑白合为一体看起来就天下无敌了？",
                "0_H104": "你到底在说些什么莫名其妙的话……"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "什么都不想一心挥剑砍向眼前的敌人。",
                "0_H111": "这就是没有背负之物的身体拥有的轻盈吗。",
                "0_H112": "若只是追求强大，这样或许就够了。",
                "0_H113": "但作为代价，诚也会变得脆弱。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "这个模样的我并不是真正的我。",
                "0_H121": "如果即便如此依然让我挥剑的话，也好。",
                "0_H122": "我就用这把黑之剑，挥出力量与恐惧吧。",
                "0_H123": "没什么，以毒攻毒也不失为一种办法。",
                "0_H124": "呵，若使用得当，我说不定也能成为你的力量。"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "伙伴们甚至没有抛弃变成这副漆黑模样的我。",
                "0_H131": "正是多亏了这种缘分，我如今才能站在你的面前。",
                "0_H132": "这个我原本甚至不可能作为从者存在。",
                "0_H133": "而之所以能在这里，是因为我们铭刻于心的那个字，",
                "0_H134": "没错，因为你也拥有与我们相同的『诚』。",
                "0_H135": "向你致谢，御主。同时……",
                "0_H136": "——诚之誓就在此处。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "问我能不能把拳头塞进嘴里？",
                "0_H171": "无聊，我又不是小孩子，怎么可能拿这种事炫耀嘛。",
                "0_H172": "什么？　是总司说的？",
                "0_H173": "那家伙……"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "岁，接下来要不要和我争当先锋呢？",
                "0_H181": "呵……让我想起当年在多摩闹腾的时候了呢。",
                "0_H182": "不管是狂战士还是别的什么，我还不会输给你哦。"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "平助，事到如今你也不需要什么道歉了吧。",
                "0_H191": "呵……无妨，想什么时候来砍我都行。",
                "0_H192": "不过，下次我也不会手下留情了。这样没问题吧。"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "那位三国无双的英杰——吕布居然也在这里……",
                "0_H201": "没事，我当然没觉得自己能独自与他对抗。",
                "0_H202": "不，如果和那三兄弟一样，由我、岁和总司三个人一起上或许也很有意思。"
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "那把闪闪发光的剑……想必拥有极其惊人的力量吧。",
                "0_H211": "誓约胜利之剑？　骑士王？",
                "0_H212": "不，不是说那个，而是旁边那个戴帽子的。",
                "0_H213": "那她叫什么名字？",
                "0_H214": "什么，女主角……",
                "0_H215": "你说什么？"
            }
        },
        "0_H220": {
            "name": "会話 9",
            "text": {
                "0_H220": "你问我英语是在哪里学的？",
                "0_H221": "呵，我也明白当今已经不是攘夷的时代了。",
                "0_H222": "虽然并不是照岁那家伙说的做，但我也觉得未尝不可接受些新鲜事物。",
                "0_H223": "而且实际说起来，感觉还挺带劲的。"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "我是剑士，近藤勇。",
                "0_S011": "那是什么表情……",
                "0_S012": "是因为这个模样和你听说的相差太大，连话都说不出来了吗。",
                "0_S013": "不过，这也难怪……",
                "0_S014": "但放心吧，这个模样不过是近藤勇这位英灵的一面而已，",
                "0_S015": "如果你确实是值得让我托付剑的人，『诚』终有一天会出现在你的面前。",
                "0_S016": "——但愿如此。"
            }
        },
        "1_B010": {
            "name": "アタック 1",
            "text": {
                "1_B010": "哼！哈！"
            }
        },
        "1_B020": {
            "name": "アタック 2",
            "text": {
                "1_B020": "嘿！"
            }
        },
        "1_B030": {
            "name": "アタック 3",
            "text": {
                "1_B030": "就是那里！"
            }
        },
        "1_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "1_B040": "狮子吼……两断！"
            }
        },
        "1_B050": {
            "name": "宝具 1",
            "text": {
                "1_B050": "【冲田】一番队，报道。",
                "1_B051": "【永仓】二番队，能上。",
                "1_B052": "【斋藤】三番队，同前。",
                "1_B053": "【原田】嗯。",
                "1_B054": "【藤堂】啊。",
                "1_B055": "【山南】交给我吧。",
                "1_B056": "【土方】新选组，出击！",
                "1_B057": "【近藤】吾等齐聚于诚之旗下！"
            }
        },
        "1_B080": {
            "name": "スキル 1",
            "text": {
                "1_B080": "别指望能轻易了事。"
            }
        },
        "1_B090": {
            "name": "スキル 2",
            "text": {
                "1_B090": "做好心理准备了吗？"
            }
        },
        "1_B100": {
            "name": "開始 1",
            "text": {
                "1_B100": "——今夜的虎彻正渴求鲜血。"
            }
        },
        "1_B110": {
            "name": "開始 2",
            "text": {
                "1_B110": "由天然理心流第四代宗家，近藤勇来做你的对手。"
            }
        },
        "1_B120": {
            "name": "勝利 1",
            "text": {
                "1_B120": "纵使时代变迁，吾等之诚也永不磨灭。"
            }
        },
        "1_B130": {
            "name": "勝利 2",
            "text": {
                "1_B130": "天然理心流重实不重名，是刚毅朴实的不败之剑。"
            }
        },
        "1_B140": {
            "name": "ダメージ 2",
            "text": {
                "1_B140": "嗯？"
            }
        },
        "1_B150": {
            "name": "ダメージ 1",
            "text": {
                "1_B150": "竟敢耍这种小把戏……！"
            }
        },
        "1_B160": {
            "name": "戦闘不能 1",
            "text": {
                "1_B160": "就此，告辞……"
            }
        },
        "1_B170": {
            "name": "戦闘不能 2",
            "text": {
                "1_B170": "若能倒在剑下……也算遂了夙愿……"
            }
        },
        "1_B180": {
            "name": "コマンドカード 1",
            "text": {
                "1_B180": "全都明白了。"
            }
        },
        "1_B190": {
            "name": "コマンドカード 2",
            "text": {
                "1_B190": "遵命。"
            }
        },
        "1_B200": {
            "name": "コマンドカード 3",
            "text": {
                "1_B200": "嗯……是这样啊。"
            }
        },
        "1_B2010": {
            "name": "アタック 10",
            "text": {
                "1_B2010": "哼！"
            }
        },
        "1_B2020": {
            "name": "アタック 11",
            "text": {
                "1_B2020": "彻底，打垮！"
            }
        },
        "1_B2030": {
            "name": "アタック 12",
            "text": {
                "1_B2030": "接招接招接招！"
            }
        },
        "1_B210": {
            "name": "宝具カード 1",
            "text": {
                "1_B210": "若我尚有诚，便回应我吧。"
            }
        },
        "1_B220": {
            "name": "宝具カード 2",
            "text": {
                "1_B220": "就在此，高举我们的旗帜吧。"
            }
        },
        "1_B230": {
            "name": "宝具カード 3",
            "text": {
                "1_B230": "……明白了。"
            }
        },
        "1_B2410": {
            "name": "アタック 13",
            "text": {
                "1_B2410": "破绽百出哦。"
            }
        },
        "1_B2420": {
            "name": "アタック 14",
            "text": {
                "1_B2420": "稍微教训你一下吧。"
            }
        },
        "1_B2430": {
            "name": "アタック 15",
            "text": {
                "1_B2430": "无礼之徒！"
            }
        },
        "1_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "1_B2440": "专心致志……喝啊啊啊啊！"
            }
        },
        "1_B250": {
            "name": "宝具カード 4",
            "text": {
                "1_B250": "也就是说，该决胜负了。"
            }
        },
        "1_B410": {
            "name": "アタック 4",
            "text": {
                "1_B410": "怎么了？"
            }
        },
        "1_B420": {
            "name": "アタック 5",
            "text": {
                "1_B420": "在这里。"
            }
        },
        "1_B430": {
            "name": "アタック 6",
            "text": {
                "1_B430": "咿呀！"
            }
        },
        "1_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "1_B440": "作为送你去黄泉的礼物吧！"
            }
        },
        "1_B480": {
            "name": "スキル 3",
            "text": {
                "1_B480": "成为虎彻上的锈斑吧。"
            }
        },
        "1_B490": {
            "name": "スキル 4",
            "text": {
                "1_B490": "堂堂正正一决胜负！"
            }
        },
        "1_B500": {
            "name": "開始 3",
            "text": {
                "1_B500": "那你究竟有几分本事呢。就让我来领教一下阁下的剑吧。"
            }
        },
        "1_B510": {
            "name": "開始 4",
            "text": {
                "1_B510": "新选组局长，近藤勇，出击！"
            }
        },
        "1_B520": {
            "name": "勝利 3",
            "text": {
                "1_B520": "退下！　此乃吾之主上的面前！"
            }
        },
        "1_B530": {
            "name": "勝利 4",
            "text": {
                "1_B530": "解决了吗。你似乎沾上太多鲜血了啊，虎彻。"
            }
        },
        "1_B540": {
            "name": "ダメージ 4",
            "text": {
                "1_B540": "可恶！？"
            }
        },
        "1_B550": {
            "name": "ダメージ 3",
            "text": {
                "1_B550": "唔哦哦哦！"
            }
        },
        "1_B560": {
            "name": "戦闘不能 3",
            "text": {
                "1_B560": "梦之……终结吗。"
            }
        },
        "1_B570": {
            "name": "戦闘不能 4",
            "text": {
                "1_B570": "去吧，跨过我的尸体……"
            }
        },
        "1_B800": {
            "name": "宝具 2",
            "text": {
                "1_B800": "【冲田】果然我们还是，",
                "1_B801": "【永仓】得这样才对嘛。",
                "1_B802": "【斋藤】一个个都这样。",
                "1_B803": "【原田】尽是些笨蛋呢。",
                "1_B804": "【藤堂】别把我算进去。",
                "1_B805": "【山南】那么各位。",
                "1_B806": "【土方】上吧。",
                "1_B807": "【近藤】新选组……在此处！"
            }
        },
        "1_B810": {
            "name": "宝具 3",
            "text": {
                "1_B810": "【近藤】我们铭刻于心的那一个字……",
                "1_B811": "唯有它，是毫无虚伪的真实……",
                "1_B812": "新选组，出阵！",
                "1_B813": "【全体】噢！",
                "1_B814": "【近藤】誓言留于彼方，诚仍在此处。"
            }
        },
        "1_B820": {
            "name": "宝具 4",
            "text": {
                "1_B820": "【近藤】出击，向着诚之旗……",
                "1_B821": "新选组，前进！",
                "1_B822": "【冲田】喝！",
                "1_B823": "【永仓】噢啦！",
                "1_B824": "【斋藤】嘿！",
                "1_B825": "【原田】看招！",
                "1_B826": "【藤堂】喝！",
                "1_B827": "【山南】哈！",
                "1_B828": "【土方】噢噢噢噢噢！",
                "1_B829": "【近藤】咆哮吧，虎彻！！"
            }
        },
        "1_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "1_B840": "虎彻啊！　咆哮吧！"
            }
        },
        "1_B880": {
            "name": "スキル 5",
            "text": {
                "1_B880": "呼……那么，从谁先开始？"
            }
        },
        "1_B890": {
            "name": "スキル 6",
            "text": {
                "1_B890": "容我先抽支烟吧。"
            }
        },
        "1_B910": {
            "name": "アタック 7",
            "text": {
                "1_B910": "认命吧！"
            }
        },
        "1_B920": {
            "name": "アタック 8",
            "text": {
                "1_B920": "击打！"
            }
        },
        "1_B930": {
            "name": "アタック 9",
            "text": {
                "1_B930": "愚蠢的家伙！"
            }
        },
        "1_G010": {
            "name": "レベルアップ 1",
            "text": {
                "1_G010": "呼……沁人心脾呢。"
            }
        },
        "1_G020": {
            "name": "霊基再臨 2",
            "text": {
                "1_G020": "我的刀？",
                "1_G021": "长曾祢虎彻，是最上大业物中的一把。",
                "1_G022": "当代似乎用『今夜的虎彻渴望鲜血』之类的形容把它说得像是把妖刀。",
                "1_G023": "不，虽说它的确啜饮了无数鲜血，但对我而言，这是无可替代的刀。"
            }
        },
        "1_G030": {
            "name": "霊基再臨 1",
            "text": {
                "1_G030": "有些兴奋过头了呢。",
                "1_G031": "年轻不顾一切时的我就到此为止吧。",
                "1_G032": "请放心，身体衰老的部分，我会用经验来弥补。",
                "1_G033": "那么，今后也请多关照。"
            }
        },
        "1_G110": {
            "name": "レベルアップ 2",
            "text": {
                "1_G110": "您的关怀，感激不尽。"
            }
        },
        "1_G120": {
            "name": "レベルアップ 3",
            "text": {
                "1_G120": "唔……！　哦，力量似乎充盈了。"
            }
        },
        "1_H010": {
            "name": "誕生日",
            "text": {
                "1_H010": "听说今天是主公值得庆祝的日子呢。",
                "1_H011": "那就由我传授您一招天然理心流的招数吧。",
                "1_H012": "请放心，我会避免总司那种粗暴教法的。",
                "1_H013": "那么，就先从挥刀千次开始吧。"
            }
        },
        "1_H020": {
            "name": "イベント開催中",
            "text": {
                "1_H020": "活动啊，偶尔放松一下也无妨，但请不要玩得太过火。",
                "1_H021": "若在游玩时丢了丑，难免会有些扫兴。"
            }
        },
        "1_H030": {
            "name": "会話 1",
            "text": {
                "1_H030": "要出阵了吧。",
                "1_H031": "那就召集队士们吧。"
            }
        },
        "1_H040": {
            "name": "会話 2",
            "text": {
                "1_H040": "我对出人头地已经没有兴趣了。",
                "1_H041": "我所侍奉的唯有您一人。",
                "1_H042": "虽为不肖之身，还请您千万不要舍弃我。"
            }
        },
        "1_H050": {
            "name": "会話 3",
            "text": {
                "1_H050": "对我而言，主公的为人处世实在令人愉快。",
                "1_H051": "但愿无论如何，您都不要失去这种为人处世的状态。"
            }
        },
        "1_H060": {
            "name": "好きなこと",
            "text": {
                "1_H060": "喜欢的东西啊。",
                "1_H061": "这个嘛，是刀。",
                "1_H062": "听说迦勒底有不少持有名刀的英杰。",
                "1_H063": "若有机会，想务必亲眼见识一番。"
            }
        },
        "1_H070": {
            "name": "嫌いなこと",
            "text": {
                "1_H070": "讨厌的东西……",
                "1_H071": "虽然我对食物没有什么好恶，但一定要说的话，大概是腌萝卜吧。",
                "1_H072": "不，倒也不是讨厌，只是身边有个一口气吃掉堆积如山腌萝卜的男人，多少还是会让人有些吃不消……",
                "1_H073": "哎哟，这件事还请务必替我保密。"
            }
        },
        "1_H080": {
            "name": "聖杯について",
            "text": {
                "1_H080": "万能的愿望机……若能如愿，真希望那些为我而倒下的人们……",
                "1_H081": "不，没什么。",
                "1_H082": "这些不过是我的感伤罢了。"
            }
        },
        "1_H10090": {
            "name": "絆Lv.1",
            "text": {
                "1_H10090": "我明白自己身为臣下的本分，所以队里的诸位还请您不必客气，尽管差遣吧。"
            }
        },
        "1_H10100": {
            "name": "絆Lv.2",
            "text": {
                "1_H10100": "您问我是不是在生气？",
                "1_H10101": "不，没有这种事，但我似乎一直很容易被人误会。",
                "1_H10102": "是的，我只是在思考午饭该吃什么菜罢了。"
            }
        },
        "1_H10110": {
            "name": "絆Lv.3",
            "text": {
                "1_H10110": "您问我能否将拳头塞进嘴里？",
                "1_H10111": "不知您是从哪里听说的……",
                "1_H10112": "什么，著名的轶事……？",
                "1_H10113": "为什么这种事会流传后世啊。",
                "1_H10114": "您问是真是假……？",
                "1_H10115": "嗯，确实塞得进去。",
                "1_H10116": "您要看吗？"
            }
        },
        "1_H10120": {
            "name": "絆Lv.4",
            "text": {
                "1_H10120": "由于没什么出众的才能，所以我也没什么可教授您……",
                "1_H10121": "一定要说的话，也就只有剑术修行了吧，但因为还有比我更有能耐的人。",
                "1_H10122": "如果即便如此您还愿意的话，我可以为您指点一二……",
                "1_H10123": "这样吗，那就请拿起剑吧。",
                "1_H10124": "天然理心流重实不重名，比起招式，更重实战。",
                "1_H10125": "那么，请做好思想准备！"
            }
        },
        "1_H10130": {
            "name": "絆Lv.5",
            "text": {
                "1_H10130": "我本来应该已经走到尽头了。我曾经放弃、屈服，想至少以牺牲自身来相报，但就连这也不过是逃避自身责任的结果。",
                "1_H10131": "我根本不是一个适合站在人上的人。",
                "1_H10132": "可即便如此，您还是携起我的手，让我再次振奋那几近消逝的诚。",
                "1_H10133": "感谢您，我的主公啊。",
                "1_H10134": "而降临于您身上的苦难，我，以及新选组，定会为您扫清！"
            }
        },
        "1_H230": {
            "name": "会話 4",
            "text": {
                "1_H230": "永仓，我很高兴这次能以剑士的身份和你一起侍奉同一位主公。",
                "1_H231": "呵，这种想法或许并不好吧。",
                "1_H232": "对了，能不能也让我看看你喜欢的那个叫作活动写真的东西呢？"
            }
        },
        "1_H240": {
            "name": "会話 5",
            "text": {
                "1_H240": "山南，对你而言，由我道歉或许并不合情理。",
                "1_H241": "但即便如此，我还是想向你道歉。对不起……",
                "1_H242": "还有，谢谢你愿意回来。",
                "1_H243": "这次定要为了主公，让我们一起竭尽全力吧。"
            }
        },
        "1_H250": {
            "name": "会話 6",
            "text": {
                "1_H250": "斋藤，让你负责了一件苦差事呢。",
                "1_H251": "即便如此，还是要谢谢你愿意助岁一臂之力。",
                "1_H252": "呵……从在试卫馆相遇的那一天起，你就一直没有变呢。",
                "1_H253": "请将你那自由之剑再次借给新选组吧。"
            }
        },
        "1_H260": {
            "name": "会話 7",
            "text": {
                "1_H260": "听说那位司马懿阁下也在迦勒底。",
                "1_H261": "若可以的话，务必请您为我引见，我想向他请教那层出不穷的神机妙算。",
                "1_H262": "那位女性？",
                "1_H263": "啊，那位怎么……",
                "1_H264": "什么！？　那就是司马懿阁下！？"
            }
        },
        "1_H270": {
            "name": "会話 8",
            "text": {
                "1_H270": "主公，那位身穿和服的女性究竟是……？",
                "1_H271": "两仪……式阁下吗。",
                "1_H272": "不，只是从她的行为举止中能感受到某种深不可测的气息。",
                "1_H273": "而且那把刀也绝非寻常之物。",
                "1_H274": "嚯，她还收藏刀剑？",
                "1_H275": "看来和我应该很聊得来。"
            }
        },
        "1_H280": {
            "name": "会話 9",
            "text": {
                "1_H280": "主公，我听总司说，您曾见过芹泽先生。",
                "1_H281": "嗯，那位曾比任何人都要强大……",
                "1_H282": "若您不介意的话，能跟我讲讲他的事吗？",
                "1_H283": "……哈？　邪马台国？",
                "1_H284": "恕我冒昧，这和芹泽先生有什么关系？"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "击溃架势！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "要上了！"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "出击！"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "白光两断！……处决！"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "【冲田】一番队，报道。",
                "2_B051": "【永仓】二番队，能上。",
                "2_B052": "【斋藤】三番队，同前。",
                "2_B053": "【原田】嗯。",
                "2_B054": "【藤堂】啊。",
                "2_B055": "【山南】交给我吧。",
                "2_B056": "【土方】新选组，出击！",
                "2_B057": "【近藤】来吧，齐聚于诚之旗下！"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "出击！"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "认命吧。"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "新选组局长，近藤勇来做你的对手。"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "执行公务！　胆敢反抗者绝不手下留情！"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "吾等之诚已于此彰显。新选组，收队！"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "结束了吗……主公，您没事吧？ 这样啊，那就好。"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "无妨。"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "这种程度还无法折断我的诚！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "我的诚，绝无虚伪……"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "纵以一死，也当报答君恩……"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "明白了。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "遵命。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "好！"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "哼！"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "咬紧牙关！"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "四连石火！"
            }
        },
        "2_B2080": {
            "name": "スキル 7",
            "text": {
                "2_B2080": "唔。"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "就在此……立起旗帜。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "高举吾等的旗帜！"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "宝具吗……明白了。"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "还没完！"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "车轮！"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "哼！哈！嘿！"
            }
        },
        "2_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "2_B2440": "咆哮吧，虎彻！　喝！"
            }
        },
        "2_B250": {
            "name": "宝具カード 4",
            "text": {
                "2_B250": "现在正是前往誓言之地的时候。"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "上！"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "月影！"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "嘿呀！"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "绝刀……狮子王！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "上吧，虎彻！"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "不会手下留情！"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "吾等以剑为生，聚于诚下。 ……杀进去，全员跟上！"
            }
        },
        "2_B510": {
            "name": "開始 4",
            "text": {
                "2_B510": "保护主公！　新选组，前进！ 从现在起无论何人都不得通行！"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "到此为止了，收起剑来吧！继续争斗也毫无意义。 若还打算继续的话，我会用这双拳让你明白。"
            }
        },
        "2_B530": {
            "name": "勝利 4",
            "text": {
                "2_B530": "——领教近藤勇的剑了吗。"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "唔！"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": "嗯……！"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "纵使此剑折断，我之诚也不会折断。"
            }
        },
        "2_B570": {
            "name": "戦闘不能 4",
            "text": {
                "2_B570": "主公啊，对不起……"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "【冲田】果然我们还是，",
                "2_B801": "【永仓】得这样才对嘛。",
                "2_B802": "【斋藤】一个个都这样。",
                "2_B803": "【原田】尽是些笨蛋呢。",
                "2_B804": "【藤堂】别把我算进去。",
                "2_B805": "【山南】那么各位。",
                "2_B806": "【土方】上吧。",
                "2_B807": "【近藤】——新选组，出击！"
            }
        },
        "2_B810": {
            "name": "宝具 3",
            "text": {
                "2_B810": "【近藤】我们铭刻于心的那一个字……",
                "2_B811": "唯有它，是毫无虚伪的真实……",
                "2_B812": "新选组，出阵！",
                "2_B813": "【全体】噢！",
                "2_B814": "【近藤】誓言留于彼方，诚仍在此处。"
            }
        },
        "2_B820": {
            "name": "宝具 4",
            "text": {
                "2_B820": "【近藤】大家的性命，",
                "2_B821": "就交给我吧……",
                "2_B822": "新选组，前进！",
                "2_B823": "【冲田】喝！",
                "2_B824": "【永仓】噢啦！",
                "2_B825": "【斋藤】嘿！",
                "2_B826": "【原田】看招！",
                "2_B827": "【藤堂】喝！",
                "2_B828": "【山南】哈！",
                "2_B829": "【土方】噢噢噢噢噢！",
                "2_B10820": "【近藤】嘿呀啊啊啊啊！！！"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "哈啊啊啊啊！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "抵达诚……吗。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "嗯，就这么办吧。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "虎王！"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "哈！"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "仁王！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "感激不尽，主公啊。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "回来了吗，回到立下誓言的地方。",
                "2_G041": "我的主公啊，新选组局长近藤勇在此向剑起誓，定向您尽诚。",
                "2_G042": "无论什么样的苦难，都将与您共同承受、相互扶持，为开辟主公的……人类的未来。"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "从体内涌现的白之力量……这真的是我吗……",
                "2_G051": "请容我向您致谢，我的主公啊。",
                "2_G052": "没想到您竟如此信任我的剑，并将其锤炼至此……",
                "2_G053": "从今往后，我将以天然理心流第四代宗家近藤勇的名义起誓，定将为主公扫除一切苦难，为全新的时代尽诚。"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "呵……才刚刚开始呢。"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "啊，力量仿佛正从体内不断涌出。"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "主公，祝您生日快乐。",
                "2_H011": "我在一家熟悉的店里备好了庆祝的宴席。",
                "2_H012": "来，在被发现之前赶紧先出发吧。",
                "2_H013": "呵呵，如果不偶尔放松一下，可是会闷坏的哦。"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "活动？",
                "2_H021": "啊，是在办什么庆典吧。",
                "2_H022": "偶尔放纵一下也无妨。",
                "2_H023": "呵呵，难得的机会，我也一起放纵吧。",
                "2_H024": "好了，我们走吧。"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "巡逻啊，交给我吧。",
                "2_H031": "那就赶在被谁阻止之前赶紧出发吧。",
                "2_H032": "得赶在被那个成天唠叨局长就该稳坐中军的家伙发现之前。"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "我的剑早已托付给身为主公的您了。",
                "2_H041": "无论什么样的战斗，我都发誓赌上性命战斗到底。",
                "2_H042": "您随时可以召唤我。",
                "2_H043": "什么？　不是这个意思，而是一起吃午饭？",
                "2_H044": "呵……既然如此，我自然乐意奉陪。"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "我很感激身为御主的您。",
                "2_H051": "毕竟是您让我再次见到了那些本以为再也无法相会的伙伴们啊。"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的东西吗。",
                "2_H061": "是呢，我从小就很经常阅读三国志。",
                "2_H062": "呵呵，尤其是刘备三兄弟中关羽的精彩表现总能令我心潮澎湃。"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "倒也算不上讨厌，但萨摩的第一刀一定要躲开。",
                "2_H071": "就算不明白为什么也要照做。",
                "2_H072": "否则就会死。"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "圣杯……",
                "2_H081": "我已经失去寻求万能愿望机的理由了。",
                "2_H082": "但如果主公想要，我自当赌上性命发起挑战。",
                "2_H083": "您意下如何？"
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "不可忘记恩义，不可舍弃情义。",
                "2_H20091": "要以情待人，不重蹈覆辙。",
                "2_H20092": "……似乎有些说教过头了。",
                "2_H20093": "剩下的改日再说吧。"
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "不可一意孤行。",
                "2_H20101": "不可嘲笑他人的过错。",
                "2_H20102": "不可偷听他人的秘密。",
                "2_H20103": "因为人心是无法用金钱购买的。"
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "抱歉，一看到有才华的年轻人，我就总忍不住说些自以为是的话。",
                "2_H20111": "这是我的坏毛病。",
                "2_H20112": "毕竟扪心自问，我也不是什么有资格说这种自以为是话的人嘛。"
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "不违逆自然，效法上天，遵循大地，以此穷尽剑理。这便是天然理心流。",
                "2_H20121": "虽然曾被讥讽为乡下剑法，但重实而不重名、绝不会败北之剑定能成为主公的助力。",
                "2_H20122": "嗯，尽管交给我吧。"
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "我要感谢命运，让我得以邂逅了曾经的我最终都未曾拥有的主公。",
                "2_H20131": "而如今，就由我近藤勇，以及新选组来支持您这位作为一介普通人勇于面对世界的御主吧。",
                "2_H20132": "来，请收下这面旗帜，然后高高举起吧。",
                "2_H20133": "如此一来，我们必将跨越一切阻隔，聚集到这面旗帜之下。",
                "2_H20134": "——『诚』与您同在。"
            }
        },
        "2_H290": {
            "name": "会話 4",
            "text": {
                "2_H290": "总司，要不要久违地过两招？",
                "2_H291": "嗯，我从来没赢过你。",
                "2_H292": "没错，多亏了你，我才知晓了天空究竟有多么湛蓝。",
                "2_H293": "而如今，我真的很高兴能再次与你交手。"
            }
        },
        "2_H300": {
            "name": "会話 5",
            "text": {
                "2_H300": "岁，我这个令人费神的兄长真让你吃了不少苦呢……",
                "2_H301": "不，还是算了。",
                "2_H302": "从当年在多摩争先恐后地暴揍坏小子的那一天起，你就一直没变呢。",
                "2_H303": "嗯，让我们再一起干吧。和你、还有总司，我们三个人一起。"
            }
        },
        "2_H310": {
            "name": "会話 6",
            "text": {
                "2_H310": "原田，听说你曾渡海去了大陆。",
                "2_H311": "怎么样，要不要聊聊这件事喝一杯？",
                "2_H312": "哈哈哈哈，今晚就让我们一起畅想那片大陆上的英杰们吧。"
            }
        },
        "2_H320": {
            "name": "会話 7",
            "text": {
                "2_H320": "主公，我听说那位关羽阁下的爱马也在这里。如果可以的话，能否请您帮忙引见？",
                "2_H321": "不，还是不见为好？",
                "2_H322": "别这么说嘛，能亲眼见到赤兔马的机会……啊，请等一下！"
            }
        },
        "2_H330": {
            "name": "会話 8",
            "text": {
                "2_H330": "河上吗。",
                "2_H331": "我对她的感谢之情真是无以言表。",
                "2_H332": "多亏了她，当时我们才能聚集到了那个地方。",
                "2_H333": "而且她的剑，现在回想起来，我都感到不寒而栗。",
                "2_H334": "呵……倘若今后还有机会与她交手，我定要牢记避开她的第一刀。",
                "2_H335": "当然，前提是我躲得开的话。"
            }
        },
        "2_H340": {
            "name": "会話 9",
            "text": {
                "2_H340": "长曾祢虎彻。",
                "2_H341": "这是与我并肩奋战至今的名副其实的爱刀。",
                "2_H342": "即便经历了无数战场，它依旧陪伴在我的身边……",
                "2_H343": "怎么了？",
                "2_H344": "啊，请放心。渴求鲜血什么的不过是无稽之谈。",
                "2_H345": "不过，若在我看不到的地方，说不定……",
                "2_H346": "哈哈哈，开个玩笑而已。对吧，虎彻。"
            }
        }
    },
    "ChrVoice_ids": [
        "106400"
    ]
}