                "0_B200": "明白了。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "踩碎。"
            },
            "raw_text": {
                "0_B2010": "踏みつぶす。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": ""
            },
            "raw_text": {
                "0_B2020": "どけ。"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "横扫。"
            },
            "raw_text": {
                "0_B2030": "薙ぎ払う。"
            }
        },
        "0_B210": {
            "name": "宝具卡",
            "text": {
                "0_B210": "杀戮。一个不留。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "啊啊，杀了便是。"
            },
            "raw_text": {
                "0_B220": "ああ、殺すとも。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "烧尽。"
            },
            "raw_text": {
                "0_B2410": "焼き尽くす。"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "扭曲吧。"
            },
            "raw_text": {
                "0_B2420": "ねじれろ。"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "太天真了。"
            },
            "raw_text": {
                "0_B2430": "甘いんだよ。"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "接近了啊。"
            },
            "raw_text": {
                "0_B2810": "近づいたな。"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "剜出来吧。"
            },
            "raw_text": {
                "0_B410": "えぐれ。"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "贯穿。"
            },
            "raw_text": {
                "0_B420": "貫く。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "飞出去吧。"
            },
            "raw_text": {
                "0_B430": "吹き飛べ。"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "尝尝看吧，这把枪。"
            },
            "raw_text": {
                "0_B440": "食らってみろ。この槍を。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "咬碎。"
            },
            "raw_text": {
                "0_B480": "噛み砕く。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "上了。"
            },
            "raw_text": {
                "0_B490": "行くぞ。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "无趣。砸扁就结束了。"
            },
            "raw_text": {
                "0_B500": "つまらん。叩き潰して終わりだ。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "你站在我面前了啊。"
            },
            "raw_text": {
                "0_B510": "俺の前に立ったな。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "不过是死了就这副德行啊。"
            },
            "raw_text": {
                "0_B520": "死んだ程度でこの有様ではな。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "没用的。"
            },
            "raw_text": {
                "0_B540": "無駄だ。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "撑住。"
            },
            "raw_text": {
                "0_B550": "耐える。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "还要……更多敌人……"
            },
            "raw_text": {
                "0_B560": "もっと敵を。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "我的杀意，我的诅咒，",
                "0_B801": "与死之兽一同迅速吞噬殆尽。",
                "0_B802": "库里德·科因亨！",
                "0_B803": "哈扎罗！"
            },
            "raw_text": {
                "0_B800": "我が殺意、我が呪い。",
                "0_B801": "死の獣と共に速やかに喰らい尽くす。",
                "0_B802": "クリードカインヘン。",
                "0_B803": "はざろ。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "缠绕死亡，释放死亡，",
                "0_B811": "装甲完毕。要上了，",
                "0_B812": "库里德·科因亨。"
            },
            "raw_text": {
                "0_B810": "死を纏い、死を放つ。",
                "0_B811": "銃架完了。行くぞ。",
                "0_B812": "クリード・コイン変。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "哈……哈……"
            },
            "raw_text": {
                "0_B840": "はぁ……はぁっ。"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "好吧。"
            },
            "raw_text": {
                "0_B880": "いいだろう。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "准备完毕。"
            },
            "raw_text": {
                "0_B890": "準備完了だ。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "碍事。"
            },
            "raw_text": {
                "0_B910": "邪魔だ。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "挑飞。"
            },
            "raw_text": {
                "0_B920": "勝ち上げる"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "咆哮吧。"
            },
            "raw_text": {
                "0_B930": "うなれ。"
            }
        },
        "0_G010": {
            "name": "升级",
            "text": {
                "0_G010": "枪更锋利了。要试试看吗？"
            }
        },
        "0_G020": {
            "name": "灵基再临 2",
            "text": {
                "0_G020": "嗯，好吧。"
            }
        },
        "0_G030": {
            "name": "灵基再临 1",
            "text": {
                "0_G030": "我的力量恢复得差不多了。"
            }
        },
        "0_G040": {
            "name": "灵基再临 3",
            "text": {
                "0_G040": "居然如此信任我。 不知道该说你胆大包天呢，还是该说你愚蠢呢……"
            }
        },
        "0_G050": {
            "name": "灵基再临 4",
            "text": {
                "0_G050": "到此为止。再继续也没什么意义。",
                "0_G051": "真是个令人诧异的御主……"
            }
        },
        "0_H010": {
            "name": "生日",
            "text": {
                "0_H010": "……看来今天对你来说是个特别的日子吧。",
                "0_H011": "但仅此而已。"
            }
        },
        "0_H020": {
            "name": "活动举行中",
            "text": {
                "0_H020": "有种危险的气息。"
            }
        },
        "0_H030": {
            "name": "对话 1",
            "text": {
                "0_H030": "……喂，继续前进啊。"
            }
        },
        "0_H040": {
            "name": "对话 2",
            "text": {
                "0_H040": "我好歹也算阿尔斯特战士的一员。",
                "0_H041": "既然作为从者被召唤，就会做应做的事。"
            }
        },
        "0_H050": {
            "name": "对话 3",
            "text": {
                "0_H050": "主从？　这种多余的思考完全没必要。",
                "0_H051": "你只要指出你的敌人是谁就行了。"
            }
        },
        "0_H060": {
            "name": "喜欢的东西",
            "text": {
                "0_H060": "问我的喜好有什么用。",
                "0_H061": "这一切都毫无意义。"
            }
        },
        "0_H070": {
            "name": "讨厌的东西",
            "text": {
                "0_H070": "我其实并不讨厌敌人。只会去杀了他们。",
                "0_H071": "这也是作为一名战士理所当然的道理。"
            }
        },
        "0_H080": {
            "name": "关于圣杯",
            "text": {
                "0_H080": "圣杯？",
                "0_H081": "我还没愚蠢到将得不到的东西寄托于愿望。",
                "0_H082": "等得到了之后，再慢慢思考吧。"
            }
        },
        "0_H090": {
            "name": "牵绊Lv.1",
            "text": {
                "0_H090": "别毫无戒心地站在我的面前。",
                "0_H091": "会让我禁不住想捅你一枪的哦？"
            }
        },
        "0_H100": {
            "name": "牵绊Lv.2",
            "text": {
                "0_H100": "不要过多考虑从者的人格。从者不过是兵器。 无论是他们，还是我。有必要的话随时可能成为敌人。"
            }
        },
        "0_H110": {
            "name": "牵绊Lv.3",
            "text": {
                "0_H110": "原来的库·丘林？",
                "0_H111": "嗯，那应该是阳的那面。",
                "0_H112": "我是阴。",
                "0_H113": "如果你不满意，随时可以换人。"
            }
        },
        "0_H120": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H120": "我只顾打倒敌人。其中没有任何不纯的要素。",
                "0_H121": "所以只要你不背叛我，我的枪就不会刺入你的身体。"
            }
        },
        "0_H130": {
            "name": "牵绊Lv.5",
            "text": {
                "0_H130": "相处了那么久，你也该明白我的作风了吧？",
                "0_H131": "不过算了。我是你的枪这点依然没有改变。"
            }
        },
        "0_H140": {
            "name": "对话 4",
            "text": {
                "0_H140": "我实在是没法模仿那种作风。",
                "0_H141": "虽然我一点也不羡慕。"
            }
        },
        "0_H150": {
            "name": "对话 5",
            "text": {
                "0_H150": "哎哟，真是松了口气。",
                "0_H151": "就算是我，也有一两个不想与之为敌的对手啊。"
            }
        },
        "0_H160": {
            "name": "对话 6",
            "text": {
                "0_H160": "梅芙吗。只希望她别再纠缠我了。",
                "0_H161": "是自己人吧？　那就行了。"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "哼，原来如此。难怪是个看起来像我、却又不太像我的存在。没想到居然会是奥丁啊。",
                "0_H201": "",
                "0_H202": ""
            },
            "raw_text": {
                "0_H200": "ふん、なるほど。どうりで 俺のようで 俺らしからぬ存在だったか？ まさかオーディンとはな。",
                "0_H201": "",
                "0_H202": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "把我当成病人对待，这感觉倒挺新鲜。不过，唯独把我强制关在床上休息这事，希望你能饶了我吧。",
                "0_H211": ""
            },
            "raw_text": {
                "0_H210": "この俺を病人扱いとは新鮮な感覚だな。まあ、ベッドに寝かされるのだけは勘弁して欲しいが。",
                "0_H211": ""
            }
        },
        "0_H220": {
            "name": "会話 9",
            "text": {
                "0_H220": "我作为狂王时的行事逻辑，大抵是受了不知哪里的某个暴君的影响吧。那个被称为‘贤王’的吉尔伽美什是怎么回事？按我的感觉，那家伙本该更那个……更糟糕才对吧。",
                "0_H221": "",
                "0_H222": "",
                "0_H223": ""
            },
            "raw_text": {
                "0_H220": "俺の教皇としての論理はだいたい。どこぞの暴君に影響されているんだろうが。 なんだあの賢きを ギルガメッシュってのは？ あいつは俺の感覚じゃもっとこう。あれだったはずなんだが。",
                "0_H221": "",
                "0_H222": "",
                "0_H223": ""
            }
        },
        "0_S010": {
            "name": "召唤",
            "text": {
                "0_S010": "库·丘林。应召唤而来。",
                "0_S011": "……我的色彩与你有关系吗？"
            }
        }
    },
    "ChrVoice_ids": [
        "702000"
    ]
}