                "0_B040": "你已经不需要醒来了。"
            }
        },
        "0_B050": {
            "name": "宝具",
            "text": {
                "0_B050": "全咒解放。",
                "0_B051": "我下手可不考虑分寸，",
                "0_B052": "挑战这份绝望吧……",
                "0_B053": "噬碎死牙之兽！"
            }
        },
        "0_B080": {
            "name": "技能 1",
            "text": {
                "0_B080": "胆怯惶恐吧……！"
            }
        },
        "0_B090": {
