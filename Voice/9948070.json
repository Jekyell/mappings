{
  "id": 9948070,
  "name": "スペース・ノブナガ",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "药研·246。"
      },
      "raw_text": {
        "0_B010": "ヤーゲン・トゥー・フォー・シックス。"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "斩断。"
      },
      "raw_text": {
        "0_B020": "切ります。"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "恒星直列，南天射线。"
      },
      "raw_text": {
        "0_B030": "恒星直列、サザンレイズ。"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "沉沦吧，本能·G终焉。"
      },
      "raw_text": {
        "0_B040": "沈め、インスティンクト・ジーエンド。"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "六亿光年的记忆……"
      },
      "raw_text": {
        "0_B080": "六億光年の記憶……"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "将一切归于一体……"
      },
      "raw_text": {
        "0_B090": "すべてを一つに……"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "宛如梦幻。"
      },
      "raw_text": {
        "0_B170": "無限のように。"
      }
    },
    "0_B300": {
      "name": "0_B300",
      "text": {
        "0_B300": "我是信长·OD·永恒。"
      },
      "raw_text": {
        "0_B300": "私は、信長オーディー・エタニティ。"
      }
    },
    "0_B310": {
      "name": "0_B310",
      "text": {
        "0_B310": "受诅咒的星之生命啊，沉入蔚蓝苍穹吧。"
      },
      "raw_text": {
        "0_B310": "呪われし星の命よ、青き空へと沈め。"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "无限轨道·Tri-Six。"
      },
      "raw_text": {
        "0_B410": "無限軌道トライシックス。"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "无限降临，本能·G终焉。"
      },
      "raw_text": {
        "0_B440": "無限降臨、インスティンクト・ジー・エンド。"
      }
    },
    "0_B560": {
      "name": "0_B560",
      "text": {
        "0_B560": "向着星辰……向着那道蔚蓝之光。"
      },
      "raw_text": {
        "0_B560": "星へ…あの青き光へと。"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "蔚蓝苍穹，六亿光年之光。"
      },
      "raw_text": {
        "0_B840": "青き空、六億光年の光。"
      }
    }
  }
}
