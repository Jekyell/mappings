{
    "id": 9947800,
    "name": "Enemy 9947800",
    "voices": {
        "0_B010": {
            "name": "0_B010",
            "text": {
                "0_B010": "三下五除二~"
            },
            "raw_text": {
                "0_B010": "ちょいちょいと。"
            }
        },
        "0_B020": {
            "name": "0_B020",
            "text": {
                "0_B020": "看招—。"
            },
            "raw_text": {
                "0_B020": "そーれ。"
            }
        },
        "0_B030": {
            "name": "0_B030",
            "text": {
                "0_B030": "你这混蛋。"
            },
            "raw_text": {
                "0_B030": "こんにゃろ。"
            }
        },
        "0_B040": {
            "name": "0_B040",
            "text": {
                "0_B040": "我要动真格的了哦—。"
            },
            "raw_text": {
                "0_B040": "本気でやっちゃうぞー。"
            }
        },
        "0_B080": {
            "name": "0_B080",
            "text": {
                "0_B080": "外卖一人份。"
            },
            "raw_text": {
                "0_B080": "出前一人前。"
            }
        },
        "0_B090": {
            "name": "0_B090",
            "text": {
                "0_B090": "来，年糕。"
            },
            "raw_text": {
                "0_B090": "はい、お餅。"
            }
        },
        "0_B100": {
            "name": "0_B100",
            "text": {
                "0_B100": "呜呜，明明人家只想窝在家里……"
            },
            "raw_text": {
                "0_B100": "うぅ、引きこもっていたいのに。"
            }
        },
        "0_B110": {
            "name": "0_B110",
            "text": {
                "0_B110": "那就爽快地干一场，然后再爽快地继续窝着吧。"
            },
            "raw_text": {
                "0_B110": "そんじゃまビシバシやって、ビシバシ引きこもりますか。"
            }
        },
        "0_B120": {
            "name": "0_B120",
            "text": {
                "0_B120": "啊——好烦好麻烦。虽然我也讨厌输就是了。"
            },
            "raw_text": {
                "0_B120": "あーかったるいかったるい。負けるのは嫌だけどさ。"
            }
        },
        "0_B130": {
            "name": "0_B130",
            "text": {
                "0_B130": "呀——！真是的，衣服都要弄脏了啦。"
            },
            "raw_text": {
                "0_B130": "きゃーっ、もう、服が汚れちゃう。"
            }
        },
        "0_B140": {
            "name": "0_B140",
            "text": {
                "0_B140": "好痛！"
            },
            "raw_text": {
                "0_B140": "いったっ。"
            }
        },
        "0_B150": {
            "name": "0_B150",
            "text": {
                "0_B150": "呜哇啊啊啊！"
            },
            "raw_text": {
                "0_B150": "ひゃああぁぁぁっ。"
            }
        },
        "0_B160": {
            "name": "0_B160",
            "text": {
                "0_B160": "请把……电脑里的数据……帮我删掉……（瘫）。"
            },
            "raw_text": {
                "0_B160": "ＰＣのデータ、消しておいて……ガクッ。"
            }
        },
        "0_B170": {
            "name": "0_B170",
            "text": {
                "0_B170": "果然……还是继续窝在家里比较好……噗（吐血）。"
            },
            "raw_text": {
                "0_B170": "やっぱり、引きこもってたほうがよかった……ぐふっ。"
            }
        },
        "0_B180": {
            "name": "0_B180",
            "text": {
                "0_B180": "哦！"
            },
            "raw_text": {
                "0_B180": "おう。"
            }
        },
        "0_B190": {
            "name": "0_B190",
            "text": {
                "0_B190": "好—啦好—啦。"
            },
            "raw_text": {
                "0_B190": "はいはーい。"
            }
        },
        "0_B200": {
            "name": "0_B200",
            "text": {
                "0_B200": "收到。"
            },
            "raw_text": {
                "0_B200": "了解。"
            }
        },
        "0_B210": {
            "name": "0_B210",
            "text": {
                "0_B210": "速战速决搞定它吧。"
            },
            "raw_text": {
                "0_B210": "手っ取り早く済ませちゃおっか。"
            }
        },
        "0_B410": {
            "name": "0_B410",
            "text": {
                "0_B410": "诶。"
            },
            "raw_text": {
                "0_B410": "えっ。"
            }
        },
        "0_B420": {
            "name": "0_B420",
            "text": {
                "0_B420": "呜呼呼。"
            },
            "raw_text": {
                "0_B420": "うふふっ。"
            }
        },
        "0_B430": {
            "name": "0_B430",
            "text": {
                "0_B430": "去吧去吧。"
            },
            "raw_text": {
                "0_B430": "やっちゃえ。"
            }
        },
        "0_B440": {
            "name": "0_B440",
            "text": {
                "0_B440": "啊啊真是的，好想缩回家里啊。"
            },
            "raw_text": {
                "0_B440": "ああもう、引きこもりたい。"
            }
        },
        "0_B480": {
            "name": "0_B480",
            "text": {
                "0_B480": "一键付款购买！"
            },
            "raw_text": {
                "0_B480": "ワンクリックで買っちゃう。"
            }
        },
        "0_B490": {
            "name": "0_B490",
            "text": {
                "0_B490": "点击下单！"
            },
            "raw_text": {
                "0_B490": "ポチる。"
            }
        }
    }
}