{
    "id": 2301100,
    "collectionNo": 448,
    "name": "玉兎",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "去吧。"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "喵呜～。"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "就是那里！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "直死——"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "阴阳螺钿——",
                "0_B051": "来了啊——",
                "0_B052": "先去学习礼仪吧！",
                "0_B053": "满月早就已经过去了！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "没什么，就那个吧。"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "嘿咻。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "明明是来游泳的，结果又要战斗啊。 你还是那么忙碌呢。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "行啊。有人找茬我肯定奉陪。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "差不多就这样吧。 毕竟拼过命了，至少要拿点报酬哦。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "感想？ 既然赢了，说明你的指挥不错吧？"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "嘁。"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "这下不太妙吧……！？"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "有点松懈了。回去了。"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "我没有放水，只是不太适应罢了。"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "那附近吗？"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "知道啦知道啦。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "挺好的嘛。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "给我死吧！"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "哼，哈！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "正所谓怒发冲冠哦。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "究竟是猫还是兔子啊……"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "太耀眼了，把头转过去。"
            }
        },
        "0_B2410": {
            "name": "アタック 12",
            "text": {
                "0_B2410": "升月！"
            }
        },
        "0_B2420": {
            "name": "アタック 13",
            "text": {
                "0_B2420": "秘剑·猫翻身！"
            }
        },
        "0_B2430": {
            "name": "アタック 14",
            "text": {
                "0_B2430": "全弹都会击中哦！"
            }
        },
        "0_B2810": {
            "name": "アタック 15",
            "text": {
                "0_B2810": "闪鞘·兔雹！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "哼！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "唔？　当真？"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "原来如此～。"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "正好拿来试刀呢！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "行啦，下一个。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "躲起来啦，笨蛋。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "巧了，我正好想要个跑腿的。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "辛苦了。要不要去吃点东西？ 我请客。不过我就不吃了。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "猫可是会报仇的。给我记住。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "其实我很早就想说了。",
                "0_B801": "行走江湖的道义——",
                "0_B802": "本就该比血缘更深厚吧！？",
                "0_B803": "灵魂理解了吗？"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "赏月结束了。",
                "0_B811": "百尺竿头——",
                "0_B813": "末那识·十六夜残花。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "搭讪到此为止，滚回去睡觉吧！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "夏天可得补得勤快点。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "这样就够了。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "哈啊——！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "击落！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "朔光！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "谢啦。",
                "0_G011": "我会好好回报收到的这部分啦。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "好了，升级了哦。",
                "0_G111": "要立刻去试试吗？"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "虽然算老调重弹了。",
                "0_G121": "不能把这个变成水羊羹吗？　毕竟是夏天嘛。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "我知道啦，今天是你的生日吧。",
                "0_H011": "记得晚上把时间空出来。",
                "0_H012": "还能干嘛，晚餐啦，晚餐。",
                "0_H013": "这一带的店我信不过，所以就借他们的厨房，由我亲自下厨。",
                "0_H014": "那东西是叫烧烤吧？　就是那个的高级餐厅版。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "这个月花得有点太多了……",
                "0_H021": "参加活动吧，御主。",
                "0_H022": "就地筹措把亏空补回来。"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "我要去散步。你要一起来吗？"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "只要别提什么离谱的要求，我倒是可以听你的命令。",
                "0_H041": "就当是你的请求哦。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和御主的关系？",
                "0_H051": "难道不是在度假胜地巧遇的当地朋友吗？"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西？",
                "0_H061": "没什么特别的。毕竟是玉兔嘛。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的东西和平时的我没什么差别。",
                "0_H071": "讨厌那些糊弄自己的家伙。",
                "0_H072": "还有那些撇开自己不管一心玩耍的家伙。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "有圣杯的话就拿来。",
                "0_H081": "我要拿来做自我矫……",
                "0_H082": "不对，是拿来自我锻炼。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "你问我为什么会是月之癌职阶？",
                "0_H091": "当然是因为出了Bug啦。",
                "0_H092": "不是系统上的Bug哦。",
                "0_H093": "是人为错误。受不了，连我都觉得自己让人头疼了。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "月亮上有兔子的说法好像不是日本独有的。",
                "0_H101": "土地和食物明明都各不相同，竟然能有如此一致的幻想呢。",
                "0_H102": "……难不成，月兔真的存在？"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "我以前一直没什么兴致，但南国的大海似乎也不赖。",
                "0_H111": "大海一直给我一种冷清的印象，可这里倒是无忧无虑得很呢。",
                "0_H112": "这样看来，难怪所谓的水上运动那么流行呢。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "我好像逐渐习惯这种状态了……",
                "0_H121": "甚至开始觉得把外套脱掉也无妨了。",
                "0_H122": "是不是换个名字换种身份后，人就会不顾羞耻和面子了呢？"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "你也真是好管闲事呢。",
                "0_H131": "竟然把宝贵的夏天耗费在我这种不爱理人的家伙身上。",
                "0_H132": "……不，收回刚才的话。",
                "0_H133": "不能叫耗费。美好的回忆应该叫“获得”才对。",
                "0_H134": "我玩得很开心哦，御主。",
                "0_H135": "所以，不光是夏天，其他季节我也不介意陪你哦。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "迦勒底没有自备的水上摩托吗？",
                "0_H171": "也没有小型游艇？　也没有巡航游艇？",
                "0_H172": "看来只能用宝具召出来了……",
                "0_H173": "没办法，去找那个黑女仆谈谈吧……"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "那个身上藏了一堆锐器的女人，是叫希耶尔啊。",
                "0_H181": "唔。举止很正经，看似在玩闹，其实始终在留意周围。",
                "0_H182": "去活动活动出一身汗吧……"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "唉……之所以会出现月亮的Bug，或者说与月亮有缘的职阶，都是你的错吧。",
                "0_H191": "你的本体很大吧？",
                "0_H192": "赶紧先出真身。我陪你打一场团体战。"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "你姐还活着吗？",
                "0_H201": "啊，只要活着就行。",
                "0_H202": "至于过得好不好就不用确认了。反正无论去哪儿，她都会随着自己的喜好生活吧。",
                "0_H203": "话说回来，要不要去那边喝杯茶？",
                "0_H204": "稍微陪我聊一会儿往事吧。"
            }
        },
        "0_N010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 1",
            "text": {
                "0_N010": "只要攒够积分就能兑换豪华奖品啊……",
                "0_N011": "还真是哪儿都有这种制度呢。"
            }
        },
        "0_N020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 2",
            "text": {
                "0_N020": "你还真够勤快的。",
                "0_N021": "不是有种一直转滚轮的小可爱嘛。就跟那个似的。"
            }
        },
        "0_N030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 3",
            "text": {
                "0_N030": "这座岛上的体育设施还是差了点呢……",
                "0_N031": "对于运动员来说，实在有点遗憾。"
            }
        },
        "0_N040": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 4",
            "text": {
                "0_N040": "我只是个打工的。",
                "0_N041": "不是都说了我是玉兔嘛。"
            }
        },
        "0_N050": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 5",
            "text": {
                "0_N050": "岛上的宣传册？",
                "0_N051": "不是到处都有嘛。",
                "0_N052": "自己去找来看啊。"
            }
        },
        "0_N1010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 6",
            "text": {
                "0_N1010": "你没办积分卡吗？",
                "0_N1011": "确实，那个很占地方嘛……",
                "0_N1012": "不过我倒是挺喜欢那种砰砰盖章的感觉。"
            }
        },
        "0_N1020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 7",
            "text": {
                "0_N1020": "哟，勤快的家伙。",
                "0_N1021": "想要什么东西的话，就加油啦，加油♪"
            }
        },
        "0_N1030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 8",
            "text": {
                "0_N1030": "又来看商品目录了吗？",
                "0_N1031": "不过，做好规划是件好事。"
            }
        },
        "0_N1040": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 9",
            "text": {
                "0_N1040": "啊～，那个啦，呼延灼？",
                "0_N1041": "那家伙其实挺危险的。",
                "0_N1042": "我是说精神稳定性方面。",
                "0_N1043": "你可得好好照顾她哦。"
            }
        },
        "0_N1050": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 10",
            "text": {
                "0_N1050": "岛上的宣传册看了吗？",
                "0_N1051": "二区和三区看起来很有意思吧……",
                "0_N1052": "我本来也想去那边好好闹一场呢。"
            }
        },
        "0_N1060": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 11",
            "text": {
                "0_N1060": "辛苦了。",
                "0_N1061": "虽然是个有点奇怪的夏天，不过应该不无聊吧？",
                "0_N1062": "哈哈，就当是一段美好的回忆，好好记住吧。"
            }
        },
        "0_N1070": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 12",
            "text": {
                "0_N1070": "虽然不用我特地提醒了，但你也要小心那些来路不明的契约哦。",
                "0_N1071": "受不了，什么螺号公司啊。居然拿幸福的婚礼仪式当牟利工具。"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "……唉。别叫我啦，多少学学察言观色啦。一看就知道我在独自旅行吧。",
                "0_S011": "不过算了。反正我也没什么重要的安排。",
                "0_S012": "从者，月之癌，玉兔。差不多就行了。",
                "0_S013": "不知道吗？　就月亮上那只兔子啦，就那个。"
            }
        },
        "1_B010": {
            "name": "アタック 1",
            "text": {
                "1_B010": "去吧。"
            }
        },
        "1_B020": {
            "name": "アタック 2",
            "text": {
                "1_B020": "动手，暴击！"
            }
        },
        "1_B030": {
            "name": "アタック 3",
            "text": {
                "1_B030": "嘿——！哼！"
            }
        },
        "1_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "1_B040": "心空妙有——重钟楼。"
            }
        },
        "1_B050": {
            "name": "宝具 1",
            "text": {
                "1_B050": "两仪宝印——",
                "1_B051": "来了呢——",
                "1_B052": "先去学点礼数再来如何？",
                "1_B053": "望月如今也已成往昔了哦。"
            }
        },
        "1_B080": {
            "name": "スキル 1",
            "text": {
                "1_B080": "呼……好热……"
            }
        },
        "1_B090": {
            "name": "スキル 2",
            "text": {
                "1_B090": "哎呀，真顽皮呢。"
            }
        },
        "1_B100": {
            "name": "開始 1",
            "text": {
                "1_B100": "明明是来纳凉的，结果还是要战斗啊？ 难道是我平时积的德不够吗？"
            }
        },
        "1_B110": {
            "name": "開始 2",
            "text": {
                "1_B110": "我想看的其实是烟花……不过也没办法吧。"
            }
        },
        "1_B120": {
            "name": "勝利 1",
            "text": {
                "1_B120": "冷静下来了吗？　但愿你还能看到庭园里的牵牛花呢。"
            }
        },
        "1_B130": {
            "name": "勝利 2",
            "text": {
                "1_B130": "衣摆弄脏了呢。看来我也还差得远呢。"
            }
        },
        "1_B140": {
            "name": "ダメージ 2",
            "text": {
                "1_B140": "还差得远呢。"
            }
        },
        "1_B150": {
            "name": "ダメージ 1",
            "text": {
                "1_B150": "危机！"
            }
        },
        "1_B160": {
            "name": "戦闘不能 1",
            "text": {
                "1_B160": "失礼了，木屐的鞋带断了。"
            }
        },
        "1_B170": {
            "name": "戦闘不能 2",
            "text": {
                "1_B170": "这笔账我一定会讨回来。可别忘了哦。"
            }
        },
        "1_B180": {
            "name": "コマンドカード 1",
            "text": {
                "1_B180": "在哪里附近？"
            }
        },
        "1_B190": {
            "name": "コマンドカード 2",
            "text": {
                "1_B190": "好啦好啦。"
            }
        },
        "1_B200": {
            "name": "コマンドカード 3",
            "text": {
                "1_B200": "我喜欢。"
            }
        },
        "1_B2010": {
            "name": "アタック 10",
            "text": {
                "1_B2010": "斩落！"
            }
        },
        "1_B2020": {
            "name": "アタック 11",
            "text": {
                "1_B2020": "来迎接我似乎还太早了呢！"
            }
        },
        "1_B2030": {
            "name": "アタック 12",
            "text": {
                "1_B2030": "咻～！　兔子跑得好快！"
            }
        },
        "1_B210": {
            "name": "宝具カード 1",
            "text": {
                "1_B210": "这就是所谓的传家宝刀（撒手锏）吧。"
            }
        },
        "1_B220": {
            "name": "宝具カード 2",
            "text": {
                "1_B220": "来一场无仁义之战吧。"
            }
        },
        "1_B230": {
            "name": "宝具カード 3",
            "text": {
                "1_B230": "礼金我会还给你的。"
            }
        },
        "1_B2410": {
            "name": "アタック 13",
            "text": {
                "1_B2410": "团扇十字斩！"
            }
        },
        "1_B2420": {
            "name": "アタック 14",
            "text": {
                "1_B2420": "这样总够了吧！"
            }
        },
        "1_B2430": {
            "name": "アタック 15",
            "text": {
                "1_B2430": "无明，双月！"
            }
        },
        "1_B2810": {
            "name": "アタック 16",
            "text": {
                "1_B2810": "就算穿着和服，这种程度也没问题！"
            }
        },
        "1_B410": {
            "name": "アタック 4",
            "text": {
                "1_B410": "两拍，一拍子！"
            }
        },
        "1_B420": {
            "name": "アタック 5",
            "text": {
                "1_B420": "夏天的风暴呢。"
            }
        },
        "1_B430": {
            "name": "アタック 6",
            "text": {
                "1_B430": "夏天就是风暴！"
            }
        },
        "1_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "1_B440": "祭典结束了哦。请前往冥府吧。"
            }
        },
        "1_B480": {
            "name": "スキル 3",
            "text": {
                "1_B480": "做好思想准备了吗？"
            }
        },
        "1_B490": {
            "name": "スキル 4",
            "text": {
                "1_B490": "你是哪个帮派的？"
            }
        },
        "1_B500": {
            "name": "開始 3",
            "text": {
                "1_B500": "这身和服可是我最喜欢的哦。千万别给我弄脏了。"
            }
        },
        "1_B520": {
            "name": "勝利 3",
            "text": {
                "1_B520": "真是的，至少让人好好纳个凉啊。夏天都被你们糟蹋了。"
            }
        },
        "1_B560": {
            "name": "戦闘不能 3",
            "text": {
                "1_B560": "我不是说了别弄脏嘛！？ 秋隆，把替换的衣服拿来！"
            }
        },
        "1_B800": {
            "name": "宝具 2",
            "text": {
                "1_B800": "真是一群不明事理的家伙。",
                "1_B801": "受过的恩情，",
                "1_B802": "可不是这点程度就能报答的！",
                "1_B803": "至少元旦那天我会返乡哦。"
            }
        },
        "1_B810": {
            "name": "宝具 3",
            "text": {
                "1_B810": "让你见识——",
                "1_B811": "所谓极限！",
                "1_B812": "凋零于十六夜吧！",
                "1_B813": "你以为还能把人带回去吗？"
            }
        },
        "1_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "1_B840": "花的生命本就短暂吧？"
            }
        },
        "1_B880": {
            "name": "スキル 5",
            "text": {
                "1_B880": "冰淇淋的话，就另当别论了哦。"
            }
        },
        "1_B890": {
            "name": "スキル 6",
            "text": {
                "1_B890": "好，脑袋开始冰得头疼了……！"
            }
        },
        "1_B910": {
            "name": "アタック 7",
            "text": {
                "1_B910": "缩地，南风！"
            }
        },
        "1_B920": {
            "name": "アタック 8",
            "text": {
                "1_B920": "刺穿！"
            }
        },
        "1_B930": {
            "name": "アタック 9",
            "text": {
                "1_B930": "唉——！"
            }
        },
        "1_G010": {
            "name": "レベルアップ 1",
            "text": {
                "1_G010": "谢谢。",
                "1_G011": "我会用成果来回报你给我的，放心吧。"
            }
        },
        "1_G020": {
            "name": "霊基再臨 2",
            "text": {
                "1_G020": "啊，木屐的鞋带快断了。",
                "1_G021": "看来下一次再临不会是什么正经样子。",
                "1_G022": "对外示人的规矩模样只能到此为止了。",
                "1_G023": "会不会很遗憾？"
            }
        },
        "1_G030": {
            "name": "霊基再臨 1",
            "text": {
                "1_G030": "好了，危险的行为也该到此为止了。",
                "1_G031": "我好歹也是个有人等我回家的人，而且一说到夏天，本来就少不了缘日庙会吧？",
                "1_G032": "比起大海，还是山里更能让我静下心来。",
                "1_G033": "要是还有烟火的话，就更无可挑剔了。"
            }
        },
        "1_G110": {
            "name": "レベルアップ 2",
            "text": {
                "1_G110": "但愿体型不要发生改变。",
                "1_G111": "毕竟你没法帮我穿和服吧？"
            }
        },
        "1_G120": {
            "name": "レベルアップ 3",
            "text": {
                "1_G120": "呵呵。",
                "1_G121": "你帮我做成水羊羹了吧，御主？"
            }
        },
        "1_H010": {
            "name": "誕生日",
            "text": {
                "1_H010": "生日我会送些日用品。",
                "1_H011": "女孩子的话就送梳妆打扮用的物品。",
                "1_H012": "男孩子的话就送些当下流行的玩具。",
                "1_H013": "要是与你的喜好不符，那就先说声抱歉了哦。"
            }
        },
        "1_H020": {
            "name": "イベント開催中",
            "text": {
                "1_H020": "御主，快起床。该工作了哦。"
            }
        },
        "1_H030": {
            "name": "会話 1",
            "text": {
                "1_H030": "既然天气这么好，还是出去散散步吧。",
                "1_H031": "这可是保持健康的秘诀哦。"
            }
        },
        "1_H040": {
            "name": "会話 2",
            "text": {
                "1_H040": "虽然不必对父母言听计从，但还是要听听他们怎么说。",
                "1_H041": "毕竟可以成为将来的参考。"
            }
        },
        "1_H050": {
            "name": "会話 3",
            "text": {
                "1_H050": "和御主的关系应该不错吧？"
            }
        },
        "1_H060": {
            "name": "好きなこと",
            "text": {
                "1_H060": "喜欢的东西……",
                "1_H061": "夏天应该是素面吧。那种口感太棒了。",
                "1_H062": "但是千万注意别吃太多了。",
                "1_H063": "那东西可是一大坨碳水化合物哦。"
            }
        },
        "1_H070": {
            "name": "嫌いなこと",
            "text": {
                "1_H070": "我没有讨厌的东西。",
                "1_H071": "……硬要说的话，大概是过于完美的财务管理吧。"
            }
        },
        "1_H080": {
            "name": "聖杯について",
            "text": {
                "1_H080": "希望圣杯实现的愿望吗……",
                "1_H081": "是啊。能不能给我一个还保留着传统烟花大会的特异点呢？"
            }
        },
        "1_H10090": {
            "name": "絆Lv.1",
            "text": {
                "1_H10090": "你那表情是想说我的语气和性格都变了吧。",
                "1_H10091": "这只不过说明我也能这样待人处世罢了。",
                "1_H10092": "阴与阳。女性化的式与男性化的式。",
                "1_H10093": "至于哪一边才是真正的我，还是不说为好。"
            }
        },
        "1_H10100": {
            "name": "絆Lv.2",
            "text": {
                "1_H10100": "穿着浴衣也照样能战斗吧？",
                "1_H10101": "毕竟这是我的日常穿着。反倒是洋装会让我觉得不自在。"
            }
        },
        "1_H10110": {
            "name": "絆Lv.3",
            "text": {
                "1_H10110": "玉兔是学生时代的两仪式。",
                "1_H10111": "而我则是比她稍微年长一些的两仪式。",
                "1_H10112": "啊，不好。玉兔的真名应该是保密的吧。"
            }
        },
        "1_H10120": {
            "name": "絆Lv.4",
            "text": {
                "1_H10120": "在迦勒底不跳盆踊啊。机库里搭个舞台应该还是能办到的。",
                "1_H10121": "如果真的举办的话，你最想做什么？",
                "1_H10122": "我的话，应该是捞金鱼。",
                "1_H10123": "那种刺激感令人欲罢不能呢。"
            }
        },
        "1_H10130": {
            "name": "絆Lv.5",
            "text": {
                "1_H10130": "……唉。",
                "1_H10131": "我本以为自己早就告别打打杀杀的日子了，看来还是不行呢。",
                "1_H10132": "要是让家人看到我这么投入的样子，真不知道该怎么解释才好。",
                "1_H10133": "要帮我保密哦？"
            }
        },
        "1_H210": {
            "name": "会話 4",
            "text": {
                "1_H210": "那个可怕的人，是叫静希草十郎先生吧。",
                "1_H211": "虽然总觉得不是初次见面，我们以前在哪里见过吗？"
            }
        },
        "1_H220": {
            "name": "会話 5",
            "text": {
                "1_H220": "放烟花～！",
                "1_H221": "那位金发的小姑娘……不，是茨木童子小姐吧。",
                "1_H222": "她的宝具满怀着孩子们的梦想。",
                "1_H223": "真希望有朝一日能和她一起发动合体宝具。"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "弦月！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "哈啊！"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "哼哈成！"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "是不是有些不得体呢？"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "——多么野蛮。",
                "2_B051": "月亮的品位也堕落了吗。",
                "2_B052": "向海月（水母）学习吧！",
                "2_B053": "地上也是有月亮的哦。"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "强人所难。"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "飞耳长目。"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "玉兔辉夜，登场！ 依照地上的作风上吧。"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "受到的恩情决不会忘记。 让各位见识一下月之光辉吧。"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "今晚的事还请保密。不可以告诉任何人。 ——我可是拜托你了哦？"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "敲打，敲打。比捣年糕还轻松。 名副其实的毫无韧性呢。"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "呵呵"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "看来，已经没法从容了呢……！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "我先回一趟家。回头能再叫我吗？"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "倒也不至于回月亮。我只是去找把刀。"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "基本掌握了。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "该选哪种呢？"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "那就有劳了。"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "银钩，兔返……！"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "哈啊！"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "姮娥，无影抄。"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "看来是惹怒人了呢。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "虽然不是所谓的休书。"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "兔子的慈悲只有三次。"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "嘿嘿嘿嘿！　收尾！"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "捣捣捣捣！　天诛！"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "给我，看过来！"
            }
        },
        "2_B2810": {
            "name": "アタック 16",
            "text": {
                "2_B2810": "刺绣剑，纤月！"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "首级、首级，还是首级！"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "月晕，三射！"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "到此为止！"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "这是倾尽全力的，捣年糕——！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "开始捣年糕！"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "天都快亮了哦。"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "竹可断缘不灭。 诸位恶徒，是否做好思想准备了呢？"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "真是一场酣畅淋漓的胜利。 接下来也要继续干脆利落地修整地表哦。"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "还是实力不够吗……真想把宝具循环效率再提高一些呢……"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "柔竹之上，",
                "2_B801": "点亮之命，何其可怜。",
                "2_B802": "以天剑回礼还望谅解！",
                "2_B803": "消失于两仪的狭缝中吧。"
            }
        },
        "2_B810": {
            "name": "宝具 3",
            "text": {
                "2_B810": "祭典结束了呢。",
                "2_B812": "——直死。",
                "2_B813": "这便是残留之月啊。"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "金乌玉兔，被砸扁吧～！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "真好吃呢。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "当然是草莓味的。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "敬天爱人剑！"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "敲打。"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "忌月，一闪！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "如果您期望成长，那便如你所愿。",
                "2_G011": "我会以精彩的表现来报恩。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "父亲大人、母亲大人。一直以来万分感谢两位的照顾。",
                "2_G041": "而今后我也会继续在这片大地上尽到自己应尽的情义——",
                "2_G042": "没错。比起出生之地，更重要的是养育自己的人。这样的故事也未尝不可吧？",
                "2_G043": "玉兔式成为辉夜式，借这个夏天正式登场♡"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "『我』这种本不被允许拥有自我的存在竟能获得这样的机会，想必一定是佛祖的慈悲吧。",
                "2_G051": "嗯。辉夜姬的话一定会这么说。",
                "2_G052": "而我则会这么回答，「月亮上的兔子有何不可。反正都被洗脑了，也没办法」。",
                "2_G053": "所以还请对我的些许顽皮多包涵，御主。",
                "2_G054": "毕竟在耀眼的月夜蹦跳的兔子似乎还远没有玩够呢♡"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "居然升级了。",
                "2_G111": "这是不是意味着，你还愿意继续陪我呢？"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "接下来会非常辛苦，但要加油哦。",
                "2_G121": "就把这当作培养公主的抚养费吧☆"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "太好了，是期盼已久的生日呢。",
                "2_H011": "一年里最美好的一天到来了。",
                "2_H012": "今年要不要边赏月边庆祝生日呢？",
                "2_H013": "放心吧。就算是阴天，就算正值新月，我也会为你带来最美的月亮哦。"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "正在举办活动呢，看起来很有趣。",
                "2_H021": "走吧，御主。",
                "2_H022": "我的刀在闪耀，杵子也在跃跃欲试哦。"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "月色好明亮啊。",
                "2_H031": "一起出去散步吧？"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "只要你下令，我可以随时一刀两断任何东西。",
                "2_H041": "呵呵。至于善后嘛，就用答应我的一个请求来换吧。"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "和御主的关系？",
                "2_H051": "是啊。这个形象的话，应该可以用各种无理难题来为难你吧。"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的东西是年糕。",
                "2_H061": "毕竟这可是望月（年糕）的由来嘛。"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "讨厌的东西是刨冰。",
                "2_H071": "太冰或许会让我恢复理性吧？"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "虽然我无法向圣杯许愿，但如果给我的话，我可不会客气哦♡",
                "2_H081": "呵呵，我知道。",
                "2_H082": "冠位职阶终于开放了吧？"
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "御主，重新自我介绍一下。",
                "2_H20091": "我是辉夜之式。被望月的光辉所浸染，各种方面都变得轻盈了的地上之月。",
                "2_H20092": "也就是说，是剑士职阶的我变得兴奋的状态哦。",
                "2_H20093": "偶尔变成这样也不错吧？　毕竟正值『筷子掉了都会觉得好笑』的年纪嘛。"
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "必须立于境界狭缝间的我，和必须返回月亮的柔竹公主。",
                "2_H20101": "你看，不觉得我们很像吗？"
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "可别因为我外表看起来文静，就对我太客气。",
                "2_H20111": "能够依照你的命令战斗才是我最大的喜悦。"
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "这么说来，我和柔竹公主还有另一个共同点。",
                "2_H20121": "我在现世不会睡觉，而那位公主夜晚或许也会仰望月亮思念着故乡而无法入眠吧。"
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "很在意我既然不用睡觉，那夜里都在做什么吗？",
                "2_H20131": "当然——是在想招式名啦。",
                "2_H20132": "难得能以剑士身份战斗，按照礼仪，自然应该连细节部分都精心讲究吧？"
            }
        },
        "2_H230": {
            "name": "会話 4",
            "text": {
                "2_H230": "希望你别再无端找茬了。",
                "2_H231": "这个主题自古以来就是属于大家的吧？",
                "2_H232": "再说了，你才叫无法无天。",
                "2_H233": "不仅是圣诞老人，还和魔法少女撞人设，你是贪心界的公主吗？"
            }
        },
        "2_H240": {
            "name": "会話 5",
            "text": {
                "2_H240": "正统本家的月兔登场了呢。",
                "2_H241": "虽然是未来的事了。",
                "2_H242": "不过话说回来……竟然是金色的兔子……",
                "2_H243": "搞怪角色不管做什么都很适合呢。",
                "2_H244": "真令人羡慕。"
            }
        },
        "2_H250": {
            "name": "会話 6",
            "text": {
                "2_H250": "真是一场虚缈的梦呢，藤乃小姐。",
                "2_H251": "做过一生仅一次的梦了吗？",
                "2_H252": "不过那样应该就够了。",
                "2_H253": "可要好好感谢我和御主他们哦。"
            }
        },
        "2_H260": {
            "name": "会話 7",
            "text": {
                "2_H260": "身处教会之人常说自己见识过地狱，但走过地狱又回来的圣者，大概也就只有你了吧。虽然现在或许只有痛苦，但岁月一定会拯救你的。",
                "2_H261": "",
                "2_H262": ""
            },
            "raw_text": {
                "2_H260": "教会に身を置いたもの 地獄を見たとはよく言うけれど、地獄を歩いて戻ってきた。聖者はあなたくらいね。今は苦しみしかないでしょうけど、きっと 年月があなたを救うわ。",
                "2_H261": "",
                "2_H262": ""
            }
        }
    },
    "ChrVoice_ids": [
        "109833670",
        "109833680",
        "2301100"
    ]
}