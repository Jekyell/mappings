        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "虽然严重超支，但顾不得那么多了，",
                "0_B811": "做好亏损准备的大出血特大奉送！最终八咫乌，粉碎！",
                "0_B812": "又得努力打工赚钱了。"
            },
            "raw_text": {
                "0_B810": "予算オーバーだけど、背に腹は代えられない。",
                "0_B811": "赤字覚悟の出血大サービス！ファイナルヤタガラス、クラーッシュ！",
                "0_B812": "またお仕事頑張らなきゃ。"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "现在开始杂贺突击，",
                "0_B821": "兽心合体，八咫——乌！",
                "0_B822": "咚咔咔咔咔咔咔咔！去吧——"
