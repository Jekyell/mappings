{
    "id": 405700,
    "collectionNo": 452,
    "name": "ネモ／ノア",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "让对方失去抵抗能力！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "这可不是普通的武器！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "大漩涡！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "绝不留情！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "孩子啊，看看这契约的晴空吧。",
                "0_B051": "歌斐木，万物之理，被隐藏的神之试炼。",
                "0_B052": "光应该赐予你们而非我。",
                "0_B053": "诺亚方舟！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "无论多大的风暴都要突破。"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "将命运托付给上天吗……"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "开始作战。全体人员，各就各位。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "我不惜付出牺牲。作战本就是冷酷无情的。"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "战斗结束。确认全体船员平安无事。"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "作战完成。现在开始返航！"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "呜……"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "呜……！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "到此为止了吗……后继者，拜托你了。"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "大海啊，我将回到你的怀抱。"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "没有异议。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "这是好机会。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "Aye，御主。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "瞄准。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "要让其命中！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "喝！呀！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "启航的时候到了！"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "将你们的性命先托付给我吧！"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "前进。这样才对。"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "轮到你们了。"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "四散飞舞。"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "准备冲角战！"
            }
        },
        "0_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "0_B2440": "这是我的王国。"
            }
        },
        "0_B250": {
            "name": "宝具カード 4",
            "text": {
                "0_B250": "你做出了选择。"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "去吧——！"
            }
        },
        "0_B2820": {
            "name": "アタック 17",
            "text": {
                "0_B2820": "装填完毕，发射！"
            }
        },
        "0_B2830": {
            "name": "アタック 18",
            "text": {
                "0_B2830": "捕捉了！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "是！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "休想逃跑！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "哈——！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "紧急下潜！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "好了，去吧。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "靠你了。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "为了不属于任何人的海洋，以及自由！"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "唔唔～……是宿醉吗……"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "真是令人欣喜的结果呢，御主。"
            }
        },
        "0_B530": {
            "name": "勝利 4",
            "text": {
                "0_B530": "呼……真想弹风琴呢……"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "呜……！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "没能躲开……"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "灵魂被过去束缚了。"
            }
        },
        "0_B570": {
            "name": "戦闘不能 4",
            "text": {
                "0_B570": "鹦鹉螺号……好怀念你啊。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "暴风雨已然过去！　方舟啊，照耀大地吧！",
                "0_B801": "吾乃佐哈尔，是延续世界的太祖！",
                "0_B802": "喜悦此刻将化作希望！ 黄金之虹，诺亚方舟！"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "声呐有反应……"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "右满舵！"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "救、救世美少年！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "朋友啊。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "在那里。"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "发现敌影……！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "谢谢你。 我得把这件事仔细地记在航海日志上才行。"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "到下次再临时，我就会……不，还是不说了。",
                "0_G021": "你应该也已经隐约察觉到了。",
                "0_G022": "唉……"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "毕竟这次的任务不同寻常，身为军人，我得把警戒等级提高一级。 虽然会显得有些拘谨，不过还是希望你能习惯。",
                "0_G031": "不过，军阶倒并不会因此提升，只是心态的问题罢了。"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "愿与你共赴一段美好的航程。 将信赖与感谢献给你。"
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "呵呵……很好。 灵基的成长无论经历多少次，都会令人高兴呢。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "♪～",
                "0_H011": "……生日快乐，御主。",
                "0_H012": "虽然微不足道，但这段演奏就是我送给你的礼物。",
                "0_H013": "如果还有其他想听的曲子，还请尽管说。",
                "0_H014": "呵呵。"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "是活动……",
                "0_H021": "正所谓好事多磨，绷紧神经参加吧。"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "准备好了吗，御主？",
                "0_H031": "那么，就启航吧。"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "我是一名注重纪律的军人。",
                "0_H041": "不会在其中掺杂个人感情。"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "御主应该算我的长官……也就是司令官。",
                "0_H051": "或者说是这艘舰船的主人吧。",
                "0_H052": "无论如何，我都会依照契约帮助你。",
                "0_H053": "只要你没有迷失自我。"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的事情，应该是弹奏风琴的时间吧。",
                "0_H061": "哎……芭菲……？",
                "0_H062": "这，这个嘛，倒也不是……毫无兴趣啦。"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的东西是米字旗……",
                "0_H071": "啊，不……我也该改掉这种孩子气的态度了。"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯……",
                "0_H081": "作为尼莫的话，大概会认为那是相当有用的兵器吧。",
                "0_H082": "至于我个人的愿望……已经留在更年轻时的自己那里了。"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "我只是唯一的尼莫。",
                "0_H091": "虽然负责了一艘船，但它并不是我原本的船。",
                "0_H092": "当然，也没有船员。",
                "0_H093": "你说我曾经将人格分割出来作为船员？　而且大家都不一样？",
                "0_H094": "哈哈。真是个有意思的玩笑。",
                "0_H095": "充满了梦想呢。"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "青年尼莫没有软弱可言。",
                "0_H101": "虽然没有……",
                "0_H102": "但基于各种原因，倒是经常会松懈。",
                "0_H103": "在那种情况下，如果可能的话，希望你能当做没看见。"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "你差不多也该知道我的真实身份了吧。",
                "0_H111": "那边的我说话总喜欢夸大。",
                "0_H112": "所以希望你听的时候只信一半就好。",
                "0_H113": "……那个。",
                "0_H114": "尤其是在他表达好感的时候。"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "作为拥有船只相关轶事的英灵，能够管理方舟是我的荣誉。",
                "0_H121": "虽然我也不知道为何会选中我，但作为一介深爱人世的人，我发誓定会让这希望绽放出应有的光辉。",
                "0_H122": "……不过话说回来。不管是特里同，还是诺亚，我总是会变成这种设定复杂的从者呢……",
                "0_H123": "虽然诺亚说我们的共通点是都很怕寂寞……",
                "0_H124": "但应该没有那种事吧……"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "无论身为尼莫，还是诺亚，我的作战目的都不会改变。",
                "0_H131": "当世界濒临毁灭之际，帮助那个试图反抗、努力挺过去的你。",
                "0_H132": "这是一项非常值得为之奋斗的任务。"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "鹦鹉螺号……",
                "0_H171": "即便它只是作为宝具显现的转瞬即逝的幻想。",
                "0_H172": "我的灵魂也仍然栖息在那里。",
                "0_H173": "栖息在那座泛着黯淡光泽的黄铜船舵前。"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "当知道了迦勒底内也有流淌着我故乡血脉的人，我感到非常高兴。",
                "0_H181": "不过，该怎么说呢……",
                "0_H182": "我总觉得守望方的神话中诸神，以及叙事诗中的英雄的数量占据了压倒性多数啊。"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "嗯……",
                "0_H191": "看来在这艘肩负着人类命运的舰船上，已经集结了与之相称的专家们呢。",
                "0_H192": "没错，不只是魔术。",
                "0_H193": "魔术与科学，推动这艘船的两种螺旋桨。",
                "0_H194": "真希望能让世人见识到这种力量，以及引领未来的光啊。"
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "骑兵，尼莫。响应召唤，前来参战。",
                "0_S011": "即使没有鹦鹉螺号，我也有其他的船。",
                "0_S012": "别看我这样，其实这灵基里不止一个人，而是有复数人格……",
                "0_S013": "……咦？　这样反而才是正常状态？",
                "0_S014": "是、是这样的吗……",
                "0_S015": "救世美少年尼莫·佐哈尔什么的……为什么会变成这样啊？",
                "0_S016": "原本意味着谁都不是的尼莫之名都快哭出来了哦。"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "בָּרָק שָׁמַיִם（天之雷火）！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "天之雷火！"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "רוּחַ（风暴）！"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "בהמה טהורה（洁净的牲畜）……！"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "伊甸的守护者，生命之树的守护者啊。",
                "2_B051": "寄宿于吾之方舟，显现汝之圣姿，向他们宣告审判吧！",
                "2_B052": "再创世的试炼！"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "伟大的火啊！"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "真希望别再刮暴风雨了呢～！"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "轮到我出场啦。 交给我吧，交给我吧！"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "与光辉同在。"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "辛苦了。来，举办酒宴吧！"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "尘归尘，土归土……"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "啊……！"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "唔……！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "到底错在了哪里呢……"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "我知道……我会认真反省……"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "נָכוֹן（准备好了）。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "我会遵从那个声音。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "好呀！"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "火与风之仆从现身吧！"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "מְצָא…טָס（去寻找，飞吧）！"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "履行你的职责！"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "来吧，登上我的方舟！"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "暴风雨要来了……！"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "显现吧，我的荣耀！"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "塞菲罗特的守护者啊。"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "呀嗬～。"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "בתר（斩开）……"
            }
        },
        "2_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "2_B2440": "很遗憾，不能让你上船……"
            }
        },
        "2_B250": {
            "name": "宝具カード 4",
            "text": {
                "2_B250": "天之怒将毁灭他们。"
            }
        },
        "2_B2810": {
            "name": "アタック 16",
            "text": {
                "2_B2810": "斩开。"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "吹飞吧！"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "קָרַב（献上）。"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "上啦～！"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "洁净的牲畜啊……！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "愿获祝福。"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "是个好消息。"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "到试炼的时间了吧。"
            }
        },
        "2_B510": {
            "name": "開始 4",
            "text": {
                "2_B510": "救世美少年尼莫·佐哈尔，启航！"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "出色的工作自然会得到出色的成果。理所当然。"
            }
        },
        "2_B530": {
            "name": "勝利 4",
            "text": {
                "2_B530": "出色的御主配出色的从者。 呵呵。真般配，真般配。"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "啊……！"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": "这才是……试炼。"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "受诅咒吧……成为仆从吧……"
            }
        },
        "2_B570": {
            "name": "戦闘不能 4",
            "text": {
                "2_B570": "都怪昨晚的葡萄酒……对不起，御主。"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "契约之舟至此！",
                "2_B801": "转动智慧之轮，于暴风与雷鸣之下，",
                "2_B802": "展开光辉之翼，彰显天之震怒吧！",
                "2_B803": "再创世的试炼！"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "没问题♪　大家动手吧！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "自大地万物而来。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "好乖好乖好乖♪"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "עַמּוּד אֵשׁ（炎之柱）！"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "看这光辉吧！"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "להט（火）！"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "哈利路亚……",
                "2_G011": "为这份幸福献上感谢。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "即使面对毁灭世界的灾厄，尼莫船长也不会屈服！",
                "2_G041": "我心中的光辉不会坐视不理！",
                "2_G042": "救世美少年尼莫·佐哈尔，在此登场！",
                "2_G043": "开玩笑的啦！",
                "2_G044": "怎么样，很可靠吧，御主？",
                "2_G045": "我是继承了英灵诺亚之力的你的骑兵。",
                "2_G046": "可以叫我尼莫·佐哈尔、尼莫诺亚，或是尼莫哥哥，想怎么称呼都可以。"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "作为从者的这年轻的形象既是诺亚，也是尼莫。",
                "2_G051": "方舟虽然只能任凭天意，在暴风雨的浪涛间漂流。可现在说点真心话，我曾无数次希望祈祷能够化作风，推动船只破浪前行。",
                "2_G052": "所以御主，能牢牢握住自身船舵的你，令我非常羡慕。",
                "2_G053": "尼莫也是如此。",
                "2_G054": "我是否能够等到成为鹦鹉螺号的一员，陪伴在掌舵的你身旁的那一天呢？",
                "2_G055": "呵呵。"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "你理解我了吗？",
                "2_G111": "那么，我可以稍微拉近一点距离吗？"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "当然啦，因为我是个勤劳的人嘛！",
                "2_G121": "虽然偶尔……也会偷个懒。"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "你的诞生之日……",
                "2_H011": "那已是逝去的过去。",
                "2_H012": "真正应该赞颂的，是努力活在今天这个日子的如今的你。",
                "2_H013": "为感谢这种幸福，也为了明天的喜悦，我会在此祈祷。"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "在这祭典之日，献上初熟的麦穗……"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "来，走吧！",
                "2_H031": "去寻找希望的枝条！"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "支配他人是不好的，但引导家人的家长还是有必要的。",
                "2_H041": "时而严厉，有时温暖。",
                "2_H042": "……可是，动物们好像觉得我很烦……",
                "2_H043": "这是为什么呢……"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "御主也是我的家人。",
                "2_H051": "你可以尽管依赖我。",
                "2_H052": "所以，也请你好好照顾我哦。"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "喜欢的东西……",
                "2_H061": "是葡萄酒！",
                "2_H062": "……不过那是不可或缺的东西，所以不算吧。",
                "2_H063": "啊，这是我个人的“讲究点”。",
                "2_H064": "不管什么东西，只要凑出一对来就会心情舒畅呢。"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "讨厌的东西是自己内心的软弱。",
                "2_H071": "绝不会舍弃希望。",
                "2_H072": "相信并不是为了得到回报。",
                "2_H073": "相信这种行为本身就具有意义。",
                "2_H074": "这才是……为了活下去所必要的力量哦。"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "圣杯！",
                "2_H081": "当然，我会许愿获得富饶的大地！",
                "2_H082": "毕竟光靠我一个人是养活不了动物们的！"
            }
        },
        "2_H200": {
            "name": "会話 4",
            "text": {
                "2_H200": "他……不，应该说她吗？",
                "2_H201": "如果站在他身旁，我大概会紧张吧。",
                "2_H202": "发现化石层的达·芬奇在留下的手稿中明确提出了质疑。",
                "2_H203": "为什么会在山上发现海洋生物的化石？　将这作为“诺亚的洪水”发生的依据是错误的！",
                "2_H204": "……我一直担心那位万能的天才会不会这样逼问我。",
                "2_H205": "但即便如此，他仍然非常虔诚。",
                "2_H206": "晚年还绘制了许多想象中的大洪水素描。",
                "2_H207": "在他的自然观里，世界末日一直与圣经中的大洪水的印象联系在一起吧。",
                "2_H208": "不知道是否有机会和他探讨洪水呢……"
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "诺亚这个名字意思是“安慰”。",
                "2_H20091": "这名字对平时酷酷的尼莫船长来说是不是不太合适？"
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "忍耐、劳动、体贴、感谢。",
                "2_H20101": "虽然都是理所当然的事，但都是生活中不可或缺的。",
                "2_H20102": "御主也不要忘记哦。"
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "诺亚被称作『大洪水』后人类的祖先，但我其实并不是什么特别的存在。",
                "2_H20111": "只不过是被神选中的一个随处可见的农夫罢了。"
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "我不太擅长应付狮子呢……",
                "2_H20121": "不如说很害怕……",
                "2_H20122": "以前我曾经因为偷懒没喂食，结果被它咬住了腿……",
                "2_H20123": "当时我真的深刻反省了。",
                "2_H20124": "忘记喂食好几个星期确实不太好吧？"
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "嗯……说实话，有时候也搞不清自己究竟是尼莫还是诺亚。",
                "2_H20131": "是诺亚的影响改变了性格，还是诺亚使用了原本就存在的一面。",
                "2_H20132": "不过，这个形象的我很喜欢开朗的自己。",
                "2_H20133": "葡萄酒最棒了，脱光也很舒服嘛！",
                "2_H20134": "要说有什么问题的话，大概就是换回军服后会抱着头懊恼吧？"
            }
        },
        "2_H210": {
            "name": "会話 5",
            "text": {
                "2_H210": "……真不可思议呢。",
                "2_H211": "明明容貌犹如死亡化作人形出现般令人恐惧、毛骨悚然。",
                "2_H212": "却又给人一丝怀念的感觉。",
                "2_H213": "他大概不会喝酒吧。",
                "2_H214": "但应该也不至于什么都不吃。",
                "2_H215": "要不要带上我珍藏的椰枣去拜访他呢。"
            }
        },
        "2_H220": {
            "name": "会話 6",
            "text": {
                "2_H220": "冠位、Grand……",
                "2_H221": "呵呵，冠位啊……",
                "2_H222": "骑兵虽然也不错，但种田是非常棒的事哦。",
                "2_H223": "麦田支撑明日的生活，橄榄树让生命绽放光辉。",
                "2_H224": "而最重要的当然是葡萄！",
                "2_H225": "因为葡萄酒能取悦心灵嘛。",
                "2_H226": "好想做冠位农夫啊～～。",
                "2_H227": "哎～？　谁是冠位醉汉啊？",
                "2_H228": "喂，你有在听吗，冠友？"
            }
        },
        "2_H230": {
            "name": "会話 7",
            "text": {
                "2_H230": "大天使梅塔特隆……",
                "2_H231": "总觉得有一丝……与玛土撒拉爷爷相似的气息……",
                "2_H232": "平时虽然温和，可一旦觉醒就会变得无从下手……的感觉。",
                "2_H233": "有种只要靠信仰的力量和超越信仰的压倒性暴力……力量就能解决一切的势头。",
                "2_H234": "……哎？　那里可能……主要是贞德的成分？",
                "2_H235": "啊……原来是这样啊。"
            }
        }
    },
    "ChrVoice_ids": [
        "405700"
    ]
}