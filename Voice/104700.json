            },
            "raw_text": {
                "0_B010": ""
            }
        },
        "0_B020": {
            "name": "攻击 2",
            "text": {
                "0_B020": "太慢了！"
            }
        },
        "0_B030": {
            "name": "攻击 3",
            "text": {
                "0_B030": "斩！"
            }
        },
        "0_B040": {
            "name": "额外攻击 1",
            "text": {
                "0_B040": "鬼火的时间。"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "临·兵·斗·者·皆·阵·列·在·前。",
                "0_B051": "吾之剑，乃斩魔性之物。",
                "0_B052": "大江山·菩提鬼杀！",
                "0_B053": "燃烧吧，消灭罪障。"
            }
        },
        "0_B080": {
            "name": "技能 1",
            "text": {
                "0_B080": "斩。"
            }
        },
        "0_B090": {
            "name": "技能 2",
            "text": {
                "0_B090": "杀。"
            }
        },
        "0_B100": {
            "name": "开始 1",
            "text": {
                "0_B100": "明白了。决定斩杀。"
            }
        },
        "0_B110": {
            "name": "开始 2",
            "text": {
                "0_B110": "虽然不擅长应对魔性之外的存在……但总有办法吧。"
            }
        },
        "0_B120": {
            "name": "胜利 1",
            "text": {
                "0_B120": "那接下来去斩杀下个敌人吧。 怎么了，不走吗？"
            }
        },
        "0_B130": {
            "name": "胜利 2",
            "text": {
                "0_B130": "这样啊，结束了啊。 那去寻找下个鬼吧。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": ""
            },
            "raw_text": {
                "0_B140": ""
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": ""
            },
            "raw_text": {
                "0_B150": ""
            }
        },
        "0_B160": {
            "name": "无法战斗 1",
            "text": {
                "0_B160": "到此为止了吗……茨木……对不起……"
            }
        },
        "0_B170": {
            "name": "无法战斗 2",
            "text": {
                "0_B170": "还有……未斩之物……没能……"
            }
        },
        "0_B180": {
            "name": "指令卡 1",
            "text": {
                "0_B180": "嗯。"
            }
        },
        "0_B190": {
            "name": "指令卡 2",
            "text": {
                "0_B190": "好。"
            }
        },
        "0_B200": {
            "name": "指令卡 3",
            "text": {
                "0_B200": "明白了。"
            }
        },
        "0_B210": {
            "name": "宝具卡 1",
            "text": {
                "0_B210": "前去斩杀。请提供支援。"
            }
        },
        "0_B220": {
            "name": "宝具卡 2",
            "text": {
                "0_B220": "既然有鬼出现，就该轮到我出马了。"
            }
        },
        "0_B230": {
            "name": "宝具卡 3",
            "text": {
                "0_B230": "划九字印。然后斩首。"
            }
        },
        "0_B2440": {
            "name": "额外攻击 4",
            "text": {
                "0_B2440": "供奉花朵。"
            }
        },
        "0_B250": {
            "name": "宝具卡 4",
            "text": {
                "0_B250": "啊啊。这瞬间总是让人很不舒服。"
            }
        },
        "0_B410": {
            "name": "攻击 4",
            "text": {
                "0_B410": "只有这种水平吗，那么！"
            }
        },
        "0_B420": {
            "name": "攻击 5",
            "text": {
                "0_B420": "斩杀！"
            }
        },
        "0_B430": {
            "name": "攻击 6",
            "text": {
                "0_B430": "太天真了。"
            }
        },
        "0_B440": {
            "name": "额外攻击 2",
            "text": {
                "0_B440": "化为灰烬吧。"
            }
        },
        "0_B480": {
            "name": "技能 3",
            "text": {
                "0_B480": "屠戮魔性。"
            }
        },
        "0_B490": {
            "name": "技能 4",
            "text": {
                "0_B490": "砍下首级。"
            }
        },
        "0_B500": {
            "name": "开始 3",
            "text": {
                "0_B500": "嗯。鬼就会斩杀，除此以外都可以试着斩杀。"
            }
        },
        "0_B510": {
            "name": "开始 4",
            "text": {
                "0_B510": "恶鬼邪鬼，全都应被根绝。"
            }
        },
        "0_B520": {
            "name": "胜利 3",
            "text": {
                "0_B520": "茨木……你……"
            }
        },
        "0_B530": {
            "name": "胜利 4",
            "text": {
                "0_B530": "所谓的人理还真是难办呢……"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": ""
            },
            "raw_text": {
                "0_B540": ""
            }
        },
        "0_B550": {
            "name": "受击 3",
            "text": {
                "0_B550": "要坚持住……！"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "划九字印，鼓舞自己。",
                "0_B801": "吾乃杀害鬼之剑。",
                "0_B802": "出击！　大江山·菩提鬼杀！",
                "0_B803": "相遇是一种不幸，对彼此都是。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "金刚针、大金刚轮、",
                "0_B811": "外狮子、内狮子、",
                "0_B812": "外缚、内缚、智拳、日轮、隐形。",
                "0_B813": "——大江山·菩提鬼杀。",
                "0_B814": "结束了。"
            }
        },
        "0_B840": {
            "name": "额外攻击 3",
            "text": {
                "0_B840": "身披业炎。"
            }
        },
        "0_G010": {
            "name": "升级 1",
            "text": {
                "0_G010": "啊啊，变强了吗。"
            }
        },
        "0_G020": {
            "name": "灵基再临 2",
            "text": {
                "0_G020": "虽然没什么变化，但感觉身体变轻了。"
            }
        },
        "0_G030": {
            "name": "灵基再临 1",
            "text": {
                "0_G030": "既然拔出了刀，就只能斩了。",
                "0_G031": "没问题。"
            }
        },
        "0_G040": {
            "name": "灵基再临 3",
            "text": {
                "0_G040": "发色变了？",
                "0_G041": "啊啊，应该是鬼切安纲的影响吧。",
                "0_G042": "变强了？　或许吧，但没什么大不了的。",
                "0_G043": "因为人类是无法轻易变强的。",
                "0_G044": "只能每天坚持修行。"
            }
        },
        "0_G050": {
            "name": "灵基再临 4",
            "text": {
                "0_G050": "您在那里啊，我的主公。",
                "0_G051": "希望您能亲眼见证我这全力的一刀。",
                "0_G052": "将一切都寄托在这一击上，我会不断斩杀鬼，斩杀魔性。",
                "0_G053": "很抱歉我只会做这种血腥的事——",
                "0_G054": "但还请允许我在您身边多陪伴您一阵。"
            }
        },
        "0_G110": {
            "name": "升级 2",
            "text": {
                "0_G110": "挥下的刀刃要快，要强……对吧。"
            }
        },
        "0_H010": {
            "name": "生日",
            "text": {
                "0_H010": "今天好像是您的生日吧。",
                "0_H011": "我不觉得自己拥有能给与您喜悦的东西……",
                "0_H012": "可即便如此，我至少也能送上祝福。",
                "0_H013": "生日快乐，我的主公。"
            }
        },
        "0_H020": {
            "name": "活动举行中",
            "text": {
                "0_H020": "主公。看来正在举办祭典。",
                "0_H021": "还是不要偷懒努力获得素材为好。"
            }
        },
        "0_H030": {
            "name": "对话 1",
            "text": {
                "0_H030": "应该出击了吧。"
            }
        },
        "0_H040": {
            "name": "对话 2",
            "text": {
                "0_H040": "我的主公。我会身为从者侍奉您。",
                "0_H041": "我对这种关系……没什么异议。"
            }
        },
        "0_H050": {
            "name": "对话 3",
            "text": {
                "0_H050": "不是并肩战斗，就是留在后方。",
                "0_H051": "无论哪种，我应该都需要纲绳来掌控吧。",
                "0_H052": "……不，我不是在说谐音梗冷笑话。",
                "0_H053": "真的不是。"
            }
        },
        "0_H060": {
            "name": "喜欢的东西",
            "text": {
                "0_H060": "喜欢的东西吗？",
                "0_H061": "没有爱好。对不起。"
            }
        },
        "0_H070": {
            "name": "讨厌的东西",
            "text": {
                "0_H070": "我并不讨厌鬼或是魔性。",
                "0_H071": "只是因为有斩杀的必要才会斩杀。",
                "0_H072": "从这个角度来说，我或许讨厌相互厮杀腥风血雨的战场吧。"
            }
        },
        "0_H080": {
            "name": "关于圣杯",
            "text": {
                "0_H080": "圣杯啊……",
                "0_H081": "像我这样的人没有任何愿望。",
                "0_H082": "就算弥补遗憾，也毫无意义……"
            }
        },
        "0_H090": {
            "name": "牵绊Lv.1",
            "text": {
                "0_H090": "唔，是主公啊。有事吗？"
            }
        },
        "0_H100": {
            "name": "牵绊Lv.2",
            "text": {
                "0_H100": "因为还在修行剑术，请允许我告退。"
            }
        },
        "0_H110": {
            "name": "牵绊Lv.3",
            "text": {
                "0_H110": "虽然还在修行剑术，但如果您不介意的话，",
                "0_H111": "我愿意陪您畅谈。"
            }
        },
        "0_H120": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H120": "斩杀鬼的方法吗？　并不会很难哦。",
                "0_H121": "鬼的动作很容易预测。",
                "0_H122": "比方说，如果伸手，就先把手臂斩断，并反手一刀斩下首级。",
                "0_H123": "这样如果还能动的话，只要砍身体和脚就能解决问题了。很简单吧？",
                "0_H124": "……我难道说了什么奇怪的话吗？"
            }
        },
        "0_H130": {
            "name": "牵绊Lv.5",
            "text": {
                "0_H130": "主公。应该称呼您为御主吧。",
                "0_H131": "我有个问题。",
                "0_H132": "我完全不理解您为何要强忍着与我这种枯燥乏味的男人来往呢，这是为什么？",
                "0_H133": "但是……既然您这么做，我自然应该报以最大程度的敬意。",
                "0_H134": "此身毕竟只能成为砍东西的菜刀。",
                "0_H135": "还请您随意使用。只要是您挥舞的刀刃，就不可能成为为恶的凶刃。"
            }
        },
        "0_H1600": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H1600": "在我看来，",
                "0_H1601": "人类比起鬼和魔性要难斩杀得多，但很少有人支持我这个意见……",
                "0_H1602": "就连金时都露出那种这人到底在说什么的表情看着我……"
            }
        },
        "0_H170": {
            "name": "对话 4",
            "text": {
                "0_H170": "茨木童子在……这里吗？",
                "0_H171": "不，我不该见她。",
                "0_H172": "一旦见到她，我就有可能毁了她的一切吧。",
                "0_H173": "即便如此，该斩杀她的那天也终会到来。",
                "0_H174": "因为我的人生与剑，就是为了斩杀她而存在的。",
                "0_H175": "即便成为了从者，这也不会改变。"
            }
        },
        "0_H190": {
            "name": "对话 5",
            "text": {
                "0_H190": "酒吞童子在这里啊。",
                "0_H191": "真棘手。",
                "0_H192": "虽然很想交给金时去处理，但总觉得那样做会导致其他问题。",
                "0_H193": "再说了，不把她关起来未免太成问题了。",
                "0_H194": "她不是那种可以放任自由的鬼。"
            }
        },
        "0_H210": {
            "name": "对话 6",
            "text": {
                "0_H210": "他们也继承了鬼之血吗……",
                "0_H211": "他们经历的人生一定非常严苛吧。",
                "0_H212": "唔？　问我为什么不斩杀？",
                "0_H213": "如果用血来区分鬼与人的话，那从走上为恶道路的那一刻，就该被称作鬼了吧。",
                "0_H214": "如果平日努力为人，那就不算是鬼。"
            }
        },
        "0_H220": {
            "name": "对话 7",
            "text": {
                "0_H220": "她也是鬼？　鬼界的偶像？",
                "0_H221": "主公，不对。",
                "0_H222": "她是货真价实的蜥蜴。称她为鬼未免太没礼貌了。",
                "0_H223": "话说，她为何会那么生气……？"
            }
        },
        "0_H230": {
            "name": "对话 8",
            "text": {
                "0_H230": "赖光大人。从今往后，纲将成为主公的部下。",
                "0_H231": "作为前辈，请不吝赐教。",
                "0_H232": "我已经做好斩杀鬼、魔性的准备了。"
            }
        },
        "0_H240": {
            "name": "对话 9",
            "text": {
                "0_H240": "金时……你这样子……",
                "0_H241": "是不是被这个时代过度毒害了……？",
                "0_H242": "不，这种样子反而更好吗。",
                "0_H243": "这样更为Golden啊。原来如此。"
            }
        },
        "0_H250": {
            "name": "对话 10",
            "text": {
                "0_H250": "赖光大人。这身衣服比平时更为轻便呢。",
                "0_H251": "夏天专用？　风纪委员？",
                "0_H252": "唔……虽然我完全不明白，但有什么需要尽管吩咐。",
                "0_H253": "只要是该斩杀的我就会斩杀。"
            }
        },
        "0_H260": {
            "name": "对话 11",
            "text": {
                "0_H260": "原来如此。",
                "0_H261": "虽然没有角，但有狐狸耳朵和尾巴，带着手机，穿着制服到处晃的她就是铃鹿御前吗？",
                "0_H262": "唔，要素太多了，既然堆积了那么多要素，那已经不是什么鬼了。"
            }
        },
        "0_H270": {
            "name": "对话 12",
            "text": {
                "0_H270": "伊吹童子……吗。",
                "0_H271": "如果主公要求我不去斩杀，我就不会斩杀。",
                "0_H272": "要我斩杀的话，我可以立刻照办。",
                "0_H273": "现在我能说的只有这些。",
                "0_H274": "不管怎样，都会是拼上性命的任务吧……"
            }
        },
        "0_S010": {
            "name": "召唤",
            "text": {
                "0_S010": "……Saber，渡边纲。",
                "0_S011": "没什么好说的，若要斩杀鬼或魔性的话，我应该很合适吧。",
                "0_S012": "稍微有些不太擅长斩杀人，这点还请手下留情。"
            }
        },
        "11_B010": {
            "name": "アタック 1 ヴァンプ武者",
            "text": {
                "11_B010": "变身。"
            },
            "raw_text": {
                "11_B010": "変身。"
            }
        },
        "11_B020": {
            "name": "アタック 2 ヴァンプ武者",
            "text": {
                "11_B020": "很快的。"
            },
            "raw_text": {
                "11_B020": "早いぞ。"
            }
        },
        "11_B030": {
            "name": "アタック 3 ヴァンプ武者",
            "text": {
                "11_B030": "咬咬看。"
            },
            "raw_text": {
                "11_B030": "噛む。"
            }
        },
        "11_B040": {
            "name": "エクストラアタック 1 ヴァンプ武者",
            "text": {
                "11_B040": "我要化身为鬼了。"
            },
            "raw_text": {
                "11_B040": "鬼になるぞ。"
            }
        },
        "11_B080": {
            "name": "スキル 1 ヴァンプ武者",
            "text": {
                "11_B080": ""
            },
            "raw_text": {
                "11_B080": "すう。"
            }
        },
        "11_B090": {
            "name": "スキル 2 ヴァンプ武者",
            "text": {
                "11_B090": "输血。"
            },
            "raw_text": {
                "11_B090": "輸血だ。"
            }
        },
        "11_B100": {
            "name": "開始 1 ヴァンプ武者",
            "text": {
                "11_B100": "原来如此。不是斩，而是决定要吸啊。"
            },
            "raw_text": {
                "11_B100": "なるほど。切る、ではなく、吸うことにする。"
            }
        },
        "11_B110": {
            "name": "開始 2 ヴァンプ武者",
            "text": {
                "11_B110": "斩，然后吸。"
            },
            "raw_text": {
                "11_B110": "切る、そして吸う。"
            }
        },
        "11_B120": {
            "name": "勝利 1 ヴァンプ武者",
            "text": {
                "11_B120": "稍微有点不便行动。但是！只要孩子们开心便足矣吧。"
            },
            "raw_text": {
                "11_B120": "少し 動きにくいな。 だが！ 子供の喜びには代えられまいか。"
            }
        },
        "11_B130": {
            "name": "勝利 2 ヴァンプ武者",
            "text": {
                "11_B130": "那么，作为胜者就吸点血吧……啊，不，不吸吗。"
            },
            "raw_text": {
                "11_B130": "では、勝者として血を吸うか……あ、いや、吸わないか。"
            }
        },
        "11_B160": {
            "name": "戦闘不能 1 ヴァンプ武者",
            "text": {
                "11_B160": "果然还是换回衣服比较好啊。"
            },
            "raw_text": {
                "11_B160": "やはり着替えた方がいいな。"
            }
        },
        "11_B170": {
            "name": "戦闘不能 2 ヴァンプ武者",
            "text": {
                "11_B170": "我可没有手下留情啊。"
            },
            "raw_text": {
                "11_B170": "手を抜いていたわけではないないのだが。"
            }
        },
        "11_B180": {
            "name": "コマンドカード 1 ヴァンプ武者",
            "text": {
                "11_B180": ""
            },
            "raw_text": {
                "11_B180": "よし。"
            }
        },
        "11_B190": {
            "name": "コマンドカード 2 ヴァンプ武者",
            "text": {
                "11_B190": "可以。"
            },
            "raw_text": {
                "11_B190": "いいだろう。"
            }
        },
        "11_B200": {
            "name": "コマンドカード 3 ヴァンプ武者",
            "text": {
                "11_B200": "了解。"
            },
            "raw_text": {
                "11_B200": "了解。"
            }
        },
        "11_B210": {
            "name": "宝具カード 1 ヴァンプ武者",
            "text": {
                "11_B210": "要吸血吗。"
            },
            "raw_text": {
                "11_B210": "血を吸うのか。"
            }
        },
        "11_B220": {
            "name": "宝具カード 2 ヴァンプ武者",
            "text": {
                "11_B220": "若是鬼就由我……不，我也是鬼吗。"
            },
            "raw_text": {
                "11_B220": "鬼なら俺が……いや、俺も鬼か。"
            }
        },
        "11_B230": {
            "name": "宝具カード 3 ヴァンプ武者",
            "text": {
                "11_B230": "切九字也可以吗。"
            },
            "raw_text": {
                "11_B230": "くじを切ってもいいか。"
            }
        },
        "11_B2440": {
            "name": "エクストラアタック 4 ヴァンプ武者",
            "text": {
                "11_B2440": "收下盐吧。"
            },
            "raw_text": {
                "11_B2440": "塩を受け取れ。"
            }
        },
        "11_B250": {
            "name": "宝具カード 4 ヴァンプ武者",
            "text": {
                "11_B250": "好，上吧。"
            },
            "raw_text": {
                "11_B250": "よしやるか。"
            }
        },
        "11_B410": {
            "name": "アタック 4 ヴァンプ武者",
            "text": {
                "11_B410": "太天真了。"
            },
            "raw_text": {
                "11_B410": "甘いぞ。"
            }
        },
        "11_B420": {
            "name": "アタック 5 ヴァンプ武者",
            "text": {
                "11_B420": "白费力气。"
            },
            "raw_text": {
                "11_B420": "無駄だ。"
            }
        },
        "11_B430": {
            "name": "アタック 6 ヴァンプ武者",
            "text": {
                "11_B430": "消散于黑暗中吧。"
            },
            "raw_text": {
                "11_B430": "闇に消えろ。"
            }
        },
        "11_B440": {
            "name": "エクストラアタック 2 ヴァンプ武者",
            "text": {
                "11_B440": "绝不留情。"
            },
            "raw_text": {
                "11_B440": "一切の容赦はない。"
            }
        },
        "11_B480": {
            "name": "スキル 3 ヴァンプ武者",
            "text": {
                "11_B480": "化为罗刹。"
            },
            "raw_text": {
                "11_B480": "羅刹となる。"
            }
        },
        "11_B490": {
            "name": "スキル 4 ヴァンプ武者",
            "text": {
                "11_B490": "咬向咽喉。"
            },
            "raw_text": {
                "11_B490": "首を噛む。"
            }
        },
        "11_B500": {
            "name": "開始 3 ヴァンプ武者",
            "text": {
                "11_B500": "若是鬼我便斩杀，但现在的我也算鬼吗。"
            },
            "raw_text": {
                "11_B500": "鬼なら斬るが、今の俺も鬼か。"
            }
        },
        "11_B510": {
            "name": "開始 4 ヴァンプ武者",
            "text": {
                "11_B510": "恶鬼现身！……我也算恶吗。"
            },
            "raw_text": {
                "11_B510": "悪鬼は立つ！俺も悪か。"
            }
        },
        "11_B520": {
            "name": "勝利 3 ヴァンプ武者",
            "text": {
                "11_B520": "我该放得开的时候也是能放开的。就是这么回事。"
            },
            "raw_text": {
                "11_B520": "俺だって弾ける時は弾ける。そういうことだ。"
            }
        },
        "11_B530": {
            "name": "勝利 4 ヴァンプ武者",
            "text": {
                "11_B530": "真是桩麻烦事啊，所谓的乔装变装。"
            },
            "raw_text": {
                "11_B530": "難儀なものだな。仮装というのは。"
            }
        },
        "11_B540": {
            "name": "ダメージ 4 ヴァンプ武者",
            "text": {
                "11_B540": ""
            },
            "raw_text": {
                "11_B540": "ふむ。"
            }
        },
        "11_B550": {
            "name": "ダメージ 3 ヴァンプ武者",
            "text": {
                "11_B550": "顶得住。"
            },
            "raw_text": {
                "11_B550": "耐える。"
            }
        },
        "11_B840": {
            "name": "エクストラアタック 3 ヴァンプ武者",
            "text": {
                "11_B840": "这样就可以了吗。"
            },
            "raw_text": {
                "11_B840": "これでいいのか。"
            }
        },
        "11_G010": {
            "name": "レベルアップ 1 ヴァンプ武者",
            "text": {
                "11_G010": "啊，变强了吗。"
            },
            "raw_text": {
                "11_G010": "ああ、強くなっているのか。"
            }
        },
        "11_G060": {
            "name": "霊衣開放 ヴァンプ武者",
            "text": {
                "11_G060": "正值万圣节，我便乔装成了鬼种。不过，据说是西欧的鬼种。斩鬼的我穿成这样，不会显得很讽刺吗。不要紧吗。据说我是个吸食一切血液的吸血鬼。血啊。也就是说，是蚊子怪物对吧。不是吗。蝙蝠？蝙蝠会吸血吗。无论如何，节日按常理来说就是要尽情享受的。请多关照了，我的主上。",
                "11_G061": "",
                "11_G062": "",
                "11_G063": "",
                "11_G064": "",
                "11_G065": "",
                "11_G066": "",
                "11_G067": "",
                "11_G068": "",
                "11_G069": ""
            },
            "raw_text": {
                "11_G060": "ハロウィンということで、騎手への仮装だ。ただ、西欧の騎手という話だが。鬼を斬る俺が斬ると、嫌味にならないだろうか。大丈夫か。俺は何でも血を吸うヴァンパイアだそうだ。血か。つまり、蚊のモンスターというわけだな。違うのか。コウモリ。コウモリは血を吸うのか。ともかく、祭りは楽しむものと相場が決まっている。よろしく頼む、我が主。",
                "11_G061": "",
                "11_G062": "",
                "11_G063": "",
                "11_G064": "",
                "11_G065": "",
                "11_G066": "",
                "11_G067": "",
                "11_G068": "",
                "11_G069": ""
            }
        },
        "11_G110": {
            "name": "レベルアップ 2 ヴァンプ武者",
            "text": {
                "11_G110": "挥刃当迅捷、刚猛，是这样吧。"
            },
            "raw_text": {
                "11_G110": "振る刃は素早く、強く、だな。"
            }
        },
        "11_H9000": {
            "name": "霊衣について ヴァンプ武者",
            "text": {
                "11_H9000": "潜伏于黑夜之中，从窗户现身吸血。据说这就是我。突然从窗户现身不就成可疑分子了吗。弱点是大蒜和十字架吗。我不讨厌大蒜，但十字架或许真有点应付不来。因为和大藏院殿切磋过几次，总会让我联想到十文字枪的枪尖。",
                "11_H9001": "",
                "11_H9002": "",
                "11_H9003": "",
                "11_H9004": ""
            },
            "raw_text": {
                "11_H9000": "夜の闇に潜み、窓から現れて血を吸う。それが俺らしい。窓から突然現れたら不審者にならないか。苦手なものはニンニクと十字架か。ニンニクは苦手ではないが、十字架は苦手かもしれないな。大蔵院殿と何度か仕合ったせいで、十文字槍の穂先を思い出す",
                "11_H9001": "",
                "11_H9002": "",
                "11_H9003": "",
                "11_H9004": ""
            }
        }
    },
