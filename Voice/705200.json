    "name": "呼延灼",
    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": "喝！"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": "哼！"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": "那边！"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "劈顶唐竹斩！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "我将高声呐喊着迅猛穿过！",
                "0_B051": "人马一体！　化身万千！",
                "0_B052": "大降临连环马猛袭击！",
                "0_B053": "呼延灼·Ｖ——！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "预备～咚！"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "怎么样？"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "请看着我哦，御主！ 呼延灼会努力的～！"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "呼延灼加油！ 没错，我是最强的！"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "我们赢了，御主。您觉得呼延灼的表现如何！"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "那个……今天也赢了。请多给我点几个赞……"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": "没什么！"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "好痛，好痛啊！"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "呜呜……夏天……夏天蛊惑了我……"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "垂头丧气……对不起，御主……"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "好！"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "可以！"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "我会努力的！"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "猛禽一击刺！"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "穿刺之刑！"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "一闪红莲光！"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "要用宝具……上了！"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "要大闹一场了吧！"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "明白了！"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "你很碍事哦！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "大卸八块之刃！"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "接招吧！"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "倒立剑舞！"
            }
        },
        "0_B2820": {
            "name": "アタック 17",
            "text": {
                "0_B2820": "看招看招看招看招！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "回旋斩骨！"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "劈斩！"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "万刃蜂巢！"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "一、二，嘿！"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "您觉得如何？"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "耶～！"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "不气馁、要努力、我很强！ 好，我们出发吧！"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "呜呜，我已经不行了……虽然不行了…… 但就算不行也要努力……嗯……"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "哼哼～，这就是呼延灼和恩浦萨的力量哦！　嗯！"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "啊好痛！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "受不了宝具啦——！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "哎，啊，暂、暂停！　暂停一下啦～！"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "那我出发啦，御主！",
                "0_B801": "仔细看好我的英姿吧！",
                "0_B802": "大降临连环马猛袭击！",
                "0_B803": "只要有您注视着，我就是无敌的！"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "就算没有战马，只要自己跑就够了！",
                "0_B811": "现在应该可以趁乱喊出来了！",
                "0_B812": "大降临连环马猛袭击！",
                "0_B813": "最喜欢御主啦——！",
                "0_B814": "我什么都没说哦——！"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "全力脚跟劈落！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "希望能爆红！"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "我要起跑啦～！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "连环飞踢！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "双夏盐踢！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "跳跃斩击！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "哈呼，升级了呢……"
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "这对耳朵不是兔耳，而是驴耳。",
                "0_G021": "嗯，因为想增加一点恩浦萨元素……",
                "0_G022": "适、适合我吗？"
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "是的，泳装就这一套，没有变化！",
                "0_G031": "虽然没有变化，但如果您愿意让我成长，我会非常开心的！"
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "我已经强大不少了。这样一来，也不会拖大家的后腿了。",
                "0_G041": "……再加一点，再加一点。"
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "今年的夏天也非常快乐！",
                "0_G051": "不，虽然夏天或许还没有结束，但我觉得应该很快乐！",
                "0_G052": "我还有好多想和御主一起做的事！",
                "0_G053": "首先，那个……我可以，再贴近您一点吗？"
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "我会变得越来越强的！"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "御主，生日快乐！",
                "0_H011": "我会背负您前行的，还请下达指示。",
                "0_H012": "只要是您的愿望，无论天涯海角，我都会一直跑下去！"
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "活动正在举办哦，御主。"
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "御主、御主、御主……",
                "0_H031": "您醒着吗，您醒着吗～……？",
                "0_H032": "我们一起出门吧……"
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主从关系吗？",
                "0_H041": "我当然是御主的宠……",
                "0_H042": "不对，是看门狗……",
                "0_H043": "也不对，是看门从者！"
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和御主的关系吗？",
                "0_H051": "嗯，我希望今后也能继续加深关系！"
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西吗？",
                "0_H061": "虽然我还是极度渴望得到他人的认同，",
                "0_H062": "但希望得到御主认同的心情是最为强烈的！"
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "讨厌的事情吗？",
                "0_H071": "虽然有很多……",
                "0_H072": "但如果被御主抛弃的话……",
                "0_H073": "我应该会死吧……",
                "0_H074": "嗯……"
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯吗？",
                "0_H081": "……获得肉身之后的户籍该怎么解决呢？",
                "0_H082": "这点无论如何都很想先问清楚！"
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "是的，御主，您叫我吗！"
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "呵呵，御主、御主……",
                "0_H101": "啊，没事，只是试着叫两声而已。",
                "0_H102": "只是觉得，自己内心越来越兴奋了……"
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "陷入危机的御主，及时赶到的呼延灼。「我决不会让任何人伤害这位！」",
                "0_H111": "……是不是应该用更帅一点的台词呢……"
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "御主，虽然有些突然……",
                "0_H121": "但您现在有没有陷入什么危机？",
                "0_H122": "不，我并不是希望您遇到危险！",
                "0_H123": "我只是想帅气地搭救御主，再来一些华丽的武打动作！　提升的牵绊！　相连的灵基！　然后就是！",
                "0_H124": "然后就是……希、希望能有大团圆结局！"
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "……刚才我的那种兴奋到底是怎么回事啊……",
                "0_H131": "我已经冷静下来了……",
                "0_H132": "不过，愿为御主赴汤蹈火这点是真的。",
                "0_H133": "无论何时何地，我都会成为御主的狗背负您前进！",
                "0_H134": "……啊，不是狗，是驴！",
                "0_H135": "居然说错了最重要的部分！！"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "快看啊，燕青。",
                "0_H171": "哼哼～～，我终于也得到泳装了哦！",
                "0_H172": "",
                "0_H173": "感谢你的掌声。",
                "0_H174": "这样一来，我也不用在夏日活动里打扮得那么闷热了。",
                "0_H175": "来，让我们一起加油吧！"
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "伊丽亲～～～！　我终于换上泳装了～！",
                "0_H181": "谢谢你，谢谢你。",
                "0_H182": "这一切都是多亏了伊丽亲。",
                "0_H183": "我差点因为过于感动导致直接消灭了……"
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "那位也换上泳装了吗……。",
                "0_H191": "是呢，我和她或许确实有几分相似呢……"
            }
        },
        "0_H2300": {
            "name": "会話 3 (絆Lv.5以上)",
            "text": {
                "0_H2300": "和御主的关系吗？",
                "0_H2301": "那个……应该是缔结了牵绊的，关系吧……"
            }
        },
        "0_I010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 8",
            "text": {
                "0_I010": "御主，欢迎光临～！",
                "0_I011": "我是商店店员呼延灼。既然受托担任这份工作，我一定会努力干好的！",
                "0_I012": "所以如果您能给我一点奖励的话，我会非常开心的！"
            }
        },
        "0_I020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 9",
            "text": {
                "0_I020": "您来了啊，御主。",
                "0_I021": "店里开着舒适的空调，请尽情在这里凉快吧。"
            }
        },
        "0_I030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 10",
            "text": {
                "0_I030": "好的。这是您要的道具。",
                "0_I031": "请收下，请收下。"
            }
        },
        "0_I040": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 11",
            "text": {
                "0_I040": "这是我亲手做的，请收下！",
                "0_I041": "……对不起，刚才我说的有些夸大其词了。",
                "0_I042": "其实并不是我亲手做的……"
            }
        },
        "0_I050": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 12",
            "text": {
                "0_I050": "好的，是要兑换道具吧。",
                "0_I051": "要不要顺便把我也一起带走呢？",
                "0_I052": "开玩笑的啦～！",
                "0_I053": "……开玩笑的……",
                "0_I054": "呵呵……我还是消失吧……"
            }
        },
        "0_I060": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 13",
            "text": {
                "0_I060": "没错，我就是本年度闯祸第一名从者，呼延灼！",
                "0_I061": "……呜哇啊啊啊，搞砸啦～～～！"
            }
        },
        "0_I070": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 14",
            "text": {
                "0_I070": "请忘了吧……",
                "0_I071": "忘掉、忘掉、快忘掉～……"
            }
        },
        "0_N010": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 1",
            "text": {
                "0_N010": "我是呼延灼。哎嘿嘿，欢迎御主光临！",
                "0_N011": "来吧，今年也努力赚取点数吧！"
            }
        },
        "0_N020": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 2",
            "text": {
                "0_N020": "御主、御主、御主！　我是呼延灼，我是呼延灼哦～！",
                "0_N021": "今年夏天，也会与您共度！"
            }
        },
        "0_N030": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 3",
            "text": {
                "0_N030": "点数奖励里有您想要的东西吗？",
                "0_N031": "请记得去确认一下哦。"
            }
        },
        "0_N040": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 4",
            "text": {
                "0_N040": "辛苦了，御主。",
                "0_N041": "如何，要一起沿着海边跑一会儿吗？",
                "0_N042": "青春感简直爆棚哦！"
            }
        },
        "0_N050": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 5",
            "text": {
                "0_N050": "通知是很重要的哦。",
                "0_N051": "吴老师也是这么说的。"
            }
        },
        "0_N060": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 6",
            "text": {
                "0_N060": "呵……呵呵呵……",
                "0_N061": "我是那个最后关头还犯下大错的呼延灼……",
                "0_N062": "对不起我居然还活着……"
            }
        },
        "0_N070": {
            "name": "カルデア・Ｕ－サマーアイランド\n～大統領は夏の夢を見るか？～ 7",
            "text": {
                "0_N070": "我在夏天快结束时闯下了那么大的祸……",
                "0_N071": "我的反省之意比大海还要深……",
