  "voices": {
    "0_N010": {
      "name": "关于活动 1",
      "text": {
        "0_N010": "欢迎来到茶信庵NOBU。",
        "0_N011": "希望您能在这里慢慢治愈平日里的遗憾NOBU！"
      }
    },
    "0_N020": {
      "name": "关于活动 2",
      "text": {
        "0_N020": "在这里可以泡茶NOBU！",
        "0_N021": "希望您能凝聚创意开辟崭新的茶道境界NOBU。"
      }
    },
    "0_N030": {
      "name": "关于活动 3",
      "text": {
        "0_N030": "NOBUNOBU～♪",
        "0_N031": "淘气茶茶～♪",
        "0_N032": "泡成一杯好茶NOBU～♪"
      }
    },
    "0_N040": {
      "name": "关于活动 4",
      "text": {
        "0_N040": "只要倒入热水搅拌搅拌！",
        "0_N041": "这就是茶道的奥秘NOBU！"
      }
    },
    "0_N050": {
      "name": "关于活动 5",
      "text": {
        "0_N050": "NOBUNOBUNOBU，茶信！",
        "0_N051": "……从难以发言到能正常发言NOBU。",
        "0_N052": "要仔细阅读帮助信息NOBU！"
      }
    },
    "0_N060": {
      "name": "关于活动 6",
      "text": {
        "0_N060": "差不多要关店NOBU。",
        "0_N061": "努力不要留下什么事忘记做NOBU哦。"
      }
    },
    "0_N070": {
      "name": "关于活动 7",
      "text": {
        "0_N070": "茶信的生命很短暂NOBU，差不多也该和大家道别NOBU。",
        "0_N071": "但这次邂逅并非没有意义NOBU。",
        "0_N072": "那么，祈祷着人类的过错或大自然的愤怒会导致全新迷你信诞生……",
        "0_N073": "非同寻常茶道之战，感谢您的参与NOBU！"
      }
    },
    "0_N080": {
      "name": "关于活动 8",
      "text": {
        "0_N080": "由于利休居士行踪不明，只能由不肖小人茶信来陪伴各位NOBU！",
        "0_N081": "还请各位多多关照NOBU。"
      }
    }
  },
