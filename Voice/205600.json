        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "以华丽的盛装……",
                "0_B801": "父亲大人、阎魔大人。",
                "0_B802": "——包在我身上。",
                "0_B803": "劝善惩恶，就在此时！",
                "0_B804": "掌控恶业，阎魔法王！"
