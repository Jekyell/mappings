{
    "id": 9947740,
    "name": "Enemy 9947740",
    "voices": {
        "0_B010": {
            "name": "0_B010",
            "text": {
                "0_B010": "大力干一场吧！"
            },
            "raw_text": {
                "0_B010": "力強くやっちゃうぜ。"
            }
        },
        "0_B020": {
            "name": "0_B020",
            "text": {
                "0_B020": "超级重哦。"
            },
            "raw_text": {
                "0_B020": "デージ重いぞ。"
            }
        },
        "0_B030": {
            "name": "0_B030",
            "text": {
                "0_B030": "风狮爷～"
            },
            "raw_text": {
                "0_B030": "しーさー。"
            }
        },
        "0_B040": {
            "name": "0_B040",
            "text": {
                "0_B040": "石狮战甲，开火！"
            },
            "raw_text": {
                "0_B040": "シサロット、ファイヤー。"
            }
        },
        "0_B080": {
            "name": "0_B080",
            "text": {
                "0_B080": "出发啰——！石狮之星！"
            },
            "raw_text": {
                "0_B080": "行くぞー！シースター。"
            }
        },
        "0_B090": {
            "name": "0_B090",
            "text": {
                "0_B090": "绝对不能原谅！"
            },
            "raw_text": {
                "0_B090": "絶対に許さない。"
            }
        },
        "0_B120": {
            "name": "0_B120",
            "text": {
                "0_B120": "很好，我正是为此而生的！"
            },
            "raw_text": {
                "0_B120": "よし、ボクはこのために。"
            }
        },
        "0_B130": {
            "name": "0_B130",
            "text": {
                "0_B130": "太棒啦！是大胜利呢。"
            },
            "raw_text": {
                "0_B130": "やったぜ！大勝利なんだわ。"
            }
        },
        "0_B140": {
            "name": "0_B140",
            "text": {
                "0_B140": "痛死啦！"
            },
            "raw_text": {
                "0_B140": "あがー。"
            }
        },
        "0_B150": {
            "name": "0_B150",
            "text": {
                "0_B150": "出大问题啦！"
            },
            "raw_text": {
                "0_B150": "デージナトーン。"
            }
        },
        "0_B160": {
            "name": "0_B160",
            "text": {
                "0_B160": "对不起，风狮爷。"
            },
            "raw_text": {
                "0_B160": "ごめんよ、志衣さん。"
            }
        },
        "0_B170": {
            "name": "0_B170",
            "text": {
                "0_B170": "必须由我……来守护才行。"
            },
            "raw_text": {
                "0_B170": "ボクが……守らなきゃ。"
            }
        },
        "0_B180": {
            "name": "0_B180",
            "text": {
                "0_B180": "绝不认输！"
            },
            "raw_text": {
                "0_B180": "負けない。"
            }
        },
        "0_B190": {
            "name": "0_B190",
            "text": {
                "0_B190": "就是这个！"
            },
            "raw_text": {
                "0_B190": "これだ。"
            }
        },
        "0_B200": {
            "name": "0_B200",
            "text": {
                "0_B200": "冲啊——！"
            },
            "raw_text": {
                "0_B200": "いくさー。"
            }
        },
        "0_B360": {
            "name": "0_B360",
            "text": {
                "0_B360": "看来还有更大的家伙在呢。"
            },
            "raw_text": {
                "0_B360": "まだまだ大きいやつがいるんだな。"
            }
        },
        "0_B410": {
            "name": "0_B410",
            "text": {
                "0_B410": "一！二！三！"
            },
            "raw_text": {
                "0_B410": "ティーチ！タッチ！ミーチ。"
            }
        },
        "0_B420": {
            "name": "0_B420",
            "text": {
                "0_B420": "这就是正义的分量！"
            },
            "raw_text": {
                "0_B420": "これが正義の重みだ。"
            }
        },
        "0_B430": {
            "name": "0_B430",
            "text": {
                "0_B430": "用肉垫压扁你！"
            },
            "raw_text": {
                "0_B430": "肉球で押しつぶす。"
            }
        },
        "0_B440": {
            "name": "0_B440",
            "text": {
                "0_B440": "南国大火球！发射！"
            },
            "raw_text": {
                "0_B440": "南国大火球！発射。"
            }
        },
        "0_B480": {
            "name": "0_B480",
            "text": {
                "0_B480": "要打起干劲来咯—。"
            },
            "raw_text": {
                "0_B480": "気合い、入れるんだわー。"
            }
        },
        "0_B490": {
            "name": "0_B490",
            "text": {
                "0_B490": "怪兽出现啦—。"
            },
            "raw_text": {
                "0_B490": "怪獣が出たぞー。"
            }
        }
    }
}