{
  "id": 9948180,
  "name": "Enemy 9948180",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "哇啊！"
      },
      "raw_text": {
        "0_B010": "ひゃっ！"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "喝！"
      },
      "raw_text": {
        "0_B020": "ふんっ！"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "尝尝这招如何！"
      },
      "raw_text": {
        "0_B030": "これはどうだ！"
      }
    },
    "0_B040": {
      "name": "0_B040",
      "text": {
        "0_B040": "我好歹也算是个Assassin啊！"
      },
      "raw_text": {
        "0_B040": "これでも一応、アサシンだからね！"
      }
    },
    "0_B050": {
      "name": "0_B050",
      "text": {
        "0_B050": "只能……喝下去了吗。"
      },
      "raw_text": {
        "0_B050": "飲むしか……ないのか。"
      }
    },
    "0_B051": {
      "name": "0_B051",
      "text": {
        "0_B051": "来了！来了！来了！来了！来了！"
      },
      "raw_text": {
        "0_B051": "来た！来た！来た！来た！来た"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "灵基，限定强化！"
      },
      "raw_text": {
        "0_B080": "霊気、限定強化！"
      }
    },
    "0_B100": {
      "name": "0_B100",
      "text": {
        "0_B100": "这也是没办法的事。"
      },
      "raw_text": {
        "0_B100": "仕方ないか。"
      }
    },
    "0_B110": {
      "name": "0_B110",
      "text": {
        "0_B110": "好，来试试看吧。"
      },
      "raw_text": {
        "0_B110": "よし、やってみよう。"
      }
    },
    "0_B120": {
      "name": "0_B120",
      "text": {
        "0_B120": "我帮上忙了吗？"
      },
      "raw_text": {
        "0_B120": "役に立てたかな？"
      }
    },
    "0_B130": {
      "name": "0_B130",
      "text": {
        "0_B130": "这样就好了。"
      },
      "raw_text": {
        "0_B130": "これでよしと。"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "这份力量是……"
      },
      "raw_text": {
        "0_B150": "この力は……"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "对不起……之后就拜托了。"
      },
      "raw_text": {
        "0_B160": "ごめん……あとは頼む。"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "看清敌人的动作了吗？"
      },
      "raw_text": {
        "0_B170": "敵の動き、見えたかい？"
      }
    },
    "0_B180": {
      "name": "0_B180",
      "text": {
        "0_B180": "嗯。"
      },
      "raw_text": {
        "0_B180": "ああ。"
      }
    },
    "0_B190": {
      "name": "0_B190",
      "text": {
        "0_B190": "嗯。"
      },
      "raw_text": {
        "0_B190": "うん。"
      }
    },
    "0_B200": {
      "name": "0_B200",
      "text": {
        "0_B200": "是啊。"
      },
      "raw_text": {
        "0_B200": "そうだね。"
      }
    },
    "0_B2010": {
      "name": "0_B2010",
      "text": {
        "0_B2010": "啊啊！"
      },
      "raw_text": {
        "0_B2010": "ああ！"
      }
    },
    "0_B2020": {
      "name": "0_B2020",
      "text": {
        "0_B2020": "剧药弹！"
      },
      "raw_text": {
        "0_B2020": "撃薬弾！"
      }
    },
    "0_B2030": {
      "name": "0_B2030",
      "text": {
        "0_B2030": "喝、呀！"
      },
      "raw_text": {
        "0_B2030": "せ、やっ！"
      }
    },
    "0_B210": {
      "name": "0_B210",
      "text": {
        "0_B210": "出来吧，海德！"
      },
      "raw_text": {
        "0_B210": "来い、ハイド！"
      }
    },
    "0_B220": {
      "name": "0_B220",
      "text": {
        "0_B220": "时间到了，海德！"
      },
      "raw_text": {
        "0_B220": "時間だ、ハイド！"
      }
    },
    "0_B230": {
      "name": "0_B230",
      "text": {
        "0_B230": "来吧来吧来吧！"
      },
      "raw_text": {
        "0_B230": "来い来い来い！"
      }
    },
    "0_B2440": {
      "name": "0_B2440",
      "text": {
        "0_B2440": "你能抓得住我吗？"
      },
      "raw_text": {
        "0_B2440": "捕らえられるかい？"
      }
    },
    "0_B250": {
      "name": "0_B250",
      "text": {
        "0_B250": "应该……做得到的！"
      },
      "raw_text": {
        "0_B250": "やれる、はずだ！"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "诶？"
      },
      "raw_text": {
        "0_B410": "えっ？"
      }
    },
    "0_B420": {
      "name": "0_B420",
      "text": {
        "0_B420": "燃烧吧！"
      },
      "raw_text": {
        "0_B420": "燃えろっ！"
      }
    },
    "0_B430": {
      "name": "0_B430",
      "text": {
        "0_B430": "可恶……"
      },
      "raw_text": {
        "0_B430": "この……"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "我很擅长隐藏身形呢。"
      },
      "raw_text": {
        "0_B440": "隠れるのは得意なんだ。"
      }
    },
    "0_B480": {
      "name": "0_B480",
      "text": {
        "0_B480": "克制住，克制住自己……"
      },
      "raw_text": {
        "0_B480": "抑えろ、自分を"
      }
    },
    "0_B490": {
      "name": "0_B490",
      "text": {
        "0_B490": "抓住诀窍了。"
      },
      "raw_text": {
        "0_B490": "コツは掴んだ。"
      }
    },
    "0_B500": {
      "name": "0_B500",
      "text": {
        "0_B500": "支援就拜托你了，御主。"
      },
      "raw_text": {
        "0_B500": "サポート頼むよ、マスター。"
      }
    },
    "0_B510": {
      "name": "0_B510",
      "text": {
        "0_B510": "既然无法避开，就只能上了。"
      },
      "raw_text": {
        "0_B510": "避けられないなら、やるしかない。"
      }
    },
    "0_B520": {
      "name": "0_B520",
      "text": {
        "0_B520": "御主，谢谢你的支援。"
      },
      "raw_text": {
        "0_B520": "マスター、サポートありがとう。"
      }
    },
    "0_B530": {
      "name": "0_B530",
      "text": {
        "0_B530": "总算是……搞定了吗……"
      },
      "raw_text": {
        "0_B530": "なんとか、やったか……"
      }
    },
    "0_B550": {
      "name": "0_B550",
      "text": {
        "0_B550": "不、不行，这招……"
      },
      "raw_text": {
        "0_B550": "だ、ダメだ、これは……"
      }
    },
    "0_B560": {
      "name": "0_B560",
      "text": {
        "0_B560": "我相信御主一定能赢。"
      },
      "raw_text": {
        "0_B560": "勝てると思う、マスターは。"
      }
    },
    "0_B570": {
      "name": "0_B570",
      "text": {
        "0_B570": "至少……能当个开路先锋吧……"
      },
      "raw_text": {
        "0_B570": "露払い、くらいには……"
      }
    },
    "0_B800": {
      "name": "0_B800",
      "text": {
        "0_B800": "海德，接下来交给你了。"
      },
      "raw_text": {
        "0_B800": "カイド、あとは頼む。"
      }
    },
    "0_B801": {
      "name": "0_B801",
      "text": {
        "0_B801": "随叫随到，正是如此！"
      },
      "raw_text": {
        "0_B801": "呼ばれて飛び出て、ってな！"
      }
    },
    "0_B810": {
      "name": "0_B810",
      "text": {
        "0_B810": "危险游戏。"
      },
      "raw_text": {
        "0_B810": "デンジャラスゲーム。"
      }
    },
    "0_B811": {
      "name": "0_B811",
      "text": {
        "0_B811": "来了来了！来大玩一场吧——！"
      },
      "raw_text": {
        "0_B811": "来た来たぁ！遊びましょー！"
      }
    },
    "0_B820": {
      "name": "0_B820",
      "text": {
        "0_B820": "危险游戏。"
      },
      "raw_text": {
        "0_B820": "デンジャラスゲーム。"
      }
    },
    "0_B821": {
      "name": "0_B821",
      "text": {
        "0_B821": "真可惜！全都要杀光！"
      },
      "raw_text": {
        "0_B821": "残念でした！皆殺しだ！"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "安静点，安静点。"
      },
      "raw_text": {
        "0_B840": "静かに、静かに。"
      }
    },
    "0_B880": {
      "name": "0_B880",
      "text": {
        "0_B880": "绝不能输！"
      },
      "raw_text": {
        "0_B880": "負けられない！"
      }
    },
    "0_B890": {
      "name": "0_B890",
      "text": {
        "0_B890": "能行……我能行的……"
      },
      "raw_text": {
        "0_B890": "やれる……やれるぞ……"
      }
    },
    "0_B910": {
      "name": "0_B910",
      "text": {
        "0_B910": "尝尝这个！"
      },
      "raw_text": {
        "0_B910": "食らえ！"
      }
    },
    "0_B920": {
      "name": "0_B920",
      "text": {
        "0_B920": "哈，哈！"
      },
      "raw_text": {
        "0_B920": "はっ、はっ！"
      }
    },
    "0_B930": {
      "name": "0_B930",
      "text": {
        "0_B930": "不好意思了。"
      },
      "raw_text": {
        "0_B930": "悪いね。"
      }
    }
  }
}
