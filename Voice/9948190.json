{
  "id": 9948190,
  "name": "Enemy 9948190",
  "voices": {
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "正中脑门！"
      },
      "raw_text": {
        "0_B020": "ノーテン！"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "给我去死吧！"
      },
      "raw_text": {
        "0_B030": "死んじまえ！"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "少废话，乖乖闭嘴被我宰了吧！"
      },
      "raw_text": {
        "0_B090": "いいから黙って殺されてろ！"
      }
    },
    "0_B120": {
      "name": "0_B120",
      "text": {
        "0_B120": "啊？搞什么啊，已经结束了吗。"
      },
      "raw_text": {
        "0_B120": "あ？なんだよ、もう終わりかよ。"
      }
    },
    "0_B130": {
      "name": "0_B130",
      "text": {
        "0_B130": "哎呀，这就完了？啊——真无聊。"
      },
      "raw_text": {
        "0_B130": "ありゃ、ここまで？あー、つまんねえ。"
      }
    },
    "0_B140": {
      "name": "0_B140",
      "text": {
        "0_B140": "这样啊！"
      },
      "raw_text": {
        "0_B140": "そうかよ！"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "根本不痛啊！"
      },
      "raw_text": {
        "0_B150": "痛くねえんだよな！"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "真蠢。这就结束了吗？可恶。"
      },
      "raw_text": {
        "0_B160": "アホらしい。終わりかよ。くそっ。"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "狼先生就这么死掉了，可喜可贺。"
      },
      "raw_text": {
        "0_B170": "オオカミさんは死にました、とさ。"
      }
    },
    "0_B180": {
      "name": "0_B180",
      "text": {
        "0_B180": "鬼才管你啊！"
      },
      "raw_text": {
        "0_B180": "知るかぁ！"
      }
    },
    "0_B190": {
      "name": "0_B190",
      "text": {
        "0_B190": "撕咬！"
      },
      "raw_text": {
        "0_B190": "Bake!"
      }
    },
    "0_B200": {
      "name": "0_B200",
      "text": {
        "0_B200": "找到了找到了！"
      },
      "raw_text": {
        "0_B200": "あったあった！"
      }
    },
    "0_B2010": {
      "name": "0_B2010",
      "text": {
        "0_B2010": "狼先生在哪里啊！"
      },
      "raw_text": {
        "0_B2010": "狼さんどこだ！"
      }
    },
    "0_B2020": {
      "name": "0_B2020",
      "text": {
        "0_B2020": "唰唰唰——！"
      },
      "raw_text": {
        "0_B2020": "するするするー！"
      }
    },
    "0_B2440": {
      "name": "0_B2440",
      "text": {
        "0_B2440": "给我死透吧！"
      },
      "raw_text": {
        "0_B2440": "死にサせ。"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "脑浆都给我泼出来吧！"
      },
      "raw_text": {
        "0_B410": "生味噌ぶちまけろ！"
      }
    },
    "0_B420": {
      "name": "0_B420",
      "text": {
        "0_B420": "去死去死去死——！"
      },
      "raw_text": {
        "0_B420": "死ね死ね死ねー！"
      }
    },
    "0_B430": {
      "name": "0_B430",
      "text": {
        "0_B430": "里面的东西……给我看看！"
      },
      "raw_text": {
        "0_B430": "中身は…見せろ！"
      }
    },
    "0_B440": {
      "name": "0_B440",
      "text": {
        "0_B440": "我开动——啦！"
      },
      "raw_text": {
        "0_B440": "いただき、まーす！"
      }
    },
    "0_B480": {
      "name": "0_B480",
      "text": {
        "0_B480": "宰了你啊！"
      },
      "raw_text": {
        "0_B480": "殺してやるや！"
      }
    },
    "0_B490": {
      "name": "0_B490",
      "text": {
        "0_B490": "力量涌上来吧！"
      },
      "raw_text": {
        "0_B490": "みなぎれ！"
      }
    },
    "0_B520": {
      "name": "0_B520",
      "text": {
        "0_B520": "明明接下来才是好戏啊……对吧，御主？"
      },
      "raw_text": {
        "0_B520": "ここからがいいとこだってのに…なあ、マスター？"
      }
    },
    "0_B530": {
      "name": "0_B530",
      "text": {
        "0_B530": "诶？既没有拷问时间也没有解体时间吗？"
      },
      "raw_text": {
        "0_B530": "え？拷問タイムも解体タイムもなし？"
      }
    },
    "0_B540": {
      "name": "0_B540",
      "text": {
        "0_B540": "事到如今才来！"
      },
      "raw_text": {
        "0_B540": "今更！"
      }
    },
    "0_B550": {
      "name": "0_B550",
      "text": {
        "0_B550": "再给我更多、还要更多啊！"
      },
      "raw_text": {
        "0_B550": "もっと、もっとよこせぁっ！"
      }
    },
    "0_B560": {
      "name": "0_B560",
      "text": {
        "0_B560": "哈！永别了，人渣们。"
      },
      "raw_text": {
        "0_B560": "あ！あばよクソども。"
      }
    },
    "0_B570": {
      "name": "0_B570",
      "text": {
        "0_B570": "玩够了玩够了。不过还没玩尽兴呢。"
      },
      "raw_text": {
        "0_B570": "遊んだ遊んだ。遊び足りねぇ。"
      }
    },
    "0_B840": {
      "name": "0_B840",
      "text": {
        "0_B840": "狠狠咬上一口，上啦——！"
      },
      "raw_text": {
        "0_B840": "ガブリト、行くぞー！"
      }
    },
    "0_B880": {
      "name": "0_B880",
      "text": {
        "0_B880": "就让你听个够吧。"
      },
      "raw_text": {
        "0_B880": "聞かせてやるよ。"
      }
    },
    "0_B910": {
      "name": "0_B910",
      "text": {
        "0_B910": "狼先生是吧！"
      },
      "raw_text": {
        "0_B910": "ウオカミさんってな！"
      }
    },
    "0_B920": {
      "name": "0_B920",
      "text": {
        "0_B920": "嗷吼！嗷呜呜呜呜呜！"
      },
      "raw_text": {
        "0_B920": "ギャオ！ガオオオオオ！"
      }
    }
  }
}
