        },
        "1_B570": {
            "name": "戦闘不能 4",
            "text": {
                "1_B570": "小心……别中暑了哦……"
            }
        },
        "1_B800": {
            "name": "宝具 2",
            "text": {
                "1_B800": "这种感情已无法停止……！",
                "1_B801": "无论是擦肩而过的日子，还是孤身一人的夜晚——",
                "1_B802": "都将通向属于两个人的夏天……！",
                "1_B803": "虚缈的夏日啊，必归闪耀青春！"
            }
        },
        "1_B810": {
            "name": "宝具 3",
            "text": {
                "1_B810": "把青春的回忆随手拨弄一下……！",
                "1_B811": "还发生过这样那样的事呢。",
                "1_B812": "然后开启了夏日故事……",
                "1_B813": "虚缈的夏日啊，必归闪耀青春！"
            }
        },
        "1_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "1_B840": "我一直，都在等你啊……！"
            }
        },
        "1_B880": {
            "name": "スキル 5",
            "text": {
                "1_B880": "……这雨好讨厌。"
            }
        },
        "1_B890": {
            "name": "スキル 6",
            "text": {
                "1_B890": "东京吗……好远啊。"
            }
        },
        "1_B910": {
            "name": "アタック 7",
            "text": {
                "1_B910": "这里能看到我们的城镇吗？"
            }
        },
        "1_B920": {
            "name": "アタック 8",
            "text": {
                "1_B920": "那个……对不起！"
            }
        },
        "1_B930": {
            "name": "アタック 9",
            "text": {
                "1_B930": "我已经有喜欢的人了……！"
            }
        },
        "1_G010": {
            "name": "レベルアップ 1",
            "text": {
                "1_G010": "闪闪发光，好漂亮。"
            }
        },
        "1_G020": {
            "name": "霊基再臨 2",
            "text": {
                "1_G020": "……泳装？",
                "1_G021": "也不是没有啦……",
                "1_G022": "等、等以后吧，以后！"
            }
        },
        "1_G030": {
            "name": "霊基再臨 1",
            "text": {
                "1_G030": "好眼生啊，你是从哪儿来的？",
                "1_G031": "……？　怎么愣住了。",
                "1_G032": "难道是看到夏日幽灵了？"
            }
        },
        "1_G110": {
            "name": "レベルアップ 2",
            "text": {
                "1_G110": "谢，谢谢……"
            }
        },
        "1_G120": {
            "name": "レベルアップ 3",
            "text": {
                "1_G120": "这个……是不是搞错糖和盐了？"
            }
        },
        "1_H010": {
            "name": "誕生日",
            "text": {
                "1_H010": "生日！？　这种事应该早点说啦！",
                "1_H011": "啊，真是的！　得赶紧做蛋糕才行！"
            }
        },
        "1_H020": {
            "name": "イベント開催中",
            "text": {
                "1_H020": "话说……我们，一起去看烟花吧？"
            }
        },
        "1_H030": {
            "name": "会話 1",
            "text": {
                "1_H030": "喂！　别偷懒了，去帮忙采购啦！"
            }
        },
        "1_H040": {
            "name": "会話 2",
            "text": {
                "1_H040": "这里是我的店。",
                "1_H041": "你是打工的。",
                "1_H042": "好，明白了的话，就认真工作！"
            }
        },
        "1_H050": {
            "name": "会話 3",
            "text": {
                "1_H050": "关系……你这么问是出于什么用意啊……？"
            }
        },
        "1_H060": {
            "name": "好きなこと",
            "text": {
                "1_H060": "其实呀，比起咖啡，我更喜欢可可。"
            }
        },
        "1_H070": {
            "name": "嫌いなこと",
            "text": {
                "1_H070": "……咖啡。",
                "1_H071": "因为……很苦。"
            }
        },
        "1_H080": {
            "name": "聖杯について",
            "text": {
                "1_H080": "什么愿望都能实现……？",
                "1_H081": "哦……",
                "1_H082": "别说傻话了，快来店里帮忙。"
            }
        },
        "1_H10090": {
            "name": "絆Lv.1",
            "text": {
                "1_H10090": "你是从岛外来的吧？",
                "1_H10091": "城市是什么样子的？"
            }
        },
        "1_H10100": {
            "name": "絆Lv.2",
            "text": {
                "1_H10100": "真好啊。",
                "1_H10101": "我也想去东京看看呢。"
            }
        },
        "1_H10110": {
            "name": "絆Lv.3",
            "text": {
                "1_H10110": "辛苦了。已经习惯工作了吗？",
                "1_H10111": "……来，咖啡。休息一会儿吧。",
                "1_H10112": "要加糖和牛奶吗？"
            }
        },
        "1_H10120": {
            "name": "絆Lv.4",
            "text": {
                "1_H10120": "真烦人！　别管我了！",
                "1_H10121": "因为……",
                "1_H10122": "夏天结束以后，你就要回去了吧……"
            }
        },
        "1_H10130": {
            "name": "絆Lv.5",
            "text": {
                "1_H10130": "那是……什么意思？",
                "1_H10131": "Like？　Love？　Agape？　火焰般的Desire？",
                "1_H10132": "喂……回答我……"
            }
        },
        "1_H200": {
            "name": "会話 4",
            "text": {
                "1_H200": "咦，总统？　为什么会来这里？"
            }
        },
        "1_H210": {
            "name": "会話 5",
            "text": {
                "1_H210": "那是……邻村的巫女吗？",
                "1_H211": "虽然大家都说不要靠近岛的另一边……"
            }
        },
        "1_H220": {
            "name": "会話 6",
            "text": {
                "1_H220": "Ahnenerbe……",
                "1_H221": "是城里的咖啡馆吧。",
                "1_H222": "……一定非常时髦吧。"
            }
        },
        "1_H230": {
            "name": "会話 7",
            "text": {
                "1_H230": "瑟坦特？",
                "1_H231": "唔～，有点像……嚣张的弟弟吧？"
            }
        },
        "1_H240": {
            "name": "会話 8",
            "text": {
                "1_H240": "那女孩，竟然穿着像绳子一样的泳装……"
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "饭！"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "正是食欲旺盛时！"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "去，泡澡吧。"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "领教母亲的，愤怒吧……！"
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "感情，溢出……！",
                "2_B051": "闪耀，悸动。",
                "2_B052": "将共鸣传达给你！",
                "2_B053": "虚缈的夏日啊，必归闪耀青春！"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "La La La La～～～～！"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "Laaaaaa…………！"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "身为母亲……我要，认真起来了！"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "将『妈妈』……解放……出来！"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "返回，大海吧。"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "即便在大海，也会保护你。"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "啊！"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "啊——！"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "夏天……结束了……"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "大海，已经……"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "嗯……！"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "真美好。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "好耀眼。"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "清洗，干净。"
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "呀！"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "这是，爱的力量！"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "要用，宝具了。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "南风，吹拂着。"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "感情，满溢而出。"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "哼！哈！"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "妈妈飞踢！"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "非常，开心……！"
            }
        },
        "2_B2440": {
            "name": "エクストラアタック 4",
            "text": {
                "2_B2440": "Aaaaaaaa……AAAAAA！"
            }
        },
        "2_B250": {
            "name": "宝具カード 4",
            "text": {
                "2_B250": "青春的，光芒……！"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "温泉！"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "Laaaaaaaaa——！"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "水之，吐息！"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "炽热……炽热……燃烧的，夏天……！"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "大海的，力量——"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "夏天的，魔力——"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "我是，母亲之海……"
            }
        },
        "2_B510": {
            "name": "開始 4",
            "text": {
                "2_B510": "非常……兴奋。"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "坏孩子，要被训斥哦。"
            }
        },
        "2_B530": {
            "name": "勝利 4",
            "text": {
                "2_B530": "海滨的母亲，是很强的。"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "哈！"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": "好痛，啊。"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "是……苦夏……"
            }
        },
        "2_B570": {
            "name": "戦闘不能 4",
            "text": {
                "2_B570": "对不起……"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "心灵，雀跃……！",
                "2_B801": "即使这感情只是幻影，",
                "2_B802": "作为人类度过的时光，依然是无可替代的光辉。",
                "2_B803": "虚缈的夏日啊，必归闪耀青春！"
            }
        },
        "2_B810": {
            "name": "宝具 3",
            "text": {
                "2_B810": "……对不起。",
                "2_B811": "你所见到的青春幻影，其实全都是妈妈……！",
                "2_B812": "虚缈的夏日啊，必归闪耀青春！",
                "2_B813": "怀抱着心中的伤痕，长大成人吧。"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "轰轰轰轰轰……嗷～！"
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "给，便当。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "因为你正值，食欲旺盛的时候。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "哈！嘿！"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "抽！　打！"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "呼唤，风暴。"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "谢谢……我很开心。"
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "是的……我，是母亲。",
                "2_G041": "试着穿了……名为泳装的，衣服。怎么样？",
                "2_G042": "海滨的大姐姐？　……你在说什么呢？"
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "……大海的，记忆。可是，并不黑暗。",
                "2_G051": "阳光在，海面上，闪闪发光。",
                "2_G052": "我的生命，也和大家一样。闪闪发光——"
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "我能感受，你的心意。"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "看来会是个，炙热的夏天呢。"
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "愿你的生命，得到祝福……"
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "我想，一起去参加祭典。"
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "一起去海滨，散步吧。"
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "现在的我，是真正的，妈妈。"
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "这是，我可爱的孩子。"
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "我的孩子们，我全都，最喜欢。"
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "……即便寂寞，我也会忍耐。"
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "捡到的失物，还是得，还回去才行。"
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "泳装……适合我吗？"
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "要去很远的地方吗？　我会担心，所以我也一起去。"
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "……约会？",
                "2_H20111": "我已经，不是大姐姐了……而是妈妈……也可以吗？",
                "2_H20112": "好开心……！"
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "夏天，好开心……！",
                "2_H20121": "大家，都面带笑容，很开心。",
                "2_H20122": "要是这个夏天，能永远持续下去，就好了……"
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "但是，我是幻影……",
                "2_H20131": "是渴望与人，同行的梦……",
                "2_H20132": "所以……你去吧。",
                "2_H20133": "请把这片景色，留在回忆的彼岸。",
                "2_H20134": "——一路走好。"
            }
        },
        "2_H250": {
            "name": "会話 4",
            "text": {
                "2_H250": "你和我，一样。",
                "2_H251": "都是梦中的幻影。"
            }
        },
        "2_H260": {
            "name": "会話 5",
            "text": {
                "2_H260": "那孩子也成了兽……可是有些不一样？",
                "2_H261": "……从者宇宙？"
            }
        },
        "2_H270": {
            "name": "会話 6",
            "text": {
                "2_H270": "妈妈的泳装，怎么样？",
                "2_H271": "呵呵……恩奇都，是个坦率的好孩子。"
            }
        }
    },
    "ChrVoice_ids": [
        "205400"
    ]
}