{
  "id": 9001001,
  "name": "",
  "voices": {
    "0_I040": {
      "name": "关于商店 4",
      "text": {
        "0_I040": "是这个吧，请拿好。"
      }
    },
    "0_I050": {
      "name": "关于商店 5",
      "text": {
        "0_I050": "这是本店推荐的商品。"
      }
    },
    "0_I060": {
      "name": "关于商店 6",
      "text": {
        "0_I060": "欢迎您再次光临。"
      }
    },
    "0_I090": {
      "name": "关于商店 9",
      "text": {
        "0_I090": "情人节快乐。",
        "0_I091": "我能感受到……甜美的预感。"
      }
    },
    "0_I100": {
      "name": "关于商店 10",
      "text": {
        "0_I100": "无论是给是收是义理还是经济装巧克力就是好吃相信巧克力吧。"
      }
    },
    "0_I110": {
      "name": "关于商店 11",
      "text": {
        "0_I110": "黑豆沙、黄豆泥、毛豆泥、栗金饨……",
        "0_I111": "唔，真让人犹豫不决……",
        "0_I112": "我腾不出空来……"
      }
    },
    "0_I120": {
      "name": "关于商店 12",
      "text": {
        "0_I120": "道具已经换好了吗？",
        "0_I121": "就算感情没有结果，还有明年呢。",
        "0_I122": "这个姑且不论，X必须被打倒。"
      }
    },
    "0_I130": {
      "name": "关于商店 13",
      "text": {
        "0_I130": "迦勒底的可可充能300％维持的日子也要结束了。",
        "0_I131": "明年会全部换成和果子。"
      }
    },
    "0_I140": {
      "name": "关于商店 14",
      "text": {
        "0_I140": "情人节快乐。",
        "0_I141": "但愿爱之勇气与你同在。"
      }
    },
    "0_I150": {
      "name": "关于商店 15",
      "text": {
        "0_I150": "欢迎光临。",
        "0_I151": "我会为你献上一点微薄之力的。"
      }
    },
    "0_I160": {
      "name": "关于商店 16",
      "text": {
        "0_I160": "如果用作礼物，需要包装吗？",
        "0_I161": "用铁丝和胶水可以吗？"
      }
    },
    "0_I170": {
      "name": "关于商店 17",
      "text": {
        "0_I170": "短暂的热闹转瞬即逝。",
        "0_I171": "千万不要忘记交换道具。",
        "0_I172": "不管怎么说，必须砍了X。"
      }
    },
    "0_I180": {
      "name": "关于商店 18",
      "text": {
        "0_I180": "不会搞什么特价促销。",
        "0_I181": "不到最后一刻都要不言放弃地突击。",
        "0_I182": "啊，剩下的材料会由我收下的，放心吧。"
      }
    }
  },
  "ChrVoice_ids": [
    "9001001"
  ]
}
