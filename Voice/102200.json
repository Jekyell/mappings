{
    "id": 102200,
    "collectionNo": 9,
    "name": "吉尔·德·雷",
    "voices": {
        "0_B010": {
            "name": "攻击 1",
            "text": {
                "0_B010": "突击！"
            }
        },
        "0_B020": {
            "name": "攻击 2",
            "text": {
                "0_B020": "跟着我上！"
            }
        },
        "0_B030": {
            "name": "攻击 3",
            "text": {
                "0_B030": "就是这里！"
            }
        },
        "0_B040": {
            "name": "额外攻击",
            "text": {
                "0_B040": "集结在旗下吧，精锐们啊！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "我们是追随圣女，并誓言与圣女同行的集结之众——",
                "0_B051": "圣战秩序（Saint War Order）！"
            },
            "raw_text": {
                "0_B050": "我らは聖女に従い、聖女と共に歩むことを誓った者たち。",
                "0_B051": "聖闘士！ウォーオーダー。"
            }
        },
        "0_B051": {
            "name": "宝具",
            "text": {
                "0_B051": "集结于圣旗之下怒吼吧！"
            }
        },
        "0_B080": {
            "name": "技能 1",
            "text": {
                "0_B080": "这样如何？"
            }
        },
        "0_B090": {
            "name": "技能 2",
            "text": {
                "0_B090": "哈哈哈哈哈！ 没问题！"
            }
        },
        "0_B100": {
            "name": "开始 1",
            "text": {
                "0_B100": "这是正义之战。来吧，我们上！"
            }
        },
        "0_B110": {
            "name": "开始 2",
            "text": {
                "0_B110": "好吧。我们将用正义之刃来制裁你们！"
            }
        },
        "0_B120": {
            "name": "胜利 1",
            "text": {
                "0_B120": "战争是空虚的。 但愿世间能迎来和平……"
            }
        },
        "0_B130": {
            "name": "胜利 2",
            "text": {
                "0_B130": "哪怕获得了胜利，但只要想起背后的牺牲者人数，顿时感到十分空虚。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": ""
            },
            "raw_text": {
                "0_B140": ""
            }
        },
        "0_B150": {
            "name": "受击 1",
            "text": {
                "0_B150": "糟了……！"
            }
        },
        "0_B160": {
            "name": "无法战斗 1",
            "text": {
                "0_B160": "到此为止了吗……贞德……"
            }
        },
        "0_B170": {
            "name": "无法战斗 2",
            "text": {
                "0_B170": "万分抱歉。请撤退……！"
            }
        },
        "0_B180": {
            "name": "指令卡 1",
            "text": {
                "0_B180": "我们上吧。"
            }
        },
        "0_B190": {
            "name": "指令卡 2",
            "text": {
                "0_B190": "交给我吧。"
            }
        },
        "0_B200": {
            "name": "指令卡 3",
            "text": {
                "0_B200": "是。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "小看了我的剑技吗。"
            },
            "raw_text": {
                "0_B2010": "剣腕、甘く見たか。"
            }
        },
        "0_B210": {
            "name": "宝具卡",
            "text": {
                "0_B210": "现在正是进军之时！"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "奔驰吧，我的爱马。"
            },
            "raw_text": {
                "0_B410": "かけろ 我が馬よ。"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "继续推进。"
            },
            "raw_text": {
                "0_B420": "押し続けろ。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "让开。"
            },
            "raw_text": {
                "0_B430": "そこをどけ。"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "为圣女开辟道路。"
            },
            "raw_text": {
                "0_B440": "聖女のために道を開く。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "哼，是这个吗。"
            },
            "raw_text": {
                "0_B480": "ふん、これかな。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "大家冷静点。"
            },
            "raw_text": {
                "0_B490": "落ち着け、皆の衆。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "为了奥尔良的圣女与神。"
            },
            "raw_text": {
                "0_B500": "オルレアンの聖女と神のために。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "让我们为败者的灵魂安息祈祷吧。战争本该如此。"
            },
            "raw_text": {
                "0_B520": "敗者の鎮魂を祈りましょう。戦いとはそうあるべきです。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "我果然……还是被神抛弃了吗。"
            },
            "raw_text": {
                "0_B560": "やはり私は……神に見放されていたか。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "我心与圣女同在，",
                "0_B801": "上吧！圣洁秩序（Saint Order）！"
            },
            "raw_text": {
                "0_B800": "我が心は聖女と共に",
                "0_B801": "行くぞ、セイントオーダーッ。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "全军突击。"
            },
            "raw_text": {
                "0_B840": "全軍突撃。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "赐予森林力量。"
            },
            "raw_text": {
                "0_B910": "森に力を"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "纵使是邪恶的力量。"
            },
            "raw_text": {
                "0_B920": "邪悪な力であれど。"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "大炮准备。"
            },
            "raw_text": {
                "0_B930": "大砲用意。"
            }
        },
        "0_G010": {
            "name": "升级",
            "text": {
                "0_G010": "哈哈，还能继续提升哦。"
            }
        },
        "0_G020": {
            "name": "灵基再临 2",
            "text": {
                "0_G020": "这力量是……不，没事。"
            }
        },
        "0_G030": {
            "name": "灵基再临 1",
            "text": {
                "0_G030": "呜……这力量……现在的我究竟是否能掌控……？"
            }
        },
        "0_G040": {
            "name": "灵基再临 3",
            "text": {
                "0_G040": "噢噢……贞德……请原谅我…… 我憎恨……憎恨一切……所有繁荣一切……！"
            }
        },
        "0_G050": {
            "name": "灵基再临 4",
            "text": {
                "0_G050": "究竟哪条路……才是我正确的前进方向……",
                "0_G051": "不……御主……我会为您效力……仅此而已……仅此而已……"
            }
        },
        "0_H010": {
            "name": "生日",
            "text": {
                "0_H010": "哎呀，居然是御主的生日啊。 生日快乐。"
            }
        },
        "0_H020": {
            "name": "活动举行中",
            "text": {
                "0_H020": "好像有些嘈杂呢……要去看看吗？"
            }
        },
        "0_H030": {
            "name": "对话 1",
            "text": {
                "0_H030": "该是赶赴战场的时候了。 虽说和平并不坏，但是……"
            }
        },
        "0_H040": {
            "name": "对话 2",
            "text": {
                "0_H040": "我是侍奉神、圣女、与御主之人。"
            }
        },
        "0_H050": {
            "name": "对话 3",
            "text": {
                "0_H050": "御主，我有一事相求。 当我精神崩溃之时，请用您的令咒，夺走我的生命。"
            }
        },
        "0_H060": {
            "name": "喜欢的东西",
            "text": {
                "0_H060": "我当然喜欢孩子们。 他们的笑容才是我们的支柱。"
            }
        },
        "0_H070": {
            "name": "讨厌的东西",
            "text": {
                "0_H070": "……讨厌的东西吗？ 还是不回答为好吧。",
                "0_H071": "一旦回答，我将坠入地狱。"
            }
        },
        "0_H080": {
            "name": "关于圣杯",
            "text": {
                "0_H080": "渴望圣杯造就奇迹是否显得很可笑？　 为了拯救某位少女的奇迹。"
            }
        },
        "0_H090": {
            "name": "牵绊Lv.1",
            "text": {
                "0_H090": "哈哈哈，请问有何贵干？"
            }
        },
        "0_H100": {
            "name": "牵绊Lv.2",
            "text": {
                "0_H100": "哎呀哎呀，真孩子气呢。"
            }
        },
        "0_H110": {
            "name": "牵绊Lv.3",
            "text": {
                "0_H110": "怎么了？"
            }
        },
        "0_H120": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H120": "关于圣女？ 唔，我不介意谈这个话题…… 不过您能空出三小时左右的时间吗？"
            }
        },
        "0_H130": {
            "name": "牵绊Lv.5",
            "text": {
                "0_H130": "我迟早会坠入地狱。 但是，哪怕只有现在，我也要站在光明的一方战斗。 直至燃烧殆尽！"
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "那就是未来的我吗。唔……明明是该厌恶的对象，却无法心生厌恶。",
                "0_H171": ""
            },
            "raw_text": {
                "0_H170": "あれが未来の私、というわけですか。うーん……嫌悪すべき対象なのに、嫌悪できないとは。",
                "0_H171": ""
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "噢，贞德，我们的光芒。这次也能与您并肩作战了呢。真是太棒了。那么就和往常一样，由我来为您掩护。贞德您就和往常一样突击吧。遵命，请安心地把后背交给我吧。",
                "0_H181": "",
                "0_H182": "",
                "0_H183": "",
                "0_H184": "",
                "0_H185": ""
            },
            "raw_text": {
                "0_H180": "おお、ジャンヌ 我らの光を。 此度もまた共に戦えるのですね。素晴らしい。ではいつも通り 私が 援護 いたします。ジャンヌはいつも通り 突撃ですね。かしこまりました。背中は安心してお預けください。",
                "0_H181": "",
                "0_H182": "",
                "0_H183": "",
                "0_H184": "",
                "0_H185": ""
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "噢，贞德。没想到您竟然能驱使海豚、鲨鱼，甚至是鲸鱼。不愧是圣女大人，区区大海自然是不在话下吧。",
                "0_H191": "",
                "0_H192": ""
            },
            "raw_text": {
                "0_H190": "おお、ジャンヌ。まさかイルカやサメ、果てはクジラをも従えるとは。やはり聖女たる者、海くらいはお手の物というわけですな。",
                "0_H191": "",
                "0_H192": ""
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "噢，贞德！的，反转姿态……不对，是在历经动荡后诞生的贞德·达尔克·Alter……变幼小了……而且，还获得了圣诞老人的资格……唔……看来有着相当复杂的内情呢。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": "",
                "0_H204": ""
            },
            "raw_text": {
                "0_H200": "おお、ジャンヌ！の、反転した姿…というわけではなく、激動の末に生まれたジャンヌ・ダルク・オルタ…が、幼くなった…上に、サンタクロースとしての資格を得たと…うーん…複雑な事情があったようですな。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": "",
                "0_H204": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "噢，贞德！……好像不是呢。从诞生过程来看，您并不是圣女。虽然听到我这么说您似乎挺高兴的，但原本的贞德会感到伤心的，所以很抱歉，就请您作为妹妹的角色吧。好的。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": ""
            },
            "raw_text": {
                "0_H210": "おお、チャング！ ではないようですな。成り立ちから考えるに、あなたは聖女ではない。 と言うと あなたは嬉しそうですが、本来のジャンヌが悲しそうにするので申し訳ありませんが、あなたは妹枠ということで はい。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": ""
            }
        },
        "0_S010": {
            "name": "召唤",
            "text": {
                "0_S010": "Saber。吉尔·德·雷，应您的召唤前来拜访。"
            }
        }
    },
    "ChrVoice_ids": [
        "102200"
    ]
}