        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "请看。这是我梦寐以求的员工证。"
            },
            "raw_text": {
                "0_B480": "見てください。憧れの社員証です。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "呜喔——带薪假太棒啦——！"
            },
            "raw_text": {
                "0_B490": "うおー、有給最高ー。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "好——要钓鱼啦——！"
            },
            "raw_text": {
                "0_B500": "よーし、釣るぞー。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "第一次出差，我会努力的。"
            },
            "raw_text": {
                "0_B510": "初めての出張頑張ります。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "大海固然不错，但宁静的泉水也很棒哦。"
            },
            "raw_text": {
                "0_B520": "海もいいけど、静かな泉もいいものですよ。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": ""
            },
            "raw_text": {
                "0_B540": "いたーっ。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "请应对意料之外的突发状况。"
            },
            "raw_text": {
                "0_B550": "予期せぬトラブル対応を。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "出差结束了对吧……"
            },
            "raw_text": {
                "0_B560": "出張は終わりですよね。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "守护泉水的龙之牙，",
                "0_B801": "撒向大地化为士兵吧。",
                "0_B802": "龙牙幻象（Dragon Tooth Phantasm）！",
                "0_B803": "不仅要安居，连敌人的府邸也一并拿下！"
            },
            "raw_text": {
                "0_B800": "泉を守るドラゴンの牙。",
                "0_B801": "地面に撒かれて兵となれ。",
                "0_B802": "ドラゴントゥース、ファンタズム。",
                "0_B803": "巨宅ならぬ敵宅、取っちゃいます。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "这就是传说中的夏日牙钓！",
                "0_B811": "骷髅战士接连上钩，",
                "0_B812": "最后再来个大物独钓！",
                "0_B813": "这是出差报告书中重要的一页！"
            },
            "raw_text": {
                "0_B810": "これが噂の夏の木場釣り",
                "0_B811": "ほねほね戦士が入れ食い状態。",
                "0_B812": "とどめに大物！一本釣り",
                "0_B813": "出張報告書の、大事な１ページです。"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "牙之钓鱼（Tooth Fishing）！",
                "0_B821": "与开朗的伙伴们尽情享受钓鱼乐趣，",
                "0_B822": "连庞大的朋友也光临了！",
                "0_B823": "夏日带薪假期充实享受中！"
            },
            "raw_text": {
                "0_B820": "トゥースフィッシング。",
                "0_B821": "陽気な仲間と釣り三昧。",
                "0_B822": "ビッグなお友達も来てくれました。",
                "0_B823": "夏の有給休暇、満喫中。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "能钓到什么呢？这是什么鬼东西啊——！"
            },
            "raw_text": {
                "0_B840": "どんなの釣れるかな？なんじゃこりゃー。"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "吐舌、吐舌头。"
            },
            "raw_text": {
                "0_B880": "チロ、チロチロ。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "比办公室的地板好睡多了。"
            },
            "raw_text": {
                "0_B890": "オフィスの床より寝やすいです。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "诶—诶—诶—！"
            },
            "raw_text": {
                "0_B910": "えいえいえーい。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "哈啊……这个有毒——！"
            },
            "raw_text": {
                "0_B920": "はぁ……これどくでしたーっ。"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "变大吧——"
            },
            "raw_text": {
                "0_B930": "おっきくなーれっとー。"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "呜喔喔—！升职啦—！开玩笑的，是意象训练。",
                "0_G011": ""
            },
            "raw_text": {
                "0_G010": "うおおー！昇進だー！嘘です、イメージトレーニングです。",
                "0_G011": ""
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "诶，“明明是假日风格，那个员工证是不是多余了”？不行！这可是我目前最重要的宝物和最大的亮点。就再让我自然而又大胆地炫耀一阵子吧。",
                "0_G021": "",
                "0_G022": ""
            },
            "raw_text": {
                "0_G020": "え、休日 スタイル なのに、その社員証は余計じゃないかってだめです。これが今の私の一番の宝物で1番のアピールポイント なんですから。 もうしばらくの間だけ さりげなく、かつ大胆に見せびらかせてください。",
                "0_G021": "",
                "0_G022": ""
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "怎、怎么样？我换上了更有假日感觉的休闲装扮。既适合水边也适合街头，是万能风格哦。也就是说……这样就能光明正大地一起进咖啡馆之类的了呢。才不是……不不，什么都没有哦。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            },
            "raw_text": {
                "0_G030": "どどうでしょうか？より休日らしい カジュアルな格好になってみました。水辺もok 街中もokな万能スタイルです。 つまり。 これでカフェとかにも堂々と一緒に入れますね。みたいないいえいえ、何でもないですよ。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "这是？可以说是抓住了另一个梦想的夏季的我吧。在调查地点经历了种种，结果……变得更加强烈地意识到了在那边就职。不，并不是跳槽哦？应该说是现状延伸线上的幸福梦想吧。御主现在不用在意也没关系的。是的。",
                "0_G041": "",
                "0_G042": "",
                "0_G043": ""
            },
            "raw_text": {
                "0_G040": "これは？ もう1つの夢を掴んだ 夏の私のようなものです。 調査先で色々あって、そっちの就職をより強く 意識してしまった。結果 みたいな。 いえ、転職なんかじゃなく？ 今の延長線上にある幸せな夢というか。 マスターは今はお気になさらずで大丈夫です。はい。",
                "0_G041": "",
                "0_G042": "",
                "0_G043": ""
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "简直像做梦一样。连自己是什么、能成为什么都不知道的我，得到了正式的头衔，拿到了新的工作，还获得了假期，然后……还能和喜欢的人并肩坐在一起，悠闲地钓着鱼，真的像梦一样。啊、啊，我刚才是不是说了什么奇怪的话？那个、就是说，作为公司的上司之类的……虽然也不仅仅是那个意思，那个……夏天的魔力真可怕。受教了。",
                "0_G051": "",
                "0_G052": "",
                "0_G053": "",
                "0_G054": "",
                "0_G055": "",
                "0_G056": ""
            },
            "raw_text": {
                "0_G050": "夢みたいです。自分が何なのか、何になれるのかもわからなかった私が、きちんとした肩書きをもらって、新しいお仕事をもらって、お休みなんかももらっちゃって、そして、好きな人と肩を並べて、のんびり釣りなんかしちゃったりして、本当に夢のような。あ、あ、私今、何かおかしなこと言いませんでした?その、あれです、会社の上司として、とか、そういう意味で、それだけではないのですが、その…夏の魔力、恐るべし。勉強になりました。",
                "0_G051": "",
                "0_G052": "",
                "0_G053": "",
                "0_G054": "",
                "0_G055": "",
                "0_G056": ""
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "感受到了。社会人经验值的提升。",
                "0_G111": ""
            },
            "raw_text": {
                "0_G110": "感じます。社会人経験の高まりを。",
                "0_G111": ""
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "员工食堂平时就很好吃，但在出差地吃到的饭菜也别有一番风味呢。"
            },
            "raw_text": {
                "0_G120": "社食はいつも美味しいですけど、出張先で食べるご飯もまた格別ですね。"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "诶嘿嘿。我早就决定好了。御主生日那天，我要再请个夏日带薪假。所以那个……要不要跟我一起去海上船钓呢？",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            },
            "raw_text": {
                "0_H010": "えへへ。 決めてたんです。マスターのお誕生日は また 夏の勇気を取ろうって。 だからその。 私と船釣りにでも行きませんか。",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "外面似乎正在举办什么特别的活动呢。在别人工作的时候休带薪假。这种优越感……呵呵，感觉要上瘾了。",
                "0_H021": "",
                "0_H022": ""
            },
            "raw_text": {
                "0_H020": "何やら外では特別なイベントが行われているようですね。人が働いている時に有給で休む。この優越。 ふふ 癖になってしまいそうです。",
                "0_H021": "",
                "0_H022": ""
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "御主御主，难得的带薪休假。要不要干脆去外面走走呢？那个……虽然确实不能排除“公司紧急召回”这种令人担心的可能性，但如果是两个人一起为此提心吊胆，一定也能成为很棒的调味剂吧。",
                "0_H031": "",
                "0_H032": "",
                "0_H033": ""
            },
            "raw_text": {
                "0_H030": "マスターマスター せっかくの有給休暇です。思い切って外に出てみませんか？えっと 会社からの緊急呼び出しという 懸念点も確かになくはないのですが、それに怯えるのも 2人ならきっといい スパイスになると思うんです。",
                "0_H031": "",
                "0_H032": "",
                "0_H033": ""
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "听说有时在兴趣活动中认识的人，碰巧会是合作方的高管呢。感觉既像机会又像陷阱，但不管怎么说，即使在休假中也不能忘记自己是迦勒底的员工，我要扎实、健全地享受假期！",
                "0_H041": "",
                "0_H042": ""
            },
            "raw_text": {
                "0_H040": "趣味で知り合った相手がたまたま 取引先の偉い人だったりすることもあるそうです。チャンス のような罠のような という感じですが、ともあれ、休みでもカルデアの社員であることは忘れず、しっかり 健全に楽しんでいきたいと思います",
                "0_H041": "",
                "0_H042": ""
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和上司的第一次出差。在充满各种戏剧性发展的夏季，怎么可能什么都没发生呢——不，我可没有在期待什么能让两个人单独相处的意外事故哦。是真的哦！",
                "0_H051": "",
                "0_H052": "",
                "0_H053": ""
            },
            "raw_text": {
                "0_H050": "上司と初めての出張。 様々なドラマだらけの夏という季節、何も起きないはずがなく、いいえ 2人きりになれるトラブルとか期待してたりはしませんよ。本当ですよ。",
                "0_H051": "",
                "0_H052": "",
                "0_H053": ""
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西吗？其实最近我终于让人帮我做那个了。也就是说，递名片！我可以演练一下吗？嗯……你好，我是这种名片上的这位。",
                "0_H061": "",
                "0_H062": "",
                "0_H063": "",
                "0_H064": "",
                "0_H065": ""
            },
            "raw_text": {
                "0_H060": "好きなものですか？実は最近ついに あれを作ってもらっちゃったんですよ。つまり 名刺を渡すことです。実演してもいいですか？うん。 どうも私こういうものです。",
                "0_H061": "",
                "0_H062": "",
                "0_H063": "",
                "0_H064": "",
                "0_H065": ""
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "我喜欢夏天。也喜欢大海。但是，夏天的海滩上为什么会有那么多男人的裸体呢？嗯。要是没有那些的话，我也就能再放松一点在沙滩上散步了。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            },
            "raw_text": {
                "0_H070": "夏は好きです。海も好きです。でも 夏の海ってどうしてあんなに男の人の裸が多いんでしょうか？うん。 それがなかったらもう少し気楽に 浜辺を歩いたりもできるんですけど。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯的用途吗？感觉现在升职还太早，永久就业（结婚）也打算不急躁、稳扎稳打地去争取，如果用来当打窝的诱饵，说不定能钓上来好多没见过的鱼呢……这种用处果然是不行的吧？",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": ""
            },
            "raw_text": {
                "0_H080": "聖杯の使い方ですか？昇進はまだ早いと思うし、永久就職は焦らず じっくり 狙っていく方針ですし、撒き餌を巻くのに使ったりしたら見たこともないようなお魚がじゃんじゃかと。 なんていうのはだめですよね。やっぱり。",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": ""
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "因为是第一次出差，可能会给您添很多麻烦。还请多多指教与关照，御主。",
                "0_H091": ""
            },
            "raw_text": {
                "0_H090": "初めての出張なので、色々ご迷惑をかけてしまうかもしれません。ご指導ご鞭撻のほどよろしくお願いします。マスター。",
                "0_H091": ""
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "虽然也听说过“带薪休假就是睡过去”这种说法，但对于还是新人的我来说，根本做不出那种资深社会人的举动。我会全力向您展现极其耀眼的带薪休假消化的！",
                "0_H101": "",
                "0_H102": ""
            },
            "raw_text": {
                "0_H100": "有給休暇は寝て過ごす という話も聞きますが、まだまだ新人の私にはとてもそんな ベテラン 社会人 ムーブはできません。全力でこの上なく キラキラな 有給消化を披露してみせます。",
                "0_H101": "",
                "0_H102": ""
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "呜嘿嘿嘿……特地帮我制作的这个员工证和名片……果然不管看多少次都是好东西呢。",
                "0_H111": "",
                "0_H112": ""
            },
            "raw_text": {
                "0_H110": "うへへへ……特別に作ってもらった、この社員証と名刺……やっぱり、何度見てもいいものですねぇ。",
                "0_H111": "",
                "0_H112": ""
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "出差与带薪休假的奥义。那是什么？我认为就是两者都要好好制定计划。正因为是需要与平时不同的时间分配的时候，才更应该明确什么才是最重要的。我试着制定一下明天的计划，等完成了请您检查一下，御主。",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            },
            "raw_text": {
                "0_H120": "出張と悠久の極意。それは？ 共にしっかり予定を立てることだと思うんです。普段と違う時間の使い方が必要な時だからこそ、何が大事かをきちんと決めておくべき みたいな。試しに 明日の予定を立ててみますので、完成したらチェックをお願いします。マスター。",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "明天的计划做好了。感觉这样就万无一失了。上午与御主一起度过，下午也与御主一起度过，然后夜晚也……不，这并没有什么奇怪的意思，你看，还有夜钓之类的各种活动嘛。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": ""
            },
            "raw_text": {
                "0_H130": "明日の予定ができました。これでバッチリだと思います。午前中は マスターと共に過ごし、午後も マスターと共に過ごし、そして夜もいえ、これは別に変な意味ではなくて、その夜釣りとか色々ありますしね。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": ""
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "我听说卫宫先生还拥有“垂钓者（Angler）”的职阶适应性呢。真想拜他为师请教各种技巧啊。诶，没有这种职阶吗？",
                "0_H171": "",
                "0_H172": ""
            },
            "raw_text": {
                "0_H170": "エミヤさんはアングラーのクラス適性も持っていらっしゃると聞きました。弟子入りして色々教えてもらいたいです。え、そんなクラスはない。",
                "0_H171": "",
                "0_H172": ""
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "多亏了蜜利亚小姐，现在的我被固定成了比平时更接近忒拜之龙的状态。魔女果然好厉害呢。",
                "0_H181": ""
            },
            "raw_text": {
                "0_H180": "メリアさんのおかげで、今の私は普段よりテイバイのドラゴンに寄った状態で固定されているのです。魔女ってやっぱりすごいですよね。",
                "0_H181": ""
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "说到水边的龙，果然还是利维坦小姐吧。虽然很向往，但因为名头实在太响亮了，那边果然还是交给溶解莉莉丝前辈，我自己就按自己的方式努力吧。",
                "0_H191": "",
                "0_H192": "",
                "0_H193": ""
            },
            "raw_text": {
                "0_H190": "水辺のドラゴンといえば、やっぱり ディヴァイアさんですよね。憧れはありますが、あまりに ビッグネームすぎるので、やっぱり そちらは メルトリリス 先輩にお任せして、私は私なりに頑張りたいと思います",
                "0_H191": "",
                "0_H192": "",
                "0_H193": ""
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "莉莉丝小姐似乎并不是蛇，但不知为何总觉得很有亲近感，或者说契合度很好呢。这是为什么呢？",
                "0_H201": ""
            },
            "raw_text": {
                "0_H200": "リリスさんは蛇じゃないみたいなんですけど、なんだかすごく親しみが持てるというか、相性がいい感じがするんですよね。どうしてなんでしょう。",
                "0_H201": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "我听说太公望先生钓鱼连饵都不挂，用的是直钩。这也太钓鱼达人了吧。真想向他学习各种技巧呢。不过，虽然我也不太用鱼饵，但我那是从骨针里渗出类似美味汤汁的感觉，所以稍微有点不太一样。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": ""
            },
            "raw_text": {
                "0_H210": "太公望さんは 餌もつけない。まっすぐの針で釣りをすると聞きました。釣りの達人すぎますよね。色々学びたいものです。まあ、私も餌はあまり使わないんですけど、あれは骨の張りから美味しい出汁みたいなのが染み出ている感じなので、ちょっとズレです。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": ""
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "第一次前往南国的出差业务，以及第一次带薪休假。如果能顺利完成这项任务，我也许终于能摆脱新员工的身份了。我打算全力工作、全力游玩！因此，御主，要不要一起去钓鱼呢？",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            },
            "raw_text": {
                "0_S010": "初めての南国への出張業務、そして初めての有給休暇。このミッションを無事にこなすことができれば、いよいよ私も 新入社員という立場を卒業できるかもしれません。全力で働いて全力で遊んでしまおうと思います。というわけで マスター。 一緒に釣りなんていかがですか。",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            }
        }
    },
    "ChrVoice_ids": [
        "506000"
    ]
}