        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "守护泉水的龙之牙，",
                "0_B801": "撒向大地化为士兵吧！",
                "0_B802": "龙牙幻影（Dragon Tooth Phantasm）！",
                "0_B803": "要收下它们吗？"
            },
            "raw_text": {
                "0_B800": "泉を守るドラゴンの牙、",
                "0_B801": "地面にまかれて兵となれ！",
                "0_B802": "ドラゴントゥース、ファンタズム！",
                "0_B803": "取っちゃいます？"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "这就是传闻中的夏日牙钓！",
                "0_B811": "骷髅战士接连咬钩！",
                "0_B812": "最后一击钓起大家伙！",
                "0_B813": "这是出差报告书中重要的一页！"
            },
            "raw_text": {
                "0_B810": "これが噂の夏の牙釣り！",
                "0_B811": "骨骨戦士が入れ食い状態！",
                "0_B812": "とどめに大物1本釣り！",
                "0_B813": "出張報告書の大事な1ページです！"
            }
        },
        "0_B820": {
            "name": "宝具 4",
            "text": {
                "0_B820": "牙之钓鱼（Tooth Fishing）！",
                "0_B821": "与欢快的伙伴们尽情享受钓鱼乐趣！",
                "0_B822": "巨大的朋友也跑来捧场了！",
                "0_B823": "夏日带薪假充分享受中！"
            },
            "raw_text": {
                "0_B820": "トゥースフィッシング！",
                "0_B821": "陽気な仲間と釣り三昧！",
                "0_B822": "ビッグなお友達も来てくれました！",
                "0_B823": "夏の有給休暇満喫中！"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "能钓上来什么呢？这是什么鬼东西啊——！"
            },
            "raw_text": {
                "0_B840": "どんなの釣れるかな？なんじゃこりゃー！"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "看、偷偷看！"
            },
            "raw_text": {
                "0_B880": "チラ、チラチラ！"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "比办公室的地板好睡多了！"
            },
            "raw_text": {
                "0_B890": "オフィスの床より寝やすいです！"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "诶！诶！诶！"
            },
            "raw_text": {
                "0_B910": "えい！えい！えい！"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "呼……这个有毒啊——！"
            },
            "raw_text": {
                "0_B920": "ふぅ…これ毒でしたぁ！"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "变大吧——！"
            },
            "raw_text": {
                "0_B930": "大きくなぁれっと！"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "呜喔——！升职啦——！开玩笑的！是形象化训练！",
                "0_G011": ""
            },
            "raw_text": {
                "0_G010": "うおぉ！昇進だぁ！嘘です！イメージトレーニングです！",
                "0_G011": ""
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "诶，“明明是假日风格，那个员工证是不是多余了”？不行！这可是我目前最重要的宝物和最大的亮点。就再让我自然而又大胆地炫耀一阵子吧！",
                "0_G021": "",
                "0_G022": ""
            },
            "raw_text": {
                "0_G020": "え、休日スタイルなのに、その社員証は余計じゃないかって？な、ダメです。これが今の私の一番の宝物で、一番のアピールポイントなんですから。もうしばらくの間だけ、さりげなく、かつ、大胆に見せびらかさせてください！",
                "0_G021": "",
                "0_G022": ""
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "怎、怎么样？我换上了更有假日感觉的休闲装扮。既适合水边也适合街头，是万能风格哦！也就是说……这样就能堂堂正正一起进咖啡馆之类的了呢，这种感觉。不、不不，什么都没有哦——！",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            },
            "raw_text": {
                "0_G030": "ど、どうでしょうか？より休日らしい、カジュアルな格好になってみました。水辺もオーケー、町中もオーケーな万能スタイルです！つまり、これで、カフェとかにも堂々と一緒に入れますね、みたいな。い、いえいえ、なんでもないですよー！",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            }
        },
        "0_G040": {
            "name": "霊基再臨 3",
            "text": {
                "0_G040": "这可以说是抓住了另一个梦想的夏天的我吧。在出差地点经历了种种，结果……变得更加强烈地意识到了在那边就职。不，并不是跳槽，应该说是现状延伸线上的幸福梦想吧……御主现在不用在意也没关系的。是的！",
                "0_G041": "",
                "0_G042": "",
                "0_G043": ""
            },
            "raw_text": {
                "0_G040": "これは、もう一つの夢を掴んだ夏の私のようなものです。出張先でいろいろあって、そっちの就職をより強く意識してしまった結果みたいな。いいえ、転職なんかじゃなく、今の延長線上にある幸せな夢というか…マスターは、今はお気になさらずで大丈夫です。はい！",
                "0_G041": "",
                "0_G042": "",
                "0_G043": ""
            }
        },
        "0_G050": {
            "name": "霊基再臨 4",
            "text": {
                "0_G050": "简直像做梦一样。连自己是什么、能成为什么都不知道的我，得到了正式的头衔，拿到了新的工作，还获得了假期。然后……还能和喜欢的人并肩坐在一起，悠闲地钓着鱼。真的……像梦一样……啊、啊，我刚才是不是说了什么奇怪的话？啊、那个、就是说，作为公司的上司之类的……虽然也不仅仅是那个意思，那个……夏天的魔力真可怕，受教了！",
                "0_G051": "",
                "0_G052": "",
                "0_G053": "",
                "0_G054": "",
                "0_G055": "",
                "0_G056": ""
            },
            "raw_text": {
                "0_G050": "夢みたいです、自分が何なのか何になれるのかもわからなかった私が、きちんとした肩書きをもらって、新しいお仕事をもらって、お休みなんかももらっちゃって。そして、好きな人と肩を並べて、のんびり釣りなんかしちゃったりして。本当に…夢のような…あっ、あ、私今、何かおかしなことを言いませんでした？あ、その、あのですね、会社の上司として、とか、そういう意味で、それだけではないのですが、その…夏の魔力、恐るべし、勉強になりました！",
                "0_G051": "",
                "0_G052": "",
                "0_G053": "",
                "0_G054": "",
                "0_G055": "",
                "0_G056": ""
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "感受到了，社会人经验值的提升。",
                "0_G111": ""
            },
            "raw_text": {
                "0_G110": "感じます、社会人経験の高まりを",
                "0_G111": ""
            }
        },
        "0_G120": {
            "name": "レベルアップ 3",
            "text": {
                "0_G120": "员工食堂平时就很好吃，但在出差地吃到的饭菜也别有一番风味呢！"
            },
            "raw_text": {
                "0_G120": "社食はいつも美味しいですけど、出張先で食べるご飯も、また格別ですね！"
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "诶嘿嘿。我早就决定好了。御主生日那天，我要再请个夏日带薪假。所以那个……要不要跟我一起去海上船钓呢？",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            },
            "raw_text": {
                "0_H010": "えへへ。決めてたんです。マスターのお誕生日は、また夏の有給を取ろうって。だからその……私と船釣りにでも行きませんか？",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "外面似乎正在举办什么特别的活动呢。在别人工作的时候休带薪假，这种愉悦！……呵呵呵，感觉要上瘾了！",
                "0_H021": "",
                "0_H022": ""
            },
            "raw_text": {
                "0_H020": "何やら外では、特別なイベントが行われているようですね。人が働いている時に、有給で休む、この愉悦！……ふふふ、癖になってしまいそうです！",
                "0_H021": "",
                "0_H022": ""
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "御主、御主！难得的带薪休假！要不要干脆去外面走走呢！？……那个，虽然确实也不能排除“公司紧急召回”这种令人担心的可能性……但如果是两个人一起为此提心胆战，一定也能成为很棒的调味剂！",
                "0_H031": "",
                "0_H032": "",
                "0_H033": ""
            },
            "raw_text": {
                "0_H030": "マスター、マスター！せっかくの有給休暇です！思い切って、外に出てみませんか！？……えっと、会社からの緊急呼び出し……という懸念点も、確かになくはないのですが……それに怯えるのも、2人なら、きっといいスパイスになると思うんです！",
                "0_H031": "",
                "0_H032": "",
                "0_H033": ""
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "听说有时在兴趣活动中认识的人，碰巧会是合作方的高管呢！感觉既像机会又像陷阱，但不管怎么说，即使在休假中也不能忘记自己是迦勒底的员工，我要扎实、健全地享受假期！",
                "0_H041": "",
                "0_H042": ""
            },
            "raw_text": {
                "0_H040": "趣味で知り合った相手が、偶々取引先の、偉い人だったりする事もあるそうです！チャンスのような、罠のような、という感じですが……ともあれ、休みでもカルデアの社員である事は忘れず、しっかり健全に楽しんでいきたいと思います！",
                "0_H041": "",
                "0_H042": ""
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和上司的第一次出差……在充满各种戏剧性发展的夏季……怎么可能什么都没发生！……不、不是的！？我才没有在期待什么能让两个人单独相处的意外事故呢！？真、真的啦！？",
                "0_H051": "",
                "0_H052": "",
                "0_H053": ""
            },
            "raw_text": {
                "0_H050": "上司と初めての出張……様々なドラマだらけの、夏という季節……何も起きないはずがなく！……い、いいえ！？2人きりになれるトラブルとか、期待してたりはしませんよ！？ほ、本当ですよ！？",
                "0_H051": "",
                "0_H052": "",
                "0_H053": ""
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的东西吗？哼哼哼～！其实最近我终于让人帮我做那个了哦～！也就是，递名片！我可以演练一下吗？咳咳！你好，在下名片如上！唰！",
                "0_H061": "",
                "0_H062": "",
                "0_H063": "",
                "0_H064": "",
                "0_H065": ""
            },
            "raw_text": {
                "0_H060": "好きなものですか？ふっふっふーん！実は最近、遂に、アレを作ってもらっちゃったんですよー！つまり、名刺を渡す事、です！実演してもいいですか？オッホン！どーも、私、こういう者です！サッ！",
                "0_H061": "",
                "0_H062": "",
                "0_H063": "",
                "0_H064": "",
                "0_H065": ""
            }
        },
        "0_H070": {
            "name": "嫌いなこと",
            "text": {
                "0_H070": "我喜欢夏天，也喜欢大海。但是，夏天的海滩上为什么会有那么多男人的裸体呢……要是没有那些的话，我也就能再放松一点在沙滩上散步了……",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            },
            "raw_text": {
                "0_H070": "夏は好きです。海も好きです。でも、夏の海って、どうしてあんなに男の人の裸が多いんでしょうか……それがなかったら、もう少し気楽に浜辺を歩いたりも出来るんですけど……",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯的用法……吗？升职……感觉还太早，永久就职（结婚）……也打算不急躁、稳扎稳打地去争取……哈！如果用来打窝撒诱饵的话，会不会接二连三钓上没见过的鱼呢！？……说这种话，果然还是不行吧？",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": ""
            },
            "raw_text": {
                "0_H080": "聖杯の使い方……ですか？昇進……はまだ早いと思うし、永久就職……は焦らずじっくり狙っていく方針ですし……は！撒き餌を撒くのに使ったりしたら、見た事もないお魚がじゃんじゃかと！？……なんて言うのは、駄目ですよね、やっぱり？",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": ""
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "因为是第一次出差，可能会给您添很多麻烦。还请多多指教与鞭策！御主！",
                "0_H091": ""
            },
            "raw_text": {
                "0_H090": "初めての出張なので、いろいろご迷惑をかけてしまうかもしれません。ご指導ご鞭撻のほど、よろしくお願いします!マスター!",
                "0_H091": ""
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "虽然也听说过“带薪休假就是睡过去”这种说法，但对于还是新人的我来说，根本做不出那种资深社会人的举动！我会全力向您展现极其闪耀的带薪休假消化的！",
                "0_H101": "",
                "0_H102": ""
            },
            "raw_text": {
                "0_H100": "有給休暇は寝て過ごすという話も聞きますが、まだまだ新人が私には、とてもそんなベテラン社会人ムーブはできません!全力で、この上なくキラキラな有給消化を披露してみせます",
                "0_H101": "",
                "0_H102": ""
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "呼呼呼，特地帮我制作的这个员工证和名片……果然不管看多少次都是好东西呢——！",
                "0_H111": "",
                "0_H112": ""
            },
            "raw_text": {
                "0_H110": "ふふふ、特別に作ってもらった この社員証と名刺。やっぱり、何度見てもいいものですねー!",
                "0_H111": "",
                "0_H112": ""
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "出差与带薪休假的奥义。那究竟是……我认为就是两者都要好好制定计划！正因为是需要与平时不同的时间分配的时候，才更应该明确什么才是最重要的！我先试着制定一下明天的计划，等完成了请您检查一下！御主！",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            },
            "raw_text": {
                "0_H120": "出張と有給の極意。それは……ともにしっかり予定を立てることだと思うんです！普段と違う時間の使い方が必要な時だからこそ、何が大事かをきちんと決めておくべきみたいな!試しに、明日の予定を立ててみますので、完成したらチェックをお願いします!マスター!",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "明天的计划做好了！感觉这样就万无一失了。上午与御主一起度过，下午也与御主一起度过，然后夜晚也！不、不是的，这并没有什么奇怪的意思，你看，还有夜钓之类的各种活动嘛，对吧？",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": ""
            },
            "raw_text": {
                "0_H130": "明日の予定ができました！これでバッチリだと思います。午前中はマスターとともに過ごし、午後もマスターとともに過ごし、そして夜も!い、いえ、これは別に変な意味ではなくてその、夜釣りとかはいろいろありますし、ね?",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": ""
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "我听说卫宫先生还拥有垂钓者（Angler）的职阶适应性呢！真想拜他为师请教各种技巧啊！诶？『没有这种职阶』？",
                "0_H171": "",
                "0_H172": ""
            },
            "raw_text": {
                "0_H170": "エミヤさんは、アングラーのクラス適性も持っていらっしゃると聞きました！弟子入りして、色々教えてもらいたいです！え？『そんなクラスはない』？",
                "0_H171": "",
                "0_H172": ""
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "多亏了美狄亚小姐，现在的我被固定成了比平时更接近忒拜之龙的状态！魔女果然好厉害呢！",
                "0_H181": ""
            },
            "raw_text": {
                "0_H180": "メディアさんのおかげで、今の私は、普段よりテーバイのドラゴンに寄った状態で固定されているのです！魔女ってやっぱり、凄いですよね！",
                "0_H181": ""
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "说到水边的龙，果然还是利维坦呢！虽然很向往，但因为名头实在太响亮了……那边果然还是交给梅尔特莉莉丝前辈，我自己就按自己的方式努力吧！",
                "0_H191": "",
                "0_H192": "",
                "0_H193": ""
            },
            "raw_text": {
                "0_H190": "水辺のドラゴンと言えば、やっぱり、リヴァイアサンですよね！憧れはありますが、あまりにビッグネーム過ぎるので……やっぱりそちらは、メルトリリス先輩にお任せして、私は私なりに、頑張りたいと思います！",
                "0_H191": "",
                "0_H192": "",
                "0_H193": ""
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "莉莉丝小姐似乎并不是蛇，但不知为何总觉得很有亲近感，或者说相性很合呢。这是为什么呢……？",
                "0_H201": ""
            },
            "raw_text": {
                "0_H200": "リリスさんは、蛇じゃないみたいなんですけど、何だか凄く親しみが持てると言うか、相性がいい感じがするんですよね。どうしてなんでしょう……？",
                "0_H201": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "我听说太公望先生钓鱼连鱼饵都不挂，用的是直钩呢！这也太钓鱼达人了吧！真想向他学习各种技巧呢！……不过，虽然我也不太用鱼饵，但我那是从骨针里渗出类似美味高汤的感觉，所以有点算耍赖了……！",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": ""
            },
            "raw_text": {
                "0_H210": "太公望さんは、餌も付けない真っ直ぐな針で釣りをすると聞きました！釣りの達人過ぎますよね！色々学びたいものです！……まあ、私も、餌はあまり使わないんですけど、あれは骨の梁から美味しい出汁みたいのが染み出ている感じなので、ちょっと、ズルです……！",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": ""
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "第一次前往南国的出差业务……以及第一次带薪休假！如果能顺利完成这项任务，我也许终于能从新员工的身份毕业了！我打算全力工作，全力痛快玩耍！因此，御主，要不要一起去钓鱼呢？",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            },
            "raw_text": {
                "0_S010": "初めての、南国への出張業務……そして、初めての有給休暇！このミッションを無事にこなすことができれば、いよいよわたしも新入社員という立場を卒業できるかもしれません！全力で働いて、全力で遊んでしまおうと思います！というわけで、マスター。一緒に、釣りなんていかがですか？",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            }
        }
    },
    "ChrVoice_ids": [
        "506000"
    ]
}
