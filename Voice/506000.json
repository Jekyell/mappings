            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "第一次出差！我会努力的！"
            },
            "raw_text": {
                "0_B510": "初めての出張！頑張ります！"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "大海固然不错，但宁静的泉水也很棒哦。"
            },
            "raw_text": {
                "0_B520": "海もいいけど、静かな泉もいいものですよ"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": "好痛！"
            },
            "raw_text": {
                "0_B540": "いた！"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "应对突发状况！"
            },
            "raw_text": {
                "0_B550": "予期せぬトラブル対応！"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "出差结束了？也是呢……"
            },
            "raw_text": {
                "0_B560": "出張は終わり？ですよねー"
