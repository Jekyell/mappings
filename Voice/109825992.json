    "0_I210": {
      "name": "关于商店 21",
      "text": {
        "0_I210": "我乃LOVE LOVE HEART若安石像。",
        "0_I211": "乃是守护情人节的石像。大概吧。"
      }
    },
    "0_I220": {
      "name": "关于商店 22",
      "text": {
        "0_I220": "我乃超巨大石像若安。 非常了不起。"
      }
    },
    "0_I230": {
      "name": "关于商店 23",
      "text": {
        "0_I230": "为什么在这里看店，为什么能够说话。",
        "0_I231": "石像究竟有没有意志。"
      }
    },
    "0_I240": {
      "name": "关于商店 24",
      "text": {
        "0_I240": "若安现在出门了。",
        "0_I241": "我是代理、助手，之类的……"
      }
    },
    "0_I310": {
      "name": "关于商店 31",
      "text": {
        "0_I310": "活动结束。",
        "0_I311": "我应该很快就会崩溃了吧。但是请一定要注意，迦勒底。",
        "0_I312": "即便我毁灭了，也会有第二、第三座石像阻挡在汝等的面前吧……前吧……吧……"
      }
    },
    "0_I320": {
      "name": "关于商店 32",
      "text": {
        "0_I320": "任务完成。",
        "0_I321": "真是LOVE LOVE。",
        "0_I322": "真是太LOVE LOVE了……"
      }
    }
