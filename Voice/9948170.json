{
  "id": 9948170,
  "name": "Enemy 9948170",
  "voices": {
    "0_B010": {
      "name": "0_B010",
      "text": {
        "0_B010": "真是残酷呢。"
      },
      "raw_text": {
        "0_B010": "残酷ですね。"
      }
    },
    "0_B020": {
      "name": "0_B020",
      "text": {
        "0_B020": "还远远不够呢。"
      },
      "raw_text": {
        "0_B020": "まだまだ。"
      }
    },
    "0_B030": {
      "name": "0_B030",
      "text": {
        "0_B030": "就只有这点程度吗？"
      },
      "raw_text": {
        "0_B030": "それだけですか？"
      }
    },
    "0_B050": {
      "name": "0_B050",
      "text": {
        "0_B050": "受天与地、受世人所爱而育的清僧。"
      },
      "raw_text": {
        "0_B050": "天と地と、人に愛され育つ清掃。"
      }
    },
    "0_B051": {
      "name": "0_B051",
      "text": {
        "0_B051": "这正是我珍藏已久的宝物！"
      },
      "raw_text": {
        "0_B051": "こちらこそが私の、とっておきの宝物！"
      }
    },
    "0_B052": {
      "name": "0_B052",
      "text": {
        "0_B052": "快法一掌，苦患解禁！"
      },
      "raw_text": {
        "0_B052": "解剖一掌、空弾解禁！"
      }
    },
    "0_B080": {
      "name": "0_B080",
      "text": {
        "0_B080": "我们彼此都要加油哦。"
      },
      "raw_text": {
        "0_B080": "お互い頑張りましょうね。"
      }
    },
    "0_B090": {
      "name": "0_B090",
      "text": {
        "0_B090": "心平气和些～"
      },
      "raw_text": {
        "0_B090": "穏やかにー。"
      }
    },
    "0_B140": {
      "name": "0_B140",
      "text": {
        "0_B140": "是！"
      },
      "raw_text": {
        "0_B140": "はいっ！"
      }
    },
    "0_B150": {
      "name": "0_B150",
      "text": {
        "0_B150": "真不愧是您～"
      },
      "raw_text": {
        "0_B150": "さすがですー。"
      }
    },
    "0_B160": {
      "name": "0_B160",
      "text": {
        "0_B160": "那么，我们就明天再见了。"
      },
      "raw_text": {
        "0_B160": "それではまた明日、ですわ。"
      }
    },
    "0_B170": {
      "name": "0_B170",
      "text": {
        "0_B170": "感觉您是不是稍微有些太拼命了呢……"
      },
      "raw_text": {
        "0_B170": "ちょっと頑張りすぎではないかと……"
      }
    },
    "0_B300": {
      "name": "0_B300",
      "text": {
        "0_B300": "哎呀哎呀哎呀，我怎么会来到这种地方？不过，既然如此那我就好好努力一番吧。"
      },
      "raw_text": {
        "0_B300": "あらあらあら、どうしてわたくしがこんなところに？でも、それならがんばらせていただきますね。"
      }
    },
    "0_B310": {
      "name": "0_B310",
      "text": {
        "0_B310": "美丽，还要更加美丽……今宵就让我们尽情享乐吧～"
      },
      "raw_text": {
        "0_B310": "美しく、なお美しく……今宵は楽しく参りましょうー。"
      }
    },
    "0_B410": {
      "name": "0_B410",
      "text": {
        "0_B410": "加油！"
      },
      "raw_text": {
        "0_B410": "頑張って！"
      }
    },
    "0_B420": {
      "name": "0_B420",
      "text": {
        "0_B420": "要加油哦。"
      },
      "raw_text": {
        "0_B420": "ファイトですよ。"
      }
    },
    "0_B430": {
      "name": "0_B430",
      "text": {
        "0_B430": "御主大人～"
      },
      "raw_text": {
        "0_B430": "主様ー。"
      }
    },
    "0_B480": {
      "name": "0_B480",
      "text": {
        "0_B480": "要上咯～"
      },
      "raw_text": {
        "0_B480": "行きますよー。"
      }
    },
    "0_B490": {
      "name": "0_B490",
      "text": {
        "0_B490": "您是认真的吗？"
      },
      "raw_text": {
        "0_B490": "本気なのです？"
      }
    },
    "0_B560": {
      "name": "0_B560",
      "text": {
        "0_B560": "稍微休息一下吧？好不好？"
      },
      "raw_text": {
        "0_B560": "少し休憩しましょう？ね？"
      }
    },
    "0_B570": {
      "name": "0_B570",
      "text": {
        "0_B570": "宛如梦幻一般的时光，真是万分感谢。那么，今后也请多多关照啦～"
      },
      "raw_text": {
        "0_B570": "夢のようなひととき、ありがとうございました。それでは、今後ともよろしくお願いしまーす。"
      }
    },
    "0_B800": {
      "name": "0_B800",
      "text": {
        "0_B800": "你定会深爱于我，得享圆满。"
      },
      "raw_text": {
        "0_B800": "きっと、我を愛し満たされる。"
      }
    },
    "0_B801": {
      "name": "0_B801",
      "text": {
        "0_B801": "我爱世间万物，由此圆满。"
      },
      "raw_text": {
        "0_B801": "我、全てを愛し満たされる。"
      }
    },
    "0_B802": {
      "name": "0_B802",
      "text": {
        "0_B802": "请伴随着这拥抱一同沉眠吧。"
      },
      "raw_text": {
        "0_B802": "抱擁と共に眠りましょう。"
      }
    },
    "0_B803": {
      "name": "0_B803",
      "text": {
        "0_B803": "快法一掌，苦患开启！"
      },
      "raw_text": {
        "0_B803": "解剖一証、空弾開き！"
      }
    },
    "0_B910": {
      "name": "0_B910",
      "text": {
        "0_B910": "您身体感觉如何呢？"
      },
      "raw_text": {
        "0_B910": "お加減どうですか？"
      }
    },
    "0_B920": {
      "name": "0_B920",
      "text": {
        "0_B920": "不要认输哦。"
      },
      "raw_text": {
        "0_B920": "負けないで。"
      }
    }
  }
}
