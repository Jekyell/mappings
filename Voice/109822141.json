  "voices": {
    "0_N020": {
      "name": "关于活动 2",
      "text": {
        "0_N020": "这套泳装吗？　其实那套泳装现在正在清洗……",
        "0_N021": "因为主人把咖喱彻底打翻了嘛。",
        "0_N022": "但是，这次不要紧了！",
        "0_N023": "我是不会输给今晚的咖喱乌冬面的！",
        "0_N024": "明天你也来帮忙一起洗吧，主人的御主啊。"
      }
    },
    "0_N070": {
      "name": "关于活动 7",
      "text": {
        "0_N070": "啊，御主！",
        "0_N071": "如何，要不要最后和我一起去海里游会儿泳？",
        "0_N072": "嗯，我还要收拾东西，你们俩自己去吧。",
        "0_N073": "唔，这样可不行。",
        "0_N074": "大家一起游吧，好吗？",
        "0_N075": "知道啦，知道啦。",
        "0_N076": "说得对……大家一起游吧。",
        "0_N077": "嗯，大家一起！"
      }
    }
  },
