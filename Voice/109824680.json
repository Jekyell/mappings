{
  "id": 109824680,
  "name": "",
  "voices": {
    "0_E010": {
      "name": "南溟弓张八犬传 8",
      "text": {
        "0_E010": "来吧，犬士们，该工作了哦。",
        "0_E011": "……喂喂，那是御主大人的鞋子，快还给人家。"
      }
    },
    "0_E020": {
      "name": "南溟弓张八犬传 9",
      "text": {
        "0_E020": "外出的时候路上小心哦。"
      }
    },
    "0_E040": {
      "name": "南溟弓张八犬传 10",
      "text": {
        "0_E040": "公告……",
        "0_E041": "不，通知您已经看过了吗？",
        "0_E042": "有备无患！"
      }
    },
    "0_E050": {
      "name": "南溟弓张八犬传 11",
      "text": {
        "0_E050": "○月○日 晴天",
        "0_E051": "御主大人来访。",
        "0_E052": "聊了一会儿天，和犬士们玩了一会儿。",
        "0_E053": "吃了点粟米年糕、冰水、蒸蛋羹等填饱肚子。",
        "0_E054": "粗茶淡饭多有怠慢。"
      }
    },
    "0_E060": {
      "name": "南溟弓张八犬传 12",
      "text": {
        "0_E060": "仁义礼智，忠信孝悌。",
        "0_E061": "里见的小小犬士们有没有帮上您的忙呢？",
        "0_E062": "若有缘分，愿能再见。",
        "0_E063": "就此告辞。"
      }
    },
    "0_E070": {
      "name": "南溟弓张八犬传 13",
      "text": {
        "0_E070": "天气已经进入盛夏，是去海边游泳的季节了呢。",
        "0_E071": "听说阿荣小姐还带着引以为傲的泳装。",
        "0_E072": "多少有点羡慕呢。",
        "0_E073": "话虽如此，我也不会游泳……",
        "0_E074": "狗刨式的话，勉强还行吧。"
      }
    },
    "0_I010": {
      "name": "关于商店 1",
      "text": {
        "0_I010": "欢迎光临！",
        "0_I011": "看店对阿路来说已是家常便饭。",
        "0_I012": "您有什么吩咐尽管提。"
      }
    },
    "0_I020": {
      "name": "关于商店 2",
      "text": {
        "0_I020": "对面胡同的狐仙先生～♪",
        "0_I021": "哎呀，是来兑换道具的呀。",
        "0_I022": "休息一会儿，要不要喝点茶吃点团子？",
        "0_I023": "呵呵呵。"
      }
    },
    "0_I030": {
      "name": "关于商店 3",
      "text": {
        "0_I030": "是兑换这件吧。",
        "0_I031": "给，路上小心。"
      }
    },
    "0_I040": {
      "name": "关于商店 4",
      "text": {
        "0_I040": "有没有想要的东西？",
        "0_I041": "那真是太好了。"
      }
    },
    "0_I050": {
      "name": "关于商店 5",
      "text": {
        "0_I050": "给，请收下。",
        "0_I051": "啊……有好多奇妙的东西呢……"
      }
    },
    "0_I060": {
      "name": "关于商店 6",
      "text": {
        "0_I060": "多亏了您的帮助，这家兑换所也差不多该卸下招牌门帘了。",
        "0_I061": "关店前请别忘了兑换哦。"
      }
    },
    "0_I070": {
      "name": "关于商店 7",
      "text": {
        "0_I070": "看店的工作是和公公齐心协力完成的，就像不断交换的两人一面，非常开心。",
        "0_I071": "御主大人每天的来访，也像是太郎的同心同事造访咱家那时一样，令我感到非常怀念。",
        "0_I072": "作为令人高兴的事，我要将这些记在咱家的日记里。"
      }
    }
  },
  "ChrVoice_ids": [
    "109824680"
  ]
}
