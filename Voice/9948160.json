{
    "id": 9948160,
    "name": "Enemy 9948160",
    "voices": {
        "0_B010": {
            "name": "0_B010",
            "text": {
                "0_B010": "喝！"
            },
            "raw_text": {
                "0_B010": "はっ。"
            }
        },
        "0_B020": {
            "name": "0_B020",
            "text": {
                "0_B020": "哈！"
            },
            "raw_text": {
                "0_B020": "てあ。"
            }
        },
        "0_B030": {
            "name": "0_B030",
            "text": {
                "0_B030": "预——备。"
            },
            "raw_text": {
                "0_B030": "せーのっ。"
            }
        },
        "0_B040": {
            "name": "0_B040",
            "text": {
                "0_B040": "如风暴般，如利刃般。"
            },
            "raw_text": {
                "0_B040": "嵐のように、刃のように。"
            }
        },
        "0_B050": {
            "name": "0_B050",
            "text": {
                "0_B050": "要上咯——"
            },
            "raw_text": {
                "0_B050": "行くぞー。"
            }
        },
        "0_B051": {
            "name": "0_B051",
            "text": {
                "0_B051": "塞诺伊、桑塞诺伊、塞曼加洛夫。"
            },
            "raw_text": {
                "0_B051": "セノイ、サンセノイ、セマンギャロフ。"
            }
        },
        "0_B052": {
            "name": "0_B052",
            "text": {
                "0_B052": "以此名义，化为斩裂病痛之风吧。"
            },
            "raw_text": {
                "0_B052": "この名をもって病を切り裂く風となれ。"
            }
        },
        "0_B053": {
            "name": "0_B053",
            "text": {
                "0_B053": "赛阿拉的阿拉特·富尔班。"
            },
            "raw_text": {
                "0_B053": "セアラのアラトフルバーン。"
            }
        },
        "0_B080": {
            "name": "0_B080",
            "text": {
                "0_B080": "好啦好啦——"
            },
            "raw_text": {
                "0_B080": "はいはーい。"
            }
        },
        "0_B090": {
            "name": "0_B090",
            "text": {
                "0_B090": "这样怎么样？"
            },
            "raw_text": {
                "0_B090": "こんなんでどう。"
            }
        },
        "0_B100": {
            "name": "0_B100",
            "text": {
                "0_B100": "哼哼~ 那就开干吧。"
            },
            "raw_text": {
                "0_B100": "ふふーん、それじゃあやるか。"
            }
        },
        "0_B110": {
            "name": "0_B110",
            "text": {
                "0_B110": "御主，我这身泳装好看吗？诶？不准看别的地方！"
            },
            "raw_text": {
                "0_B110": "マスター、水着似合う？え？よそ見するな。"
            }
        },
        "0_B120": {
            "name": "0_B120",
            "text": {
                "0_B120": "赢啦赢啦！快看快看御主，我表现得怎么样？"
            },
            "raw_text": {
                "0_B120": "勝った勝った！ほらほらマスター、あたしどうだった。"
            }
        },
        "0_B130": {
            "name": "0_B130",
            "text": {
                "0_B130": "我刚才算帅气？还是算可爱？只有这两个选项可以选哦！"
            },
            "raw_text": {
                "0_B130": "あたし、カッコよかった？それとも可愛かった？二択以外ないからね。"
            }
        },
        "0_B140": {
            "name": "0_B140",
            "text": {
                "0_B140": "找到了！"
            },
            "raw_text": {
                "0_B140": "あった。"
            }
        },
        "0_B150": {
            "name": "0_B150",
            "text": {
                "0_B150": "就说很痛了啦，真是的。"
            },
            "raw_text": {
                "0_B150": "痛いってばさぁ、もう。"
            }
        },
        "0_B160": {
            "name": "0_B160",
            "text": {
                "0_B160": "呜……衣服都变得破破烂烂的了啦——"
            },
            "raw_text": {
                "0_B160": "うーん、服がボロボロじゃんかー。"
            }
        },
        "0_B170": {
            "name": "0_B170",
            "text": {
                "0_B170": "你给我记好了，混蛋小崽子。"
            },
            "raw_text": {
                "0_B170": "覚えてろよ、こんにゃろ。"
            }
        },
        "0_B180": {
            "name": "0_B180",
            "text": {
                "0_B180": "没问题~"
            },
            "raw_text": {
                "0_B180": "オッケー。"
            }
        },
        "0_B190": {
            "name": "0_B190",
            "text": {
                "0_B190": "好哦——"
            },
            "raw_text": {
                "0_B190": "いいよー。"
            }
        },
        "0_B200": {
            "name": "0_B200",
            "text": {
                "0_B200": "要动手了吗？"
            },
            "raw_text": {
                "0_B200": "やっちゃうか。"
            }
        },
        "0_B2010": {
            "name": "0_B2010",
            "text": {
                "0_B2010": "飞踩攻击！"
            },
            "raw_text": {
                "0_B2010": "フットスタンプ。"
            }
        },
        "0_B2020": {
            "name": "0_B2020",
            "text": {
                "0_B2020": "给我爆炸吧——！"
            },
            "raw_text": {
                "0_B2020": "爆発しなーっ。"
            }
        },
        "0_B2030": {
            "name": "0_B2030",
            "text": {
                "0_B2030": "这可是旋风攻击哦！"
            },
            "raw_text": {
                "0_B2030": "サイクロンだぜ。"
            }
        },
        "0_B2080": {
            "name": "0_B2080",
            "text": {
                "0_B2080": "去做个好梦吧。"
            },
            "raw_text": {
                "0_B2080": "夢を見るの。"
            }
        },
        "0_B2090": {
            "name": "0_B2090",
            "text": {
                "0_B2090": "在黑夜中欢笑吧。"
            },
            "raw_text": {
                "0_B2090": "夜に笑うの。"
            }
        },
        "0_B210": {
            "name": "0_B210",
            "text": {
                "0_B210": "是要用宝具对吧。交给我吧。"
            },
            "raw_text": {
                "0_B210": "宝具だね。任された。"
            }
        },
        "0_B220": {
            "name": "0_B220",
            "text": {
                "0_B220": "好，要把你们全卷进来咯。"
            },
            "raw_text": {
                "0_B220": "よし、巻き上げちゃうね。"
            }
        },
        "0_B230": {
            "name": "0_B230",
            "text": {
                "0_B230": "想看人家的宝具吗？"
            },
            "raw_text": {
                "0_B230": "アテシの宝具、見たいんだ。"
            }
        },
        "0_B2410": {
            "name": "0_B2410",
            "text": {
                "0_B2410": "逆向旋转吧！"
            },
            "raw_text": {
                "0_B2410": "逆島に回れ。"
            }
        },
        "0_B2420": {
            "name": "0_B2420",
            "text": {
                "0_B2420": "巴拉克·内谢尔。"
            },
            "raw_text": {
                "0_B2420": "バラクネシェル。"
            }
        },
        "0_B2430": {
            "name": "0_B2430",
            "text": {
                "0_B2430": "咻咻激光！"
            },
            "raw_text": {
                "0_B2430": "ギュンギュンレーザー。"
            }
        },
        "0_B2480": {
            "name": "0_B2480",
            "text": {
                "0_B2480": "坠入爱河吧。"
            },
            "raw_text": {
                "0_B2480": "恋に堕けるの。"
            }
        },
        "0_B2810": {
            "name": "0_B2810",
            "text": {
                "0_B2810": "转啊转——轰！"
            },
            "raw_text": {
                "0_B2810": "ぐるぐるガーン。"
            }
        },
        "0_B2820": {
            "name": "0_B2820",
            "text": {
                "0_B2820": "嗷呜嗷呜——！"
            },
            "raw_text": {
                "0_B2820": "ガルガルだー。"
            }
        },
        "0_B2830": {
            "name": "0_B2830",
            "text": {
                "0_B2830": "糖果导弹！"
            },
            "raw_text": {
                "0_B2830": "キャンディーミサイル。"
            }
        },
        "0_B3010": {
            "name": "0_B3010",
            "text": {
                "0_B3010": "这可是热追踪的哦。"
            },
            "raw_text": {
                "0_B3010": "熱誘導だぜ。"
            }
        },
        "0_B410": {
            "name": "0_B410",
            "text": {
                "0_B410": "来，砰的一下——"
            },
            "raw_text": {
                "0_B410": "はい、どーんと。"
            }
        },
        "0_B420": {
            "name": "0_B420",
            "text": {
                "0_B420": "冰淇淋超好吃的——！"
            },
            "raw_text": {
                "0_B420": "アイスうみゃー。"
            }
        },
        "0_B430": {
            "name": "0_B430",
            "text": {
                "0_B430": "吃颗糖果~"
            },
            "raw_text": {
                "0_B430": "キャンディ食べる"
            }
        },
        "0_B440": {
            "name": "0_B440",
            "text": {
                "0_B440": "意思就是给我呼啸狂吹啦。"
            },
            "raw_text": {
                "0_B440": "吹きすさべって話さ。"
            }
        },
        "0_B480": {
            "name": "0_B480",
            "text": {
                "0_B480": "出发咯！"
            },
            "raw_text": {
                "0_B480": "レッツゴー。"
            }
        },
        "0_B490": {
            "name": "0_B490",
            "text": {
                "0_B490": "唔——嗯，真好吃。"
            },
            "raw_text": {
                "0_B490": "んー、はいおいしい。"
            }
        },
        "0_B500": {
            "name": "0_B500",
            "text": {
                "0_B500": "我现在可是在度假休假中耶——"
            },
            "raw_text": {
                "0_B500": "今レジャー中なんだけどー。"
            }
        },
        "0_B510": {
            "name": "0_B510",
            "text": {
                "0_B510": "那么，就华丽地干掉他们吧。"
            },
            "raw_text": {
                "0_B510": "それじゃあ、華麗に倒しちゃうか。"
            }
        },
        "0_B520": {
            "name": "0_B520",
            "text": {
                "0_B520": "穿着泳装战斗还挺有意思的嘛~ 难道说是御主的特殊癖好？"
            },
            "raw_text": {
                "0_B520": "水着で戦うとか面白いねー。もしかしてマスターの趣味。"
            }
        },
        "0_B540": {
            "name": "0_B540",
            "text": {
                "0_B540": "真是的——！"
            },
            "raw_text": {
                "0_B540": "もーっ。"
            }
        },
        "0_B550": {
            "name": "0_B550",
            "text": {
                "0_B550": "我可绝不原谅你哦。"
            },
            "raw_text": {
                "0_B550": "許さないかんな。"
            }
        },
        "0_B560": {
            "name": "0_B560",
            "text": {
                "0_B560": "下次我一定会完美拿下的。"
            },
            "raw_text": {
                "0_B560": "次はまたバッチリ決めてくるから。"
            }
        },
        "0_B570": {
            "name": "0_B570",
            "text": {
                "0_B570": "好嘞，我先稍微退场一下咯~"
            },
            "raw_text": {
                "0_B570": "はい、ちょっと落ちまーす。"
            }
        },
        "0_B800": {
            "name": "0_B800",
            "text": {
                "0_B800": "吾之风暴，吾之夜晚，吾之利刃。"
            },
            "raw_text": {
                "0_B800": "我が嵐、我が夜、我が刃。"
            }
        },
        "0_B801": {
            "name": "0_B801",
            "text": {
                "0_B801": "闪耀于天际，贯穿敌人吧！"
            },
            "raw_text": {
                "0_B801": "空に煌めき、敵を貫け。"
            }
        },
        "0_B802": {
            "name": "0_B802",
            "text": {
                "0_B802": "赛阿拉·纳哈拉·特富尔班。"
            },
            "raw_text": {
                "0_B802": "セアラナーラトフルバーン。"
            }
        },
        "0_B803": {
            "name": "0_B803",
            "text": {
                "0_B803": "没错，人家最可爱了~"
            },
            "raw_text": {
                "0_B803": "はい、あてし可愛い"
            }
        },
        "0_B810": {
            "name": "0_B810",
            "text": {
                "0_B810": "咻咻飞上天，闪亮登场！"
            },
            "raw_text": {
                "0_B810": "ギュンギュン飛んで、キラキラ登場。"
            }
        },
        "0_B811": {
            "name": "0_B811",
            "text": {
                "0_B811": "御主！给我好好瞻仰我这又帅又可爱的身姿吧！"
            },
            "raw_text": {
                "0_B811": "マスター！あたしのカッコ可愛い姿、バッチリ拝め。"
            }
        },
        "0_B812": {
            "name": "0_B812",
            "text": {
                "0_B812": "好啦，坠入爱河了吧——"
            },
            "raw_text": {
                "0_B812": "はい、恋に落ちたー。"
            }
        },
        "0_B840": {
            "name": "0_B840",
            "text": {
                "0_B840": "让你好好见识见识我帅气的一面——"
            },
            "raw_text": {
                "0_B840": "あたしのかっこいいとこ見せちゃうぞー。"
            }
        },
        "0_B880": {
            "name": "0_B880",
            "text": {
                "0_B880": "眼睛眨巴眨巴——！"
            },
            "raw_text": {
                "0_B880": "おめめパチーん。"
            }
        },
        "0_B890": {
            "name": "0_B890",
            "text": {
                "0_B890": "来掀起一阵风暴吧——"
            },
            "raw_text": {
                "0_B890": "ひと風起こすかー。"
            }
        },
        "0_B910": {
            "name": "0_B910",
            "text": {
                "0_B910": "甜品攻击！"
            },
            "raw_text": {
                "0_B910": "スイーツアタック。"
            }
        },
        "0_B920": {
            "name": "0_B920",
            "text": {
                "0_B920": "飞过去——砰！"
            },
            "raw_text": {
                "0_B920": "飛んでドーン。"
            }
        },
        "0_B930": {
            "name": "0_B930",
            "text": {
                "0_B930": "脑门粉碎！"
            },
            "raw_text": {
                "0_B930": "脳天クラッシュ。"
            }
        }
    }
}