    "voices": {
        "0_B010": {
            "name": "アタック 1",
            "text": {
                "0_B010": ""
            },
            "raw_text": {
                "0_B010": "はっ。"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": ""
            },
            "raw_text": {
                "0_B020": "てああっ。"
            }
        },
        "0_B030": {
            "name": "アタック 3",
            "text": {
                "0_B030": ""
            },
            "raw_text": {
                "0_B030": "せーのっ。"
            }
        },
        "0_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "0_B040": "如风暴般，如利刃般。"
            },
            "raw_text": {
                "0_B040": "嵐のように 刃のように。"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "要上啦—！",
                "0_B051": "光明之使、辟邪三天使！",
                "0_B052": "以这些名字化作斩断疾病的风吧。",
                "0_B053": "斩断疾病与灾厄之风！"
            },
            "raw_text": {
                "0_B050": "行くぞー！",
                "0_B051": "セノイ、サンセノイ、セマンギャロフ。",
                "0_B052": "この名をもって病を切り裂く風となれ。",
                "0_B053": "セアラ・ナアラト・フルバーン！"
            }
        },
        "0_B080": {
            "name": "スキル 1",
            "text": {
                "0_B080": "好—好—。"
            },
            "raw_text": {
                "0_B080": "はいはーい。"
            }
        },
        "0_B090": {
            "name": "スキル 2",
            "text": {
                "0_B090": "这样如何。"
            },
            "raw_text": {
                "0_B090": "こんなんでどう。"
            }
        },
        "0_B100": {
            "name": "開始 1",
            "text": {
                "0_B100": "哼哼—，那就干吧。"
            },
            "raw_text": {
                "0_B100": "ふふーん、それじゃあやるか。"
            }
        },
        "0_B110": {
            "name": "開始 2",
            "text": {
                "0_B110": "御主，我穿泳装好看吗？诶？不要看别处哦？"
            },
            "raw_text": {
                "0_B110": "マスター、水着似合う？え？よそ見するな？"
            }
        },
        "0_B120": {
            "name": "勝利 1",
            "text": {
                "0_B120": "赢了赢了—！来嘛来嘛御主，人家表现得怎么样？"
            },
            "raw_text": {
                "0_B120": "勝った勝ったー！ほらほらマスター、アテシどうだった？"
            }
        },
        "0_B130": {
            "name": "勝利 2",
            "text": {
                "0_B130": "人家是帅气呢？还是可爱呢？除这两个选项外可没有别的答案哦。"
            },
            "raw_text": {
                "0_B130": "アテシ、かっこよかった？それとも可愛かった？2択以外ないからね。"
            }
        },
        "0_B140": {
            "name": "ダメージ 2",
            "text": {
                "0_B140": ""
            },
            "raw_text": {
                "0_B140": "あった。"
            }
        },
        "0_B150": {
            "name": "ダメージ 1",
            "text": {
                "0_B150": "都说了很痛啦，真是的。"
            },
            "raw_text": {
                "0_B150": "痛いってばさぁ、もう。"
            }
        },
        "0_B160": {
            "name": "戦闘不能 1",
            "text": {
                "0_B160": "啊嗯！衣服都变得破破烂烂的了啦！"
            },
            "raw_text": {
                "0_B160": "あーん!服がボロボロじゃんか!"
            }
        },
        "0_B170": {
            "name": "戦闘不能 2",
            "text": {
                "0_B170": "给你记住了，混蛋小鬼！"
            },
            "raw_text": {
                "0_B170": "覚えてるよ、こんにゃろ！"
            }
        },
        "0_B180": {
            "name": "コマンドカード 1",
            "text": {
                "0_B180": "OK。"
            },
            "raw_text": {
                "0_B180": "オッケー。"
            }
        },
        "0_B190": {
            "name": "コマンドカード 2",
            "text": {
                "0_B190": "好哦—。"
            },
            "raw_text": {
                "0_B190": "いいよー。"
            }
        },
        "0_B200": {
            "name": "コマンドカード 3",
            "text": {
                "0_B200": "干掉他们吧。"
            },
            "raw_text": {
                "0_B200": "やっちゃうか。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "脚踩攻击。"
            },
            "raw_text": {
                "0_B2010": "フットスタンプ。"
            }
        },
        "0_B2020": {
            "name": "アタック 11",
            "text": {
                "0_B2020": "给我爆炸吧。"
            },
            "raw_text": {
                "0_B2020": "爆発しな。"
            }
        },
        "0_B2030": {
            "name": "アタック 12",
            "text": {
                "0_B2030": "看我的气旋。"
            },
            "raw_text": {
                "0_B2030": "サイクロンだぜ。"
            }
        },
        "0_B2080": {
            "name": "スキル 7",
            "text": {
                "0_B2080": "做个梦吧。"
            },
            "raw_text": {
                "0_B2080": "夢を見るの。"
            }
        },
        "0_B2090": {
            "name": "スキル 8",
            "text": {
                "0_B2090": "在夜里欢笑吧。"
            },
            "raw_text": {
                "0_B2090": "夜に笑うの。"
            }
        },
        "0_B210": {
            "name": "宝具カード 1",
            "text": {
                "0_B210": "要用宝具对吧。交给我吧。"
            },
            "raw_text": {
                "0_B210": "宝具だね。任された。"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "好，卷起来吧。"
            },
            "raw_text": {
                "0_B220": "よし 巻き上げちゃうね。"
            }
        },
        "0_B230": {
            "name": "宝具カード 3",
            "text": {
                "0_B230": "想看人家的宝具吗？"
            },
            "raw_text": {
                "0_B230": "アテシの宝具見たいんだ？"
            }
        },
        "0_B2410": {
            "name": "アタック 13",
            "text": {
                "0_B2410": "倒着旋转吧！"
            },
            "raw_text": {
                "0_B2410": "逆しまに回れ！"
            }
        },
        "0_B2420": {
            "name": "アタック 14",
            "text": {
                "0_B2420": "巴拉克奈歇尔！"
            },
            "raw_text": {
                "0_B2420": "バラクネシェル！"
            }
        },
        "0_B2430": {
            "name": "アタック 15",
            "text": {
                "0_B2430": "咻咻激光。"
            },
            "raw_text": {
                "0_B2430": "ギュンギュンレーザー。"
            }
        },
        "0_B2480": {
            "name": "スキル 9",
            "text": {
                "0_B2480": "融化在恋情中吧。"
            },
            "raw_text": {
                "0_B2480": "恋に溶けるの。"
            }
        },
        "0_B2810": {
            "name": "アタック 16",
            "text": {
                "0_B2810": "转啊转，轰！"
            },
            "raw_text": {
                "0_B2810": "ぐるぐるガーン。"
            }
        },
        "0_B2820": {
            "name": "アタック 17",
            "text": {
                "0_B2820": "嘎噜嘎噜上啊—。"
            },
            "raw_text": {
                "0_B2820": "ガルガルだー。"
            }
        },
        "0_B2830": {
            "name": "アタック 18",
            "text": {
                "0_B2830": "糖果导弹。"
            },
            "raw_text": {
                "0_B2830": "キャンディーミサイル。"
            }
        },
        "0_B3010": {
            "name": "アタック 19",
            "text": {
                "0_B3010": "热诱导弹哦。"
            },
            "raw_text": {
                "0_B3010": "熱誘導だぜ。"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "看招，咚地一下。"
            },
            "raw_text": {
                "0_B410": "はい、どーんと。"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "冰淇淋超好吃—。"
            },
            "raw_text": {
                "0_B420": "アイスうみゃー。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "要吃糖果吗。"
            },
            "raw_text": {
                "0_B430": "キャンディ食べる"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "意思就是给我狂吹吧。"
            },
            "raw_text": {
                "0_B440": "吹きすさべって話さ。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "Let's go。"
            },
            "raw_text": {
                "0_B480": "レッツゴー。"
            }
        },
        "0_B490": {
            "name": "スキル 4",
            "text": {
                "0_B490": "嗯—，好美味。"
            },
            "raw_text": {
                "0_B490": "んー、はいおいしい。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "我现在正在休假中耶。"
            },
            "raw_text": {
                "0_B500": "今レジャー中なんだけど。"
            }
        },
        "0_B510": {
            "name": "開始 4",
            "text": {
                "0_B510": "那么，就华丽地干掉他们吧。"
            },
            "raw_text": {
                "0_B510": "それじゃあ、華麗に倒しちゃうか。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "穿着水着战斗还真有趣呢。难道说是御主的趣味？"
            },
            "raw_text": {
                "0_B520": "水着で戦うとか面白いね。もしかして マスターの趣味。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": ""
            },
            "raw_text": {
                "0_B540": "もう。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "我可不会原谅你哦。"
            },
            "raw_text": {
                "0_B550": "許さないかんな。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "下次我一定会完美解决的啦。"
            },
            "raw_text": {
                "0_B560": "次はまたバッチリ決めてくるから。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "我之风暴，我之夜晚，我之利刃。",
                "0_B801": "在天空闪耀，贯穿敌人吧。",
                "0_B802": "斩断疾病与灾厄之风！",
                "0_B803": "好啦，人家可爱吧～"
            },
            "raw_text": {
                "0_B800": "我が嵐、我が夜、我が刃。",
                "0_B801": "空に煌めき、敵を貫け。",
                "0_B802": "セアラ・ナアラト・フルバーン！",
                "0_B803": "はい、あてし可愛い～"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "咻咻地飞翔，闪闪发光登场！",
                "0_B811": "御主！好好拜见人家帅气又可爱的姿态吧！",
                "0_B812": "好咧，坠入爱河了吧。"
            },
            "raw_text": {
                "0_B810": "ギュンギュン飛んで、キラキラ登場。",
                "0_B811": "マスター！あたしのカッコ可愛い姿、バッチリ拝め。",
                "0_B812": "はい、恋に落ちたー。"
            }
        },
        "0_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "0_B840": "要让你看看我帅气的一面喽。"
            },
            "raw_text": {
                "0_B840": "あたしのかっこいいとこ見せちゃうぞ。"
            }
        },
        "0_B880": {
            "name": "スキル 5",
            "text": {
                "0_B880": "眼睛眨啊眨。"
            },
            "raw_text": {
                "0_B880": "おめめパチーン。"
            }
        },
        "0_B890": {
            "name": "スキル 6",
            "text": {
                "0_B890": "刮一阵风吧。"
            },
            "raw_text": {
                "0_B890": "ひと風起こすか。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "甜品攻击。"
            },
            "raw_text": {
                "0_B910": "スイーツアタック。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "飞起来，咚！"
            },
            "raw_text": {
                "0_B920": "飛んでドーン。"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "爆头痛击。"
            },
            "raw_text": {
                "0_B930": "ノーテンクラッシュ。"
            }
        },
        "0_G010": {
            "name": "レベルアップ 1",
            "text": {
                "0_G010": "好好，成长啦—。不过身高倒是没变高呢。",
                "0_G011": ""
            },
            "raw_text": {
                "0_G010": "はいはい、成長ー。背丈とか高くなんない。",
                "0_G011": ""
            }
        },
        "0_G020": {
            "name": "霊基再臨 2",
            "text": {
                "0_G020": "没有变化。也就是说下次交棒给我。所以灵基保持这样的话，我会很高兴的呢—。",
                "0_G021": "",
                "0_G022": ""
            },
            "raw_text": {
                "0_G020": "変化なし。次は私にバトンタッチってこと。だからレイキはこのままだと、あたし嬉しいなー。",
                "0_G021": "",
                "0_G022": ""
            }
        },
        "0_G030": {
            "name": "霊基再臨 1",
            "text": {
                "0_G030": "哦、哦哦，这样会不会太迷倒御主了呢？要是御主喜欢的话，我当然可以保持这样哦？说话听起来像陷阱？切，别看穿我嘛。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            },
            "raw_text": {
                "0_G030": "お、おお、これはちょっとマスターを魅了しすぎかな？マスターが好きなら、もちろんこのままでいるけど？発言が罠っぽい？ちぇ、見破るなよ。",
                "0_G031": "",
                "0_G032": "",
                "0_G033": "",
                "0_G034": ""
            }
        },
        "0_G110": {
            "name": "レベルアップ 2",
            "text": {
                "0_G110": "嗯—……种火要是有夏天的风味就好了呢。",
                "0_G111": ""
            },
            "raw_text": {
                "0_G110": "んー……種火も夏の味付けが欲しいところ。",
                "0_G111": ""
            }
        },
        "0_H010": {
            "name": "誕生日",
            "text": {
                "0_H010": "哼哼，我可是好好记着呢。谢谢你来到这个世界上，谢谢你把我带到了这里。生日快乐。",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            },
            "raw_text": {
                "0_H010": "ふふっ、ちゃーんと覚えてるよ。生まれてきてくれて、あたしをここに連れてきてくれて、本当にありがとうね。ハッピーバースデー。",
                "0_H011": "",
                "0_H012": "",
                "0_H013": ""
            }
        },
        "0_H020": {
            "name": "イベント開催中",
            "text": {
                "0_H020": "是活动耶—！快把我变得越来越强吧—。",
                "0_H021": ""
            },
            "raw_text": {
                "0_H020": "イベントだー！あたしをどんどん強くしちゃえー。",
                "0_H021": ""
            }
        },
        "0_H030": {
            "name": "会話 1",
            "text": {
                "0_H030": "御主，去玩吧—！首选大海，巨浪泳池，去山里也行哦。",
                "0_H031": ""
            },
            "raw_text": {
                "0_H030": "マスター、遊びに行こー！本命海、太鼓プール、山でもいいよ。",
                "0_H031": ""
            }
        },
        "0_H040": {
            "name": "会話 2",
            "text": {
                "0_H040": "主仆啊……你想被叫『主人大人』之类的吗？干嘛啊，露出那种怪表情。",
                "0_H041": "",
                "0_H042": ""
            },
            "raw_text": {
                "0_H040": "シュジュウか…ご主人様?とか呼ばれたかったりする?なーんだね、その変な顔は。",
                "0_H041": "",
                "0_H042": ""
            }
        },
        "0_H050": {
            "name": "会話 3",
            "text": {
                "0_H050": "和御主的关系？这和以前一样没变哦。战友，重要的人。死了就是死了，仅此而已。",
                "0_H051": "",
                "0_H052": "",
                "0_H053": "",
                "0_H054": ""
            },
            "raw_text": {
                "0_H050": "マスターとの関係。 これは前と変わらないよ。戦友 大切な人。 死んだら死ぬ。それだけ。",
                "0_H051": "",
                "0_H052": "",
                "0_H053": "",
                "0_H054": ""
            }
        },
        "0_H060": {
            "name": "好きなこと",
            "text": {
                "0_H060": "喜欢的事物吗？可能是因为换上了水着，变得相当喜欢大海和泳池了呢。痛痛快快地游泳，痛痛快快地飞翔。",
                "0_H061": "",
                "0_H062": ""
            },
            "raw_text": {
                "0_H060": "好きなことか、水着になったせいか、海とかプールがかなり好きになったな。ガーっと泳いだり、ガーっと飛んだり。",
                "0_H061": "",
                "0_H062": ""
            }
        },
        "0_H070": {
            "name": "嫌いなこと 1",
            "text": {
                "0_H070": "讨厌的事物啊，有一个。虫、虫、被虫咬。不，虽然不会被咬，但偶尔出现巨大的虫子时背上就会一阵发毛。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            },
            "raw_text": {
                "0_H070": "嫌いなことかあ 1つあった。虫 虫 虫 刺され いや 刺されないんだけど、たまに巨大な虫が出てくると背中がゾワゾワしてくる。",
                "0_H071": "",
                "0_H072": "",
                "0_H073": ""
            }
        },
        "0_H080": {
            "name": "聖杯について",
            "text": {
                "0_H080": "圣杯吗？许愿倒是有的哦。但是我不告诉你想许什么。就算加深羁绊也不告诉你。不如说，羁绊越深越不想告诉你了。不，没什么啦，没什么。",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": "",
                "0_H085": ""
            },
            "raw_text": {
                "0_H080": "聖杯か？ 願い事あるよ。でも教えてあげない。絆を深めても教えてあげない。むしろ 絆が深まると教えてあげたくなくなる。 いや、何でもないよ。何でも",
                "0_H081": "",
                "0_H082": "",
                "0_H083": "",
                "0_H084": "",
                "0_H085": ""
            }
        },
        "0_H090": {
            "name": "絆Lv.1",
            "text": {
                "0_H090": "猜对羁绊了。毕竟我和御主已经有很深的羁绊了嘛。你要是说没有我可要生气了哦。",
                "0_H091": "",
                "0_H092": ""
            },
            "raw_text": {
                "0_H090": "絆 当てした。マスター もう強い絆があるもんね。ないって言ったら怒るぞ。",
                "0_H091": "",
                "0_H092": ""
            }
        },
        "0_H100": {
            "name": "絆Lv.2",
            "text": {
                "0_H100": "喂，御主。好无聊啊。理理我嘛。",
                "0_H101": "",
                "0_H102": ""
            },
            "raw_text": {
                "0_H100": "ねえ、マスター。暇だよ。構えよ。",
                "0_H101": "",
                "0_H102": ""
            }
        },
        "0_H1000": {
            "name": "絆Lv.1 (奏章Ⅳクリア以降)",
            "text": {
                "0_H1000": "基列莱特的水着很可爱呢。我可没有什么别的含意哦。",
                "0_H1001": ""
            },
            "raw_text": {
                "0_H1000": "キリエライトの水着、可愛いね。別に含むところはないよ。",
                "0_H1001": ""
            }
        },
        "0_H110": {
            "name": "絆Lv.3",
            "text": {
                "0_H110": "御主你啊，给别人看水着的时候会感到不好意思吗？我可能有点害羞呢。但是被移开视线又会觉得不爽。到底是想怎样嘛。啊哈哈。",
                "0_H111": "",
                "0_H112": "",
                "0_H113": ""
            },
            "raw_text": {
                "0_H110": "マスターはさ 水着を見せる時って恥ずかしかったりする？ あたしはちょっと恥ずかしいかも。でも目を逸らされるのも嫌かも。どっち なんだって話だよね。あはは。",
                "0_H111": "",
                "0_H112": "",
                "0_H113": ""
            }
        },
        "0_H120": {
            "name": "絆Lv.4",
            "text": {
                "0_H120": "换成这身姿态后，死不死什么的不是显得很蠢嘛。话说也不会死吧，一定。嗯。但要是情况不妙的话，不管是什么严肃的时空我都给它粉碎掉，把你拉回这个时空来，所以放心吧。没事的。",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            },
            "raw_text": {
                "0_H120": "この姿だと死ぬとか死なないとかバカバカしくない。 ていうか 死なないよね。きっと。 うん。でももしまずかったらどんなシリアス もぶち壊して こっちの時空に引っ張り込むから大丈夫。大丈夫。",
                "0_H121": "",
                "0_H122": "",
                "0_H123": ""
            }
        },
        "0_H1200": {
            "name": "絆Lv.2 (奏章Ⅳクリア以降)",
            "text": {
                "0_H1200": "哼—，得意忘形了啊。那人家就要得意忘形3倍—。",
                "0_H1201": ""
            },
            "raw_text": {
                "0_H1200": "ふーん、浮かれてるんだ。じゃあアテシは３倍浮かれよー。",
                "0_H1201": ""
            }
        },
        "0_H130": {
            "name": "絆Lv.5",
            "text": {
                "0_H130": "喂，御主。羁绊都加深到这种地步了，我现在在想什么你不是随随便便就能猜中吗？没问题吧？没问题吧？可以的吧？来嘛来嘛，猜猜看呀。不用提示应该也行吧！对吧。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": "",
                "0_H135": ""
            },
            "raw_text": {
                "0_H130": "ねえ、マスター こんだけ。絆が深まったら私が今何考えてるかとか簡単に当てられない。 大丈夫？大丈夫？いけるいける？ほらほら 当ててみてよ。ノーヒントでもいけるっしょ！ ね。",
                "0_H131": "",
                "0_H132": "",
                "0_H133": "",
                "0_H134": "",
                "0_H135": ""
            }
        },
        "0_H1400": {
            "name": "絆Lv.3 (奏章Ⅳクリア以降)",
            "text": {
                "0_H1400": "穿水着跑去战斗模拟室了？啊哈哈，在搞什么啊。话虽这么说，其实我也经常干这种糊涂事呢。",
                "0_H1401": "",
                "0_H1402": ""
            },
            "raw_text": {
                "0_H1400": "戦闘シミュレーターに水着で来ちゃった？あはは、なにやってんだか。とか言ってたら普通にあたしもやらかしたな。",
                "0_H1401": "",
                "0_H1402": ""
            }
        },
        "0_H1600": {
            "name": "絆Lv.4 (奏章Ⅳクリア以降)",
            "text": {
                "0_H1600": "那个……御主？啊，抱歉，没什么。我正在想些不好的事情呢……啊哈哈。",
                "0_H1601": "",
                "0_H1602": "",
                "0_H1603": ""
            },
            "raw_text": {
                "0_H1600": "えーっと……マスター？あ、ごめん、なんでもない。あたしよくないこと考えてるや……あはは。",
                "0_H1601": "",
                "0_H1602": "",
                "0_H1603": ""
            }
        },
        "0_H170": {
            "name": "会話 4",
            "text": {
                "0_H170": "果然穿水着的从者也有很多呢。不，我才没有输，完全没输，不如说是我赢了才对。输不了的吧。",
                "0_H171": "",
                "0_H172": "",
                "0_H173": "",
                "0_H174": ""
            },
            "raw_text": {
                "0_H170": "やっぱ 水着着てる。サーヴァント もたくさんいるなあ。いや 負けてないから全然負けてないからむしろ 勝ってるから。 勝ってるよね。",
                "0_H171": "",
                "0_H172": "",
                "0_H173": "",
                "0_H174": ""
            }
        },
        "0_H180": {
            "name": "会話 5",
            "text": {
                "0_H180": "嘿—，那就是迦勒底的新所长啊。哼—，你喜欢强势的上司那一款吗？比如『御主君，正座！』之类的。",
                "0_H181": "",
                "0_H182": "",
                "0_H183": ""
            },
            "raw_text": {
                "0_H180": "へぇー、あれがカルデアの新しい所長さんなんだ。ふーん、気の強い上司とかが好みだったりするの？マスターくん、せいざ！みたいな。",
                "0_H181": "",
                "0_H182": "",
                "0_H183": ""
            }
        },
        "0_H1800": {
            "name": "絆Lv.5 (奏章Ⅳクリア以降)",
            "text": {
                "0_H1800": "之前说的那些不好的事。没什么啦。说没什么就是没什么。再问下去就要绝交了哦。虽然这是我自己的错啦。",
                "0_H1801": "",
                "0_H1802": "",
                "0_H1803": ""
            },
            "raw_text": {
                "0_H1800": "以前言ってた 良くないこと。 なんでもない。何でもないったら何でもない。それ以上言ったら絶交だかんね。私のせいなんだけどさ。",
                "0_H1801": "",
                "0_H1802": "",
                "0_H1803": ""
            }
        },
        "0_H190": {
            "name": "会話 6",
            "text": {
                "0_H190": "啊，是哈贝特洛特女士。问我为什么要加敬称？哎呀你看，好像不是我的那个我一直给人添麻烦了？况且以后缝制水着方面也要受她照顾，干嘛要把那么好的孩子也卷进来啊，我真是个傻瓜。",
                "0_H191": "",
                "0_H192": "",
                "0_H193": "",
                "0_H194": ""
            },
            "raw_text": {
                "0_H190": "あ、ハベトロットさんだ。なんでさん付けかって?いやほら、当てしじゃない当てしがこう、ずーっとやっちゃったらしいから?これからも水着の縫製とかでお世話になるし、なんであんないい子まで巻き込んじゃうかな、当てしのバカ。",
                "0_H191": "",
                "0_H192": "",
                "0_H193": "",
                "0_H194": ""
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "好像听说4个人一起把心中的想法大声喊出来了呢。果然感到很爽快吧。诶，超棒的！我也想试试看啊。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": ""
            },
            "raw_text": {
                "0_H200": "なんか4人で思いの丈を叫んだらしいじゃん。やっぱり気分爽快だった。 え、めちゃくちゃ良かった！ あたしもやりたかった。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": ""
            }
        },
        "0_H3070": {
            "name": "嫌いなこと 2",
            "text": {
                "0_H3070": "讨厌的从者？没有—哦。",
                "0_H3071": ""
            },
            "raw_text": {
                "0_H3070": "嫌いなサーヴァント？いませーん。",
                "0_H3071": ""
            }
        },
        "0_S010": {
            "name": "召喚",
            "text": {
                "0_S010": "好—好—。是我哦。自我介绍什么的需要吗？不需要吧。但我还是要说。我是莉莉丝。这次是夏天限定的夏日版本哦。如果不看我看呆了的话，我可是会大哭大闹、训斥你然后再起诉你的哦。",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            },
            "raw_text": {
                "0_S010": "はい、はーい。あてしだよ。自己紹介とかいる いらないよね。でも言っちゃう。私はリリス。今回は 夏限定 サマーバージョンだよ。見とれてくんないと泣きわめいて 叱るのちに訴えるからね。",
                "0_S011": "",
                "0_S012": "",
                "0_S013": "",
                "0_S014": "",
                "0_S015": ""
            }
        },
        "2_B010": {
            "name": "アタック 1",
            "text": {
                "2_B010": "走你。"
            },
            "raw_text": {
                "2_B010": "そーれ。"
            }
        },
        "2_B020": {
            "name": "アタック 2",
            "text": {
                "2_B020": "看这招。"
            },
            "raw_text": {
                "2_B020": "これです。"
            }
        },
        "2_B030": {
            "name": "アタック 3",
            "text": {
                "2_B030": "不可以哦。"
            },
            "raw_text": {
                "2_B030": "ダメですよ。"
            }
        },
        "2_B040": {
            "name": "エクストラアタック 1",
            "text": {
                "2_B040": "要起舞了哦。",
                "2_B041": ""
            },
            "raw_text": {
                "2_B040": "踊りますよ。",
                "2_B041": ""
            }
        },
        "2_B050": {
            "name": "宝具 1",
            "text": {
                "2_B050": "坠入爱河的话就歌唱吧。",
                "2_B051": "收获爱意的话就战斗吧。",
                "2_B052": "『其为彻霄之龙卷，宛如终焉之白鸟』",
                "2_B053": "恋爱的歌曲很伤人吧。"
            },
            "raw_text": {
                "2_B050": "恋をしたなら、歌いましょう。",
                "2_B051": "愛を得たなら、戦いましょう。",
                "2_B052": "ラシール・セアラ・レドディ。",
                "2_B053": "恋の歌は痛いでしょう。"
            }
        },
        "2_B080": {
            "name": "スキル 1",
            "text": {
                "2_B080": "要干了哦。‘好—！’"
            },
            "raw_text": {
                "2_B080": "やりますよ。はーい。"
            }
        },
        "2_B090": {
            "name": "スキル 2",
            "text": {
                "2_B090": "这个如何呢。"
            },
            "raw_text": {
                "2_B090": "こちらいかがですか。"
            }
        },
        "2_B100": {
            "name": "開始 1",
            "text": {
                "2_B100": "那么我们要开始喽。‘上啊—！干掉他们！’Namaste。‘真搞不懂Drei的定位。’"
            },
            "raw_text": {
                "2_B100": "それでは始めますよ。やるぞー！ぶっ殺しだ！なまして。ドライの方向性がわからない。"
            }
        },
        "2_B110": {
            "name": "開始 2",
            "text": {
                "2_B110": "我可是成熟的大人呢。就优雅地、顺畅地杀掉他们吧。"
            },
            "raw_text": {
                "2_B110": "私は大人ですからね。たおやかに、そして滑らかに殺します。"
            }
        },
        "2_B120": {
            "name": "勝利 1",
            "text": {
                "2_B120": "赢啦—！耶—！‘苍天已死。’Drei，你那是跟谁学的呀。"
            },
            "raw_text": {
                "2_B120": "勝ったー！イエーイ！蒼天すでに死す。ドライ、それ誰から習いました。"
            }
        },
        "2_B130": {
            "name": "勝利 2",
            "text": {
                "2_B130": "来吧，御主，我们要凯旋了。挽起手臂之类的吧。"
            },
            "raw_text": {
                "2_B130": "さあ、マスター、凱旋ですよ。腕を組んだりとかしちゃいましょう。"
            }
        },
        "2_B140": {
            "name": "ダメージ 2",
            "text": {
                "2_B140": "呜软。"
            },
            "raw_text": {
                "2_B140": "ふにゃ。"
            }
        },
        "2_B150": {
            "name": "ダメージ 1",
            "text": {
                "2_B150": "痛痛痛痛。"
            },
            "raw_text": {
                "2_B150": "あいたたたた。"
            }
        },
        "2_B160": {
            "name": "戦闘不能 1",
            "text": {
                "2_B160": "就到此为止了吗。遗憾。那么再会。"
            },
            "raw_text": {
                "2_B160": "ここまでですか。残念。ではまた。"
            }
        },
        "2_B170": {
            "name": "戦闘不能 2",
            "text": {
                "2_B170": "‘要引退啦—。’就是这么回事。"
            },
            "raw_text": {
                "2_B170": "引退しまーす。そういうことで。"
            }
        },
        "2_B180": {
            "name": "コマンドカード 1",
            "text": {
                "2_B180": "遵命。"
            },
            "raw_text": {
                "2_B180": "ラシャッタ。"
            }
        },
        "2_B190": {
            "name": "コマンドカード 2",
            "text": {
                "2_B190": "OK。"
            },
            "raw_text": {
                "2_B190": "オッケー。"
            }
        },
        "2_B200": {
            "name": "コマンドカード 3",
            "text": {
                "2_B200": "‘不要—。’不可以任性哦。"
            },
            "raw_text": {
                "2_B200": "やだー、わがまま言わないの。"
            }
        },
        "2_B2010": {
            "name": "アタック 10",
            "text": {
                "2_B2010": "请尝尝看吧。"
            },
            "raw_text": {
                "2_B2010": "맛있어 보세요."
            }
        },
        "2_B2020": {
            "name": "アタック 11",
            "text": {
                "2_B2020": "扁掉了呢。"
            },
            "raw_text": {
                "2_B2020": "ぺしゃんこですね。"
            }
        },
        "2_B2030": {
            "name": "アタック 12",
            "text": {
                "2_B2030": "风啊，风啊。"
            },
            "raw_text": {
                "2_B2030": "風よ、風よ。"
            }
        },
        "2_B210": {
            "name": "宝具カード 1",
            "text": {
                "2_B210": "解放宝具。"
            },
            "raw_text": {
                "2_B210": "宝具解放します。"
            }
        },
        "2_B220": {
            "name": "宝具カード 2",
            "text": {
                "2_B220": "宝具准备，‘要唱歌啦—！’"
            },
            "raw_text": {
                "2_B220": "宝具準備、歌うぞー。"
            }
        },
        "2_B230": {
            "name": "宝具カード 3",
            "text": {
                "2_B230": "就让我盛大献唱一曲吧。"
            },
            "raw_text": {
                "2_B230": "一つ盛大に歌いますね。"
            }
        },
        "2_B2410": {
            "name": "アタック 13",
            "text": {
                "2_B2410": "呼啸咆哮吧。"
            },
            "raw_text": {
                "2_B2410": "吹きすさべ。"
            }
        },
        "2_B2420": {
            "name": "アタック 14",
            "text": {
                "2_B2420": "小蛇这边请。"
            },
            "raw_text": {
                "2_B2420": "蛇さんこちら。"
            }
        },
        "2_B2430": {
            "name": "アタック 15",
            "text": {
                "2_B2430": "肚子饿了呢。"
            },
            "raw_text": {
                "2_B2430": "空腹ですね。"
            }
        },
        "2_B2810": {
            "name": "アタック 16",
            "text": {
                "2_B2810": "转啊转。"
            },
            "raw_text": {
                "2_B2810": "くるくるり。"
            }
        },
        "2_B2820": {
            "name": "アタック 17",
            "text": {
                "2_B2820": "好开心。"
            },
            "raw_text": {
                "2_B2820": "楽しい"
            }
        },
        "2_B2830": {
            "name": "アタック 18",
            "text": {
                "2_B2830": "风暴啊。"
            },
            "raw_text": {
                "2_B2830": "嵐よ。"
            }
        },
        "2_B3010": {
            "name": "アタック 19",
            "text": {
                "2_B3010": "哎呀，没事吧。"
            },
            "raw_text": {
                "2_B3010": "あら、大丈夫。"
            }
        },
        "2_B410": {
            "name": "アタック 4",
            "text": {
                "2_B410": "看招看招看招—。"
            },
            "raw_text": {
                "2_B410": "それそれそれー。"
            }
        },
        "2_B420": {
            "name": "アタック 5",
            "text": {
                "2_B420": "把你们吹飞。"
            },
            "raw_text": {
                "2_B420": "吹っ飛ばします。"
            }
        },
        "2_B430": {
            "name": "アタック 6",
            "text": {
                "2_B430": "哗啦—。"
            },
            "raw_text": {
                "2_B430": "さっばーん。"
            }
        },
        "2_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "2_B440": "Finish。"
            },
            "raw_text": {
                "2_B440": "フィニッシュ。"
            }
        },
        "2_B480": {
            "name": "スキル 3",
            "text": {
                "2_B480": "真可惜。"
            },
            "raw_text": {
                "2_B480": "残念です。"
            }
        },
        "2_B490": {
            "name": "スキル 4",
            "text": {
                "2_B490": "‘驾、驾照呢？’没问题—。"
            },
            "raw_text": {
                "2_B490": "め、免許は？問題なーし。"
            }
        },
        "2_B500": {
            "name": "開始 3",
            "text": {
                "2_B500": "并非风暴与黑夜，而是鲜花与夏日的魔女，参上。"
            },
            "raw_text": {
                "2_B500": "嵐と夜、ではなく、花と夏の魔女、参ります。"
            }
        },
        "2_B510": {
            "name": "開始 4",
            "text": {
                "2_B510": "‘啊、偶像之力全开。’能理解你害羞的心情。‘成熟点吧。’还真是辛辣呢。"
            },
            "raw_text": {
                "2_B510": "あ、アイドルパワー全開。照れがある気持ちはわかる。大人になれよ。辛辣ですね。"
            }
        },
        "2_B520": {
            "name": "勝利 3",
            "text": {
                "2_B520": "那么就挽着手臂吧。‘你在发抖呢。’Drei，安静一点。"
            },
            "raw_text": {
                "2_B520": "じゃあ 腕を組みましょう。震えてるね。ドライ うるさいですよ。"
            }
        },
        "2_B540": {
            "name": "ダメージ 4",
            "text": {
                "2_B540": "还早着呢。"
            },
            "raw_text": {
                "2_B540": "まだまだ。"
            }
        },
        "2_B550": {
            "name": "ダメージ 3",
            "text": {
                "2_B550": ""
            },
            "raw_text": {
                "2_B550": "ひどーい。"
            }
        },
        "2_B560": {
            "name": "戦闘不能 3",
            "text": {
                "2_B560": "我去稍微改装一下神殿。‘会回来的哦！’"
            },
            "raw_text": {
                "2_B560": "ちょっとリフォームしてきます。帰ってくるぞ。"
            }
        },
        "2_B800": {
            "name": "宝具 2",
            "text": {
                "2_B800": "怀揣思念，为爱迷茫，",
                "2_B801": "我们再次奔赴战场。",
                "2_B802": "『其为彻霄之龙卷，宛如终焉之白鸟』",
                "2_B803": "是恋爱啊—。"
            },
            "raw_text": {
                "2_B800": "想いを馳せて、恋にまどって。",
                "2_B801": "私たちはまた戦うのです。",
                "2_B802": "ラシール・セアラ・レドディ。",
                "2_B803": "こいだー。"
            }
        },
        "2_B810": {
            "name": "宝具 3",
            "text": {
                "2_B810": "好厉害！闪闪发光的呢。",
                "2_B811": "‘歌颂恋情吧。’",
                "2_B812": "‘偶像就是爆炸！’",
                "2_B813": "爆炸。爆炸。"
            },
            "raw_text": {
                "2_B810": "すごい！ピカピカしてる。",
                "2_B811": "恋を歌うぞー。",
                "2_B812": "アイドルは爆発だぞー。",
                "2_B813": "爆発……爆発。"
            }
        },
        "2_B820": {
            "name": "宝具 4",
            "text": {
                "2_B820": "守护心上人的永恒恋歌，",
                "2_B821": "将不知去向的恋心，献给你。",
                "2_B822": "『其为彻霄之龙卷，宛如终焉之白鸟』",
                "2_B823": "我的恋情啊，你好。"
            },
            "raw_text": {
                "2_B820": "アニレドリベドリリ。",
                "2_B821": "行き先知らぬ恋心を、あなたへ。",
                "2_B822": "ラシール・セアラ・レドディ。",
                "2_B823": "私の恋よ、こんにちは。"
            }
        },
        "2_B840": {
            "name": "エクストラアタック 3",
            "text": {
                "2_B840": "‘跳舞就会死啊—！’莫名其妙。",
                "2_B841": "",
                "2_B842": ""
            },
            "raw_text": {
                "2_B840": "踊ったら死ぬー！意味ふ。",
                "2_B841": "",
                "2_B842": ""
            }
        },
        "2_B880": {
            "name": "スキル 5",
            "text": {
                "2_B880": "夏天是？‘冰淇淋。’"
            },
            "raw_text": {
                "2_B880": "夏は？アイス。"
            }
        },
        "2_B890": {
            "name": "スキル 6",
            "text": {
                "2_B890": "如风暴般，如鲜花般。"
            },
            "raw_text": {
                "2_B890": "嵐のように、花のように。"
            }
        },
        "2_B910": {
            "name": "アタック 7",
            "text": {
                "2_B910": "要华丽地解决哦。"
            },
            "raw_text": {
                "2_B910": "カレーにですよ。"
            }
        },
        "2_B920": {
            "name": "アタック 8",
            "text": {
                "2_B920": "就是那样哦。"
            },
            "raw_text": {
                "2_B920": "そうだよ。"
            }
        },
        "2_B930": {
            "name": "アタック 9",
            "text": {
                "2_B930": "夷为平地。"
            },
            "raw_text": {
                "2_B930": "更地にします。"
            }
        },
        "2_G010": {
            "name": "レベルアップ 1",
            "text": {
                "2_G010": "升级，恭喜你—！再加把劲。",
                "2_G011": "",
                "2_G012": ""
            },
            "raw_text": {
                "2_G010": "レベルアップ、おめでとうー！もう一声。",
                "2_G011": "",
                "2_G012": ""
            }
        },
        "2_G040": {
            "name": "霊基再臨 1",
            "text": {
                "2_G040": "好的，正因如此，是我哦。御主，与其说是水着，不如说是偶像规格的我。莉林也因为能跳舞而兴奋不已呢。‘要展现一手了，加油！’‘仔细反复讨论，进行综合性讨论。’‘这说的什么语言啊。’",
                "2_G041": "",
                "2_G042": "",
                "2_G043": "",
                "2_G044": "",
                "2_G045": "",
                "2_G046": ""
            },
            "raw_text": {
                "2_G040": "はい、というわけで 私ですよ。マスター 水着というよりも アイドル仕様の私です。リリンも踊れるのではしゃいでますね。決めるぜ 頑張る。丁寧に議論を重ね、総合的に議論します。何語。",
                "2_G041": "",
                "2_G042": "",
                "2_G043": "",
                "2_G044": "",
                "2_G045": "",
                "2_G046": ""
            }
        },
        "2_G050": {
            "name": "霊基再臨 2",
            "text": {
                "2_G050": "嗨—！是我哦！还是说！那边的我比较好吗？开玩笑的啦。要是御主会考虑那种事情的话，我也不会这么喜欢你了。完全没想到能和你一起度过夏天，所以稍微有些得意忘形就请多包涵啦。接下来要去泳池，去大海，还要去山上，总之把夏天所有快乐的事情全做一遍吧。尽情享受才是属于你的夏天呀。",
                "2_G051": "",
                "2_G052": "",
                "2_G053": "",
                "2_G054": "",
                "2_G055": "",
                "2_G056": "",
                "2_G057": ""
            },
            "raw_text": {
                "2_G050": "やっほー！私だよ！それとも！ 私の方が良かったですか？なんてね。そんなことを考える マスターなら私はこんなに好きにならないか。一緒に夏を過ごせるなんて思ってもみなかったから、ちょっと浮かれているのは見逃してね。この後は プール行って海行って山にも行って、とにかく 夏の楽しいことは全部やっちゃおう。思いっきり楽しんでこそ あなたの夏なんだから。",
                "2_G051": "",
                "2_G052": "",
                "2_G053": "",
                "2_G054": "",
                "2_G055": "",
                "2_G056": "",
                "2_G057": ""
            }
        },
        "2_G110": {
            "name": "レベルアップ 2",
            "text": {
                "2_G110": "哼哼，一直以来多谢您了。"
            },
            "raw_text": {
                "2_G110": "ふふっ、いつもありがとうございます。"
            }
        },
        "2_G120": {
            "name": "レベルアップ 3",
            "text": {
                "2_G120": "本来想装傻搞笑一下的但没想出来。‘不用搞笑也没关系的。’",
                "2_G121": ""
            },
            "raw_text": {
                "2_G120": "ボケようとしたけど思いつかなかったボケなくていいんです。",
                "2_G121": ""
            }
        },
        "2_H010": {
            "name": "誕生日",
            "text": {
                "2_H010": "祝您生日快乐。如果您能健康、并且幸福的话，那对我而言就是最大的幸福。不过，要是遇到什么事的话，请一定要告诉我哦。",
                "2_H011": "",
                "2_H012": "",
                "2_H013": ""
            },
            "raw_text": {
                "2_H010": "誕生日おめでとうございます。あなたが健やかに そして幸福であるなら、それが私にとって最大の幸福です。でも、もし何かあるのなら 私に言ってくださいね。",
                "2_H011": "",
                "2_H012": "",
                "2_H013": ""
            }
        },
        "2_H020": {
            "name": "イベント開催中",
            "text": {
                "2_H020": "活动！也就是转圈圈—。",
                "2_H021": "",
                "2_H022": ""
            },
            "raw_text": {
                "2_H020": "イベント！つまりぐるぐるー。",
                "2_H021": "",
                "2_H022": ""
            }
        },
        "2_H030": {
            "name": "会話 1",
            "text": {
                "2_H030": "要出发啦—！去百货商店！",
                "2_H031": ""
            },
            "raw_text": {
                "2_H030": "行くぞー！デパァーツ。",
                "2_H031": ""
            }
        },
        "2_H040": {
            "name": "会話 2",
            "text": {
                "2_H040": "当然，您就是御主。值得依靠的御主，对吧。",
                "2_H041": ""
            },
            "raw_text": {
                "2_H040": "もちろん、あなたがマスターです。頼れるマスター、ですよね。",
                "2_H041": ""
            }
        },
        "2_H050": {
            "name": "会話 3",
            "text": {
                "2_H050": "与御主的关系？我是通过御主获得魔力供给，并由此诞生出莉林。也就是说，这些孩子是我和您的孩子。好啦，爸爸，我们要一起加油哦。",
                "2_H051": "",
                "2_H052": "",
                "2_H053": "",
                "2_H054": ""
            },
            "raw_text": {
                "2_H050": "マスターとの関係。 私はマスターを通して 魔力を供給してもらい、それにより リリンを生み出しています。つまり、この子達は私とあなたの子というわけです。はい、パパ 頑張りましょうね。",
                "2_H051": "",
                "2_H052": "",
                "2_H053": "",
                "2_H054": ""
            }
        },
        "2_H060": {
            "name": "好きなこと",
            "text": {
                "2_H060": "我喜欢御主哦。另外，我也有一点喜欢唱歌。虽然偶尔会觉得不好意思。只是偶尔哦。",
                "2_H061": "",
                "2_H062": "",
                "2_H063": ""
            },
            "raw_text": {
                "2_H060": "マスターが好きですよ。それから 歌うこともちょっと好きです。たまに 恥ずかしくなりますけど。 たまに。",
                "2_H061": "",
                "2_H062": "",
                "2_H063": ""
            }
        },
        "2_H070": {
            "name": "嫌いなこと",
            "text": {
                "2_H070": "讨厌的东西？没有哦。问我『现在』？是的，现在。",
                "2_H071": "",
                "2_H072": ""
            },
            "raw_text": {
                "2_H070": "嫌いなもの。 ありませんよ。今は？ はい、今は",
                "2_H071": "",
                "2_H072": ""
            }
        },
        "2_H080": {
            "name": "聖杯について",
            "text": {
                "2_H080": "向圣杯许下的愿望吗？让我想想。希望有朝一日能向世界歌颂爱意。将我这扭曲的爱、丑陋的恋情传达给所有人。",
                "2_H081": "",
                "2_H082": "",
                "2_H083": ""
            },
            "raw_text": {
                "2_H080": "聖杯にかける願いですか？そうですね。いつか世界に愛を歌いましょう。この私のゆがんだ愛を 醜い恋を皆に伝えられるように。",
                "2_H081": "",
                "2_H082": "",
                "2_H083": ""
            }
        },
        "2_H20090": {
            "name": "絆Lv.1",
            "text": {
                "2_H20090": "是的，请问有什么事吗，您。",
                "2_H20091": ""
            },
            "raw_text": {
                "2_H20090": "はい、なんでしょうか、あなた。",
                "2_H20091": ""
            }
        },
        "2_H20100": {
            "name": "絆Lv.2",
            "text": {
                "2_H20100": "莉林想见您，如果不介意的话……‘嗨—！理我理我。’被当成挡箭牌了呢。‘才没有。’",
                "2_H20101": "",
                "2_H20102": "",
                "2_H20103": "",
                "2_H20104": ""
            },
            "raw_text": {
                "2_H20100": "リリンが会いたがっていたので、よろしければ…やっほー。構え構え。出しにされた。してません。",
                "2_H20101": "",
                "2_H20102": "",
                "2_H20103": "",
                "2_H20104": ""
            }
        },
        "2_H20110": {
            "name": "絆Lv.3",
            "text": {
                "2_H20110": "虽然我的水着也不错，但我这身服装也很棒吧。很不错吧，偶像。不过，如果是带娃的偶像，倒是显得有些与众不同呢。",
                "2_H20111": "",
                "2_H20112": ""
            },
            "raw_text": {
                "2_H20110": "私の水着もいいものですが、私のこの服もなかなかでしょう。いいですよね。アイドル。 まあ、子持ちのアイドルとなるとちょっと異彩を放ちますが。",
                "2_H20111": "",
                "2_H20112": ""
            }
        },
        "2_H20120": {
            "name": "絆Lv.4",
            "text": {
                "2_H20120": "或许是因为换上了水着，那个我似乎有些飘飘然了呢。大概这种轻飘飘的感觉也是受其影响吧。所以可不是因为害羞哦。",
                "2_H20121": "",
                "2_H20122": ""
            },
            "raw_text": {
                "2_H20120": "水着になったせいか、少し当てしは舞い上がっているようですね。多分このふわふわした感覚はそれに引っ張られているせいかと。だから照れてなんかいませんから。",
                "2_H20121": "",
                "2_H20122": ""
            }
        },
        "2_H20130": {
            "name": "絆Lv.5",
            "text": {
                "2_H20130": "看来这种轻飘飘的感觉，正是所谓的恋爱或爱意呢。真让人惊讶。不过感觉也不坏呢，这种体验？啊，不需要回答我哦。因为这是单方面强加给你的恋爱。御主只需要带着稍微有些害羞的面容接受就好了。",
                "2_H20131": "",
                "2_H20132": "",
                "2_H20133": "",
                "2_H20134": "",
                "2_H20135": "",
                "2_H20136": ""
            },
            "raw_text": {
                "2_H20130": "どうやらこのふわふわした感覚 こそが 恋だったり、愛だったりするみたいですよ。驚きました。でも悪くはありませんね。こういうの？ あ、返事はしなくていいですよ。これは 押し付けの恋ですから。 マスターはただちょっと照れた顔で受け取ってくれればいいんです。",
                "2_H20131": "",
                "2_H20132": "",
                "2_H20133": "",
                "2_H20134": "",
                "2_H20135": "",
                "2_H20136": ""
            }
        },
        "2_H210": {
            "name": "会話 4",
            "text": {
                "2_H210": "上次真的很抱歉。没能理解大家的处境就自作主张。我也多亏了改过自新才终于明白了。家人真是美好的存在呢。对吧。",
                "2_H211": "",
                "2_H212": "",
                "2_H213": "",
                "2_H214": ""
            },
            "raw_text": {
                "2_H210": "前回はごめんなさい。皆さんの事情も理解せずに勝手なことを私も改心したおかげで理解できました。家族っていいものですね。 ねえ。",
                "2_H211": "",
                "2_H212": "",
                "2_H213": "",
                "2_H214": ""
            }
        },
        "2_H21600": {
            "name": "絆Lv.4 (奏章Ⅳクリア以降)",
            "text": {
                "2_H21600": "问我之前说的是指什么，吗？呵呵，耍赖可不行哦。",
                "2_H21601": ""
            },
            "raw_text": {
                "2_H21600": "私の言っていたことは何か、ですか？ふふ、ずるっこはダメですよ。",
                "2_H21601": ""
            }
        },
        "2_H21800": {
            "name": "絆Lv.5 (奏章Ⅳクリア以降)",
            "text": {
                "2_H21800": "真拿你没办法呢。那么，给个提示：把两个人的水着拿来对比到底哪个更好，这种问题是永远不会有答案的吧。就是这么回事。请务必好好安慰我一下。因为我哪怕只考虑了一瞬间，都好像开始讨厌起自己了呢。",
                "2_H21801": "",
                "2_H21802": "",
                "2_H21803": "",
                "2_H21804": "",
                "2_H21805": ""
            },
            "raw_text": {
                "2_H21800": "しょうがないですね。では、ヒント 2人の水着を見比べてどちらがいいかなんて 永遠に答えが出ませんよね。そういうことです。どうか私を慰めてあげてください。一瞬でも考えた。自分が嫌になっちゃったみたいなんで。",
                "2_H21801": "",
                "2_H21802": "",
                "2_H21803": "",
                "2_H21804": "",
                "2_H21805": ""
            }
        },
        "2_H220": {
            "name": "会話 5",
            "text": {
                "2_H220": "哎呀，我们的家吗？神殿看起来不太适合居住，能帮我们重新装修一下吗？还有耐震设计。另外，要是能有很多儿童房就好了呢。",
                "2_H221": "",
                "2_H222": "",
                "2_H223": ""
            },
            "raw_text": {
                "2_H220": "まあ、お家ですか。神殿は住みにくそうなので、リフォームしていただけます？あと耐震設計も。それから子供部屋がたくさんあるといいですね。",
                "2_H221": "",
                "2_H222": "",
                "2_H223": ""
            }
        },
        "2_H230": {
            "name": "会話 6",
            "text": {
                "2_H230": "哼—，北欧的时光女神吗？嘿—。御主请小心一点哦。那种女神的想法规模对人类来说有点难以想象，如果她靠近的话，保持退后三步的距离感觉刚刚好。‘弱爆了。’",
                "2_H231": "",
                "2_H232": "",
                "2_H233": "",
                "2_H234": ""
            },
            "raw_text": {
                "2_H230": "ふーん、北欧の時の女神ですか？へえ。 マスター 用心してくださいね。ああいう女神は発想のスケールがちょっと人間にはありえないので、近づいてきたら 3歩下がるくらいでちょうどいい感じだと思います。よええ。",
                "2_H231": "",
                "2_H232": "",
                "2_H233": "",
                "2_H234": ""
            }
        },
        "2_H3060": {
            "name": "好きなこと (絆Lv.5以上)",
            "text": {
                "2_H3060": "当然，因为喜欢御主，所以我打算遵守那个誓言哦。不过，如果是这种情况，未免有点不成体面呢。",
                "2_H3061": ""
            },
            "raw_text": {
                "2_H3060": "もちろん、マスターが好きなので例の誓いは守るつもりですよ。でも、さすがに格好がつかないですよね、これだと。",
                "2_H3061": ""
            }
        }
    },
    "ChrVoice_ids": [
        "405900"
    ]
}
