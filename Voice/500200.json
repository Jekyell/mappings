{
    "id": 500200,
    "collectionNo": 32,
    "name": "吉尔·德·雷",
    "voices": {
        "0_B010": {
            "name": "攻击 1",
            "text": {
                "0_B010": "感觉如何？"
            }
        },
        "0_B020": {
            "name": "アタック 2",
            "text": {
                "0_B020": ""
            },
            "raw_text": {
                "0_B020": ""
            }
        },
        "0_B030": {
            "name": "攻击 3",
            "text": {
                "0_B030": "看吧！"
            }
        },
        "0_B040": {
            "name": "额外攻击",
            "text": {
                "0_B040": "这悲鸣正是天籁之音！"
            }
        },
        "0_B050": {
            "name": "宝具 1",
            "text": {
                "0_B050": "看吧！这令人忌惮而又豪壮的，我之全新军势！",
                "0_B051": "呵呵呵呵呵。"
            },
            "raw_text": {
                "0_B050": "見よ！おぞましくも豪壮な我が新たなる軍勢を。",
                "0_B051": "フフフフフフ。"
            }
        },
        "0_B051": {
            "name": "宝具",
            "text": {
                "0_B051": "呼哈哈哈哈哈啊哈哈哈哈哈哈！！"
            }
        },
        "0_B080": {
            "name": "技能 1",
            "text": {
                "0_B080": "那么，这是否能合您心意呢？"
            }
        },
        "0_B090": {
            "name": "技能 2",
            "text": {
                "0_B090": "请笑纳！"
            }
        },
        "0_B100": {
            "name": "开始 1",
            "text": {
                "0_B100": "来，连诸神都一并嘲讽的喜剧将拉开帷幕！"
            }
        },
        "0_B110": {
            "name": "开始 2",
            "text": {
                "0_B110": "欢迎来到我这渎神之宴！"
            }
        },
        "0_B120": {
            "name": "胜利 1",
            "text": {
                "0_B120": "咈哈哈哈哈哈哈！ 闪耀之人才该遭到玷污而坠落！"
            }
        },
        "0_B130": {
            "name": "胜利 2",
            "text": {
                "0_B130": "如此一来，又一位受神祝福的英灵将堕落至黑暗深渊……唔呼呼呼。"
            }
        },
        "0_B140": {
            "name": "受击 2",
            "text": {
                "0_B140": "该死！"
            }
        },
        "0_B150": {
            "name": "受击 1",
            "text": {
                "0_B150": "你这卑贱匹夫！"
            }
        },
        "0_B160": {
            "name": "无法战斗 1",
            "text": {
                "0_B160": "如此一来，我也将成为祭品之一……"
            }
        },
        "0_B170": {
            "name": "无法战斗 2",
            "text": {
                "0_B170": "还没完，还不够污秽！"
            }
        },
        "0_B180": {
            "name": "指令卡 1",
            "text": {
                "0_B180": "是。"
            }
        },
        "0_B190": {
            "name": "指令卡 2",
            "text": {
                "0_B190": "交给我吧。"
            }
        },
        "0_B200": {
            "name": "指令卡 3",
            "text": {
                "0_B200": "没问题。"
            }
        },
        "0_B2010": {
            "name": "アタック 10",
            "text": {
                "0_B2010": "真难看真难看真难看。"
            },
            "raw_text": {
                "0_B2010": "無様無様無様。"
            }
        },
        "0_B210": {
            "name": "宝具卡",
            "text": {
                "0_B210": "就让你见识一下至上的COOL吧！"
            }
        },
        "0_B220": {
            "name": "宝具カード 2",
            "text": {
                "0_B220": "可爱的小海魔们，该你们出场了呢。"
            },
            "raw_text": {
                "0_B220": "かわいいカイマたちの出番ですね。"
            }
        },
        "0_B410": {
            "name": "アタック 4",
            "text": {
                "0_B410": "被毒素侵蚀吧。"
            },
            "raw_text": {
                "0_B410": "毒に犯されなさい。"
            }
        },
        "0_B420": {
            "name": "アタック 5",
            "text": {
                "0_B420": "痛苦地挣扎吧。"
            },
            "raw_text": {
                "0_B420": "悶え苦しむがいい。"
            }
        },
        "0_B430": {
            "name": "アタック 6",
            "text": {
                "0_B430": "被吞食的滋味如何啊？"
            },
            "raw_text": {
                "0_B430": "食われる気分は如何ごこ。"
            }
        },
        "0_B440": {
            "name": "エクストラアタック 2",
            "text": {
                "0_B440": "这数量很残酷吧？"
            },
            "raw_text": {
                "0_B440": "残酷な数でしょう。"
            }
        },
        "0_B480": {
            "name": "スキル 3",
            "text": {
                "0_B480": "何等滑稽的喜剧啊。"
            },
            "raw_text": {
                "0_B480": "なんたる喜劇か。"
            }
        },
        "0_B500": {
            "name": "開始 3",
            "text": {
                "0_B500": "这可不是战斗。而是蹂躏哦。"
            },
            "raw_text": {
                "0_B500": "戦闘ではありません。蹂躙なのですよ。"
            }
        },
        "0_B520": {
            "name": "勝利 3",
            "text": {
                "0_B520": "来，你们还能保持住人类的形态吗？"
            },
            "raw_text": {
                "0_B520": "さあ、人としての形を保っておられますかな。"
            }
        },
        "0_B540": {
            "name": "ダメージ 4",
            "text": {
                "0_B540": ""
            },
            "raw_text": {
                "0_B540": "ふん。"
            }
        },
        "0_B550": {
            "name": "ダメージ 3",
            "text": {
                "0_B550": "怎么会这样。"
            },
            "raw_text": {
                "0_B550": "まさかそんな。"
            }
        },
        "0_B560": {
            "name": "戦闘不能 3",
            "text": {
                "0_B560": "啊啊，贞德啊。我们的荣光……"
            },
            "raw_text": {
                "0_B560": "ああ、じゃぬよ。我らが栄光は。"
            }
        },
        "0_B800": {
            "name": "宝具 2",
            "text": {
                "0_B800": "我那可爱的海魔们啊，",
                "0_B801": "蹂躏吧，尽情蹂躏吧。"
            },
            "raw_text": {
                "0_B800": "我が愛すべき皆馬よ。",
                "0_B801": "蹂躙なさい、蹂躙なさい。"
            }
        },
        "0_B810": {
            "name": "宝具 3",
            "text": {
                "0_B810": "哦，我的挚友普勒拉蒂啊，",
                "0_B811": "将他所赐予的力量，于此时此地展现。"
            },
            "raw_text": {
                "0_B810": "おお我が友プレラーティよ。",
                "0_B811": "彼より与えられし力を今、ここに。"
            }
        },
        "0_B910": {
            "name": "アタック 7",
            "text": {
                "0_B910": "这是凌辱。"
            },
            "raw_text": {
                "0_B910": "これは陵辱です。"
            }
        },
        "0_B920": {
            "name": "アタック 8",
            "text": {
                "0_B920": "绝不原谅。"
            },
            "raw_text": {
                "0_B920": "許さん。"
            }
        },
        "0_B930": {
            "name": "アタック 9",
            "text": {
                "0_B930": "成为饵食吧。"
            },
            "raw_text": {
                "0_B930": "餌となるのです。"
            }
        },
        "0_G010": {
            "name": "升级",
            "text": {
                "0_G010": "不胜惶恐！"
            }
        },
        "0_G020": {
            "name": "灵基再临 2",
            "text": {
                "0_G020": "有种成为杰作的感觉！"
            }
        },
        "0_G030": {
            "name": "灵基再临 1",
            "text": {
                "0_G030": "啊啊，刚才我闪现了新的灵感……！"
            }
        },
        "0_G040": {
            "name": "灵基再临 3",
            "text": {
                "0_G040": "噢噢，您究竟打算让我提升到何等境界……！"
            }
        },
        "0_G050": {
            "name": "灵基再临 4",
            "text": {
                "0_G050": "嗬嗬嗬嗬，我的亵渎终于触及了神的领域！"
            }
        },
        "0_H010": {
            "name": "生日",
            "text": {
                "0_H010": "为您这舞台的开幕献上祝福。 那么，演出剧目是喜剧？还是悲剧？"
            }
        },
        "0_H020": {
            "name": "活动举行中",
            "text": {
                "0_H020": "此时何不寻找一些乐趣来慰藉无聊的日子？"
            }
        },
        "0_H030": {
            "name": "对话 1",
            "text": {
                "0_H030": "来吧，接下来您将设计何种方法来让我沉醉呢？"
            }
        },
        "0_H040": {
            "name": "对话 2",
            "text": {
                "0_H040": "噢噢，真是卓越的指挥…… 这才配得上当我的主人！"
            }
        },
        "0_H050": {
            "name": "对话 3",
            "text": {
                "0_H050": "在下所侍奉的您在神的御前也只是平等的仆从之一。",
                "0_H051": "来吧，让我们一起彻底亵渎、嘲弄吧！"
            }
        },
        "0_H060": {
            "name": "喜欢的东西",
            "text": {
                "0_H060": "当我想着闪耀的存在、神圣的存在时，就无法抑制内心的激动。",
                "0_H061": "尤其是一想到其被玷污的瞬间……啊啊！"
            }
        },
        "0_H070": {
            "name": "讨厌的东西",
            "text": {
                "0_H070": "我无法忍受看到那些肤浅的利欲熏心之人。 世间岂有比凡俗更甚之罪！"
            }
        },
        "0_H080": {
            "name": "关于圣杯",
            "text": {
                "0_H080": "圣杯……成就我悲愿的最后希望…… 总有一天我将得到它，一定会！"
            }
        },
        "0_H090": {
            "name": "牵绊Lv.1",
            "text": {
                "0_H090": "唔，这份努力值得认可。"
            }
        },
        "0_H100": {
            "name": "牵绊Lv.2",
            "text": {
                "0_H100": "嗯，这份诚意与热情值得评价。"
            }
        },
        "0_H110": {
            "name": "牵绊Lv.3",
            "text": {
                "0_H110": "噢噢，这是何等的创造性！ 您该不会……"
            }
        },
        "0_H120": {
            "name": "牵绊Lv.4",
            "text": {
                "0_H120": "毋庸置疑的卓越才能！ 在下敬佩不已，我的主人啊！"
            }
        },
        "0_H130": {
            "name": "牵绊Lv.5",
            "text": {
                "0_H130": "噢噢噢噢！ 这是何等神圣之美的表现！ 要如何用言语来表达在下灵魂的震颤！"
            }
        },
        "0_H140": {
            "name": "对话 4",
            "text": {
                "0_H140": "又见面了呢，转生后的第二贞德！",
                "0_H141": "作为重逢的纪念，吃下这犹如章鱼般的海魔吧！"
            }
        },
        "0_H150": {
            "name": "对话 5",
            "text": {
                "0_H150": "……总有一些不太对呢……并不是只要金发女骑士就行的……",
                "0_H151": "该说你缺乏清秀、可爱、稳重、纯洁的要素呢……还是该说你根本没有呢……"
            }
        },
        "0_H160": {
            "name": "对话 6",
            "text": {
                "0_H160": "噢噢噢噢哦哦哦！ 我的主人啊，您是神吗！不，您正是神！",
                "0_H161": "您竟然……竟然能够将她带到我的面前！"
            }
        },
        "0_H200": {
            "name": "会話 7",
            "text": {
                "0_H200": "哦呀，我的挚友普勒拉蒂啊。不过话说回来，你这身衣服可真是大不相同了呢。那么今后也让我们继续“酷（Cool）”下去吧。嗯？“酷”是什么意思？唔，这说起来可就有点长了……",
                "0_H201": "",
                "0_H202": "",
                "0_H203": "",
                "0_H204": ""
            },
            "raw_text": {
                "0_H200": "なんと、我が友プレラーティよ。いやしかし、随分と服を違えましたな。ではこれからもクールに参りましょうぞ。ん？クールとは何ぞや？ううん、少々長くなりますが。",
                "0_H201": "",
                "0_H202": "",
                "0_H203": "",
                "0_H204": ""
            }
        },
        "0_H210": {
            "name": "会話 8",
            "text": {
                "0_H210": "说起来，我的挚友，你觉得迦勒底如何？是个愉快的地方吧。我在这里待的时间也算挺长了。如果不介意的话，就由我来为你向导吧。啊，遗憾的是，这里是严禁拷问之类的哦。真是令人吃惊呢，这样一个自诩正义的组织。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": "",
                "0_H215": ""
            },
            "raw_text": {
                "0_H210": "時に我が友 カルデアはいかがですか な？愉快な場所でしょう。私など それなりに長いですからね。よろしければご案内しましょう。ああ、残念なことに 拷問などは厳禁なのですよ。まったく 驚きですよね。こんな 独身 たる組織が。",
                "0_H211": "",
                "0_H212": "",
                "0_H213": "",
                "0_H214": "",
                "0_H215": ""
            }
        },
        "0_H220": {
            "name": "会話 9",
            "text": {
                "0_H220": "嗯？是但丁·阿利吉耶里吗？你拿着笔对我的魔导书做什么……想修改一下？因为打眼一看各处都是错别字，看着难受？你这愚蠢之辈啊啊啊啊啊啊啊啊！",
                "0_H221": "",
                "0_H222": "",
                "0_H223": "",
                "0_H224": "",
                "0_H225": ""
            },
            "raw_text": {
                "0_H220": "ん？ダンテ・アリギエーリですか？ペンを持って我が魔導書に何を……修正させて欲しいだと？パッと見誤字があちこちにあるので気になるから？知れ物がぁぁぁぁぁぁぁぁ。",
                "0_H221": "",
                "0_H222": "",
                "0_H223": "",
                "0_H224": "",
                "0_H225": ""
            }
        },
        "0_S010": {
            "name": "召唤",
            "text": {
                "0_S010": "应您之邀特来赴约。小人不肖吉尔·德·雷。",
                "0_S011": "从今往后将随侍您的左右。"
            }
        }
    },
    "ChrVoice_ids": [
        "500200"
    ]
}